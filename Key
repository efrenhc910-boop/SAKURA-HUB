	local ny = a.Y + (ty - a.Y) * f
	local limX = GUI.AbsoluteSize.X - PANEL.AbsoluteSize.X
	local limY = GUI.AbsoluteSize.Y - PANEL.AbsoluteSize.Y
	PANEL.Position = UDim2.fromOffset(
		math.clamp(nx, 0, math.max(limX, 0)),
		math.clamp(ny, 0, math.max(limY, 0))
	)
end)
