local function boton(texto, x, tinte, transp)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0.3, 0, 0, 36)
    b.Position = UDim2.new(x, 0, 0, 150)
    b.AnchorPoint = Vector2.new(0.5, 0)
    b.BackgroundColor3 = tinte
    b.BackgroundTransparency = transp
    b.Text = texto
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.FredokaOne
    b.TextSize = 14
    b.TextStrokeTransparency = 0.6
    b.TextStrokeColor3 = Color3.new(0, 0, 0)
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    b.ZIndex = 12
    b.Parent = contenedor
    esquina(b, 9)
    borde(b, AGUA_CLARA, 1.4, 0.3)

    local esc = Instance.new("UIScale")
    esc.Parent = b

    b.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
            tween(esc, { Scale = 0.96 }, 0.08)
        end
    end)
    b.InputEnded:Connect(function()
        tween(esc, { Scale = 1 }, 0.2, Enum.EasingStyle.Back)
    end)

    return b
end

