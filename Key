local function tween(obj, props, time, style)
    local t = TweenService:Create(obj,
        TweenInfo.new(time or 0.25, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function corner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = obj
    return c
end

local function label(parent, text, size, font, color, pos, sz, alignX)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextSize = size
    l.Font = font
    l.TextColor3 = color
    l.TextXAlignment = alignX or Enum.TextXAlignment.Center
    if pos then l.Position = pos end
    if sz then l.Size = sz end
    l.Parent = parent
    return l
end

local function boton(parent, texto, y, colorBase, colorGlow)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -60, 0, 42)
    b.Position = UDim2.fromOffset(30, y)
    b.BackgroundTransparency = 1
    b.Text = texto
    b.TextColor3 = C.White
    b.TextSize = 13
    b.Font = Enum.Font.GothamBlack
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    b.ZIndex = 8
    b.Parent = parent
    corner(b, 10)

    local fondo = Instance.new("Frame")
    fondo.Size = UDim2.fromScale(1, 1)
    fondo.BackgroundColor3 = colorBase
    fondo.BorderSizePixel = 0
    fondo.ZIndex = 7
    fondo.Parent = b
    corner(fondo, 10)

    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new(colorBase, colorGlow)
    grad.Rotation = 45
    grad.Parent = fondo

    local borde = Instance.new("UIStroke")
    borde.Color = C.Secondary
    borde.Thickness = 1.2
    borde.Transparency = 0.4
    borde.Parent = fondo

    local esc = Instance.new("UIScale")
    esc.Parent = b

    b.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            tween(esc, { Scale = 0.96 }, 0.08)
            tween(borde, { Transparency = 0 }, 0.12)
        end
    end)
    b.InputEnded:Connect(function()
        tween(esc, { Scale = 1 }, 0.2, Enum.EasingStyle.Back)
        tween(borde, { Transparency = 0.4 }, 0.2)
    end)

    return b, grad, fondo
end

