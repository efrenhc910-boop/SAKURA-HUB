-- Bucle para actualizar los FPS reales
local frames = 0
local ultimoTiempo = tick()
RunService.RenderStepped:Connect(function()
	frames = frames + 1
	local ahora = tick()
	if ahora - ultimoTiempo >= 1 then
		fpsLabel.Text = "FPS: " .. frames
		frames = 0
		ultimoTiempo = ahora
	end
end)

