-- LÓGICA DE VALIDACIÓN Y ACCESO ASÍNCRONO
--==================================================

local busy = false
local intentos = 0
local lastTap = 0

local function procesarAcceso()
    if busy then return end
    if os.clock() - lastTap < 0.3 then return end
    lastTap = os.clock()

    local escrito = string.lower(string.gsub(Input.Text or "", "^%s*(.-)%s*$", "%1"))

    if escrito == "" then
        Status.Text = "⚠️ El campo de clave está vacío"
        Status.TextColor3 = C.Gray
        return
    end

    if escrito ~= CLAVE then
        intentos += 1
        Status.Text = "❌ Llave incorrecta · Intento " .. intentos
        Status.TextColor3 = C.Primary

        -- Efecto de vibración elegante al fallar la clave
        local base = Panel.Position
        for _, d in ipairs({ 8, -8, 5, -5, 2, 0 }) do
            Panel.Position = UDim2.new(base.X.Scale, base.X.Offset + d, base.Y.Scale, base.Y.Offset)
            task.wait(0.03)
        end
        Panel.Position = base

        tween(InputStroke, { Color = C.Primary, Transparency = 0 }, 0.1)
        task.delay(0.4, function()
            tween(InputStroke, { Color = C.Secondary, Transparency = 0.4 }, 0.25)
        end)
        return
    end

    -- Acceso Correcto: Bloquear interacciones y ejecutar hilo de red
    busy = true
    Submit.Text = "VERIFICANDO..."
    Status.TextColor3 = C.Green
    tween(SubmitGrad, { Color = ColorSequence.new(C.Green, Color3.fromRGB(10, 90, 50)) }, 0.25)

    -- Uso de task.spawn para evitar congelar el juego durante la descarga web
    task.spawn(function()
        local src = nil
        for _, url in ipairs(URLS) do
            Status.Text = "Conectando al repositorio..."
            src = descargar(url)
            if src then
                print("[SakuraKey] Código descargado con éxito desde: " .. url)
                break
            end
        end

        if not src then
            busy = false
            Submit.Text = "VERIFICAR LLAVE"
            Status.Text = "❌ Error de conexión con el servidor"
            Status.TextColor3 = C.Primary
            tween(SubmitGrad, { Color = ColorSequence.new(C.Primary, C.Blue) }, 0.25)
            mostrarAviso("No se pudo descargar el script principal. Revisa tu conexión o ejecutor.")
            return
        end

        Status.Text = "Compilando script..."
        local fn = compilar(src)
        if not fn then
            busy = false
            Submit.Text = "VERIFICAR LLAVE"
            Status.Text = "❌ Error de compilación"
            Status.TextColor3 = C.Primary
            tween(SubmitGrad, { Color = ColorSequence.new(C.Primary, C.Blue) }, 0.25)
            mostrarAviso("El código descargado no es compatible con el loadstring de tu ejecutor.")
            return
        end

        Submit.Text = "¡ACCESO CONCEDIDO!"
        Status.Text = "Iniciando Sakura Hub..."
        Status.TextColor3 = C.Green

        -- Animación de salida del panel
        tween(Outer, { Thickness = 4 }, 0.2)
        task.wait(0.3)
        tween(Panel, { BackgroundTransparency = 1, Size = UDim2.fromOffset(W * 0.6, 0) }, 0.25)
        task.wait(0.25)
        matarPanel()

        -- Ejecución protegida del Hub principal
        local ok, err = pcall(fn)
        if not ok then
            warn("[SakuraKey] Fallo al ejecutar el script principal: " .. tostring(err))
            mostrarAviso("Error interno al arrancar el Hub: " .. tostring(err))
        else
            print("[SakuraKey] Sakura Hub ejecutado correctamente.")
        end
    end)
end

Submit.Activated:Connect(procesarAcceso)
Input.FocusLost:Connect(function(enter)
