local function matarPanel()
    if Screen.Parent then Screen:Destroy() end
end

local function descargar(url)
    if type(game.HttpGet) == "function" then
        local ok, r = pcall(game.HttpGet, game, url)
        if ok and type(r) == "string" and #r > 200 then return r end
    end
    if type(game.HttpGetAsync) == "function" then
        local ok, r = pcall(game.HttpGetAsync, game, url)
        if ok and type(r) == "string" and #r > 200 then return r end
    end
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if req then
        local ok, res = pcall(req, { Url = url, Method = "GET" })
        if ok and type(res) == "table" and type(res.Body) == "string" and #res.Body > 200 then
            return res.Body
        end
    end
    return nil
end

local function compilar(src)
    local ok, fn = pcall(function() return loadstring(src) end)
    if ok and type(fn) == "function" then return fn end
    ok, fn = pcall(function() return loadstring(src, "DestroyaHub") end)
    if ok and type(fn) == "function" then return fn end
    return nil
end

