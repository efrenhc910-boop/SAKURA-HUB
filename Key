local function cargarHub()
    for _, url in ipairs(URLS) do
        local okHttp, src = pcall(function()
            return game:HttpGet(url, true)
        end)

        if okHttp and type(src) == "string" and #src > 200 then
            local fn, errCompile = loadstring(src)
            if fn then
                local okRun, errRun = pcall(fn)
                if okRun then
                    print("[DestroyaKey] hub cargado desde " .. url)
                    return true
                end
                warn("[DestroyaKey] error al ejecutar: " .. tostring(errRun))
            else
                warn("[DestroyaKey] error de compilación: " .. tostring(errCompile))
            end
        else
            warn("[DestroyaKey] no se pudo descargar: " .. url)
        end
    end
    return false
end

