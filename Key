local ARCHIVO_LLAVE = "LlaveGuardada_Im.txt"

local function normalizar(s)
    return string.lower(string.gsub(tostring(s or ""), "%s+", ""))
end

local function verificarLlaveGuardada()
    if isfile and readfile and isfile(ARCHIVO_LLAVE) then
        if normalizar(readfile(ARCHIVO_LLAVE)) == normalizar(LLAVE_CORRECTA) then return true end
    end
    return false
end

local function cargarHub()
    local ok, err = pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/efrenhc910-boop/SAKURA-HUB/refs/heads/main/v6.2"))()
    end)
    if not ok then warn("[Acceso] fallo al cargar: " .. tostring(err)) end
end

if verificarLlaveGuardada() then
    print("Llave guardada detectada, cargando...")
    cargarHub()
    return
end

local nombreRaw = player.Name
