local function crear(clase, props, padre)
	local o = Instance.new(clase)
	for k, v in pairs(props or {}) do o[k] = v end
	if padre then o.Parent = padre end
	return o
end

local function esquina(o, r)
	crear("UICorner", { CornerRadius = UDim.new(0, r or 6) }, o)
end

local function trazo(o, col, grosor, trans)
	local s = crear("UIStroke", { Color = col, Thickness = grosor or 1.5, Transparency = trans or 0 }, o)
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	return s
end

local function grad(o, c1, c2, rot)
	return crear("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rot or 90 }, o)
end
