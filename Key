local VIVAS, MAX_CHISPAS = 0, 30

local function chispa()
	if not VIVO or VIVAS >= MAX_CHISPAS then return end
	VIVAS += 1

	local tam = math.random(3, 7)
	local xs = math.random() * 0.92 + 0.04
	local s = crear("Frame", {
		Size = UDim2.fromOffset(tam, tam),
		Position = UDim2.new(xs, 0, 1, -10),
		BackgroundColor3 = (math.random(1, 3) == 1)
			and Color3.fromRGB(255, 240, 170)
			or Color3.fromRGB(255, 132, 18),
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		ZIndex = 3,
	}, FUEGO)
	esquina(s, 10)

	local alto = math.random(140, 370)
	local deriva = math.random(-30, 30) / 342
	local dur = math.random(85, 175) / 100

	local t = TweenService:Create(s, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.new(xs + deriva, 0, 0, -alto),
		Size = UDim2.fromOffset(1, 1),
		BackgroundTransparency = 1,
		Rotation = math.random(-80, 80),
	})
	t:Play()
	t.Completed:Connect(function()
		VIVAS -= 1
		s:Destroy()
	end)
end

