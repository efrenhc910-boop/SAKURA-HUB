				c.BackgroundTransparency = math.random(10, 45) / 100
				c.Size = UDim2.new(0, math.random(2, 6), 0, math.random(7, 20))
			else
				c.BackgroundTransparency = math.min(0.85, c.BackgroundTransparency + dt * 0.5)
			end
			c.Position = UDim2.new(posX, 0, posY, 0)
		end
		task.wait(0.03)
	end
end)
