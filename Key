local busy = false
local intentos = 0
local lastTap = 0

local function entrar()
    if busy then return end
    if os.clock() - lastTap < 0.25 then return end
    lastTap = os.clock()

    local escrito = string.lower(string.gsub(Input.Text or "", "^%s*(.-)%s*$", "%1"))

    if escrito == "" then
        Status.Text = "El campo está vacío"
        Status.TextColor3 = C.Gray
        return
    end

    if escrito ~= CLAVE then
        intentos += 1
        Status.Text = "Llave incorrecta  ·  intento " .. intentos
        Status.TextColor3 = C.Red

        local base = Panel.Position
        for _, d in ipairs({ 9, -9, 7, -7, 4, 0 }) do
            Panel.Position = UDim2.new(base.X.Scale, base.X.Offset + d, base.Y.Scale, base.Y.Offset)
            task.wait(0.035)
        end
        Panel.Position = base

        tween(InputStroke, { Color = C.Red, Transparency = 0 }, 0.1)
        task.delay(0.4, function()
            tween(InputStroke, { Color = C.Blue, Transparency = 0.3 }, 0.25)
        end)
        return
    end

    busy = true
    Submit.Text = "VERIFICANDO..."
    Status.TextColor3 = C.Green
    tween(SubmitGrad, { Color = ColorSequence.new(C.Green, Color3.fromRGB(10, 90, 50)) }, 0.25)

    local src
    for _, url in ipairs(URLS) do
        Status.Text = "Descargando hub..."
        src = descargar(url)
        if src then
            print("[DestroyaKey] descargado desde " .. url .. " (" .. #src .. " bytes)")
            break
        end
        warn("[DestroyaKey] descarga fallida: " .. url)
    end

    if not src then
        busy = false
        Submit.Text = "VERIFICAR LLAVE"
        Status.Text = "Llave correcta, pero no se pudo descargar"
        Status.TextColor3 = C.Red
        tween(SubmitGrad, { Color = ColorSequence.new(C.RedD, C.BlueD) }, 0.25)
        aviso("La descarga falló en las dos rutas disponibles.")
        return
    end

    Status.Text = "Compilando..."
    local fn = compilar(src)
    if not fn then
        busy = false
        Submit.Text = "VERIFICAR LLAVE"
        Status.Text = "Llave correcta, pero no compila"
        Status.TextColor3 = C.Red
        tween(SubmitGrad, { Color = ColorSequence.new(C.RedD, C.BlueD) }, 0.25)
        aviso("Tu ejecutor no tiene loadstring disponible.")
        return
    end

    Submit.Text = "ACCESO CONCEDIDO"
    Status.Text = "Llave correcta, ejecutando..."
    tween(Outer, { Thickness = 4 }, 0.2)

    task.wait(0.35)
    tween(Panel, { BackgroundTransparency = 1, Size = UDim2.fromOffset(W * 0.7, 0) }, 0.28)
    task.wait(0.3)
    matarPanel()
    task.wait(0.12)

    local ok, err = pcall(fn)
    if not ok then
        warn("[DestroyaKey] error al ejecutar: " .. tostring(err))
        aviso("El hub falló al arrancar: " .. tostring(err))
    else
        print("[DestroyaKey] hub en marcha")
    end
end

