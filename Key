corner(Close, 6)

for _, rot in ipairs({ 45, -45 }) do
    local bar = Instance.new("Frame")
    bar.AnchorPoint = Vector2.new(0.5, 0.5)
    bar.Position = UDim2.fromScale(0.5, 0.5)
    bar.Size = UDim2.fromOffset(12, 2)
    bar.Rotation = rot
    bar.BackgroundColor3 = C.White
    bar.BorderSizePixel = 0
    bar.Parent = Close
    corner(bar, 1)
end

Close.Activated:Connect(function()
    Screen:Destroy()
end)

local Input = Instance.new("TextBox")
Input.Size = UDim2.new(1, -60, 0, 42)
Input.Position = UDim2.fromOffset(30, 85)
Input.BackgroundColor3 = Color3.fromRGB(13, 26, 48)
Input.PlaceholderText = "Ingresa la clave..."
Input.PlaceholderColor3 = C.Gray
Input.Text = ""
Input.TextColor3 = C.White
Input.TextSize = 14
Input.Font = Enum.Font.GothamBold
Input.ClearTextOnFocus = false
Input.Parent = Frame
corner(Input, 10)

local InputStroke = Instance.new("UIStroke")
InputStroke.Color = C.Blue
InputStroke.Thickness = 1.4
InputStroke.Parent = Input

local Submit = Instance.new("TextButton")
Submit.Size = UDim2.new(1, -60, 0, 40)
Submit.Position = UDim2.fromOffset(30, 145)
Submit.BackgroundColor3 = C.Red
Submit.Text = "VERIFICAR LLAVE"
Submit.TextColor3 = C.White
Submit.TextSize = 14
Submit.Font = Enum.Font.GothamBlack
Submit.AutoButtonColor = false
Submit.Parent = Frame
corner(Submit, 10)

local Status = Instance.new("TextLabel")
Status.Size = UDim2.new(1, -20, 0, 20)
Status.Position = UDim2.fromOffset(10, 205)
Status.BackgroundTransparency = 1
Status.Text = "Escribe la clave para continuar"
Status.TextColor3 = C.Gray
Status.TextSize = 12
Status.Font = Enum.Font.GothamMedium
Status.Parent = Frame

local busy = false

local function shake()
    local base = Frame.Position
    for _, d in ipairs({ 8, -8, 5, -5, 0 }) do
        Frame.Position = UDim2.new(base.X.Scale, base.X.Offset + d, base.Y.Scale, base.Y.Offset)
        task.wait(0.04)
    end
    Frame.Position = base
end

local function check()
    if busy then return end
    local escrito = string.lower((string.gsub(Input.Text, "^%s*(.-)%s*$", "%1")))
    if escrito == "" then
        Status.Text = "Escribe la clave primero"
        Status.TextColor3 = C.Gray
        return
    end
    if escrito ~= CLAVE then
        Status.Text = "Clave incorrecta"
        Status.TextColor3 = C.Red
        task.spawn(shake)
        return
    end
    busy = true
    Status.Text = "Acceso concedido"
    Status.TextColor3 = C.Green
    task.wait(0.4)
    tween(Frame, { Size = UDim2.fromOffset(0, 0), Position = UDim2.new(0.5, 0, 0.5, 0) }, 0.3)
    task.wait(0.3)
    Screen:Destroy()

    --------------------------------------------------
    ---Aqui pega el resto de tu código----
    --------------------------------------------------

end

Submit.Activated:Connect(check)
Input.FocusLost:Connect(function(enter)
    if enter then check() end
end)

