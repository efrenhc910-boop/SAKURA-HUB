local function aviso(txt, col)
	ESTADO.Text = txt
	ESTADO.TextColor3 = col or HUESO
end

local function normalizar(s)
	return string.lower((string.gsub(tostring(s or ""), "%s", "")))
end

local function guardar()
	pcall(function()
		if writefile then writefile(ARCHIVO, CLAVE) end
	end)
end

local function leerGuardada()
	local ok, res = pcall(function()
		if isfile and isfile(ARCHIVO) and readfile then return readfile(ARCHIVO) end
		return nil
	end)
	return ok and res ~= nil and normalizar(res) == CLAVE
end

local function descargar()
	local rutas = {
		function() return game:HttpGet(URL, true) end,
		function() return game:HttpGetAsync(URL) end,
		function() return request({ Url = URL, Method = "GET" }).Body end,
		function() return syn.request({ Url = URL, Method = "GET" }).Body end,
	}
	for _, m in ipairs(rutas) do
		local ok, res = pcall(m)
		if ok and type(res) == "string" and #res > 300 then return res end
	end
	return nil
end

function CerrarTodo()
	VIVO = false
	for _, c in ipairs(CONEX) do pcall(function() c:Disconnect() end) end
	CONEX = {}
	pcall(function() GUI:Destroy() end)
end

local cargando = false

local function entrar()
	if cargando then return end
	cargando = true
	BTN.Text = "CARGANDO..."
	aviso("Descargando Destroya Hub...", VERDE)

	task.spawn(function()
		local src = descargar()
		if not src then
			aviso("No se pudo descargar. Revisa tu conexión.", ROJO)
			BTN.Text = "ENTRAR AL HUB"
			cargando = false
			return
		end
		aviso("Compilando...", VERDE)
		local fn, err = loadstring(src, "DestroyaHub")
		if not fn then
			aviso("Error de compilación: " .. tostring(err), ROJO)
			BTN.Text = "ENTRAR AL HUB"
			cargando = false
			return
		end
		guardar()
		CerrarTodo()
		task.wait(0.2)
		local ok, e = pcall(fn)
		if not ok then warn("[Destroya] " .. tostring(e)) end
	end)
end

