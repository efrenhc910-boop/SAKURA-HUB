	while true do
		local dt = RunService.RenderStepped:Wait()
		for _, dato in ipairs(chispas) do
			local c = dato.objeto
			local posY = c.Position.Y.Scale - dato.velY
			local posX = c.Position.X.Scale + dato.velX
			dato.vida = dato.vida - dt

			if posY < 0.04 or posX <= 0.02 or posX >= 0.98 or dato.vida <= 0 then
				posY = math.random(80, 98) / 100
				posX = math.random(5, 95) / 100
				dato.velY = math.random(10, 26) * 0.0008
				dato.velX = math.random(-18, 18) * 0.0001
