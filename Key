	keyBox.Text = LINK_OBTENER_LLAVE
	
	pcall(function()
		setclipboard(LINK_OBTENER_LLAVE)
	end)
	
	statusLabel.TextColor3 = Color3.fromRGB(140, 255, 190)
	statusLabel.Text = "¡Enlace copiado al portapapeles!"
end)

verifyBtn.MouseButton1Click:Connect(function()
	if botonYaUsado then return end
	
	local textoEscrito = string.lower(string.gsub(keyBox.Text, "%s+", ""))
	botonYaUsado = true
	verifyBtn.Active = false
	getKeyBtn.Active = false
	verifyBtn.BackgroundTransparency = 0.5
	getKeyBtn.BackgroundTransparency = 0.5

	-- Secuencia obligatoria de "Verificando..." (3 segundos con puntitos animados)
	statusLabel.TextColor3 = Color3.fromRGB(255, 220, 100)
	statusLabel.Text = "Verificando"
	
	task.spawn(function()
		for i = 1, 3 do
			task.wait(1)
			if statusLabel and statusLabel.Parent then
				statusLabel.Text = statusLabel.Text .. "."
			end
		end
	end)
	
	-- Esperar los 3 segundos de rigor
	task.wait(3)

	-- Evaluar si es correcta o incorrecta después de la animación
	if textoEscrito == LLAVE_CORRECTA then
		-- Si es correcta: mostrar mensaje verde durante 2 segundos y luego destruir menú
		statusLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
		statusLabel.Text = "¡Llave correcta!"
		
		task.wait(2)
		
		-- Recordar llave en la sesión
		_G.LlaveVerificadaSesion = true
		
		screenGui:Destroy()

		-- ========================================================
		-- === [ EL RESTO DEL CÓDIGO AQUÍ ] ========================
		print("¡Llave correcta V6.2 verificada! Script ejecutándose...")
		-- ========================================================
	else
		-- Si es incorrecta: mostrar mensaje rojo y reactivar botones para reintentar
		statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
		statusLabel.Text = "Llave incorrecta"
		
		botonYaUsado = false
		verifyBtn.Active = true
		getKeyBtn.Active = true
		verifyBtn.BackgroundTransparency = 0.1
		getKeyBtn.BackgroundTransparency = 0.2
	end
end)
