-- Efecto visual del Placeholder parpadeando
task.spawn(function()
	local estadoBlink = false
	while true do
		task.wait(2)
		estadoBlink = not estadoBlink
		if string.len(valorRealLlave) == 0 then
			if estadoBlink then
				keyBox.PlaceholderText = "> Pon tu llave"
			else
				keyBox.PlaceholderText = "> Pon tu llave _"
			end
		end
	end
end)

-- Sistema para decorar visualmente lo que escribe el usuario mientras guarda el valor real
keyBox:GetPropertyChangedSignal("Text"):Connect(function()
	local textoActual = keyBox.Text
	
	-- Si el usuario borra todo, limpiamos la variable real
	if textoActual == "" then
		valorRealLlave = ""
		return
	end
	
	-- Evitamos bucles infinitos midiendo si ya está estilizado
	-- Tomamos el texto limpio que escribió el usuario (quitando decoraciones visuales si las hubiera)
	local limpio = string.gsub(textoActual, "[%[%]%-%>]", "")
	limpio = string.gsub(limpio, "%s+", "") -- quitar espacios
	
	if limpio ~= "" then
		valorRealLlave = limpio
		-- Decoramos visualmente la caja de texto con un formato limpio y estético (Ej: [ V6.2 ])
		local textoDecorado = "[ " .. string.upper(limpio) .. " ]"
		if keyBox.Text ~= textoDecorado then
			keyBox.Text = textoDecorado
			-- Mover el cursor al final de forma segura
			keyBox.CursorPosition = string.len(textoDecorado) + 1
		end
	end
end)

