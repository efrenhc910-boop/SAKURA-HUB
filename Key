local busy = false
local intentos = 0

local function entrar()
    if busy then return end

    local escrito = string.lower(string.gsub(Input.Text or "", "^%s*(.-)%s*$", "%1"))

    if escrito == "" then
        Status.Text = "El campo está vacío"
        Status.TextColor3 = C.Gray
        return
    end

    if escrito == CLAVE then
        busy = true
        Submit.Text = "ACCESO CONCEDIDO"
        Status.Text = "Clave correcta, cargando el hub..."
        Status.TextColor3 = C.Green
        tween(SubmitGrad, { Color = ColorSequence.new(C.Green, Color3.fromRGB(10, 90, 50)) }, 0.25)
        tween(Outer, { Transparency = 0, Thickness = 4 }, 0.2)
        tween(InputStroke, { Color = C.Green, Transparency = 0 }, 0.2)

        task.wait(0.55)
        tween(Panel, { Size = UDim2.fromOffset(W * 0.6, 0), Position = UDim2.new(0.5, -W * 0.3, 0.5, 0), BackgroundTransparency = 1 }, 0.32, Enum.EasingStyle.Back)
        task.wait(0.34)
        if Screen.Parent then Screen:Destroy() end

        task.spawn(function()
            local ok, err = pcall(function()
                loadstring(game:HttpGet("https://raw.githubusercontent.com/efrenhc910-boop/SAKURA-HUB/refs/heads/main/v6.2"))()
            end)
            if not ok then
                warn("[DestroyaKey] error al cargar el hub: " .. tostring(err))
            end
        end)
        return
    end

    intentos += 1
    Status.Text = "Clave incorrecta  ·  intento " .. intentos
    Status.TextColor3 = C.Red

    -- Vibración de error
    local base = HOME
    for _, d in ipairs({ 9, -9, 7, -7, 4, 0 }) do
        Panel.Position = UDim2.new(base.X.Scale, base.X.Offset + d, base.Y.Scale, base.Y.Offset)
        task.wait(0.035)
    end
    Panel.Position = base

    tween(InputStroke, { Color = C.Red, Transparency = 0 }, 0.1)
    task.delay(0.4, function()
        tween(InputStroke, { Color = C.Blue, Transparency = 0.3 }, 0.25)
    end)
end

Submit.Activated:Connect(entrar)
Input.FocusLost:Connect(function(enter)
    if enter then entrar() end
end)

