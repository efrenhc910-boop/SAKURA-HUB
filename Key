-- Animación de marquesina deslizándose sin parar estilo noticiero
task.spawn(function()
	while true do
		newsText.Position = UDim2.new(1, 0, 0, 0)
		local tweenInfo = 18 -- velocidad de desplazamiento
		local elapsed = 0
		while elapsed < tweenInfo do
			local dt = RunService.RenderStepped:Wait()
			elapsed = elapsed + dt
			local alpha = elapsed / tweenInfo
			newsText.Position = UDim2.new(1 - (alpha * 2.3), 0, 0, 0)
		end
	end
end)

