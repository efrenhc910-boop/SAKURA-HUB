local function chispa()
	if not VIVO or VIVAS >= CONFIG.FUEGO_MAX then return end
	VIVAS += 1

	local tam = math.random(3, 7)
	local xs = math.random() * 0.94 + 0.03
	local s = crear("Frame", {
		Size = UDim2.fromOffset(tam, tam),
		Position = UDim2.new(xs, 0, 1, -10),
		BackgroundColor3 = (math.random(1, 3) == 1)
			and Color3.fromRGB(225, 255, 240)
			or Color3.fromRGB(0, 230, 120),
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		ZIndex = 3,
	}, FUEGO)
	esquina(s, 10)

	local alto = math.random(150, 390)
	local deriva = math.random(-30, 30) / ANCHO
	local dur = math.random(90, 180) / 100 / CONFIG.FUEGO_VEL

	TweenService:Create(s, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.new(xs + deriva, 0, 0, -alto),
		Size = UDim2.fromOffset(1, 1),
		BackgroundTransparency = 1,
		Rotation = math.random(-80, 80),
	}):Play()

	task.delay(dur, function()
		VIVAS -= 1
		s:Destroy()
	end)
end

