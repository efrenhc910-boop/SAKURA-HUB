local function padButton(y, glyphKind)
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(54, 54)
    b.Position = UDim2.new(1, -74, 0.5, y)
    b.BackgroundColor3 = Color3.fromRGB(16, 46, 58)
    b.BackgroundTransparency = 0.25
    b.Text = ""
    b.AutoButtonColor = false
    b.Visible = false
    b.ZIndex = 10
    b.Parent = Screen
    corner(b, 27)
    stroke(b, "Acc2", 2, 0.15)

    local tri = Instance.new("Frame")
    tri.AnchorPoint = Vector2.new(0.5, 0.5)
    tri.Position = UDim2.fromScale(0.5, 0.5)
    tri.Size = UDim2.fromOffset(14, 3)
    tri.Rotation = (glyphKind == "up") and 0 or 180
    tri.BackgroundColor3 = Color3.fromRGB(235, 252, 255)
    tri.BorderSizePixel = 0
    tri.ZIndex = 11
    tri.Parent = b
    corner(tri, 1)
    for i = 1, 2 do
        local w = tri:Clone()
        w.Size = UDim2.fromOffset(14 - i * 4, 3)
        w.Position = UDim2.fromOffset(0, (glyphKind == "up") and (-i * 4) or (i * 4))
        w.Parent = b
    end

    local sc = Instance.new("UIScale")
    sc.Scale = 0
    sc.Parent = b

    b.InputBegan:Connect(function(i)
        if isPointer(i) then
            if glyphKind == "up" then S.up = true else S.down = true end
            tween(sc, { Scale = 0.88 }, 0.08)
        end
    end)
    local function off()
        if glyphKind == "up" then S.up = false else S.down = false end
        tween(sc, { Scale = 1 }, 0.18, Enum.EasingStyle.Back)
    end
    b.InputEnded:Connect(function(i) if isPointer(i) then off() end end)
    b.MouseLeave:Connect(off)
    b.TouchLongPress:Connect(off)
    return b, sc
end

