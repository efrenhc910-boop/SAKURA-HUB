    if msg then notify(msg) end
    if UI.refreshLists then UI.refreshLists() end
end

local function startTP(plr)
    if TP.target == plr then stopTP("Seguimiento cancelado") return end
    if not plr or plr.Parent ~= Players then notify("Jugador no disponible") return end
    if not getParts() then notify("Tu personaje no está listo") return end
    TP.target = plr
    TP.missing = 0
    S.tpActive = true
    notify("Siguiendo a @" .. plr.Name)
    if UI.showCamStop then UI.showCamStop(true) end
    if UI.refreshLists then UI.refreshLists() end
end

track(RunService.Heartbeat:Connect(function(dt)
    local plr = TP.target
    if not plr then return end
    pcall(function()
        local root = getParts()
        if not root then return end
        if plr.Parent ~= Players then stopTP("Salió del juego") return end
        local tChar = plr.Character
        local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
        if not tRoot then
            TP.missing += dt
            if TP.missing > 3 then stopTP("Sin personaje") end
            return
        end
        TP.missing = 0
        local look = tRoot.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
        flat = flat.Unit
        local goal = tRoot.Position - flat * 3.2
        local diff = goal - root.Position
        if diff.Magnitude <= 1.2 then
            root.CFrame = CFrame.lookAt(goal, goal + flat)
        else
            local dir = diff.Unit
            local np = root.Position + dir * math.min(diff.Magnitude, S.tpSpeed * dt)
            root.CFrame = CFrame.lookAt(np, np + Vector3.new(dir.X, 0, dir.Z))
        end
        root.AssemblyLinearVelocity = Vector3.zero
    end)
end))

local camHeld, camPrev, camErr = false, nil, 0
local camParams = RaycastParams.new()
camParams.FilterType = Enum.RaycastFilterType.Exclude
camParams.IgnoreWater = true

local function releaseCamera()
    local cam = getCamera()
    local _, hum = getParts()
    if camHeld and cam then
        cam.CameraType = camPrev or Enum.CameraType.Custom
        if hum then cam.CameraSubject = hum end
    end
    camHeld = false
    if hum then hum.AutoRotate = true end
end

local function camStep()
    if not S.lockMode or not S.target then
        if camHeld then releaseCamera() end
        return
    end
    local cam = getCamera()
    local root, hum = getParts()
    if not cam or not root then return end
    local tChar = S.target.Character
    local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
    if not tRoot then
        if camHeld then releaseCamera() end
        return
    end
    local flat = Vector3.new(tRoot.Position.X - root.Position.X, 0, tRoot.Position.Z - root.Position.Z)
    if flat.Magnitude < 0.4 then return end
    local dir = flat.Unit

    if not camHeld then
        camHeld = true
        camPrev = cam.CameraType
    end
    if cam.CameraType ~= Enum.CameraType.Scriptable then cam.CameraType = Enum.CameraType.Scriptable end
    if hum then hum.AutoRotate = false end
    root.CFrame = CFrame.lookAt(root.Position, root.Position + dir)

    local focus
    if S.lockMode == "head" then
        local h = tChar:FindFirstChild("Head")
        focus = h and h.Position or tRoot.Position
    else
        focus = tRoot.Position
    end

    local pivot = root.Position + Vector3.new(0, 2.2, 0)
    local want = root.Position - dir * 8.5 + Vector3.new(0, 3.2, 0)
    camParams.FilterDescendantsInstances = { player.Character }
    local delta = want - pivot
    if delta.Magnitude > 0.2 then
        local hit = Workspace:Raycast(pivot, delta, camParams)
        if hit then want = hit.Position + (pivot - hit.Position).Unit * 0.35 end
    end
    cam.CFrame = CFrame.lookAt(want, focus)
end

local function syncLock()
    if UI.headToggle then UI.headToggle.Set(S.lockMode == "head", true) end
    if UI.chestToggle then UI.chestToggle.Set(S.lockMode == "chest", true) end
    UI.setStatus(S.lockMode and "Objetivo fijado" or "Seguimiento apagado")
end

local function setLockMode(mode)
    S.lockMode = mode
    if not mode then S.target = nil end
    syncLock()
    if not mode then pcall(releaseCamera) end
end

local function selectTarget(plr)
    if not plr or plr.Parent ~= Players then return end
    S.target = plr
    if S.lockMode ~= "head" then S.lockMode = "chest" end
    syncLock()
end

RunService:BindToRenderStep("DestroyaCam", Enum.RenderPriority.Last.Value, function()
    if not S.lockMode then return end
    if pcall(camStep) then
        camErr = 0
    else
        camErr += 1
        if camErr > 30 then
            camErr = 0
            S.lockMode, S.target = nil, nil
