X.Sky = {}

function X.setNight(on)
    if on == X.Sky.on then return end
    X.Sky.on = on
    if on then
        X.Sky.save = { Lighting.ClockTime, Lighting.Brightness, Lighting.Ambient, Lighting.FogEnd }
        Lighting.ClockTime = 0
        Lighting.Brightness = 0.7
        Lighting.Ambient = Color3.fromRGB(18, 22, 46)
        Lighting.FogEnd = 4000
        X.setStars(true)
    else
        local s = X.Sky.save
        if s then
            pcall(function()
                Lighting.ClockTime = s[1]
                Lighting.Brightness = s[2]
                Lighting.Ambient = s[3]
                Lighting.FogEnd = s[4]
            end)
        end
        X.setStars(false)
    end
end

function X.setStars(on)
    if on then
        if X.Sky.stars and X.Sky.stars.Parent then return end
        local st = Instance.new("Stars")
        st.Parent = Lighting
        X.Sky.stars = st
    elseif X.Sky.stars and X.Sky.stars.Parent then
        X.Sky.stars:Destroy()
        X.Sky.stars = nil
    end
end

local fbSave
function X.setFullbright(on)
    if on then
        fbSave = { Lighting.Brightness, Lighting.ClockTime, Lighting.FogEnd }
        Lighting.Brightness = 2.5
        Lighting.ClockTime = 14
        Lighting.FogEnd = 100000
        Lighting.GlobalShadows = false
    elseif fbSave then
        pcall(function()
            Lighting.Brightness = fbSave[1]
            Lighting.ClockTime = fbSave[2]
            Lighting.FogEnd = fbSave[3]
        end)
    end
end

function X.setPerf(on)
    PERF.mode = on
    for _, s in ipairs(strokes) do
        s.Transparency = on and 1 or (s:GetAttribute("Base") or 0)
    end
    for _, gg in ipairs(grads) do gg.Enabled = not on end
    if on then
        UI.anim = false
        MenuScale.Scale = UI.size
        Content.BackgroundTransparency = 0.75
        Main.BackgroundTransparency = 0.4
        notify("Modo rendimiento")
    else
        UI.anim = true
        Main.BackgroundTransparency = MENU_T
        Content.BackgroundTransparency = 0.55
        notify("Calidad normal")
    end
end

do
    local frames, acc = 0, 0
    local low = 0
    track(RunService.Heartbeat:Connect(function(dt)
        frames += 1
        acc += dt
        if acc < 1 then return end
        local avg = frames / acc
        frames, acc = 0, 0
        if UI.open then FpsText.Text = "FPS " .. math.floor(avg + 0.5) end
        if avg < 26 then
            low += 1
            if low >= 3 and not PERF.mode then
                low = 0
                pcall(X.setPerf, true)
            end
        else
            low = 0
        end
    end))
end

do
    local pad = Instance.new("Frame")
    pad.Size = UDim2.fromOffset(64, 150)
    pad.Position = UDim2.new(1, -90, 0.5, -75)
    pad.BackgroundTransparency = 1
    pad.Visible = false
    pad.ZIndex = 10
    pad.Parent = Screen
    UI.flyPad = pad

    local held = {}
    local function mk(key, y, up)
        local b = Instance.new("TextButton")
        b.Size = UDim2.fromOffset(64, 64)
        b.Position = UDim2.fromOffset(0, y)
        b.BackgroundColor3 = Color3.fromRGB(10, 30, 40)
        b.BackgroundTransparency = 0.15
        b.Text = ""
        b.AutoButtonColor = false
        b.ZIndex = 10
        b.Parent = pad
        corner(b, 18)
        local ch = drawChevron(b, C.White, 2.4)
        ch.Position = UDim2.fromScale(0.5, 0.5)
        ch.Rotation = up and 180 or 0
        b.InputBegan:Connect(function(i)
            if isPointer(i) then
                flyInput[key] = true
                held[key] = i
            end
        end)
    end
    mk("up", 22, true)
    mk("down", 90, false)

    track(UserInputService.InputEnded:Connect(function(i)
        for k, h in pairs(held) do
            if h == i or i.UserInputType == Enum.UserInputType.MouseButton1 then
                held[k] = nil
                flyInput[k] = false
            end
        end
    end))
end

local closing = false
DestroyBtn.Activated:Connect(safe(function()
    if closing then return end
    closing = true
    UI.open = false
    if Screen.Parent then Screen:Destroy() end
end, "destroy"))

Screen.Destroying:Connect(function()
    S.esp, S.fly, S.infJump, S.noclip = false, false, false, false
    S.lockMode, S.target, S.tpActive, S.walls = nil, nil, false, false
    S.circulo, S.botVisual, S.botKill = false, false, false
    pcall(releaseCamera)
    pcall(setNoclip, false)
    pcall(setFpsBoost, false)
    pcall(setWalls, false)
    pcall(stopFly)
    pcall(clearESP)
    pcall(X.clearBot)
    pcall(X.clearCirculo)
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    pcall(function() RunService:UnbindFromRenderStep("DestroyaCam") end)
end)

