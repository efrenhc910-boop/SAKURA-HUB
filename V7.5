function X.findModules(pat)
    local out = {}
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if d:IsA("ModuleScript") then
            local n = string.lower(d.Name)
            for _, p in ipairs(pat) do
                if string.find(n, p, 1, true) then out[#out + 1] = d break end
            end
        end
    end
    return out
end

X.ATTACK, X.EQUIP = {}, {}
X.hitCd = setmetatable({}, { __mode = "k" })

function X.scanRemotes()
    table.clear(X.ATTACK)
    table.clear(X.EQUIP)
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if d:IsA("RemoteEvent") then
            local n = string.lower(d.Name)
            if string.find(n, "equip", 1, true) or string.find(n, "skin", 1, true) then
                X.EQUIP[#X.EQUIP + 1] = d
            end
            if string.find(n, "hit", 1, true) or string.find(n, "damage", 1, true)
                or string.find(n, "attack", 1, true) or string.find(n, "swing", 1, true) then
                X.ATTACK[#X.ATTACK + 1] = d
            end
        end
    end
end
X.scanRemotes()

function X.fireHit(char)
    local r = X.ATTACK[1]
    if not r or not r.Parent then return false end
    local now = os.clock()
    if (X.hitCd[char] or 0) > now then return false end
    X.hitCd[char] = now + X.EXTRA.HitCooldown
    local head = char:FindFirstChild("Head")
    if not head then return false end
    pcall(function() r:FireServer({ Target = char, Position = head.Position }) end)
    return true
end

X.saved, X.keys, X.unlocked = {}, {}, false

local function patchTbl(t, d)
    if type(t) ~= "table" or d > 3 then return end
    for k, v in pairs(t) do
        if type(v) == "function" then
            local n = string.lower(tostring(k))
            if string.find(n, "owned", 1, true) or string.find(n, "hasitem", 1, true) then
                local key = tostring(t) .. tostring(k)
                if not X.keys[key] then
                    X.keys[key] = true
                    X.saved[#X.saved + 1] = { t, k, v }
                    t[k] = function() return true end
                end
            end
        elseif type(v) == "table" then
            patchTbl(v, d + 1)
        end
    end
end

function X.unlockAll()
    pcall(function()
        for _, lib in ipairs(X.findModules({ "skin", "item", "cosmetic" })) do
            local ok, mod = pcall(require, lib)
            if ok and type(mod) == "table" then patchTbl(mod, 0) end
        end
        X.unlocked = true
    end)
end

function X.relockAll()
    for _, s in ipairs(X.saved) do pcall(function() s[1][s[2]] = s[3] end) end
    table.clear(X.saved)
    table.clear(X.keys)
    X.unlocked = false
    notify("Skins restauradas")
end

function X.equipSkin(w, s)
    if #X.EQUIP == 0 then X.scanRemotes() end
    if X.EQUIP[1] then pcall(function() X.EQUIP[1]:FireServer(w, s) end) end
end

X.Circulo = { frame = nil }

function X.applyCirculo()
    local f = X.Circulo.frame
    if not f then return end
    f.Size = UDim2.fromOffset(X.EXTRA.CirculoRadio * 2, X.EXTRA.CirculoRadio * 2)
    f.BackgroundTransparency = X.EXTRA.CirculoRelleno
end

function X.buildCirculo()
    if X.Circulo.frame then X.applyCirculo() return end
    local f = Instance.new("Frame")
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.Position = UDim2.fromScale(0.5, 0.5)
    f.BackgroundColor3 = C.Acc
    f.BackgroundTransparency = X.EXTRA.CirculoRelleno
    f.BorderSizePixel = 0
    f.ZIndex = 0
    f.Parent = Screen
    corner(f, 9999)
    qStroke(f, X.EXTRA.CirculoGrosor, 0.1, C.Acc)
    X.Circulo.frame = f
    X.applyCirculo()
end

function X.clearCirculo()
    if X.Circulo.frame then X.Circulo.frame:Destroy() end
    X.Circulo.frame = nil
end

task.spawn(function()
    while Screen.Parent do
        task.wait(CONFIG.CIRC_TICK)
        if not S.circulo then continue end
        pcall(function()
            local cam = getCamera()
            local root = getParts()
            local f = X.Circulo.frame
            if not cam or not root or not f then return end
            local cx = f.AbsolutePosition.X + f.AbsoluteSize.X / 2
            local cy = f.AbsolutePosition.Y + f.AbsoluteSize.Y / 2
            local r2 = X.EXTRA.CirculoRadio * X.EXTRA.CirculoRadio
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player and not (X.EXTRA.CirculoIgnorar and isAlly(plr)) then
                    local char = plr.Character
                    local head = char and char:FindFirstChild("Head")
                    if head and (head.Position - root.Position).Magnitude <= X.EXTRA.CirculoAlcance then
                        local sp, vis = cam:WorldToViewportPoint(head.Position)
                        if vis and sp.Z > 0 then
                            local dx, dy = sp.X - cx, sp.Y - cy
                            if dx * dx + dy * dy <= r2 then X.fireHit(char) end
                        end
                    end
                end
            end
        end)
    end
end)

X.Bot = { char = nil, nodes = {}, folder = nil, hits = 0, spin = 0, at = 0 }

function X.clearBot()
    if X.Bot.folder and X.Bot.folder.Parent then X.Bot.folder:Destroy() end
    X.Bot.folder, X.Bot.char = nil, nil
    table.clear(X.Bot.nodes)
end

function X.buildBot()
    X.clearBot()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    X.Bot.char = char
    local folder = Instance.new("Folder")
    folder.Parent = Workspace
    X.Bot.folder = folder
    local n = 16
    for i = 1, n do
        local a = (i / n) * math.pi * 2
        local p = Instance.new("Part")
        p.Size = Vector3.new(0.5, 0.5, 0.5)
        p.Shape = Enum.PartType.Ball
        p.Anchored = true
        p.CanCollide = false
        p.CanQuery = false
        p.CastShadow = false
        p.Material = Enum.Material.Neon
        p.Color = C.Acc
        p.CFrame = root.CFrame * CFrame.new(math.cos(a) * X.EXTRA.BotRadius, -2.8, math.sin(a) * X.EXTRA.BotRadius)
        p.Parent = folder
        X.Bot.nodes[#X.Bot.nodes + 1] = { part = p, a = a }
    end
end

track(RunService.Heartbeat:Connect(function(dt)
    if not S.botVisual then return end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if X.Bot.char ~= char or not X.Bot.folder then
        if os.clock() >= X.Bot.at then
            X.Bot.at = os.clock() + 0.5
            X.buildBot()
        end
        return
    end
    if not PERF.mode then X.Bot.spin += dt * 1.4 end
    for i = 1, #X.Bot.nodes do
        local it = X.Bot.nodes[i]
        local a = it.a + X.Bot.spin
        it.part.CFrame = root.CFrame * CFrame.new(math.cos(a) * X.EXTRA.BotRadius, -2.8, math.sin(a) * X.EXTRA.BotRadius)
    end
end))

function X.pickTarget()
    local root = getParts()
    if not root then return end
    local best, score
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and not (X.EXTRA.BotIgnoreAllies and isAlly(plr)) then
            local c = plr.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            if h and hrp and h.Health > 0 then
                local d = (hrp.Position - root.Position).Magnitude
                if d <= X.EXTRA.BotKillRange and (not score or d < score) then
                    best, score = c, d
                end
            end
        end
    end
    return best
end

task.spawn(function()
    while Screen.Parent do
        task.wait(CONFIG.BOT_TICK)
        if not S.botKill then continue end
        local t = X.pickTarget()
        if t and X.fireHit(t) then X.Bot.hits += 1 end
    end
end)

