function selRemove(plr)
    if not Sel.set[plr] then return end
    Sel.set[plr] = nil
    for i = #Sel.list, 1, -1 do
        if Sel.list[i] == plr then table.remove(Sel.list, i) end
    end
    if TP.target == plr then stopTP() end
    if refreshSel then refreshSel() end
end

