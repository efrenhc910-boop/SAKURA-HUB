local TabButtons, Pages, tabOrder = {}, {}, {}
local CurrentPage

local function moveIndicator(animated)
    local b = TabButtons[CurrentPage]
    if not b then return end
    if animated and not PERF.mode then
        tween(TabIndicator, { Position = b.Position, Size = b.Size }, 0.3, Enum.EasingStyle.Quint)
    else
        TabIndicator.Position = b.Position
        TabIndicator.Size = b.Size
    end
end

local function paintTabs(animated)
    for name, b in pairs(TabButtons) do
        local col = (name == CurrentPage) and C.Bg or C.Gray
        if animated and not PERF.mode then tween(b, { TextColor3 = col }, 0.2) else b.TextColor3 = col end
    end
    moveIndicator(animated)
end

local function layoutTabs()
    local n = #tabOrder
    if n == 0 then return end
    local gap = 3
    local w = math.max(76, (BASE_W - 16 - 6 - gap * (n - 1)) / n)
    for i, name in ipairs(tabOrder) do
        local b = TabButtons[name]
        b.Size = UDim2.fromOffset(w, 22)
        b.Position = UDim2.fromOffset(3 + (i - 1) * (w + gap), 2)
    end
    TabScroll.CanvasSize = UDim2.fromOffset(6 + n * (w + gap), 0)
    moveIndicator(false)
end

local function showPage(name)
    if CurrentPage == name then return end
    CurrentPage = name
    for pageName, page in pairs(Pages) do
        page.Visible = (pageName == name)
    end
    paintTabs(true)
end

local function addTab(name)
    local b = Instance.new("TextButton")
    b.Name = name
    b.Text = string.upper(name)
    b.TextSize = 11
    b.Font = F.head
    b.BackgroundTransparency = 1
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    b.ZIndex = 2
    b.Parent = TabScroll
    squish(b, 0.9)
    TabButtons[name] = b
    tabOrder[#tabOrder + 1] = name

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.fromScale(1, 1)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = C.Acc
    page.CanvasSize = UDim2.new()
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible = false
    page.Parent = Content

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 12)
    pad.PaddingBottom = UDim.new(0, 14)
    pad.PaddingLeft = UDim.new(0, 10)
    pad.PaddingRight = UDim.new(0, 10)
    pad.Parent = page

    local lay = Instance.new("UIListLayout")
    lay.Padding = UDim.new(0, 14)
    lay.SortOrder = Enum.SortOrder.LayoutOrder
    lay.Parent = page

    Pages[name] = page
    b.Activated:Connect(function() showPage(name) end)
    layoutTabs()
    paintTabs(false)
    return page
end

