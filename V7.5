local function hookPlayer(plr)
    if plr == player then return end
    track(plr.CharacterAdded:Connect(function()
        if S.esp then
            task.wait(1)
            if S.esp then pcall(applyESP, plr) end
        end
    end))
end

track(RunService.Heartbeat:Connect(function(dt)
    if not S.esp then return end
    espAcc += dt
    if espAcc < CONFIG.ESP_TICK then return end
    espAcc = 0

    local lr = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not lr then return end

    local near = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if root and (root.Position - lr.Position).Magnitude <= CONFIG.ESP_MAX then
                near[#near + 1] = plr
            end
        end
    end

    if #near > CONFIG.ESP_LIMIT then
        if not espCapped then
            espCapped = true
            for _, d in pairs(espObjects) do
                d.hl.Enabled = false
                d.bb.Enabled = false
            end
            UI.setStatus("ESP pausado: " .. #near .. " en rango")
        end
        return
    end
    if espCapped then
        espCapped = false
        UI.setStatus("ESP activo")
    end

    for _, plr in ipairs(near) do
        local char = plr.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            local d = espObjects[plr]
            if not d or d.char ~= char then
                applyESP(plr)
                d = espObjects[plr]
            end
            if d then
                d.hl.Enabled = true
                d.bb.Enabled = true

                local hum = char:FindFirstChildOfClass("Humanoid")
                local hp, mx = 0, 100
                if hum then
                    hp = math.max(0, math.floor(hum.Health + 0.5))
                    mx = math.max(1, math.floor(hum.MaxHealth + 0.5))
                end
                if d.hp ~= hp or d.mx ~= mx then
                    d.hp, d.mx = hp, mx
                    d.fill.Size = UDim2.fromScale(math.clamp(hp / mx, 0, 1), 1)
                    if hp / mx > 0.55 then
                        d.fill.BackgroundColor3 = C.Enemy
                    elseif hp / mx > 0.25 then
                        d.fill.BackgroundColor3 = Color3.fromRGB(255, 200, 60)
                    else
                        d.fill.BackgroundColor3 = Color3.fromRGB(255, 60, 80)
                    end
                end

                local dist = math.floor((root.Position - lr.Position).Magnitude + 0.5)
                if d.dist ~= dist then
                    d.dist = dist
                    d.distL.Text = dist .. " m"
                end
            end
        end
    end

    for plr, d in pairs(espObjects) do
        local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        if not root or (root.Position - lr.Position).Magnitude > CONFIG.ESP_MAX then
            d.hl.Enabled = false
            d.bb.Enabled = false
        end
    end
end))

