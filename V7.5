        if w > 0 then setRatio((input.Position.X - barF.AbsolutePosition.X) / w) end
    end

    hit.InputBegan:Connect(function(input)
        if isPointer(input) then
            fromInput(input)
            beginDrag(input, fromInput, true)
        end
    end)

    setRatio((default - min) / (max - min))
    return row
end

