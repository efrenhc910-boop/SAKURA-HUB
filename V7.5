local function track(c)
    conns[#conns + 1] = c
    return c
end

local function qStroke(obj, thickness, transparency, color)
    local s = Instance.new("UIStroke")
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.Color = color or C.Acc
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = obj
    s:SetAttribute("Base", transparency or 0)
    strokes[#strokes + 1] = s
    return s
end

local function qGrad(obj, rot, c1, c2)
    local g = Instance.new("UIGradient")
    g.Rotation = rot or 90
    g.Color = ColorSequence.new(c1, c2)
    g.Parent = obj
    grads[#grads + 1] = g
    return g
end

local function tween(obj, props, time, style, dir)
    local t = TweenService:Create(obj,
        TweenInfo.new(time or 0.2, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function corner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = obj
    return c
end

local function plain(parent, text, size, font, color, pos, sz, alignX)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextSize = size
    l.Font = font
    l.TextColor3 = color
    l.TextXAlignment = alignX or Enum.TextXAlignment.Left
    if pos then l.Position = pos end
    if sz then l.Size = sz end
    l.Parent = parent
    return l
end

local function isPointer(input)
    return input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1
end

local function screenPos(input)
    local inset = GuiService:GetGuiInset()
    return Vector2.new(input.Position.X + inset.X, input.Position.Y + inset.Y)
end

local orderN = 0
local function nextOrder()
    orderN += 1
    return orderN
end

local function safe(fn, label)
    return function(...)
        local ok, err = pcall(fn, ...)
        if not ok then warn("[DestroyaHub] " .. tostring(label) .. ": " .. tostring(err)) end
    end
end

local function debounced(fn)
    local pending = false
    return function()
        if pending then return end
        pending = true
        task.defer(function()
            pending = false
            pcall(fn)
        end)
    end
end

local function squish(btn, depth)
    local sc = Instance.new("UIScale")
    sc.Parent = btn
    local d = depth or 0.9
    btn.InputBegan:Connect(function(i)
        if isPointer(i) and not PERF.mode then
            tween(sc, { Scale = d }, 0.07, Enum.EasingStyle.Quad)
        end
    end)
    btn.InputEnded:Connect(function(i)
        if isPointer(i) and not PERF.mode then
            tween(sc, { Scale = 1 }, 0.22, Enum.EasingStyle.Back)
        end
    end)
    return sc
end

local activeDrag, activeInput, activeEnd
local function endDrag()
    if not activeDrag then return end
    local fin = activeEnd
    activeDrag, activeInput, activeEnd = nil, nil, nil
    if fin then pcall(fin) end
end
local function beginDrag(input, handler, lockScroll, onEnd)
    endDrag()
    activeDrag, activeInput, activeEnd = handler, input, onEnd
end
track(UserInputService.InputChanged:Connect(function(input)
    if activeDrag and (input == activeInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
        if not pcall(activeDrag, input) then endDrag() end
    end
end))
track(UserInputService.InputEnded:Connect(function(input)
    if activeDrag and (input == activeInput or input.UserInputType == Enum.UserInputType.MouseButton1) then
        endDrag()
    end
end))

local lastToast
local function notify(text)
    if lastToast and lastToast.Parent then lastToast:Destroy() end
    local t = Instance.new("Frame")
    lastToast = t
    t.AnchorPoint = Vector2.new(0.5, 1)
    t.Size = UDim2.fromOffset(270, 28)
    t.Position = UDim2.new(0.5, 0, 1, 14)
    t.BackgroundColor3 = Color3.fromRGB(8, 22, 30)
    t.BackgroundTransparency = 0.1
    t.BorderSizePixel = 0
    t.ZIndex = 30
    t.Parent = Screen
    corner(t, 9)
    local l = plain(t, text, 12, F.head, C.White, UDim2.fromOffset(12, 0), UDim2.new(1, -18, 1, 0))
    l.ZIndex = 31
    if not PERF.mode then
        tween(t, { Position = UDim2.new(0.5, 0, 1, -14) }, 0.3, Enum.EasingStyle.Back)
    else
        t.Position = UDim2.new(0.5, 0, 1, -14)
    end
    task.delay(2, function()
        if t.Parent then t:Destroy() end
    end)
end

