local setFpsBoost
do
    local orig = setmetatable({}, { __mode = "k" })
    local conn, token = nil, 0

    local KIND = {
        ParticleEmitter = 1, Trail = 1, Smoke = 1, Fire = 1, Sparkles = 1, Beam = 1,
        PointLight = 1, SpotLight = 1, SurfaceLight = 1, Clouds = 1,
        BloomEffect = 1, BlurEffect = 1, ColorCorrectionEffect = 1,
        DepthOfFieldEffect = 1, SunRaysEffect = 1,
        Decal = 2, Texture = 2, Atmosphere = 3, Explosion = 4,
    }

    local function boost(inst)
        if not S.boost or orig[inst] then return end
        local k = KIND[inst.ClassName]
        if not k then return end
        local saved
        pcall(function()
            if k == 1 then
                saved = { Enabled = inst.Enabled }
                inst.Enabled = false
            elseif k == 2 then
                saved = { Transparency = inst.Transparency }
                inst.Transparency = 1
            elseif k == 3 then
                saved = { Density = inst.Density }
                inst.Density = 0
            else
                saved = { Visible = inst.Visible }
                inst.Visible = false
            end
        end)
        if saved then orig[inst] = saved end
    end

    local function sweep(list, myToken)
        for i = 1, #list do
            if myToken ~= token or not S.boost then return end
            boost(list[i])
            if i % 150 == 0 then RunService.Heartbeat:Wait() end
        end
    end

    setFpsBoost = function(on)
        if on == S.boost then return end
        S.boost = on
        token += 1
        if on then
            pcall(function()
                settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
                Lighting.GlobalShadows = false
            end)
            if conn then conn:Disconnect() end
            conn = Workspace.DescendantAdded:Connect(function(inst)
                if S.boost then task.defer(boost, inst) end
            end)
            task.spawn(function()
                sweep(Lighting:GetDescendants(), token)
                local cam = Workspace.CurrentCamera
                if cam then sweep(cam:GetDescendants(), token) end
            end)
        else
            if conn then conn:Disconnect() conn = nil end
            for inst, saved in pairs(orig) do
                pcall(function()
                    for prop, v in pairs(saved) do inst[prop] = v end
                end)
            end
            table.clear(orig)
        end
    end
end

local setWalls
do
    local saved, running, lastPos = {}, false, nil
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.MaxParts = 1200

    local function restore(p)
        local t = saved[p]
        if t ~= nil then
            saved[p] = nil
            pcall(function() p.Transparency = t end)
        end
    end

    local function restoreAll()
        for p in pairs(saved) do restore(p) end
    end

    local function cycle()
        local root = getParts()
        if not root then return end
        if lastPos and (root.Position - lastPos).Magnitude < CONFIG.WALL_MOVE then return end
        lastPos = root.Position
        params.FilterDescendantsInstances = { player.Character }
        local hits = Workspace:GetPartBoundsInRadius(root.Position, CONFIG.WALL_RADIUS, params)
        local seen = {}
        for _, p in ipairs(hits) do
            if p:IsA("BasePart") and p.Parent and saved[p] == nil then
                seen[p] = true
                if p.Transparency < 0.6 then
                    saved[p] = p.Transparency
                    p.Transparency = CONFIG.WALL_ALPHA
                end
            end
        end
        for p in pairs(saved) do
            if not seen[p] or not p.Parent then restore(p) end
        end
    end

    setWalls = function(on)
        if on == S.walls then return end
        S.walls = on
        if on then
            if running then return end
            running = true
            lastPos = nil
            task.spawn(function()
                while S.walls and Screen.Parent do
                    pcall(cycle)
                    task.wait(CONFIG.WALL_TICK)
                end
                running = false
                restoreAll()
            end)
        else
            restoreAll()
        end
    end
end

