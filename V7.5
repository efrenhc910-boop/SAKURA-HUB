    knob.BackgroundColor3 = C.White
    knob.BorderSizePixel = 0
    knob.Parent = pill
    corner(knob, 5)

    local enabled = false
    local function paint()
        local on = enabled
        row.BackgroundColor3 = on and C.RowOn or C.Row
        row.BackgroundTransparency = on and CONFIG.BTN_T_ON or CONFIG.BTN_T
        accent.Size = UDim2.fromOffset(3, on and 20 or 0)
        pill.BackgroundColor3 = on and C.Acc or C.Off
        knob.Position = on and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
    end

    local api = {}
    function api.Set(v, silent)
        if v == enabled then return end
        enabled = v
        paint()
        if cb and not silent then cb(enabled) end
    end
    function api.Get() return enabled end

    row.Activated:Connect(function() api.Set(not enabled) end)
    return api
end

