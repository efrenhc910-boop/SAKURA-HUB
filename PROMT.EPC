--==================================================
--        DESTROYA HUB  •  PANTALLA DE ACCESO
--                 PARTE 1 / 2
--==================================================
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

--==================================================
-- CONFIGURACIÓN Y GUARDADO
--==================================================
local LLAVE_CORRECTA = "v6.2"
local LINK_OBTENER_LLAVE = "https://discord.gg/ykHwgmQnD"
local ARCHIVO_LLAVE = "LlaveGuardada_Im.txt"

local function normalizar(s)
    return string.lower(string.gsub(tostring(s or ""), "%s+", ""))
end

local function verificarLlaveGuardada()
    if isfile and readfile and isfile(ARCHIVO_LLAVE) then
        local contenido = normalizar(readfile(ARCHIVO_LLAVE))
        if contenido == normalizar(LLAVE_CORRECTA) then return true end
    end
    return false
end

local function cargarHub()
    local ok, err = pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/efrenhc910-boop/SAKURA-HUB/refs/heads/main/v6.2"))()
    end)
    if not ok then warn("[Acceso] fallo al cargar: " .. tostring(err)) end
end

if verificarLlaveGuardada() then
    print("Llave guardada detectada, cargando...")
    cargarHub()
    return
end

local nombreRaw = player.Name
local nombreFormateado = string.upper(string.sub(nombreRaw, 1, 1)) .. string.lower(string.sub(nombreRaw, 2))

--==================================================
-- UTILIDADES
--==================================================
local function tween(obj, props, tiempo, estilo)
    local t = TweenService:Create(obj,
        TweenInfo.new(tiempo or 0.2, estilo or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function esquina(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = obj
    return c
end

local function borde(obj, color, grosor, transp)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(170, 245, 255)
    s.Thickness = grosor or 1
    s.Transparency = transp or 0.2
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = obj
    return s
end

local function etiqueta(parent, texto, tam, fuente, color, pos, tam2, alineacion)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = texto
    l.TextSize = tam
    l.Font = fuente
    l.TextColor3 = color
    l.TextXAlignment = alineacion or Enum.TextXAlignment.Center
    if pos then l.Position = pos end
    if tam2 then l.Size = tam2 end
    l.Parent = parent
    return l
end

local AGUA_CLARA = Color3.fromRGB(190, 248, 255)
local AGUA_MEDIA = Color3.fromRGB(60, 180, 225)
local AGUA_HONDA = Color3.fromRGB(10, 58, 92)
local ESMERALDA = Color3.fromRGB(0, 240, 125)

--==================================================
-- INTERFAZ
--==================================================
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "MenuAccesoGui"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.DisplayOrder = 10000
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = playerGui

local W, H = 560, 286
local PASO = 5

local raiz = Instance.new("Frame")
raiz.Size = UDim2.fromOffset(W, H)
raiz.Position = UDim2.new(0.5, 0, 0.5, 0)
raiz.AnchorPoint = Vector2.new(0.5, 0.5)
raiz.BackgroundTransparency = 1
raiz.Parent = screenGui

-- Perfil de curvatura: más estrecho arriba y abajo, más ancho al centro
local function perfil(t)
    local k = t * 2 - 1
    return 1 - 0.075 * k * k
end

local lienzo = Instance.new("Frame")
lienzo.Size = UDim2.fromScale(1, 1)
lienzo.BackgroundTransparency = 1
lienzo.ClipsDescendants = true
lienzo.Parent = raiz

-- Relleno de cristal por franjas
local relleno = Instance.new("Frame")
relleno.Size = UDim2.fromScale(1, 1)
relleno.BackgroundTransparency = 1
relleno.Parent = lienzo

for y = 0, H, PASO do
    local t = y / H
    local ancho = perfil(t)
    local f = Instance.new("Frame")
    f.AnchorPoint = Vector2.new(0.5, 0)
    f.Position = UDim2.new(0.5, 0, 0, y - 1)
    f.Size = UDim2.new(ancho, 0, 0, PASO + 2)
    f.BackgroundColor3 = AGUA_HONDA:Lerp(AGUA_MEDIA, 0.35 + 0.35 * math.sin(t * math.pi))
    f.BackgroundTransparency = 0.32
    f.BorderSizePixel = 0
    f.Parent = relleno
    esquina(f, 3)
end

-- Brillo especular diagonal
local brillo = Instance.new("Frame")
brillo.Size = UDim2.fromScale(1, 1)
brillo.BackgroundColor3 = Color3.new(1, 1, 1)
brillo.BackgroundTransparency = 0.88
brillo.BorderSizePixel = 0
brillo.Parent = lienzo
local brilloGrad = Instance.new("UIGradient")
brilloGrad.Rotation = 115
brilloGrad.Transparency = NumberSequence.new({
    NumberSequenceKeypoint.new(0, 1),
    NumberSequenceKeypoint.new(0.35, 0.75),
    NumberSequenceKeypoint.new(0.5, 0.96),
    NumberSequenceKeypoint.new(1, 1),
})
brilloGrad.Parent = brillo

-- Borde siguiendo la curva
local bordeCapa = Instance.new("Frame")
bordeCapa.Size = UDim2.fromScale(1, 1)
bordeCapa.BackgroundTransparency = 1
bordeCapa.Parent = raiz

local funcionBorde = Instance.new("Frame")
funcionBorde.Size = UDim2.fromScale(1, 1)
funcionBorde.BackgroundTransparency = 1
funcionBorde.ZIndex = 3
funcionBorde.Parent = raiz

for y = 0, H, PASO do
    local t = y / H
    local ancho = perfil(t)
    local fade = 0.15 + 0.55 * math.abs(t * 2 - 1)
    for _, lado in ipairs({ -1, 1 }) do
        local s = Instance.new("Frame")
        s.AnchorPoint = Vector2.new(0.5, 0)
        s.Position = UDim2.new(0.5, lado * (ancho * W / 2), 0, y - 1)
        s.Size = UDim2.fromOffset(2, PASO + 2)
        s.BackgroundColor3 = AGUA_CLARA
        s.BackgroundTransparency = fade
        s.BorderSizePixel = 0
        s.ZIndex = 3
        s.Parent = funcionBorde
        esquina(s, 1)
    end
end

for _, datos in ipairs({ { 0, perfil(0) }, { H - 2, perfil(1) } }) do
    local c = Instance.new("Frame")
    c.AnchorPoint = Vector2.new(0.5, 0)
    c.Position = UDim2.new(0.5, 0, 0, datos[1])
    c.Size = UDim2.new(datos[2], 0, 0, 2)
    c.BackgroundColor3 = AGUA_CLARA
    c.BackgroundTransparency = 0.55
    c.BorderSizePixel = 0
    c.ZIndex = 3
    c.Parent = funcionBorde
    esquina(c, 1)
end

