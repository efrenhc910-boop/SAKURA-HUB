    Color3.fromRGB(255, 110, 110), UDim2.new(0.5, 0, 0, 148), UDim2.new(0.85, 0, 0, 18))
estado.AnchorPoint = Vector2.new(0.5, 0)
estado.ZIndex = 7

--==================================================
-- BOTONES
--==================================================
local function boton(texto, x, tinte, transp)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0.32, 0, 0, 38)
    b.Position = UDim2.new(x, 0, 0, 178)
    b.AnchorPoint = Vector2.new(0.5, 0)
    b.BackgroundColor3 = tinte
    b.BackgroundTransparency = transp
    b.Text = texto
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.FredokaOne
    b.TextSize = 14
    b.TextStrokeTransparency = 0.6
    b.TextStrokeColor3 = Color3.new(0, 0, 0)
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    b.ZIndex = 7
    b.Parent = contenedor
    esquina(b, 9)
    borde(b, AGUA_CLARA, 1.4, 0.3)

    local esc = Instance.new("UIScale")
    esc.Parent = b

    b.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
            tween(esc, { Scale = 0.96 }, 0.08)
        end
    end)
    b.InputEnded:Connect(function()
        tween(esc, { Scale = 1 }, 0.2, Enum.EasingStyle.Back)
    end)

    return b, esc
end

local botonVerificar = boton("Verificar Llave", 0.31, Color3.fromRGB(0, 150, 255), 0.05)
local botonObtener = boton("Obtener llave", 0.69, Color3.fromRGB(0, 100, 190), 0.15)

local creditos = etiqueta(contenedor, "Echo por I`m", 9, Enum.Font.FredokaOne,
    Color3.fromRGB(150, 210, 235), UDim2.new(0, 0, 1, -16), UDim2.new(1, 0, 0, 12))
creditos.TextTransparency = 0.35
creditos.ZIndex = 7

--==================================================
-- UN SOLO BUCLE PARA TODO
--==================================================
local frames, ultimoFps = 0, os.clock()
local reloj, fase = 0, 0

local conexionRender = RunService.RenderStepped:Connect(function(dt)
    if not VIVO then return end
    reloj += dt
    fase += dt

    -- Chispas
    for i = 1, #chispas do
        local d = chispas[i]
        d.vida -= dt
        if d.vida <= 0 or d.y < 0.06 then
            d.x = math.random(8, 92) / 100
            d.y = math.random(88, 99) / 100
            d.vy = math.random(30, 80) / 100
            d.vx = math.random(-14, 14) / 100
            d.vida = math.random(6, 22) / 10
            d.obj.Size = UDim2.fromOffset(math.random(2, 4), math.random(5, 11))
        end
        d.y -= d.vy * dt
        d.x += d.vx * dt
        if d.x < 0.04 or d.x > 0.96 then d.vx = -d.vx end
        d.obj.Position = UDim2.fromScale(d.x, d.y)
        d.obj.BackgroundTransparency = 0.15 + 0.45 * math.min(1, (1 - d.y) * 1.4)
    end

    -- Parpadeo de la brasa
    brasaColor.Offset = Vector2.new(math.sin(fase * 3.1) * 0.12, 0)
    brasa.BackgroundTransparency = 0.32 + 0.07 * math.sin(fase * 5.3)

    -- Cinta de noticias
    cintaTexto.Position = UDim2.new(1 - (reloj % 12) / 12 * 2.3, 0, 0, 0)

    -- Título arcoíris cada 3 frames
    frames += 1
    if frames % 3 == 0 then
        titulo.TextColor3 = Color3.fromHSV((reloj * 0.12) % 1, 0.55, 1)
    end

    -- FPS
    local ahora = os.clock()
    if ahora - ultimoFps >= 1 then
        fps.Text = "FPS " .. frames
        frames = 0
        ultimoFps = ahora
    end
end)

--==================================================
-- EVENTOS
--==================================================
local bloqueado = false
local ultimoToque = 0

local function cerrarTodo()
    VIVO = false
    if conexionRender then conexionRender:Disconnect() end
    if conexionArrastre then conexionArrastre:Disconnect() end
    if screenGui.Parent then screenGui:Destroy() end
end

cerrar.Activated:Connect(cerrarTodo)

botonObtener.Activated:Connect(function()
    pcall(function() setclipboard(LINK_OBTENER_LLAVE) end)
    estado.TextColor3 = Color3.fromRGB(150, 255, 200)
    estado.Text = "Enlace copiado al portapapeles"
    botonObtener.Text = "Enlace copiado"
    task.delay(2.2, function()
        if botonObtener.Parent and not bloqueado then
            botonObtener.Text = "Obtener llave"
            estado.Text = ""
        end
    end)
end)

local function verificar()
    if bloqueado then return end
    if os.clock() - ultimoToque < 0.3 then return end
    ultimoToque = os.clock()

    local escrito = normalizar(campo.Text)

    if escrito == "" then
        estado.TextColor3 = Color3.fromRGB(255, 200, 120)
        estado.Text = "Escribe una llave"
        return
    end

    bloqueado = true
    estado.TextColor3 = Color3.fromRGB(255, 220, 120)
    estado.Text = "Verificando"
    tween(campoBorde, { Transparency = 0.55 }, 0.2)

    for i = 1, 3 do
        task.wait(0.85)
        if not VIVO then return end
        estado.Text = estado.Text .. "."
    end

    if escrito == normalizar(LLAVE_CORRECTA) then
        estado.TextColor3 = Color3.fromRGB(140, 255, 190)
        estado.Text = "Llave correcta"
        tween(campoBorde, { Color = Color3.fromRGB(140, 255, 190), Transparency = 0 }, 0.2)

        if writefile then
            pcall(function() writefile(ARCHIVO_LLAVE, LLAVE_CORRECTA) end)
        end

        task.wait(0.9)
        if not VIVO then return end
        tween(raiz, { Size = UDim2.fromOffset(W * 0.55, 0), BackgroundTransparency = 1 }, 0.28)
        task.wait(0.3)
        cerrarTodo()
        task.wait(0.12)
        cargarHub()
    else
        estado.TextColor3 = Color3.fromRGB(255, 110, 110)
        estado.Text = "Llave incorrecta"
        tween(campoBorde, { Color = Color3.fromRGB(255, 110, 110), Transparency = 0 }, 0.15)
        task.delay(0.5, function()
            if campoBorde.Parent then
                tween(campoBorde, { Color = ESMERALDA, Transparency = 0.05 }, 0.3)
            end
        end)
        bloqueado = false
    end
end

botonVerificar.Activated:Connect(verificar)
campo.FocusLost:Connect(function(enter)
    if enter then verificar() end
end)

--==================================================
-- ENTRADA
--==================================================
raiz.Position = UDim2.new(0.5, 0, 0.5, 24)
tween(raiz, { Position = UDim2.new(0.5, 0, 0.5, 0) }, 0.38, Enum.EasingStyle.Back)
