local header = Instance.new("Frame")
header.Size = UDim2.new(1, -40, 0, 34)
header.Position = UDim2.fromOffset(20, 6)
header.BackgroundTransparency = 1
header.ZIndex = 5
header.Parent = contenedor

local arrastrando, puntoInicio, posicionInicio, entradaArrastre
local VIVO = true

header.InputBegan:Connect(function(entrada)
    if entrada.UserInputType == Enum.UserInputType.MouseButton1
        or entrada.UserInputType == Enum.UserInputType.Touch then
        arrastrando = true
        entradaArrastre = entrada
        puntoInicio = entrada.Position
        posicionInicio = raiz.Position
        entrada.Changed:Connect(function()
            if entrada.UserInputState == Enum.UserInputState.End then arrastrando = false end
        end)
    end
end)

header.InputChanged:Connect(function(entrada)
    if entrada.UserInputType == Enum.UserInputType.MouseMovement
        or entrada.UserInputType == Enum.UserInputType.Touch then
        entradaArrastre = entrada
    end
end)

local conexionArrastre = UserInputService.InputChanged:Connect(function(entrada)
    if arrastrando and entrada == entradaArrastre then
        local d = entrada.Position - puntoInicio
        raiz.Position = UDim2.new(posicionInicio.X.Scale, posicionInicio.X.Offset + d.X,
            posicionInicio.Y.Scale, posicionInicio.Y.Offset + d.Y)
    end
end)

