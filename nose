    bind(weaponBox, "TextColor3", "White")
    corner(weaponBox, 10)
    stroke(weaponBox, "Acc", 1, 0.5)
    weaponBox.FocusLost:Connect(safe(function()
        if weaponBox.Text ~= "" then
            Locker.weapon = weaponBox.Text
            refreshLocker()
            notify("Arma: " .. weaponBox.Text)
        end
    end, "arma"))

    createSection(SkinPage, "Buscar skin")

    local search = Instance.new("TextBox")
