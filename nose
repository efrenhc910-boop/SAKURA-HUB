    local ag = createGrid(SkinPage)

    createButton(ag, "Aleatoria", "Equipa una al azar", function()
        local pool = X.SKINS[Locker.weapon] or {}
        if #pool == 0 then return end
        local skin = pool[math.random(1, #pool)]
        if X.equipSkin(Locker.weapon, skin) then notify("Aleatoria: " .. skin) end
    end)

    createButton(ag, "Quitar skin", "Deja el arma limpia", function()
        X.removeSkin(Locker.weapon)
    end)

    createButton(ag, "Favoritos", "Equipa el primero guardado", function()
        for _, skin in ipairs(X.SKINS[Locker.weapon] or {}) do
            if Locker.fav[Locker.weapon .. "/" .. skin] then
                if X.equipSkin(Locker.weapon, skin) then notify("Favorito: " .. skin) end
                return
            end
        end
        notify("No hay favoritos en esta arma")
    end)

    createButton(ag, "Aplicar a todas", "Misma skin en cada arma", function()
        local first
        for _, skin in ipairs(X.SKINS[Locker.weapon] or {}) do
            if Locker.fav[Locker.weapon .. "/" .. skin] then
                first = skin
                break
            end
        end
        first = first or (X.SKINS[Locker.weapon] or {})[1]
        if not first then return end
        for _, weapon in ipairs(X.WEAPONS) do
            if weapon ~= Locker.weapon then
                X.equipSkin(weapon, first)
                task.wait(0.12)
            end
        end
        notify("Aplicado " .. first .. " a todas")
    end)

    refreshLocker()
end

