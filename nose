function X.fireHit(char)
    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    local root = char:FindFirstChild("HumanoidRootPart")
    local list = X.EXTRA.BotFireAll and X.ATTACK or { X.ATTACK[1] }
    for _, r in ipairs(list) do
        if r and r.Parent then
            pcall(function()
                r:FireServer({ Target = char, Position = head and head.Position or root.Position })
            end)
            pcall(function() r:FireServer(char) end)
        end
    end
end

function X.pickTarget()
    local root = getParts()
    if not root then return end
    if X.EXTRA.BotMode == "apuntado" and S.target and S.target.Character then
        return S.target.Character
    end
    local best, bestScore
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and not (X.EXTRA.BotIgnoreAllies and isAlly(plr)) then
            local char = plr.Character
            local h = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if h and hrp and h.Health > 0 then
                local dist = (hrp.Position - root.Position).Magnitude
                if dist <= X.EXTRA.BotKillRange then
                    local score = (X.EXTRA.BotMode == "debil") and h.Health or dist
                    if not bestScore or score < bestScore then
                        best, bestScore = char, score
                    end
                end
            end
        end
    end
    return best
end

task.spawn(function()
    while Screen.Parent do
        task.wait(X.EXTRA.BotKillInterval)
        if not S.botKill then continue end
        local ok = pcall(function()
            local target = X.pickTarget()
            if not target then return end
            if X.EXTRA.BotTPBeforeKill then
                local root, hum = getParts()
                local hrp = target:FindFirstChild("HumanoidRootPart")
                if root and hum and hrp then
                    root.CFrame = hrp.CFrame * CFrame.new(0, 0, 2)
                end
            end
            X.fireHit(target)
            if X.EXTRA.BotCountHits then
                X.Bot.hits += 1
                if X.Bot.sub and X.Bot.sub.Parent then
                    X.Bot.sub.Text = X.Bot.hits .. " golpes"
                end
            end
        end)
        if not ok then task.wait(0.3) end
    end
end)

