    end)

    createSection(SkinPage, "Arma")

    local wg = createGrid(SkinPage)
    for _, weapon in ipairs(X.WEAPONS) do
        createButton(wg, weapon, "Ver skins", function()
            Locker.weapon = weapon
            if refreshLocker then refreshLocker() end
            notify("Arma: " .. weapon)
        end)
    end

    local weaponBox = Instance.new("TextBox")
    weaponBox.Size = UDim2.new(1, -4, 0, 34)
