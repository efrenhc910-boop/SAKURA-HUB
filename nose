    box.AnchorPoint = Vector2.new(0.5, 0.5)
    box.Size = UDim2.fromOffset(14 * k, 12 * k)
    box.BackgroundTransparency = 1
    box.Parent = parent
    local parts = {}
    for i, s in ipairs({ { 4, 6, 45 }, { 10, 6, -45 } }) do
        local p = Instance.new("Frame")
        p.AnchorPoint = Vector2.new(0.5, 0.5)
        p.Size = UDim2.fromOffset(9 * k, 2 * k)
