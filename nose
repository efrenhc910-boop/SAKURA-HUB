-- PARTE 1: BASE
-- ============================================================
local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local UIS     = game:GetService("UserInputService")
local Run     = game:GetService("RunService")

local LP = Players.LocalPlayer

local CFG = {
    -- ---- SKINS ----
    SkinEquipRemote = "EquipSkin",   -- <-- pon aquí lo que salga en el recon
    SkinUnlockAll   = true,          -- false = solo parchea propiedad local, sin forzar equip

    -- ---- POWER JUMP ----
    JumpImpulse     = 130,           -- fuerza vertical (110-150 va bien, +200 = desync)
    JumpAutoEnable  = false,         -- true = activo al cargar

    -- ---- I'M BOT ----
    BotRingRadius   = 14,            -- radio del círculo
    BotRingColor    = Color3.fromRGB(255, 40, 40),
    BotRingSegments = 32,            -- más = círculo más fino
    BotTagText      = "[BOT]",
    BotKillRange    = 40,            -- alcance del auto-kill
    BotKillDelay    = 0.12,          -- cadencia de golpes
    BotAutoKill     = true,
}

-- búsqueda profunda por nombre + clase
local function deepFind(name, class)
    for _, d in ipairs(RS:GetDescendants()) do
        if d.Name == name and d:IsA(class) then return d end
    end
end

local function getChar()
    local c = LP.Character
    return c, c and c:FindFirstChild("Humanoid"), c and c:FindFirstChild("HumanoidRootPart")
end

local function isAlive()
    local _, hum = getChar()
    return hum and hum.Health > 0
end
-- ============================================================
-- PARTE 2: SKINS UNLOCKER
-- ============================================================
local Skins = { ids = {}, owned = {} }

-- 2.1 localizar el módulo de datos de skins
function Skins.findData()
    for _, d in ipairs(RS:GetDescendants()) do
        if d:IsA("ModuleScript") then
            local n = d.Name:lower()
            if n:find("skin") or n:find("cosmetic") then
                local ok, data = pcall(require, d)
                if ok and type(data) == "table" then
                    Skins.module = d
                    return data
                end
            end
        end
    end
end

-- 2.2 aplanar el módulo a una lista de IDs (acepta tablas anidadas)
function Skins.collect(tbl)
    for k, v in pairs(tbl or {}) do
        if type(v) == "table" then
            Skins.collect(v)
        elseif type(v) == "string" and #v > 2 then
            Skins.ids[v] = true
        elseif type(k) == "string" and #k > 2 and type(v) == "boolean" then
            Skins.ids[k] = true      -- formato { SkinId = true }
        end
    end
end

-- 2.3 CAPA A: marcar propiedad en el perfil local
function Skins.patchProfile()
    -- el perfil suele colgar del jugador o de _G si el script ya lo cacheó
    local prof = rawget(getfenv(), "RIVALS_PROFILE") or _G.RIVALS_PROFILE
    if not prof then return false end

    pcall(setreadonly, prof, false)
    local lists = { "OwnedSkins", "Skins", "Owned", "Inventory" }
    for _, key in ipairs(lists) do
        local t = prof[key]
        if type(t) == "table" then
            for id in pairs(Skins.ids) do t[id] = true end
        end
    end
    pcall(setreadonly, prof, true)
    return true
end

-- 2.4 CAPA B: forzar equip
function Skins.equip(id)
    local remote = deepFind(CFG.SkinEquipRemote, "RemoteEvent")
             or deepFind(CFG.SkinEquipRemote, "RemoteFunction")
    if not remote then return false end

    if remote:IsA("RemoteFunction") then
        pcall(function() remote:InvokeServer(id) end)
    else
        pcall(function() remote:FireServer(id) end)
    end
    return true
end

function Skins.unlockAll()
    local data = Skins.findData()
    if data then Skins.collect(data) end
    Skins.patchProfile()

    local count = 0
    for id in pairs(Skins.ids) do
        if Skins.equip(id) then count += 1 end
        task.wait(0.03)              -- throttle: si no, el server te tira
    end
    print(("[SKINS] %d skins procesadas"):format(count))
end
-- ============================================================
-- PARTE 3: POWER JUMP
-- ============================================================
local PowerJump = { on = CFG.JumpAutoEnable, conn = nil }

function PowerJump.set(state)
    PowerJump.on = state
    if state and not PowerJump.conn then
        PowerJump.conn = UIS.JumpRequest:Connect(function()
            if not PowerJump.on or not isAlive() then return end
            local _, hum, hrp = getChar()
            if not hrp then return end
            hum.UseJumpPower = true
            hum.JumpPower = 50                       -- base normal
            local v = hrp.AssemblyLinearVelocity
            hrp.AssemblyLinearVelocity = Vector3.new(v.X, CFG.JumpImpulse, v.Z)
        end)
    elseif not state and PowerJump.conn then
        PowerJump.conn:Disconnect()
        PowerJump.conn = nil
    end
end
PowerJump.set(PowerJump.on)
