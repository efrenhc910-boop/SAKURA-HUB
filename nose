        local pool = X.SKINS[Locker.weapon] or {}
        UI.lockerHead.Text = "SKINS · " .. string.upper(Locker.weapon) .. " (" .. #pool .. ")"

        local shown = 0
        for _, skin in ipairs(pool) do
            local key = Locker.weapon .. "/" .. skin
            if Locker.filter == "" or string.find(string.lower(skin), Locker.filter, 1, true) then
