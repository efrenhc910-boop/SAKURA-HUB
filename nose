local function eachSkin(fn)
    for weapon, list in pairs(X.SKINS) do
        for _, skin in ipairs(list) do fn(weapon, skin) end
    end
end

local function patchTable(tbl, depth)
    if type(tbl) ~= "table" or depth > 3 then return end
    for k, v in pairs(tbl) do
        if type(v) == "function" then
            local n = string.lower(tostring(k))
            if string.find(n, "owned", 1, true) or string.find(n, "owns", 1, true)
                or string.find(n, "hasitem", 1, true) or string.find(n, "unlock", 1, true)
                or string.find(n, "hasunlocked", 1, true) then
                X.saved[#X.saved + 1] = { tbl = tbl, key = k, fn = v }
                tbl[k] = function() return true end
            end
        elseif type(v) == "table" then
            patchTable(v, depth + 1)
        end
    end
end

local function fillOwned(tbl, depth)
    if type(tbl) ~= "table" or depth > 3 then return end
    for k, v in pairs(tbl) do
        local n = string.lower(tostring(k))
        if type(v) == "table" and (n == "owned" or n == "ownedskins" or n == "unlocked"
            or n == "owneditems" or n == "inventory" or n == "skins") then
            eachSkin(function(weapon, skin)
                pcall(function() v[skin] = true end)
                pcall(function() v[weapon .. "_" .. skin] = true end)
                pcall(function() table.insert(v, skin) end)
            end)
        elseif type(v) == "table" then
            fillOwned(v, depth + 1)
        end
    end
end

function X.unlockAll()
    local ok, err = pcall(function()
        -- 1. módulos de items / skins
        local libs = X.findModules({ "item", "skin", "weapon", "cosmetic", "inventory", "shop" })
        for _, lib in ipairs(libs) do
            local rok, mod = pcall(require, lib)
            if rok and type(mod) == "table" then
                patchTable(mod, 0)
                fillOwned(mod, 0)
            end
        end

        -- 2. tablas sueltas dentro de ReplicatedStorage
        for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
            if d:IsA("Folder") or d:IsA("ModuleScript") then
                pcall(function() fillOwned(d, 0) end)
            end
        end

        -- 3. atributos del jugador y del personaje
        eachSkin(function(weapon, skin)
            pcall(function() player:SetAttribute("Owned_" .. skin, true) end)
            pcall(function() player:SetAttribute("Owned_" .. weapon .. "_" .. skin, true) end)
            pcall(function() player:SetAttribute(skin, true) end)
        end)

        -- 4. remotes de desbloqueo
        for _, r in ipairs(X.UNLOCK) do
            pcall(function() r:FireServer() end)
        end
        for _, r in ipairs(X.UNLOCK) do
            pcall(function() r:FireServer("all") end)
            task.wait(0.05)
        end
    end)

    if not ok then
        warn("[DestroyaHub] skins: " .. tostring(err))
        notify("Hubo un error, revisa la consola")
        return false
    end

    X.unlocked = true
    notify("Todas las skins desbloqueadas")
    return true
end

function X.relockAll()
    for _, s in ipairs(X.saved) do
        pcall(function() s.tbl[s.key] = s.fn end)
    end
    table.clear(X.saved)
    X.unlocked = false
    notify("Skins restauradas")
end

function X.equipSkin(weapon, skin)
    if #X.EQUIP == 0 then
        X.scanRemotes()
        if #X.EQUIP == 0 then
            notify("No hay remote de equipar")
            return false
        end
    end
    for _, r in ipairs(X.EQUIP) do
        if r.Parent then
            pcall(function() r:FireServer(weapon, skin) end)
            pcall(function() r:FireServer({ Weapon = weapon, Skin = skin }) end)
            pcall(function() r:FireServer(skin) end)
        end
    end
    pcall(function() player:SetAttribute("Skin_" .. weapon, skin) end)
    return true
end

function X.removeSkin(weapon)
    if #X.EQUIP == 0 then return end
    for _, r in ipairs(X.EQUIP) do
        if r.Parent then
            pcall(function() r:FireServer(weapon, "None") end)
            pcall(function() r:FireServer({ Weapon = weapon, Skin = "None" }) end)
        end
    end
    notify("Skin quitada de " .. weapon)
end

