X.Bot = { char = nil, nodes = {}, tag = nil, core = nil, folder = nil, hits = 0, spin = 0, miss = 0 }

function X.clearBot()
    if X.Bot.folder and X.Bot.folder.Parent then X.Bot.folder:Destroy() end
    if X.Bot.tag and X.Bot.tag.Parent then X.Bot.tag:Destroy() end
    X.Bot.folder, X.Bot.core, X.Bot.tag, X.Bot.sub, X.Bot.char = nil, nil, nil, nil, nil
    table.clear(X.Bot.nodes)
    if X.Bot.hl and X.Bot.hl.Parent then X.Bot.hl:Destroy() end
    X.Bot.hl = nil
end

function X.addNode(root, angle, radius, y, size)
    local p = Instance.new("Part")
    p.Size = size
    p.Shape = Enum.PartType.Ball
    p.Anchored = false
    p.Massless = true
    p.CanCollide = false
    p.CanQuery = false
    p.CastShadow = false
    p.Material = Enum.Material.Neon
    p.Color = X.EXTRA.BotColor
    p.Transparency = 0.05
    p.CFrame = root.CFrame * CFrame.new(math.cos(angle) * radius, y, math.sin(angle) * radius)
    p.Parent = X.Bot.folder

    local w = Instance.new("WeldConstraint")
    w.Part0 = X.Bot.core
    w.Part1 = p
    w.Parent = p

    X.Bot.nodes[#X.Bot.nodes + 1] = { part = p, r = radius, y = y, a = angle }
end

function X.buildRing(char)
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    X.Bot.folder = Instance.new("Folder")
    X.Bot.folder.Name = "DestroyaBot"
    X.Bot.folder.Parent = Workspace

    local core = Instance.new("Part")
    core.Name = "Core"
    core.Size = Vector3.new(0.2, 0.2, 0.2)
    core.Transparency = 1
    core.Anchored = false
    core.Massless = true
    core.CanCollide = false
    core.CanQuery = false
    core.CFrame = root.CFrame * CFrame.new(0, -2.8, 0)
    core.Parent = X.Bot.folder
    X.Bot.core = core

    local w = Instance.new("WeldConstraint")
    w.Part0 = root
    w.Part1 = core
    w.Parent = core

    local style = X.EXTRA.BotStyle
    if style == "ninguno" then return end
    local n = (style == "disco") and 40 or 26
    for i = 1, n do
        local a = (i / n) * math.pi * 2
        X.addNode(root, a, X.EXTRA.BotRadius, 0,
            (style == "disco") and Vector3.new(0.55, 0.55, 0.55) or Vector3.new(0.5, 0.5, 0.5))
        if style == "doble" then
            X.addNode(root, a, X.EXTRA.BotRadius * 0.6, 0.6, Vector3.new(0.32, 0.32, 0.32))
        end
    end
end

function X.buildTag(char)
    local head = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
    if not head then return end
    local bb = Instance.new("BillboardGui")
    bb.Name = "DestroyaBotTag"
    bb.Size = UDim2.fromOffset(160, 36)
    bb.StudsOffset = Vector3.new(0, 3.4, 0)
