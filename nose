-- PARTE 4: I'M BOT
-- ============================================================
local ImBot = { on = false, ring = {}, tag = nil, loop = nil }

-- 4.1 anillo: partes finas soldadas al HRP
function ImBot.buildRing(hrp)
    local segs = CFG.BotRingSegments
    for i = 1, segs do
        local ang = (i / segs) * math.pi * 2
        local p = Instance.new("Part")
        p.Anchored     = false
        p.CanCollide   = false
        p.CanQuery     = false
        p.CanTouch     = false
        p.Material     = Enum.Material.Neon
        p.Color        = CFG.BotRingColor
        p.Transparency = 0.25
        p.Size         = Vector3.new(0.6, 0.12, 0.9)
        p.CFrame       = hrp.CFrame * CFrame.new(
            math.cos(ang) * CFG.BotRingRadius,
            -2.6,
            math.sin(ang) * CFG.BotRingRadius
        ) * CFrame.Angles(0, -ang, 0)

        local w = Instance.new("WeldConstraint")
        w.Part0, w.Part1 = hrp, p
        w.Parent = p
        p.Parent = workspace
        table.insert(ImBot.ring, p)
    end
end

-- 4.2 etiqueta de bot
function ImBot.buildTag(hrp)
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.fromScale(5, 1.6)
    bb.StudsOffset = Vector3.new(0, 3.4, 0)
    bb.AlwaysOnTop = true
    bb.Parent = hrp

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.fromScale(1, 1)
    lbl.BackgroundTransparency = 1
    lbl.Text = CFG.BotTagText
    lbl.TextColor3 = Color3.fromRGB(220, 220, 220)
    lbl.TextStrokeTransparency = 0.4
    lbl.Font = Enum.Font.Code
    lbl.TextScaled = true
    lbl.Parent = bb

    ImBot.tag = bb
end

-- 4.3 ataque: gira al objetivo y dispara/golpea
function ImBot.attack(target)
    local char, _, hrp = getChar()
    if not char or not hrp then return end
    local thp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if not thp then return end

    -- encarar
    hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(
        thp.Position.X, hrp.Position.Y, thp.Position.Z
    ))

    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() tool:Activate() end)
    else
        local remote = deepFind("FireWeapon", "RemoteEvent") or deepFind("Attack", "RemoteEvent")
        if remote then pcall(function() remote:FireServer() end) end
    end
end

-- 4.4 bucle: busca el más cercano en rango y lo mata
function ImBot.startKill()
    if ImBot.loop then return end
    ImBot.loop = task.spawn(function()
        while ImBot.on do
            if CFG.BotAutoKill and isAlive() then
                local _, _, hrp = getChar()
                local best, bestD = nil, CFG.BotKillRange

                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LP and plr.Character then
                        local ph = plr.Character:FindFirstChild("Humanoid")
                        local pr = plr.Character:FindFirstChild("HumanoidRootPart")
                        if ph and pr and ph.Health > 0 then
                            local d = (pr.Position - hrp.Position).Magnitude
                            if d < bestD then best, bestD = plr, d end
                        end
                    end
                end

                if best then ImBot.attack(best) end
            end
            task.wait(CFG.BotKillDelay)
        end
    end)
end

-- 4.5 toggle
function ImBot.set(state)
    ImBot.on = state
    if state then
        local _, _, hrp = getChar()
        if hrp then
            ImBot.buildRing(hrp)
            ImBot.buildTag(hrp)
        end
        ImBot.startKill()
    else
        for _, p in ipairs(ImBot.ring) do p:Destroy() end
        ImBot.ring = {}
        if ImBot.tag then ImBot.tag:Destroy() ImBot.tag = nil end
        ImBot.loop = nil
    end
end
