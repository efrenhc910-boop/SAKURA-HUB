local function floatButton(y, label, tint1, tint2, lineColor)
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(120, 42)
    b.Position = UDim2.new(0, 14, 0.5, y)
    b.BackgroundColor3 = Color3.new(1, 1, 1)
    b.BackgroundTransparency = 0.45
    b.Text = ""
    b.AutoButtonColor = false
    b.Visible = false
    b.ZIndex = 10
    b.Parent = Screen
    corner(b, 13)

    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new(tint1, tint2)
    g.Rotation = 90
    g.Parent = b

    local sc = Instance.new("UIScale")
    sc.Scale = 0
    sc.Parent = b

    local st = Instance.new("UIStroke")
    st.Color = lineColor
    st.Thickness = 2
    st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    st.Parent = b

    local box = Instance.new("Frame")
    box.Position = UDim2.fromOffset(8, 9)
    box.Size = UDim2.fromOffset(24, 24)
    box.BackgroundColor3 = lineColor
    box.BackgroundTransparency = 0.25
    box.BorderSizePixel = 0
    box.ZIndex = 11
    box.Parent = b
    corner(box, 12)
    for _, rot in ipairs({ 45, -45 }) do
