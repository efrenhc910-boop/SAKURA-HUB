function X.deepFind(name, class)
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if (not class or d:IsA(class))
            and string.find(string.lower(d.Name), string.lower(name), 1, true) then
            return d
        end
    end
end

function X.findModules(patterns)
    local out = {}
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if d:IsA("ModuleScript") then
            local n = string.lower(d.Name)
            for _, p in ipairs(patterns) do
                if string.find(n, p, 1, true) then
                    out[#out + 1] = d
                    break
                end
            end
        end
    end
    return out
end

X.ATTACK, X.EQUIP, X.UNLOCK = {}, {}, {}

function X.scanRemotes()
    table.clear(X.ATTACK)
    table.clear(X.EQUIP)
    table.clear(X.UNLOCK)
