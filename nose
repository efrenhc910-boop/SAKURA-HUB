--==================================================
-- BOT: anillo, tag y auto-kill
-- Los aros son piezas ancladas que se reposicionan
-- cada frame respecto al HRP, así giran sin welds
-- y no se despegan al respawnear.
--==================================================

X.Bot = { char = nil, parts = {}, tag = nil, hits = 0, spin = 0 }

function X.clearBot()
    for _, it in ipairs(X.Bot.parts) do
        if it.part and it.part.Parent then it.part:Destroy() end
    end
    table.clear(X.Bot.parts)
    if X.Bot.tag and X.Bot.tag.Parent then X.Bot.tag:Destroy() end
    X.Bot.tag, X.Bot.sub, X.Bot.char = nil, nil, nil
end

function X.addNode(root, angle, radius, y, size)
    local p = Instance.new("Part")
    p.Size = size
    p.Shape = Enum.PartType.Ball
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CastShadow = false
    p.Material = Enum.Material.Neon
    p.Color = X.EXTRA.BotRingColor
    p.Transparency = 0.15
    p.CFrame = root.CFrame * CFrame.new(math.cos(angle) * radius, y, math.sin(angle) * radius)
    p.Parent = Workspace
    X.Bot.parts[#X.Bot.parts + 1] = { part = p, r = radius, y = y }
end

function X.buildRing(char)
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or X.EXTRA.BotRingStyle == "ninguno" then return end
    local style, r = X.EXTRA.BotRingStyle, X.EXTRA.BotRingRadius
    local n = (style == "disco") and 40 or 26
    for i = 1, n do
        local a = (i / n) * math.pi * 2
        X.addNode(root, a, r, -2.6, (style == "disco") and Vector3.new(0.55, 0.55, 0.55) or Vector3.new(0.42, 0.42, 0.42))
        if style == "doble" then
            X.addNode(root, a, r * 0.6, -2.1, Vector3.new(0.3, 0.3, 0.3))
        end
    end
end

function X.buildTag(char)
    local head = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
    if not head then return end
    local bb = Instance.new("BillboardGui")
    bb.Name = "DestroyaBotTag"
    bb.Size = UDim2.fromOffset(150, 34)
    bb.StudsOffset = Vector3.new(0, 3.4, 0)
    bb.AlwaysOnTop = true
    bb.LightInfluence = 0
    bb.Adornee = head
    bb.Parent = Workspace
    local l = plain(bb, X.EXTRA.BotTagText, 16, F.head, X.EXTRA.BotRingColor,
        UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, 18), Enum.TextXAlignment.Center)
    l.TextStrokeTransparency = 0.15
    l.TextStrokeColor3 = Color3.new(0, 0, 0)
    local sub = plain(bb, "", 11, F.body, C.White,
        UDim2.fromOffset(0, 18), UDim2.new(1, 0, 0, 14), Enum.TextXAlignment.Center)
    sub.TextStrokeTransparency = 0.3
    X.Bot.tag, X.Bot.sub = bb, sub
end

function X.buildBot()
    X.clearBot()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    X.Bot.char = char
    pcall(X.buildRing, char)
    pcall(X.buildTag, char)
end

track(RunService.Heartbeat:Connect(function(dt)
    if not S.botVisual then return end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        if X.Bot.char then X.clearBot() end
        return
    end
    if X.Bot.char ~= char then
        X.buildBot()
        return
    end
    X.Bot.spin += dt * 1.6
    local n = #X.Bot.parts
    for i = 1, n do
        local it = X.Bot.parts[i]
        if it.part and it.part.Parent then
            local a = (i / n) * math.pi * 2 + X.Bot.spin
            it.part.CFrame = root.CFrame * CFrame.new(math.cos(a) * it.r, it.y, math.sin(a) * it.r)
            it.part.Color = X.EXTRA.BotRingColor
        end
    end
end))

track(player.CharacterAdded:Connect(function()
    X.clearBot()
    if S.botVisual then
        task.wait(1)
        if S.botVisual then X.buildBot() end
    end
end))

function X.fireHit(char)
    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    local root = char:FindFirstChild("HumanoidRootPart")
    local list = X.EXTRA.BotFireAll and X.HITS or { X.REM.hit }
    for _, r in ipairs(list) do
        if r and r.Parent then
            pcall(function()
                r:FireServer({ Target = char, Position = head and head.Position or root.Position })
            end)
            pcall(function() r:FireServer(char) end)
        end
    end
end

function X.pickTarget()
    local root = getParts()
    if not root then return end
    if X.EXTRA.BotKillMode == "apuntado" and S.target and S.target.Character then
        return S.target.Character
    end
    local best, bestScore
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and not (X.EXTRA.BotIgnoreAllies and isAlly(plr)) then
            local char = plr.Character
            local h = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if h and hrp and h.Health > 0 then
                local dist = (hrp.Position - root.Position).Magnitude
                if dist <= X.EXTRA.BotKillRange then
                    local score = (X.EXTRA.BotKillMode == "debil") and h.Health or dist
                    if not bestScore or score < bestScore then
                        best, bestScore = char, score
                    end
                end
            end
        end
    end
    return best
end

task.spawn(function()
    while Screen.Parent do
        task.wait(X.EXTRA.BotKillInterval)
        if not S.botKill then continue end
        local ok = pcall(function()
            local target = X.pickTarget()
            if not target then return end
            if X.EXTRA.BotTPBeforeKill then
                local root, hum = getParts()
                local hrp = target:FindFirstChild("HumanoidRootPart")
                if root and hum and hrp then
                    root.CFrame = hrp.CFrame * CFrame.new(0, 0, 2)
                end
            end
            X.fireHit(target)
            if X.EXTRA.BotCountHits then
                X.Bot.hits += 1
                if X.Bot.sub and X.Bot.sub.Parent then
                    X.Bot.sub.Text = X.Bot.hits .. " golpes"
                end
            end
        end)
        if not ok then task.wait(0.3) end
    end
end)

