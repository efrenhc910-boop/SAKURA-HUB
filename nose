X.Sky = {}

function X.setNight(on)
    if on == X.Sky.on then return end
    X.Sky.on = on
    if on then
        X.Sky.save = {
            ClockTime = Lighting.ClockTime,
            Brightness = Lighting.Brightness,
            Ambient = Lighting.Ambient,
            Outdoor = Lighting.OutdoorAmbient,
            FogEnd = Lighting.FogEnd,
            FogStart = Lighting.FogStart,
            FogColor = Lighting.FogColor,
        }
        Lighting.ClockTime = 0
        Lighting.Brightness = 0.7
        Lighting.Ambient = Color3.fromRGB(18, 22, 46)
        Lighting.OutdoorAmbient = Color3.fromRGB(26, 32, 66)
        Lighting.FogEnd = 4000
        Lighting.FogStart = 0
        Lighting.FogColor = Color3.fromRGB(10, 14, 32)
        X.setStars(true)
        task.spawn(function()
            while X.Sky.on and Screen.Parent do
                pcall(function()
                    Lighting.ClockTime = 0
                    Lighting.Brightness = 0.7
                end)
                task.wait(1)
            end
        end)
    else
        local s = X.Sky.save
        if s then
            pcall(function()
                Lighting.ClockTime = s.ClockTime
                Lighting.Brightness = s.Brightness
                Lighting.Ambient = s.Ambient
                Lighting.OutdoorAmbient = s.Outdoor
                Lighting.FogEnd = s.FogEnd
                Lighting.FogStart = s.FogStart
                Lighting.FogColor = s.FogColor
            end)
        end
        X.setStars(false)
    end
end

function X.setStars(on)
    if on then
        if X.Sky.stars and X.Sky.stars.Parent then return end
        local st = Instance.new("Stars")
        st.Name = "DestroyaStars"
        st.Density = 2200
        st.Parent = Lighting
        X.Sky.stars = st
    elseif X.Sky.stars and X.Sky.stars.Parent then
        X.Sky.stars:Destroy()
        X.Sky.stars = nil
    end
end

function X.setShadows(on)
    pcall(function() Lighting.GlobalShadows = on end)
    X.Sky.shadows = on
end

local pulseObj
function X.setPulse(on)
    if on then
        if pulseObj then return end
        pulseObj = TweenService:Create(Main:FindFirstChildOfClass("UIStroke"),
            TweenInfo.new(1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
            { Transparency = 0.6 })
        pulseObj:Play()
    elseif pulseObj then
        pulseObj:Cancel()
        pulseObj = nil
        local st = Main:FindFirstChildOfClass("UIStroke")
        if st then st.Transparency = 0.1 end
    end
end

--==================================================
-- CONTADOR FPS Y RAINBOW (SOLO CON MENÚ ABIERTO)
--==================================================

do
    local clock, acc, frames, fpsAcc = 0, 0, 0, 0
    track(RunService.Heartbeat:Connect(function(dt)
        frames += 1
        fpsAcc += dt
        if fpsAcc >= 0.5 then
            if UI.open then
                FpsText.Text = "FPS " .. math.floor(frames / fpsAcc + 0.5)
            end
            frames, fpsAcc = 0, 0
        end

        if not UI.open then return end
        acc += dt
        if acc < 1 / 15 then return end
        clock += acc
        acc = 0

        if UI.flyPad and UI.flyPad.Visible then
            for i, it in ipairs(UI.padItems) do
                local c = UI.anim and Color3.fromHSV((clock * 0.4 + i * 0.17) % 1, 1, 1) or GLOW
                it.stroke.Color = c
                for _, p in ipairs(it.parts) do p.BackgroundColor3 = c end
            end
        end
    end))
end

