                        accent.Size = UDim2.fromOffset(3, 20)
                        notify("Equipado: " .. skin)
                        task.delay(0.4, function()
                            if accent.Parent then accent.Size = UDim2.fromOffset(3, 0) end
                        end)
                    end
                end, "equipar"))

                local star = Instance.new("TextButton")
                star.AnchorPoint = Vector2.new(1, 0.5)
                star.Position = UDim2.new(1, -6, 0.5, 0)
                star.Size = UDim2.fromOffset(24, 24)
                star.BackgroundTransparency = 1
                star.Text = Locker.fav[key] and "★" or "☆"
                star.TextSize = 16
                star.Font = F.head
                star.TextColor3 = Locker.fav[key] and C.Acc2 or C.Gray
                star.AutoButtonColor = false
                star.Parent = row
                equipL.Position = UDim2.new(1, -102, 0, 0)
                equipL.Size = UDim2.fromOffset(44, 34)

                star.Activated:Connect(safe(function()
                    Locker.fav[key] = not Locker.fav[key]
                    star.Text = Locker.fav[key] and "★" or "☆"
                    star.TextColor3 = Locker.fav[key] and C.Acc2 or C.Gray
                end, "favorito"))
            end
        end

        if shown == 0 then
            local e = plain(list, "Sin resultados en esta arma", 11, F.body, C.Gray,
                nil, UDim2.new(1, 0, 0, 28), Enum.TextXAlignment.Center)
            e.LayoutOrder = 1
        end
    end

