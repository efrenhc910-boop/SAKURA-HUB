local setNoclip
do
    local parts, orig, refreshAt = {}, {}, 0

    local function collect()
        table.clear(parts)
        local char = player.Character
        if not char then return end
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then parts[#parts + 1] = d end
        end
    end

    setNoclip = function(enabled)
        S.noclip = enabled
        if not enabled then
            for p in pairs(orig) do
                if p.Parent then p.CanCollide = true end
            end
            table.clear(orig)
        else
            refreshAt = 0
        end
    end

    track(RunService.Stepped:Connect(function()
        if not S.noclip then return end
        local now = os.clock()
        if now >= refreshAt then
            refreshAt = now + 1
            collect()
        end
        for i = 1, #parts do
            local p = parts[i]
            if p.Parent and p.CanCollide then
                orig[p] = true
                p.CanCollide = false
            end
        end
    end))

    track(player.CharacterAdded:Connect(function()
        table.clear(orig)
        refreshAt = 0
    end))
end

