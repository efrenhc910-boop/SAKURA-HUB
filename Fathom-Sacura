--==================================================
-- BUCLE CENTRAL DE ANIMACIÓN (una sola conexión, 15 veces/seg)
--==================================================

do
    local clock, animAcc, frames, fpsAcc = 0, 0, 0, 0

    track(RunService.Heartbeat:Connect(function(dt)
        frames += 1
        fpsAcc += dt
        if fpsAcc >= 0.5 then
            FpsText.Text = "FPS " .. math.floor(frames / fpsAcc + 0.5)
            frames, fpsAcc = 0, 0
        end

        animAcc += dt
        if animAcc < 1 / 15 then return end
        clock += animAcc
        animAcc = 0

        -- Arcoíris del FPS (siempre visible)
        FpsGrad.Offset = Vector2.new(math.sin(clock * 1.8) * 0.5, 0)

        if UI.open then
            -- Letras: ola negro ↔ azul marino
            for i, l in ipairs(UI.letters) do
                local w = math.sin(clock * 2.2 + i * 0.7) * 0.5 + 0.5
                l.lbl.TextColor3 = UI.INK_A:Lerp(UI.INK_B, w)
                l.lbl.Position = UDim2.fromOffset(l.x, 2 + math.sin(clock * 3 + i * 0.6) * 1.5)
            end

            -- Línea de escaneo
            UI.scan.Position = UDim2.fromOffset((math.sin(clock * 1.3) * 0.5 + 0.5) * (BASE_W - 70), HEADER_H - 2)
            UI.scan.BackgroundColor3 = C.Acc2

            -- Borde LED
            if UI.led then
                MainGrad.Rotation = (clock * 50) % 360
            end
        end

        -- Botones de Fly: arcoíris neón cambiante
        if UI.flyPad.Visible then
            for i, it in ipairs(UI.padItems) do
                local c = Color3.fromHSV((clock * 0.4 + i * 0.17) % 1, 1, 1)
                it.stroke.Color = c
                it.btn.TextColor3 = c
            end
        end
    end))
end

