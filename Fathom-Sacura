local function applyPlayerESP(plr)
	if plr == player then return end
	if playerHighlightObjects[plr] then return end

	local highlight = Instance.new("Highlight")
	highlight.Adornee = plr.Character
	highlight.FillColor = Color3.fromRGB(255, 92, 200)
	highlight.OutlineColor = Color3.fromRGB(255, 145, 230)
	highlight.FillTransparency = 0.4
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = Workspace

	playerHighlightObjects[plr] = highlight
end

local function clearPlayerESP()
	for _, highlight in pairs(playerHighlightObjects) do
		if highlight then highlight:Destroy() end
	end
	playerHighlightObjects = {}
end

espToggle.MouseButton1Click:Connect(function()
	espEnabled = not espEnabled
	setToggle(espToggle, espEnabled)

	if espEnabled then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player and plr.Character then
				applyPlayerESP(plr)
			end
		end
	else
		clearPlayerESP()
	end
end)

camToggle.MouseButton1Click:Connect(function()
	camLockEnabled = not camLockEnabled
	setToggle(camToggle, camLockEnabled)

	if not camLockEnabled then
		selectedTarget = nil
	end
end)

Players.PlayerAdded:Connect(function(plr)
	plr.CharacterAdded:Connect(function()
		if espEnabled and plr ~= player then
			applyPlayerESP(plr)
		end
	end)
end)

local dragStart
local dragStartPos
local dragging = false

topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		dragStartPos = root.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		root.Position = UDim2.new(
			dragStartPos.X.Scale,
			dragStartPos.X.Offset + delta.X,
			dragStartPos.Y.Scale,
			dragStartPos.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

