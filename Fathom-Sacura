    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = container

    updatePlayerList = function()
        local filter = string.lower(search.Text or "")

        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and (filter == "" or string.find(string.lower(plr.Name), filter, 1, true)) then
                local isTarget = S.target == plr

                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, 0, 0, 26)
                btn.BackgroundColor3 = isTarget and C.RowOn or C.Row
                btn.BackgroundTransparency = 0.18
                btn.Text = "  @" .. plr.Name
                btn.TextColor3 = C.White
                btn.TextSize = 11
                btn.Font = Enum.Font.GothamBold
                btn.TextXAlignment = Enum.TextXAlignment.Left
                btn.AutoButtonColor = false
                btn.Parent = container
                corner(btn, 7)

                local s = Instance.new("UIStroke")
                s.Color = isTarget and C.Acc2 or C.Off
                s.Thickness = isTarget and 1.6 or 1
                s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                s.Parent = btn

                btn.Activated:Connect(function()
                    S.target = plr
                    S.camLock = true
                    setCamToggle(true, true)
                    Status.Text = "Objetivo: @" .. plr.Name
                    updatePlayerList()
                    showPage("Funciones")
                end)
            end
        end
    end

    search:GetPropertyChangedSignal("Text"):Connect(function() updatePlayerList() end)
    onTheme(function() updatePlayerList() end)
end

track(Players.PlayerAdded:Connect(function(plr)
    hookPlayer(plr)
    updatePlayerList()
end))

track(Players.PlayerRemoving:Connect(function(plr)
    removeESP(plr)
    if S.target == plr then
        S.target = nil
        S.camLock = false
        setCamToggle(false, true)
        releaseCamLock()
        Status.Text = "El objetivo salió del juego"
    end
    task.defer(updatePlayerList)
end))

