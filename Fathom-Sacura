    for i, opt in ipairs(options) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1 / #options, -8, 0, 22)
        b.Position = UDim2.new((i - 1) / #options, 4, 0, 19)
        b.BackgroundColor3 = opt[2]
