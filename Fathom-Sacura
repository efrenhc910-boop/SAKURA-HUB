local customPending, customBusy = nil, false
local function applyCustom(col)
    customPending = col
    if customBusy then return end
    customBusy = true
    task.delay(0.07, function()
        customBusy = false
        local c = customPending
        if not c then return end
        local h, s, v = c:ToHSV()
        local acc = Color3.fromHSV(h, s, math.max(v, 0.6))
        THEMES.Custom = {
            Acc = acc,
            Acc2 = acc:Lerp(Color3.new(1, 1, 1), 0.4),
            Dark = Color3.fromHSV(h, s * 0.7, 0.09),
            Panel = Color3.fromHSV(h, s * 0.7, 0.14),
            Row = Color3.fromHSV(h, s * 0.7, 0.22),
            Off = Color3.fromHSV(h, s * 0.5, 0.30),
            Tab = Color3.fromHSV(h, s * 0.7, 0.17),
        }
        applyTheme("Custom")
    end)
end

local function createWheel(page, name, callback)
    local R = 46
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -4, 0, 2 * R + 30)
    row.BackgroundTransparency = 0.18
    row.LayoutOrder = nextOrder()
    row.Parent = page
    bind(row, "BackgroundColor3", "Row")
    corner(row, 7)
    stroke(row, "Off", 1)

    mkLabel(row, name, 11, Enum.Font.GothamBold, "White", UDim2.fromOffset(8, 3), UDim2.new(1, -16, 0, 14))

    local wheel = Instance.new("Frame")
    wheel.AnchorPoint = Vector2.new(0.5, 0)
    wheel.Position = UDim2.new(0.5, 0, 0, 22)
    wheel.Size = UDim2.fromOffset(2 * R, 2 * R)
    wheel.BackgroundTransparency = 1
    wheel.Parent = row

    -- Rueda armada con 72 rayos (blanco en el centro → color intenso en el borde)
    local SPOKES = 72
    local spokeH = math.ceil(2 * math.pi * R / SPOKES) + 2
    for i = 0, SPOKES - 1 do
        local hue = i / SPOKES
        local s = Instance.new("Frame")
        s.AnchorPoint = Vector2.new(0.5, 0.5)
        s.Position = UDim2.fromOffset(R, R)
        s.Size = UDim2.fromOffset(2 * R, spokeH)
        s.Rotation = hue * 360
        s.BackgroundColor3 = Color3.new(1, 1, 1)
        s.BorderSizePixel = 0
        s.Parent = wheel

        local g = Instance.new("UIGradient")
        g.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
            ColorSequenceKeypoint.new(0.5, Color3.new(1, 1, 1)),
            ColorSequenceKeypoint.new(1, Color3.fromHSV(hue, 1, 1)),
        })
        g.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.4999, 1),
            NumberSequenceKeypoint.new(0.5, 0),
            NumberSequenceKeypoint.new(1, 0),
        })
        g.Parent = s
    end

    local marker = Instance.new("Frame")
    marker.AnchorPoint = Vector2.new(0.5, 0.5)
    marker.Position = UDim2.fromScale(0.5, 0.5)
    marker.Size = UDim2.fromOffset(12, 12)
    marker.BackgroundTransparency = 1
    marker.ZIndex = 5
    marker.Parent = wheel
    corner(marker, 6)
    local ms = Instance.new("UIStroke")
    ms.Color = Color3.new(1, 1, 1)
    ms.Thickness = 2
    ms.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    ms.Parent = marker

    local hit = Instance.new("TextButton")
    hit.Size = UDim2.fromScale(1, 1)
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.AutoButtonColor = false
    hit.ZIndex = 6
    hit.Parent = wheel

    local function pick(input)
        local size = wheel.AbsoluteSize.X
        if size <= 0 then return end
        local rad = size / 2
        local cx = wheel.AbsolutePosition.X + rad
        local cy = wheel.AbsolutePosition.Y + rad
        local dx, dy = input.Position.X - cx, input.Position.Y - cy
        local dist = math.sqrt(dx * dx + dy * dy)
        local sat = math.clamp(dist / rad, 0, 1)
        local hue = (math.deg(math.atan2(dy, dx)) % 360) / 360

        local k = dist > rad and (rad / dist) or 1
        marker.Position = UDim2.fromScale(0.5 + (dx * k) / size, 0.5 + (dy * k) / size)

        callback(Color3.fromHSV(hue, sat, 1))
    end

    hit.InputBegan:Connect(function(input)
        if isPointer(input) then
            pick(input)
            beginDrag(input, pick)
        end
    end)
end

