        b.TextSize = 10
        b.Font = Enum.Font.GothamBold
        b.AutoButtonColor = false
        b.Parent = row
        corner(b, 6)

        local s = Instance.new("UIStroke")
        s.Color = Color3.new(1, 1, 1)
        s.Thickness = 2
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        s.Parent = b
        items[opt[1]] = s

        b.Activated:Connect(function()
            paint(opt[1])
            callback(opt[1])
        end)
    end
    paint(default)
    return paint
