local C = {
    White = Color3.fromRGB(240, 245, 255),
    Gray = Color3.fromRGB(165, 178, 200),
}

local binds, refreshers, conns = {}, {}, {}
local UI = { led = true, open = true }

local function track(c)
    conns[#conns + 1] = c
    return c
end

local function bind(obj, prop, key)
    binds[#binds + 1] = { obj, prop, key }
    obj[prop] = C[key]
    return obj
end

local function onTheme(fn)
    refreshers[#refreshers + 1] = fn
    fn()
end

local function applyTheme(name)
    local t = THEMES[name]
    if not t then return end
    for k, v in pairs(t) do C[k] = v end
    C.RowOn = t.Row:Lerp(t.Acc, 0.3)
    for i = 1, #binds do
        local b = binds[i]
        pcall(function() b[1][b[2]] = C[b[3]] end)
    end
    for i = 1, #refreshers do pcall(refreshers[i]) end
end
applyTheme("Azul")

