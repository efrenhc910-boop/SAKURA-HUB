local function setToggle(button, enabled)
	if enabled then
		button.Text = "ON"
		button.BackgroundColor3 = Color3.fromRGB(255, 110, 210)
		button.TextColor3 = Color3.fromRGB(255, 255, 255)
	else
		button.Text = "OFF"
		button.BackgroundColor3 = Color3.fromRGB(44, 30, 47)
		button.TextColor3 = Color3.fromRGB(180, 170, 190)
	end
end

