--==================================================

local setFpsBoost
do
    local orig, glob, conn = {}, {}, nil

    local function inCharacter(inst)
        local m = inst:FindFirstAncestorOfClass("Model")
        while m do
            if m:FindFirstChildOfClass("Humanoid") then return true end
            m = m:FindFirstAncestorOfClass("Model")
        end
        return false
    end

    local function boost(inst)
        if not S.boost or orig[inst] then return end
        local saved
        pcall(function()
            if inst:IsA("Terrain") then
                return
            elseif inst:IsA("BasePart") then
                if inCharacter(inst) then return end
                saved = { Material = inst.Material, Reflectance = inst.Reflectance, CastShadow = inst.CastShadow }
                inst.Material = Enum.Material.SmoothPlastic
                inst.Reflectance = 0
                inst.CastShadow = false
                if inst:IsA("MeshPart") then
                    saved.TextureID = inst.TextureID
                    inst.TextureID = ""
                end
            elseif inst:IsA("Decal") then
                if inCharacter(inst) then return end
                saved = { Transparency = inst.Transparency }
                inst.Transparency = 1
            elseif inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Smoke")
                or inst:IsA("Fire") or inst:IsA("Sparkles") or inst:IsA("Beam")
                or inst:IsA("Light") or inst:IsA("PostEffect") then
                saved = { Enabled = inst.Enabled }
                inst.Enabled = false
            elseif inst:IsA("Atmosphere") then
                saved = { Density = inst.Density, Haze = inst.Haze }
                inst.Density = 0
                inst.Haze = 0
            elseif inst:IsA("SurfaceAppearance") then
                saved = { Parent = inst.Parent }
                inst.Parent = nil
            end
        end)
        if saved then orig[inst] = saved end
    end

    local function applyGlobal()
        pcall(function()
            glob.Quality = settings().Rendering.QualityLevel
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)
        pcall(function()
            glob.Shadows = Lighting.GlobalShadows
            Lighting.GlobalShadows = false
        end)
        pcall(function()
            local t = Workspace.Terrain
            glob.Terrain = { WaterWaveSize = t.WaterWaveSize, WaterWaveSpeed = t.WaterWaveSpeed, WaterReflectance = t.WaterReflectance }
            t.WaterWaveSize, t.WaterWaveSpeed, t.WaterReflectance = 0, 0, 0
            glob.Decoration = t.Decoration
            t.Decoration = false
        end)
    end

    local function restoreGlobal()
        pcall(function() if glob.Quality then settings().Rendering.QualityLevel = glob.Quality end end)
        pcall(function() if glob.Shadows ~= nil then Lighting.GlobalShadows = glob.Shadows end end)
        pcall(function()
            if glob.Terrain then
                for k, v in pairs(glob.Terrain) do Workspace.Terrain[k] = v end
            end
            if glob.Decoration ~= nil then Workspace.Terrain.Decoration = glob.Decoration end
        end)
        glob = {}
    end

    setFpsBoost = function(enabled)
        if enabled == S.boost then return end
        S.boost = enabled

        if enabled then
            applyGlobal()
            if conn then conn:Disconnect() end
            conn = Workspace.DescendantAdded:Connect(function(inst)
                if S.boost then task.defer(boost, inst) end
            end)
            task.spawn(function()
                for _, inst in ipairs(Lighting:GetChildren()) do boost(inst) end
                local n = 0
                for _, inst in ipairs(Workspace:GetDescendants()) do
                    if not S.boost then return end
                    boost(inst)
                    n += 1
                    if n % 300 == 0 then task.wait() end
                end
            end)
        else
            if conn then
                conn:Disconnect()
                conn = nil
            end
            for inst, saved in pairs(orig) do
                pcall(function()
                    for prop, value in pairs(saved) do inst[prop] = value end
                end)
            end
            orig = {}
            restoreGlobal()
        end
    end
end

