local TabButtons, Pages, tabOrder = {}, {}, {}
local CurrentPage

local function layoutTabs()
    local n = #tabOrder
    if n == 0 then return end
    local gap = 3
    local w = (TAB_BAR_W - 6 - gap * (n - 1)) / n
    if w < 84 then w = 84 end
    for i, name in ipairs(tabOrder) do
        local b = TabButtons[name]
        b.Size = UDim2.fromOffset(w, 18)
        b.Position = UDim2.fromOffset(3 + (i - 1) * (w + gap), 2)
    end
    TabScroll.CanvasSize = UDim2.fromOffset(6 + n * (w + gap), 0)
end

local function paintTabs(animated)
    for name, b in pairs(TabButtons) do
        local sel = name == CurrentPage
        local col = sel and C.Acc or C.Tab
        local tr = sel and 0.1 or 0.5
        if animated then
            tween(b, { BackgroundColor3 = col, BackgroundTransparency = tr }, 0.18)
        else
            b.BackgroundColor3 = col
            b.BackgroundTransparency = tr
        end
    end
end
onTheme(function() paintTabs(false) end)

local function showPage(name)
    if CurrentPage == name then return end
    CurrentPage = name
    for pageName, page in pairs(Pages) do
        page.Visible = pageName == name
    end
    paintTabs(true)
end

local function createPage(name)
    local page = Instance.new("ScrollingFrame")
    page.Name = name
    page.Size = UDim2.fromScale(1, 1)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 3
    page.CanvasSize = UDim2.new()
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible = false
    page.Parent = Content
    bind(page, "ScrollBarImageColor3", "Acc")

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 6)
    pad.PaddingBottom = UDim.new(0, 6)
    pad.PaddingLeft = UDim.new(0, 6)
    pad.PaddingRight = UDim.new(0, 6)
    pad.Parent = page

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 5)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = page

    Pages[name] = page
    return page
end

local function addTab(name)
    local b = Instance.new("TextButton")
    b.Name = name
    b.Text = name
    b.TextSize = 11
    b.Font = Enum.Font.GothamBold
    b.TextColor3 = C.White
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    b.Parent = TabScroll
    corner(b, 6)
    squish(b)
    TabButtons[name] = b
    tabOrder[#tabOrder + 1] = name
    local page = createPage(name)
    b.Activated:Connect(function() showPage(name) end)
    layoutTabs()
    paintTabs(false)
    return page
end

local function setMenuTransparency(v)
    Main.BackgroundTransparency = v
    Content.BackgroundTransparency = math.min(0.95, v + 0.1)
    TabBar.BackgroundTransparency = math.min(0.95, v)
    Header.BackgroundTransparency = math.min(0.9, 0.1 + v * 0.5)
end

