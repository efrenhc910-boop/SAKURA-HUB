local Lighting = game:GetService("Lighting")

local espEnabled = false
local camLockEnabled = false
local infiniteJumpEnabled = false
local flyEnabled = false
local walkEnabled = false
local ledEnabled = true
local snakeEnabled = true
local fpsBoostEnabled = false
local flySpeed = 60
local walkSpeed = 32
local defaultWalkSpeed = 16
local selectedTarget = nil

local espObjects = {}
local connections = {}

local function track(conn)
    connections[#connections + 1] = conn
    return conn
end

local function getCamera()
    return Workspace.CurrentCamera
end

local function getCharacterParts()
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    return root, hum, char
end

--==================================================
-- ESP (azul neón + nombre / vida / distancia arcoíris)
--==================================================

local NEON_BLUE = Color3.fromRGB(0, 140, 255)
local NEON_BLUE_OUTLINE = Color3.fromRGB(0, 230, 255)

local function removeESP(plr)
    local data = espObjects[plr]
    if data then
        if data.Highlight then data.Highlight:Destroy() end
        if data.Billboard then data.Billboard:Destroy() end
        espObjects[plr] = nil
    end
end

local function clearESP()
    for plr in pairs(espObjects) do
        removeESP(plr)
    end
end

local function applyESP(plr)
    if plr == player then return end
    local char = plr.Character
    if not char then return end
    removeESP(plr)

    local highlight = Instance.new("Highlight")
    highlight.Adornee = char
    highlight.FillColor = NEON_BLUE
    highlight.OutlineColor = NEON_BLUE_OUTLINE
    highlight.FillTransparency = 0.1
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = Workspace

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "EfrenESP"
    billboard.Size = UDim2.fromOffset(150, 44)
    billboard.StudsOffset = Vector3.new(0, 3.2, 0)
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.Adornee = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    billboard.Parent = Workspace

    local text = Instance.new("TextLabel")
    text.Size = UDim2.fromScale(1, 1)
    text.BackgroundTransparency = 1
    text.Font = Enum.Font.GothamBlack
    text.TextSize = 13
    text.TextStrokeTransparency = 0
    text.TextStrokeColor3 = Color3.new(0, 0, 0)
    text.TextColor3 = C.Cyan
    text.Text = plr.Name
    text.Parent = billboard

    espObjects[plr] = {
        Highlight = highlight,
        Billboard = billboard,
        Label = text,
        Character = char
    }
end

local function hookPlayer(plr)
    if plr == player then return end
    plr.CharacterAdded:Connect(function()
        if espEnabled then
            task.wait(1)
            if espEnabled then applyESP(plr) end
        end
    end)
end

for _, plr in ipairs(Players:GetPlayers()) do
    hookPlayer(plr)
end

-- Actualiza texto/colores y se autorepara si alguien resetea
track(RunService.Heartbeat:Connect(function()
    if not espEnabled then return end

    local localRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local t = os.clock()
    local index = 0

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            index += 1
            local char = plr.Character
            local data = espObjects[plr]

            if char and (not data or data.Character ~= char) then
                applyESP(plr)
                data = espObjects[plr]
            end

            if data and char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local root = char:FindFirstChild("HumanoidRootPart")
                local head = char:FindFirstChild("Head") or root

                if head and data.Billboard.Adornee ~= head then
                    data.Billboard.Adornee = head
                end

                local hp, maxHp = 0, 100
                if hum then
                    hp = math.max(0, math.floor(hum.Health + 0.5))
                    maxHp = math.max(1, math.floor(hum.MaxHealth + 0.5))
                end

                local dist = 0
                if root and localRoot then
                    dist = math.floor((root.Position - localRoot.Position).Magnitude + 0.5)
                end

                data.Label.Text = plr.Name .. "\nHP " .. hp .. "/" .. maxHp .. "  •  " .. dist .. "m"
                data.Label.TextColor3 = Color3.fromHSV((t * 0.6 + index * 0.13) % 1, 1, 1)
            end
        end
    end
end))

--==================================================
-- CAM LOCK (cámara + personaje apuntan al objetivo)
--==================================================

local function releaseCamLock()
    local cam = getCamera()
    if cam then cam.CameraType = Enum.CameraType.Custom end
    local _, hum = getCharacterParts()
    if hum then hum.AutoRotate = true end
end

local function updateCamLock()
    if not camLockEnabled or not selectedTarget then return end

    local targetChar = selectedTarget.Character
    local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    local root, hum = getCharacterParts()
    local cam = getCamera()
    if not targetRoot or not root or not cam then return end

    local aimPos = targetRoot.Position + Vector3.new(0, 1.5, 0)

    local flat = Vector3.new(
        targetRoot.Position.X - root.Position.X,
        0,
        targetRoot.Position.Z - root.Position.Z
    )
    if flat.Magnitude < 0.5 then return end
    local dir = flat.Unit

    local camPos = root.Position - dir * 9 + Vector3.new(0, 3.5, 0)
    cam.CameraType = Enum.CameraType.Scriptable
    cam.CFrame = CFrame.lookAt(camPos, aimPos)

    if hum then hum.AutoRotate = false end
    root.CFrame = CFrame.lookAt(root.Position, root.Position + dir)
end

RunService:BindToRenderStep(
    "TargetCamera",
    Enum.RenderPriority.Camera.Value + 1,
    updateCamLock
)

--==================================================
-- FLY
--==================================================

local flyBV

local function stopFly()
    if flyBV then
        flyBV:Destroy()
        flyBV = nil
    end
end

track(RunService.Heartbeat:Connect(function()
    if not flyEnabled then
        if flyBV then stopFly() end
        return
    end

    local root, hum = getCharacterParts()
    local cam = getCamera()
    if not root or not hum or not cam then
        stopFly()
        return
    end

    if not flyBV or flyBV.Parent ~= root then
        stopFly()
        flyBV = Instance.new("BodyVelocity")
        flyBV.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        flyBV.Velocity = Vector3.zero
        flyBV.Parent = root
    end

    local move = hum.MoveDirection
    local velocity = Vector3.zero

    if move.Magnitude > 0.05 then
        local rel = cam.CFrame:VectorToObjectSpace(move)
        local dir = cam.CFrame.LookVector * (-rel.Z)
            + cam.CFrame.RightVector * rel.X
        if dir.Magnitude > 0.01 then
            velocity = dir.Unit * move.Magnitude * flySpeed
        end
    end

    flyBV.Velocity = velocity
end))

--==================================================
-- WALK SPEED
--==================================================

local function setWalkEnabled(value)
    local _, hum = getCharacterParts()
    if value then
        if hum and not walkEnabled then
            defaultWalkSpeed = hum.WalkSpeed
        end
        walkEnabled = true
    else
        if walkEnabled and hum then
            hum.WalkSpeed = defaultWalkSpeed
        end
        walkEnabled = false
    end
end

track(RunService.Heartbeat:Connect(function()
    if not walkEnabled then return end
    local _, hum = getCharacterParts()
    if hum and hum.WalkSpeed ~= walkSpeed then
        hum.WalkSpeed = walkSpeed
    end
end))

--==================================================
-- INFINITE JUMP
--==================================================

track(UserInputService.JumpRequest:Connect(function()
    if infiniteJumpEnabled then
        local _, hum = getCharacterParts()
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end))

--==================================================
-- FPS BOOST (gráficos mínimos, reversible)
--==================================================

local boostOriginals = {}
local boostSettings = {}
local boostConnection

local function isCharacterPart(inst)
    local model = inst:FindFirstAncestorOfClass("Model")
    while model do
        if model:FindFirstChildOfClass("Humanoid") then
            return true
        end
        model = model:FindFirstAncestorOfClass("Model")
    end
    return false
end

local function boostInstance(inst)
    if not fpsBoostEnabled then return end
    if boostOriginals[inst] then return end

    local saved
    pcall(function()
        if inst:IsA("Terrain") then
            return
        elseif inst:IsA("BasePart") then
            if isCharacterPart(inst) then return end
            saved = {
                Material = inst.Material,
                Reflectance = inst.Reflectance,
                CastShadow = inst.CastShadow
            }
            inst.Material = Enum.Material.SmoothPlastic
            inst.Reflectance = 0
            inst.CastShadow = false
            if inst:IsA("MeshPart") then
                saved.TextureID = inst.TextureID
                inst.TextureID = ""
            end
        elseif inst:IsA("Decal") then
            if isCharacterPart(inst) then return end
            saved = { Transparency = inst.Transparency }
            inst.Transparency = 1
        elseif inst:IsA("ParticleEmitter") or inst:IsA("Trail")
            or inst:IsA("Smoke") or inst:IsA("Fire")
            or inst:IsA("Sparkles") or inst:IsA("Beam")
            or inst:IsA("Light") or inst:IsA("PostEffect") then
            saved = { Enabled = inst.Enabled }
            inst.Enabled = false
        elseif inst:IsA("Atmosphere") then
            saved = { Density = inst.Density, Haze = inst.Haze }
            inst.Density = 0
            inst.Haze = 0
        elseif inst:IsA("SurfaceAppearance") then
            saved = { Parent = inst.Parent }
            inst.Parent = nil
        end
    end)

    if saved then
        boostOriginals[inst] = saved
    end
end

local function restoreBoost()
    for inst, saved in pairs(boostOriginals) do
        pcall(function()
            for prop, value in pairs(saved) do
                inst[prop] = value
            end
        end)
    end
    boostOriginals = {}
end

local function applyGlobalBoost()
    pcall(function()
        boostSettings.Quality = settings().Rendering.QualityLevel
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)
    pcall(function()
        boostSettings.GlobalShadows = Lighting.GlobalShadows
        Lighting.GlobalShadows = false
    end)
    pcall(function()
        local terrain = Workspace.Terrain
        boostSettings.Terrain = {
            WaterWaveSize = terrain.WaterWaveSize,
            WaterWaveSpeed = terrain.WaterWaveSpeed,
            WaterReflectance = terrain.WaterReflectance
        }
        terrain.WaterWaveSize = 0
        terrain.WaterWaveSpeed = 0
        terrain.WaterReflectance = 0
    end)
    pcall(function()
        boostSettings.Decoration = Workspace.Terrain.Decoration
        Workspace.Terrain.Decoration = false
    end)
end

local function restoreGlobal()
    pcall(function()
        if boostSettings.Quality then
            settings().Rendering.QualityLevel = boostSettings.Quality
        end
    end)
    pcall(function()
        if boostSettings.GlobalShadows ~= nil then
            Lighting.GlobalShadows = boostSettings.GlobalShadows
        end
    end)
    pcall(function()
        if boostSettings.Terrain then
            for prop, value in pairs(boostSettings.Terrain) do
                Workspace.Terrain[prop] = value
            end
        end
    end)
    pcall(function()
        if boostSettings.Decoration ~= nil then
            Workspace.Terrain.Decoration = boostSettings.Decoration
        end
    end)
    boostSettings = {}
end

local function setFpsBoost(enabled)
    if enabled == fpsBoostEnabled then return end
    fpsBoostEnabled = enabled

    if enabled then
        applyGlobalBoost()

        if boostConnection then boostConnection:Disconnect() end
        boostConnection = Workspace.DescendantAdded:Connect(function(inst)
            if fpsBoostEnabled then
                task.defer(boostInstance, inst)
            end
        end)

        task.spawn(function()
            for _, inst in ipairs(Lighting:GetChildren()) do
                boostInstance(inst)
            end

            local count = 0
            for _, inst in ipairs(Workspace:GetDescendants()) do
                if not fpsBoostEnabled then return end
                boostInstance(inst)
                count += 1
                if count % 300 == 0 then
                    task.wait()
                end
            end
        end)
    else
        if boostConnection then
            boostConnection:Disconnect()
            boostConnection = nil
        end
        restoreBoost()
        restoreGlobal()
    end
end

