		Parent = page,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 20),
		Text = "✦  " .. text,
		TextColor3 = C.Cyan,
		TextSize = 12,
		Font = Enum.Font.GothamBlack,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	return lbl
end

local function createFunctionCard(page, name, desc, callback)
	local card = make("TextButton", {
		Parent = page,
		Size = UDim2.new(1, -8, 0, 48),
		BackgroundColor3 = Color3.fromRGB(18, 31, 49),
		Text = "",
		AutoButtonColor = false,
	})
	round(card, 8)
	local strokeCard = stroke(card, C.Blue, 1)

	local title = make("TextLabel", {
		Parent = card,
		Position = UDim2.fromOffset(10, 6),
		Size = UDim2.new(1, -90, 0, 18),
		BackgroundTransparency = 1,
		Text = name,
		TextColor3 = C.White,
		TextSize = 12,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	local descLabel = make("TextLabel", {
		Parent = card,
		Position = UDim2.fromOffset(10, 25),
		Size = UDim2.new(1, -90, 0, 14),
		BackgroundTransparency = 1,
		Text = desc,
		TextColor3 = C.Gray,
		TextSize = 9,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	local state = make("TextLabel", {
		Parent = card,
		Position = UDim2.new(1, -70, 0.5, -11),
		Size = UDim2.fromOffset(58, 22),
		BackgroundColor3 = Color3.fromRGB(30, 44, 62),
		Text = "OFF",
		TextColor3 = C.White,
		TextSize = 10,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	round(state, 7)

	local active = false

	card.MouseEnter:Connect(function()
		tween(card, { BackgroundColor3 = Color3.fromRGB(24, 47, 77) }, 0.12)
		tween(strokeCard, { Color = C.Cyan }, 0.12)
	end)

	card.MouseLeave:Connect(function()
		tween(card, { BackgroundColor3 = Color3.fromRGB(18, 31, 49) }, 0.14)
		tween(strokeCard, { Color = active and C.Cyan or C.Blue }, 0.14)
	end)

	card.Activated:Connect(function()
		active = not active
		state.Text = active and "ON" or "OFF"

		tween(state, {
			BackgroundColor3 = active and C.Blue or Color3.fromRGB(30, 44, 62),
		}, 0.15)

		tween(strokeCard, {
			Color = active and C.Cyan or C.Blue,
			Thickness = active and 2 or 1,
		}, 0.15)

		if callback then
			callback(active)
		end
	end)

	return card
end

local FuncBtn, FuncStroke = createCategory("Funciones", 1)
local ListBtn, ListStroke = createCategory("Lista", 2)
local ConfigBtn, ConfigStroke = createCategory("Configuracion", 3)

catData["Funciones"] = { Button = FuncBtn, Stroke = FuncStroke }
catData["Lista"] = { Button = ListBtn, Stroke = ListStroke }
catData["Configuracion"] = { Button = ConfigBtn, Stroke = ConfigStroke }

local function showPage(name)
	for key, page in pairs({
		["Funciones"] = FuncPage,
		["Lista"] = ListPage,
		["Configuracion"] = ConfigPage,
	}) do
		page.Visible = key == name
	end
	updateCategoryState(name)
end

FuncBtn.Activated:Connect(function()
	showPage("Funciones")
end)
ListBtn.Activated:Connect(function()
	showPage("Lista")
end)
ConfigBtn.Activated:Connect(function()
	showPage("Configuracion")
end)

