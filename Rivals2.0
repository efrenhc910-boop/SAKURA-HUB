local function createToggleRow(parent, label, y)
	local row = make("Frame", {
		Parent = parent,
		BackgroundColor3 = Color3.fromRGB(44, 30, 47),
		BackgroundTransparency = 0.12,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 12, 0, y),
		Size = UDim2.new(1, -24, 0, 32),
	})
	round(row, 10)

	local textLabel = make("TextLabel", {
		Parent = row,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -90, 1, 0),
		Text = label,
		TextColor3 = Color3.fromRGB(250, 245, 255),
		Font = Enum.Font.GothamSemibold,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	local toggle = make("TextButton", {
		Parent = row,
		BackgroundColor3 = Color3.fromRGB(44, 30, 47),
		BorderSizePixel = 0,
		Position = UDim2.new(1, -72, 0.5, -11),
		Size = UDim2.new(0, 60, 0, 22),
		Text = "OFF",
		TextColor3 = Color3.fromRGB(180, 170, 190),
		Font = Enum.Font.GothamBold,
		TextSize = 10,
		AutoButtonColor = false,
	})
	round(toggle, 12)
	stroke(toggle, Color3.fromRGB(255, 92, 200), 1)

	return row, toggle
end

local espRow, espToggle = createToggleRow(funcsPanel, "ESP Player", 14)
local camRow, camToggle = createToggleRow(funcsPanel, "Cam Lock", 52)
local flyRow, flyToggle = createToggleRow(funcsPanel, "Fly", 90)

local function setToggle(button, enabled)
	if enabled then
		button.Text = "ON"
		button.BackgroundColor3 = Color3.fromRGB(255, 110, 210)
		button.TextColor3 = Color3.fromRGB(255, 255, 255)
	else
		button.Text = "OFF"
		button.BackgroundColor3 = Color3.fromRGB(44, 30, 47)
		button.TextColor3 = Color3.fromRGB(180, 170, 190)
	end
end

local function showPanel(mode)
	if mode == "Funciones" then
		funcsPanel.Visible = true
		listFrame.Visible = false
		funcsTab.BackgroundColor3 = Color3.fromRGB(255, 92, 200)
		funcsTab.TextColor3 = Color3.fromRGB(255, 255, 255)
		listTab.BackgroundColor3 = Color3.fromRGB(44, 30, 47)
		listTab.TextColor3 = Color3.fromRGB(180, 170, 190)
	else
		funcsPanel.Visible = false
		listFrame.Visible = true
		listTab.BackgroundColor3 = Color3.fromRGB(255, 92, 200)
		listTab.TextColor3 = Color3.fromRGB(255, 255, 255)
		funcsTab.BackgroundColor3 = Color3.fromRGB(44, 30, 47)
		funcsTab.TextColor3 = Color3.fromRGB(180, 170, 190)
	end
end

