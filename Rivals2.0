local function refreshPlayerList()
	for _, child in ipairs(listScroll:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local textFilter = string.lower(searchBox.Text or "")
	for _, plr in ipairs(Players:GetPlayers()) do
		if textFilter == "" or string.find(string.lower(plr.Name), textFilter, 1, true) then
			local btn = make("TextButton", {
				Parent = listScroll,
				BackgroundColor3 = Color3.fromRGB(44, 30, 47),
				BorderSizePixel = 0,
				Size = UDim2.new(1, -4, 0, 28),
				Text = plr.Name,
				TextColor3 = Color3.fromRGB(250, 245, 255),
				Font = Enum.Font.GothamSemibold,
				TextSize = 12,
				AutoButtonColor = false,
			})
			round(btn, 8)
			stroke(btn, Color3.fromRGB(255, 92, 200), 1)

			btn.MouseButton1Click:Connect(function()
				selectedTarget = plr
				camLockEnabled = true
				setToggle(camToggle, true)
				Camera.CameraType = Enum.CameraType.Scriptable
				showPanel("Funciones")
			end)
		end
	end
end

searchBox:GetPropertyChangedSignal("Text"):Connect(function()
	refreshPlayerList()
end)

Players.PlayerAdded:Connect(function()
	task.wait(0.1)
	refreshPlayerList()
end)

Players.PlayerRemoving:Connect(function()
	task.wait(0.1)
	refreshPlayerList()
end)

refreshPlayerList()

listToggle.MouseButton1Click:Connect(function()
	listVisible = not listVisible
	setToggle(listToggle, listVisible)

	if listVisible then
		showPanel("Lista")
	else
		showPanel("Funciones")
	end
end)

espToggle.MouseButton1Click:Connect(function()
	espEnabled = not espEnabled
	setToggle(espToggle, espEnabled)

	if espEnabled then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character then
				createESP(plr, plr.Character)
			end
		end
	else
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				removeESP(plr)
			end
		end
	end
end)

camToggle.MouseButton1Click:Connect(function()
	camLockEnabled = not camLockEnabled
	setToggle(camToggle, camLockEnabled)

	if camLockEnabled then
		Camera.CameraType = Enum.CameraType.Scriptable
	else
		selectedTarget = nil
		Camera.CameraType = Enum.CameraType.Custom
	end
end)

