local function createSection(page, text)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 25)
    label.BackgroundTransparency = 1
    label.Text = "✦  " .. text
    label.TextColor3 = C.Cyan
    label.TextSize = 13
    label.Font = Enum.Font.GothamBlack
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = page
    return label
end

--==================================================
-- CREAR BOTONES / TOGGLES
--==================================================

local function createButton(page, name, description, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -5, 0, 51)
    button.BackgroundColor3 = Color3.fromRGB(16, 40, 80)
    button.Text = ""
    button.AutoButtonColor = false
    button.Parent = page
    corner(button, 8)

    local stroke = Instance.new("UIStroke")
    stroke.Color = C.Blue
    stroke.Thickness = 1
    stroke.Parent = button

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -85, 0, 23)
    title.Position = UDim2.fromOffset(12, 4)
    title.BackgroundTransparency = 1
    title.Text = name
    title.TextColor3 = C.White
    title.TextSize = 13
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = button

    local desc = Instance.new("TextLabel")
    desc.Size = UDim2.new(1, -85, 0, 16)
    desc.Position = UDim2.fromOffset(12, 27)
    desc.BackgroundTransparency = 1
    desc.Text = description
    desc.TextColor3 = C.Gray
    desc.TextSize = 10
    desc.Font = Enum.Font.Gotham
    desc.TextXAlignment = Enum.TextXAlignment.Left
    desc.Parent = button

    local state = Instance.new("TextLabel")
    state.Size = UDim2.fromOffset(49, 25)
    state.Position = UDim2.new(1, -62, 0.5, -12)
    state.BackgroundColor3 = Color3.fromRGB(30, 45, 65)
    state.Text = "OFF"
    state.TextColor3 = C.White
    state.TextSize = 10
    state.Font = Enum.Font.GothamBold
    state.Parent = button
    corner(state, 6)

    local enabled = false

    button.MouseEnter:Connect(function()
        tween(button, {
            BackgroundColor3 = Color3.fromRGB(20, 65, 115)
        }, 0.15)
        tween(stroke, {Color = C.Cyan}, 0.15)
    end)

    button.MouseLeave:Connect(function()
        tween(button, {
            BackgroundColor3 = Color3.fromRGB(16, 40, 80)
        }, 0.15)
        tween(stroke, {
            Color = enabled and C.Cyan or C.Blue
        }, 0.15)
    end)

    button.Activated:Connect(function()
        enabled = not enabled

        state.Text = enabled and "ON" or "OFF"

        tween(state, {
            BackgroundColor3 = enabled and C.Blue
                or Color3.fromRGB(30, 45, 65)
        }, 0.2)

        tween(stroke, {
            Color = enabled and C.Cyan or C.Blue,
            Thickness = enabled and 2 or 1
        }, 0.2)

        tween(button, {
            Size = UDim2.new(1, -10, 0, 48)
        }, 0.08)

        task.delay(0.1, function()
            if button.Parent then
                tween(button, {
                    Size = UDim2.new(1, -5, 0, 51)
                }, 0.15)
            end
        end)

        if callback then
            callback(enabled, state)
        end
    end)

    return button, state
end

-- VARIABLES DE FUNCIONALIDAD
local espEnabled = false
local camLockEnabled = false
local infiniteJumpEnabled = false
local selectedTarget = nil
local playerHighlightObjects = {}

-- FUNCTIONS PAGE
createSection(FunctionPage, "FUNCIONES PRINCIPALES")

local _, espToggleState = createButton(FunctionPage, "ESP Player", "Resalta a los jugadores a través de paredes", function(enabled)
    espEnabled = enabled
    if espEnabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character and not playerHighlightObjects[plr] then
                local highlight = Instance.new("Highlight")
                highlight.Adornee = plr.Character
                highlight.FillColor = C.Cyan
                highlight.OutlineColor = C.White
                highlight.FillTransparency = 0.4
                highlight.OutlineTransparency = 0
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                highlight.Parent = Workspace
                playerHighlightObjects[plr] = highlight
            end
        end
    else
        for _, highlight in pairs(playerHighlightObjects) do
            if highlight then highlight:Destroy() end
        end
        playerHighlightObjects = {}
    end
end)

local _, camToggleState = createButton(FunctionPage, "Cam Lock", "Mantiene la cámara fija en el objetivo seleccionado", function(enabled)
    camLockEnabled = enabled
    if camLockEnabled then
        camera.CameraType = Enum.CameraType.Scriptable
    else
        selectedTarget = nil
        camera.CameraType = Enum.CameraType.Custom
    end
end)

createButton(FunctionPage, "Infinite Jump", "Permite saltar sin parar en el aire", function(enabled)
    infiniteJumpEnabled = enabled
end)

UserInputService.JumpRequest:Connect(function()
    if infiniteJumpEnabled then
        local character = player.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end
end)

