-- ==================================================
-- PLAYER LIST
-- ==================================================
local function updatePlayerList()
	for _, child in ipairs(listFrame:GetChildren()) do
		if child:IsA("TextButton") and child.Name == "PlayerButton" then
			child:Destroy()
		end
	end

	local searchQuery = string.lower(listSearch.Text or "")

	for _, plr in ipairs(Players:GetPlayers()) do
		local nameText = plr.Name
		local displayText = plr.DisplayName
		local combined = (nameText .. " " .. displayText):lower()

		if searchQuery == "" or combined:find(searchQuery, 1, true) then
			local btn = make("TextButton", {
				Parent = listFrame,
				Name = "PlayerButton",
				BackgroundColor3 = Color3.fromRGB(44, 30, 47),
				BorderSizePixel = 0,
				Size = UDim2.new(1, -20, 0, 28),
				Text = displayText .. " (" .. nameText .. ")",
				TextColor3 = Color3.fromRGB(250, 245, 255),
				Font = Enum.Font.GothamSemibold,
				TextSize = 12,
				AutoButtonColor = false,
			})
			round(btn, 8)
			stroke(btn, Color3.fromRGB(255, 92, 200), 1)

			btn.MouseButton1Click:Connect(function()
				selectedTarget = plr
				camLockEnabled = true
				setToggle(camToggle, true)
				camera.CameraType = Enum.CameraType.Scriptable
				showPanel("Funciones")
			end)
		end
	end
end

listSearch:GetPropertyChangedSignal("Text"):Connect(function()
	updatePlayerList()
end)

Players.PlayerAdded:Connect(function()
	task.wait(0.1)
	updatePlayerList()
end)

Players.PlayerRemoving:Connect(function()
	task.wait(0.1)
	updatePlayerList()
end)

updatePlayerList()

-- ==================================================
-- ESP
-- ==================================================
local function applyPlayerESP(plr)
	if plr == player then return end
	if playerHighlightObjects[plr] then return end

	local highlight = Instance.new("Highlight")
	highlight.Adornee = plr.Character
	highlight.FillColor = Color3.fromRGB(255, 92, 200)
	highlight.OutlineColor = Color3.fromRGB(255, 145, 230)
	highlight.FillTransparency = 0.4
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = Workspace

	playerHighlightObjects[plr] = highlight
end

local function clearPlayerESP()
	for _, highlight in pairs(playerHighlightObjects) do
		if highlight then highlight:Destroy() end
	end
	playerHighlightObjects = {}
end

espToggle.MouseButton1Click:Connect(function()
	espEnabled = not espEnabled
	setToggle(espToggle, espEnabled)

	if espEnabled then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player and plr.Character then
				applyPlayerESP(plr)
			end
		end
	else
		clearPlayerESP()
	end
end)

camToggle.MouseButton1Click:Connect(function()
	camLockEnabled = not camLockEnabled
	setToggle(camToggle, camLockEnabled)

	if camLockEnabled then
		camera.CameraType = Enum.CameraType.Scriptable
	else
		selectedTarget = nil
		camera.CameraType = Enum.CameraType.Custom
	end
end)

Players.PlayerAdded:Connect(function(plr)
	plr.CharacterAdded:Connect(function()
		if espEnabled and plr ~= player then
			applyPlayerESP(plr)
		end
	end)
end)

local dragStart
local dragStartPos
local dragging = false

topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		dragStartPos = root.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		root.Position = UDim2.new(
			dragStartPos.X.Scale,
			dragStartPos.X.Offset + delta.X,
			dragStartPos.Y.Scale,
			dragStartPos.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

funcsTab.MouseButton1Click:Connect(function()
	showPanel("Funciones")
end)

listTab.MouseButton1Click:Connect(function()
	showPanel("Lista")
end)

-- ==================================================
-- FLY
-- ==================================================
local function updateFly()
	if not flyEnabled then
		return
	end

	local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		return
	end

	local velocity = Vector3.zero
	local moveX = 0
	local moveZ = 0

	if UserInputService:IsKeyDown(Enum.KeyCode.W) then
		moveZ = moveZ - 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then
		moveZ = moveZ + 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then
		moveX = moveX - 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then
		moveX = moveX + 1
	end

	local forward = camera.CFrame.LookVector
	local right = camera.CFrame.RightVector

	forward = Vector3.new(forward.X, 0, forward.Z)
	right = Vector3.new(right.X, 0, right.Z)

	if forward.Magnitude > 0 then
		forward = forward.Unit
	end
	if right.Magnitude > 0 then
		right = right.Unit
	end

	local moveDir = (forward * moveZ + right * moveX)
	if moveDir.Magnitude > 0 then
		moveDir = moveDir.Unit
	end

	velocity = moveDir * flySpeed

	local bodyVelocity = rootPart:FindFirstChild("SakuraFlyVelocity")
	if not bodyVelocity then
		bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.Name = "SakuraFlyVelocity"
		bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bodyVelocity.Parent = rootPart
	end

	bodyVelocity.Velocity = Vector3.new(velocity.X, 0, velocity.Z)
end

flyToggle.MouseButton1Click:Connect(function()
	flyEnabled = not flyEnabled
	setToggle(flyToggle, flyEnabled)

	if flyEnabled then
		local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if rootPart then
			local bodyVelocity = rootPart:FindFirstChild("SakuraFlyVelocity")
			if not bodyVelocity then
				bodyVelocity = Instance.new("BodyVelocity")
				bodyVelocity.Name = "SakuraFlyVelocity"
				bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
				bodyVelocity.Parent = rootPart
			end
			bodyVelocity.Velocity = Vector3.zero
		end
	else
		local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if rootPart then
			local bodyVelocity = rootPart:FindFirstChild("SakuraFlyVelocity")
			if bodyVelocity then
				bodyVelocity:Destroy()
			end
		end
	end
end)

-- ==================================================
-- CAM LOCK
-- ==================================================
local function updateCamera()
	if not camLockEnabled or not selectedTarget then
		return
	end

	local targetCharacter = selectedTarget.Character
	if not targetCharacter then
		return
	end

	local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
	if not targetRoot then
		return
	end

	local playerRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not playerRoot then
		return
	end

	local targetPosition = targetRoot.Position + Vector3.new(0, 2, 0)

	local offset = -(playerRoot.CFrame.LookVector) * 9 + Vector3.new(0, 3.5, 0)
	local cameraPosition = playerRoot.Position + offset

	playerRoot.CFrame = CFrame.lookAt(playerRoot.Position, targetPosition)

	camera.CFrame = CFrame.lookAt(cameraPosition, targetPosition)
end

RunService:BindToRenderStep(
	"TargetCamera",
	Enum.RenderPriority.Camera.Value + 1,
	function()
		updateCamera()
		if flyEnabled then
			updateFly()
		end
	end
)

showPanel("Funciones")