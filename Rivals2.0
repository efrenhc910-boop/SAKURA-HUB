})

local function createCategory(name, order)
	local btn = make("TextButton", {
		Parent = categoryBar,
		Size = UDim2.fromOffset(150, 36),
		BackgroundColor3 = Color3.fromRGB(19, 26, 42),
		Text = name,
		TextColor3 = C.White,
		TextSize = 12,
		Font = Enum.Font.GothamBold,
		AutoButtonColor = false,
	})
	round(btn, 10)
	local s = stroke(btn, C.Blue, 1.2)
	btn.LayoutOrder = order
	return btn, s
end

local catData = {}
local function updateCategoryState(name)
	for key, data in pairs(catData) do
		local selected = key == name
		tween(data.Button, {
			BackgroundColor3 = selected and Color3.fromRGB(37, 110, 255) or Color3.fromRGB(19, 26, 42)
		}, 0.18)
		tween(data.Stroke, {
			Color = selected and C.Cyan or C.Blue,
			Thickness = selected and 2 or 1.2
		}, 0.18)
	end
end

local function createPage(name)
	local page = make("ScrollingFrame", {
		Parent = Main,
		Name = name,
		Position = UDim2.fromOffset(15, 138),
		Size = UDim2.new(1, -30, 1, -150),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(0, 0, 0, 1000),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.Cyan,
		Visible = false,
	})
	local uiLayout = make("UIListLayout", {
		Parent = page,
		Padding = UDim.new(0, 7),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	return page
end

