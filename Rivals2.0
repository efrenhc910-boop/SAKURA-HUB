	Padding = UDim.new(0, 6),
	SortOrder = Enum.SortOrder.LayoutOrder,
})

local function refreshPlayerList()
	for _, child in ipairs(playerList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local query = string.lower((searchBox.Text or ""))

	for _, p in ipairs(Players:GetPlayers()) do
		local searchText = getPlayerSearchText(p)
		local match = query == "" or string.find(searchText, query, 1, true) ~= nil

		if match then
			local btn = make("TextButton", {
				Parent = playerList,
				Size = UDim2.new(1, -6, 0, 30),
				BackgroundColor3 = Color3.fromRGB(20, 30, 48),
				Text = p.DisplayName .. " (" .. p.Name .. ")",
				TextColor3 = C.White,
				TextSize = 12,
				Font = Enum.Font.GothamSemibold,
				AutoButtonColor = false,
			})
			round(btn, 8)
			stroke(btn, Color3.fromRGB(70, 110, 220), 1)

			btn.Activated:Connect(function()
				selectedTarget = p
				camLockEnabled = true
				Camera.CameraType = Enum.CameraType.Scriptable
				showPage("Funciones")
			end)
		end
	end
end

searchBox:GetPropertyChangedSignal("Text"):Connect(refreshPlayerList)
refreshPlayerList()

