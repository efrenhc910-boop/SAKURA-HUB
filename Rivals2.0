local listLayout = Instance.new("UIListLayout")
listLayout.Padding = UDim.new(0, 8)
listLayout.SortOrder = Enum.SortOrder.LayoutOrder
listLayout.Parent = containerList

local function updatePlayerList(filterText)
    filterText = filterText or ""
    filterText = string.lower(filterText)

    for _, child in ipairs(containerList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local username = string.lower(plr.Name)

            if filterText == "" or string.find(username, filterText) then
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, -5, 0, 40)
                btn.BackgroundColor3 = Color3.fromRGB(16, 40, 80)
                btn.Text = "  @" .. plr.Name
                btn.TextColor3 = C.White
                btn.TextSize = 12
                btn.Font = Enum.Font.GothamBold
                btn.TextXAlignment = Enum.TextXAlignment.Left
                btn.AutoButtonColor = false
                btn.Parent = containerList
                corner(btn, 8)

                local stroke = Instance.new("UIStroke")
                stroke.Color = C.Blue
                stroke.Thickness = 1
                stroke.Parent = btn

                btn.MouseButton1Click:Connect(function()
                    selectedTarget = plr
                    camLockEnabled = true
                    camToggleState.Text = "ON"
                    camToggleState.BackgroundColor3 = C.Blue
                    camera.CameraType = Enum.CameraType.Scriptable
                    showPage("Funciones")
                end)
            end
        end
    end
end

searchBar:GetPropertyChangedSignal("Text"):Connect(function()
    updatePlayerList(searchBar.Text)
end)

updatePlayerList()
Players.PlayerAdded:Connect(function()
    updatePlayerList(searchBar.Text)
end)
Players.PlayerRemoving:Connect(function()
    updatePlayerList(searchBar.Text)
end)

