    label.Text = "✦  " .. text
    label.TextColor3 = C.Cyan
    label.TextSize = 11
    label.Font = Enum.Font.GothamBlack
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = page
    return label
end

-- Devuelve: button, state, setEnabled(bool, silent)
local function createButton(page, name, description, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -4, 0, 42)
    button.BackgroundColor3 = C.Row
    button.Text = ""
    button.AutoButtonColor = false
    button.Parent = page
    corner(button, 8)

    local stroke = Instance.new("UIStroke")
    stroke.Color = C.Blue
    stroke.Thickness = 1
    stroke.Parent = button

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -70, 0, 18)
    title.Position = UDim2.fromOffset(10, 4)
    title.BackgroundTransparency = 1
    title.Text = name
    title.TextColor3 = C.White
    title.TextSize = 12
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = button

    local desc = Instance.new("TextLabel")
    desc.Size = UDim2.new(1, -70, 0, 14)
    desc.Position = UDim2.fromOffset(10, 22)
    desc.BackgroundTransparency = 1
    desc.Text = description
    desc.TextColor3 = C.Gray
    desc.TextSize = 9
    desc.Font = Enum.Font.Gotham
    desc.TextXAlignment = Enum.TextXAlignment.Left
    desc.Parent = button

    local state = Instance.new("TextLabel")
    state.Size = UDim2.fromOffset(42, 22)
    state.Position = UDim2.new(1, -52, 0.5, -11)
    state.BackgroundColor3 = C.Off
    state.Text = "OFF"
    state.TextColor3 = C.White
    state.TextSize = 10
    state.Font = Enum.Font.GothamBold
    state.Parent = button
    corner(state, 6)

    local enabled = false

    local function setEnabled(value, silent)
        enabled = value
        state.Text = enabled and "ON" or "OFF"

        tween(state, {
            BackgroundColor3 = enabled and C.Blue or C.Off
        }, 0.2)

        tween(stroke, {
            Color = enabled and C.Cyan or C.Blue,
            Thickness = enabled and 2 or 1
        }, 0.2)

        if callback and not silent then
            callback(enabled, state)
        end
    end

    button.Activated:Connect(function()
        setEnabled(not enabled)
    end)

    return button, state, setEnabled
end

-- Barra deslizante (táctil)
local function createSlider(page, name, min, max, default, fmt, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -4, 0, 52)
    row.BackgroundColor3 = C.Row
    row.Parent = page
    corner(row, 8)

    local stroke = Instance.new("UIStroke")
    stroke.Color = C.Blue
    stroke.Thickness = 1
    stroke.Parent = row

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(0.6, 0, 0, 18)
    title.Position = UDim2.fromOffset(10, 4)
    title.BackgroundTransparency = 1
    title.Text = name
    title.TextColor3 = C.White
    title.TextSize = 12
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = row

    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0.3, 0, 0, 18)
    valueLabel.Position = UDim2.new(0.7, -10, 0, 4)
    valueLabel.BackgroundTransparency = 1
    valueLabel.TextColor3 = C.Cyan
    valueLabel.TextSize = 11
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Parent = row

    -- zona táctil amplia
    local hit = Instance.new("Frame")
    hit.Size = UDim2.new(1, -20, 0, 26)
    hit.Position = UDim2.fromOffset(10, 22)
    hit.BackgroundTransparency = 1
    hit.Parent = row

    local track = Instance.new("Frame")
    track.AnchorPoint = Vector2.new(0, 0.5)
    track.Size = UDim2.new(1, 0, 0, 6)
    track.Position = UDim2.new(0, 0, 0.5, 0)
    track.BackgroundColor3 = C.Off
    track.BorderSizePixel = 0
    track.Parent = hit
    corner(track, 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(0, 1)
    fill.BackgroundColor3 = C.Blue
    fill.BorderSizePixel = 0
    fill.Parent = track
    corner(fill, 3)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(16, 16)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BackgroundColor3 = C.White
    knob.BorderSizePixel = 0
    knob.Parent = track
    corner(knob, 8)

    local function setRatio(r)
        r = math.clamp(r, 0, 1)
        fill.Size = UDim2.fromScale(r, 1)
        knob.Position = UDim2.new(r, 0, 0.5, 0)
        local value = min + (max - min) * r
        valueLabel.Text = fmt(value)
        if callback then callback(value) end
    end

    local sliding = false

    local function updateFromInput(input)
        local width = track.AbsoluteSize.X
        if width <= 0 then return end
        setRatio((input.Position.X - track.AbsolutePosition.X) / width)
    end

    hit.InputBegan:Connect(function(input)
        if isPointer(input) then
            sliding = true
            updateFromInput(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if sliding and isMove(input) then
            updateFromInput(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if isPointer(input) then
            sliding = false
        end
    end)

    setRatio((default - min) / (max - min))
end

