-- Contenedor de Páginas
local ContentArea = Instance.new("Frame")
ContentArea.Name = "ContentArea"
ContentArea.Position = UDim2.fromOffset(10, 96)
ContentArea.Size = UDim2.new(1, -20, 1, -104)
ContentArea.BackgroundColor3 = Theme.Panel
ContentArea.BackgroundTransparency = 0.2
ContentArea.Parent = MainWindow
CreateCorner(ContentArea, 8)

local Pages = {}
local TabButtons = {}
local CurrentPage = nil

local function CreatePage(name)
    local page = Instance.new("ScrollingFrame")
    page.Name = name .. "Page"
    page.Size = UDim2.new(1, -12, 1, -12)
    page.Position = UDim2.fromOffset(6, 6)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 2
    page.ScrollBarImageColor3 = Theme.Cyan
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible = false
    page.Parent = ContentArea

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = page

    Pages[name] = page
    return page
end

local function ShowPage(name)
    CurrentPage = name
    for pageName, page in pairs(Pages) do
        page.Visible = (pageName == name)
    end
    for tabName, btn in pairs(TabButtons) do
        local isSelected = (tabName == name)
        btn.BackgroundColor3 = isSelected and Theme.Secondary or Color3.fromRGB(16, 20, 30)
        btn.TextColor3 = isSelected and Theme.White or Theme.Gray
    end
end

local function CreateTab(name, order)
    local btn = Instance.new("TextButton")
    btn.Name = name .. "Tab"
    btn.Size = UDim2.new(0.31, 0, 0, 24)
    btn.BackgroundColor3 = Color3.fromRGB(16, 20, 30)
    btn.Text = name
    btn.TextColor3 = Theme.Gray
    btn.TextSize = 11
    btn.Font = Enum.Font.GothamBold
    btn.LayoutOrder = order
    btn.Parent = TabsBlock
    CreateCorner(btn, 5)

    TabButtons[name] = btn
    btn.Activated:Connect(function() ShowPage(name) end)
end

-- Componentes UI de Contenido
local function CreateSectionLabel(page, text)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 20)
    label.BackgroundTransparency = 1
    label.Text = "✦ " .. text
    label.TextColor3 = Theme.Cyan
    label.TextSize = 11
    label.Font = Enum.Font.GothamBlack
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = page
    return label
end

local function CreateToggle(page, titleText, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = Color3.fromRGB(15, 20, 32)
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Parent = page
    CreateCorner(btn, 6)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -55, 1, 0)
    lbl.Position = UDim2.fromOffset(10, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = titleText
    lbl.TextColor3 = Theme.White
    lbl.TextSize = 11
    lbl.Font = Enum.Font.GothamBold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = btn

    local stateTag = Instance.new("TextLabel")
    stateTag.Size = UDim2.fromOffset(40, 18)
    stateTag.Position = UDim2.new(1, -46, 0.5, -9)
    stateTag.BackgroundColor3 = Color3.fromRGB(25, 32, 48)
    stateTag.Text = "OFF"
    stateTag.TextColor3 = Theme.Gray
    stateTag.TextSize = 9
    stateTag.Font = Enum.Font.GothamBold
    stateTag.Parent = btn
    CreateCorner(stateTag, 4)

    local enabled = false
    btn.Activated:Connect(function()
        enabled = not enabled
        stateTag.Text = enabled and "ON" or "OFF"
        stateTag.TextColor3 = enabled and Theme.Cyan or Theme.Gray
        stateTag.BackgroundColor3 = enabled and Theme.Secondary or Color3.fromRGB(25, 32, 48)
        if callback then callback(enabled) end
    end)
    return btn
end

