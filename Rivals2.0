SearchBox.PlaceholderColor3 = Theme.Gray
SearchBox.TextSize = 11
SearchBox.Font = Enum.Font.GothamBold
SearchBox.Parent = PlayersPage
CreateCorner(SearchBox, 6)

local ListFrame = Instance.new("Frame")
ListFrame.Size = UDim2.new(1, 0, 0, 0)
ListFrame.BackgroundTransparency = 1
ListFrame.AutomaticSize = Enum.AutomaticSize.Y
ListFrame.Parent = PlayersPage

local ListLayout = Instance.new("UIListLayout")
ListLayout.Padding = UDim.new(0, 4)
ListLayout.Parent = ListFrame

local function RefreshPlayerList(filterText)
    filterText = string.lower(filterText or "")
    for _, child in ipairs(ListFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            if filterText == "" or string.find(string.lower(plr.Name), filterText) then
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, 0, 0, 30)
                btn.BackgroundColor3 = Color3.fromRGB(15, 20, 32)
                btn.Text = "  ⚡ Target: @" .. plr.Name
                btn.TextColor3 = Theme.White
                btn.TextSize = 11
                btn.Font = Enum.Font.GothamBold
                btn.TextXAlignment = Enum.TextXAlignment.Left
                btn.Parent = ListFrame
                CreateCorner(btn, 5)

                btn.Activated:Connect(function()
                    currentTargetPlayer = plr
                    camLockEnabled = true
                    ShowPage("Camera")
                end)
            end
        end
    end
end

Janitor:AddConnection(SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
    RefreshPlayerList(SearchBox.Text)
end))

Janitor:AddConnection(Players.PlayerAdded:Connect(function() RefreshPlayerList(SearchBox.Text) end))
Janitor:AddConnection(Players.PlayerRemoving:Connect(function() RefreshPlayerList(SearchBox.Text) end))

RefreshPlayerList("")
ShowPage("Visuals")

--==================================================
-- 07. CICLO LED Y ARRANQUE SEGURO
--==================================================
task.spawn(function()
    local ledColors = {Theme.Primary, Theme.Secondary, Theme.Cyan}
    local idx = 1
    while ScreenGui.Parent do
        idx = idx % #ledColors + 1
        local col = ledColors[idx]
        local t1 = TweenService:Create(MainStroke, TweenInfo.new(1), {Color = col})
        local t2 = TweenService:Create(FloatStroke, TweenInfo.new(1), {Color = col})
        t1:Play()
        t2:Play()
        task.wait(1)
    end
end)

print("🌸 SAKURA HUB (MASTER EDITION) LOADED SUCCESSFULLY