end)

listTab.MouseButton1Click:Connect(function()
	showPanel("Lista")
end)

-- ==================================================
-- FLY
-- ==================================================
local function stopFly()
	if flyVelocity then
		flyVelocity:Destroy()
		flyVelocity = nil
	end
	if flyGyro then
		flyGyro:Destroy()
		flyGyro = nil
	end
	flyEnabled = false
end

local function startFly()
	if flyEnabled then return end

	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not root then return end

	flyEnabled = true

	flyVelocity = Instance.new("BodyVelocity")
	flyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	flyVelocity.Velocity = Vector3.zero
	flyVelocity.Parent = root

	flyGyro = Instance.new("BodyGyro")
	flyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
	flyGyro.CFrame = root.CFrame
	flyGyro.Parent = root
end

local function updateFly()
	if not flyEnabled then return end

	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not root or not flyVelocity then return end

	local moveVector = Vector3.zero
	local forward = Camera.CFrame.LookVector
	local right = Camera.CFrame.RightVector

	forward = Vector3.new(forward.X, 0, forward.Z)
	right = Vector3.new(right.X, 0, right.Z)

	if forward.Magnitude > 0 then
		forward = forward.Unit
	end
	if right.Magnitude > 0 then
		right = right.Unit
	end

	local keys = UserInputService:GetKeysPressed()
	for _, input in ipairs(keys) do
		local key = input.KeyCode
		if key == Enum.KeyCode.W then
			moveVector += forward
		elseif key == Enum.KeyCode.S then
			moveVector -= forward
		elseif key == Enum.KeyCode.A then
			moveVector -= right
		elseif key == Enum.KeyCode.D then
			moveVector += right
		elseif key == Enum.KeyCode.Space then
			moveVector += Vector3.new(0, 1, 0)
		elseif key == Enum.KeyCode.LeftControl then
			moveVector -= Vector3.new(0, 1, 0)
		end
	end

	local speed = 25
	if moveVector.Magnitude > 0 then
		moveVector = moveVector.Unit * speed
	end

	flyVelocity.Velocity = Vector3.new(moveVector.X, moveVector.Y, moveVector.Z)
end

flyToggle.MouseButton1Click:Connect(function()
	if flyEnabled then
		stopFly()
		setToggle(flyToggle, false)
	else
		startFly()
		setToggle(flyToggle, true)
	end
end)

-- ==================================================
-- CAM LOCK
-- ==================================================
local function updateCamLock()
	if not camLockEnabled or not selectedTarget then return end

	local targetChar = selectedTarget.Character
	if not targetChar then return end

	local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
	local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not targetRoot or not myRoot then return end

	local targetPos = targetRoot.Position + Vector3.new(0, 2, 0)
	local behindOffset = -(myRoot.CFrame.LookVector) * 9 + Vector3.new(0, 3.5, 0)
	local camPos = myRoot.Position + behindOffset

	Camera.CFrame = CFrame.lookAt(camPos, targetPos)
end

local dragStart
local dragStartPos
local dragging = false

topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		dragStartPos = root.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		root.Position = UDim2.new(
			dragStartPos.X.Scale,
			dragStartPos.X.Offset + delta.X,
			dragStartPos.Y.Scale,
			dragStartPos.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

RunService.RenderStepped:Connect(function()
	if flyEnabled then
		updateFly()
	end

	if camLockEnabled then
		updateCamLock()
	end
end)

