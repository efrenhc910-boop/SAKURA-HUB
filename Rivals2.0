--==================================================
-- LÓGICA DE CÁMARA Y ESP CORREGIDA
--==================================================
Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function()
        if espEnabled and plr ~= player then
            task.wait(1)
            if not playerHighlightObjects[plr] then
                local highlight = Instance.new("Highlight")
                highlight.Adornee = plr.Character
                highlight.FillColor = C.Cyan
                highlight.OutlineColor = C.White
                highlight.FillTransparency = 0.4
                highlight.OutlineTransparency = 0
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                highlight.Parent = Workspace
                playerHighlightObjects[plr] = highlight
            end
        end
    end)
end)

local function updateCamera()
    if not camLockEnabled or not selectedTarget then
        return
    end

    local targetCharacter = selectedTarget.Character
    if not targetCharacter then
        return
    end

    local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
    local playerRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    
    if not targetRoot or not playerRoot then
        return
    end

    local targetPosition = targetRoot.Position + Vector3.new(0, 2, 0)
    local offset = -(playerRoot.CFrame.LookVector) * 9 + Vector3.new(0, 3.5, 0)
    local cameraPosition = playerRoot.Position + offset

    camera.CFrame = CFrame.lookAt(cameraPosition, targetPosition)
end

camera.CameraType = Enum.CameraType.Scriptable
RunService:BindToRenderStep("TargetCamera", Enum.RenderPriority.Camera.Value + 1, updateCamera)

--==================================================
-- ANIMATED SAKURA SNAKE
--==================================================

local Snake = Instance.new("Frame")
Snake.Size = UDim2.fromOffset(130, 35)
Snake.Position = UDim2.new(1, -145, 1, -43)
Snake.BackgroundTransparency = 1
Snake.Parent = Main

local Segments = {}

for i = 1, 11 do
    local segment = Instance.new("Frame")
    local size = i == 1 and 12 or math.max(5, 11 - i * 0.45)

    segment.Size = UDim2.fromOffset(size, size)
    segment.AnchorPoint = Vector2.new(0.5, 0.5)
    segment.BackgroundColor3 = i % 2 == 0 and C.Red or C.Cyan
    segment.BorderSizePixel = 0
    segment.Parent = Snake
    corner(segment, 20)

    Segments[i] = segment
end

local snakeRunning = true

task.spawn(function()
    local clock = 0

    while snakeRunning and Screen.Parent do
        clock += 0.10

        for i, segment in ipairs(Segments) do
            local phase = clock - i * 0.48
            local x = 125 - i * 10
            local y = 17 + math.sin(phase) * (i * 0.9)

            segment.Position = UDim2.fromOffset(x, y)
            segment.BackgroundColor3 =
                Color3.fromRGB(
                    255,
                    math.floor(30 + 150 * ((math.sin(clock + i * 0.4) + 1) / 2)),
                    255
                )
        end

        task.wait(0.04)
    end
end)

