----------------------------------------------------
-- A. VISUALS (ESP CON NOMBRES, HP Y DISTANCIA)
----------------------------------------------------
CreateSectionLabel(VisualsPage, "SISTEMA ESP AVANZADO")

local espEnabled = false
local espHighlights = {}
local espBillboards = {}

local function RemoveESP(plr)
    if espHighlights[plr] then
        espHighlights[plr]:Destroy()
        espHighlights[plr] = nil
    end
    if espBillboards[plr] then
        espBillboards[plr]:Destroy()
        espBillboards[plr] = nil
    end
end

local function UpdateESP()
    if not espEnabled then
        for plr, _ in pairs(espHighlights) do RemoveESP(plr) end
        return
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            local head = char:FindFirstChild("Head")

            if root and hum and head and hum.Health > 0 then
                -- Highlight
                if not espHighlights[plr] or espHighlights[plr].Parent ~= char then
                    RemoveESP(plr)
                    local hl = Instance.new("Highlight")
                    hl.FillColor = Theme.Primary
                    hl.OutlineColor = Theme.White
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0
                    hl.Adornee = char
                    hl.Parent = char
                    espHighlights[plr] = hl
                end

                -- BillboardGui (Info completísima)
                if not espBillboards[plr] or espBillboards[plr].Parent ~= head then
                    local bb = Instance.new("BillboardGui")
                    bb.Name = "SakuraEspTag"
                    bb.Adornee = head
                    bb.Size = UDim2.new(0, 120, 0, 40)
                    bb.StudsOffset = Vector3.new(0, 2.2, 0)
                    bb.AlwaysOnTop = true

                    local txt = Instance.new("TextLabel")
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.TextColor3 = Theme.Cyan
                    txt.TextSize = 10
                    txt.Font = Enum.Font.GothamBold
                    txt.TextStrokeTransparency = 0.2
                    txt.Parent = bb
                    bb.Parent = head
                    espBillboards[plr] = bb
                end

                -- Actualización dinámica en tiempo real
                if espBillboards[plr] then
                    local dist = math.floor((root.Position - Camera.CFrame.Position).Magnitude)
                    local hp = math.floor(hum.Health)
                    local maxHp = math.floor(hum.MaxHealth)
                    local label = espBillboards[plr]:FindFirstChildOfClass("TextLabel")
                    if label then
                        label.Text = string.format("@%s\nHP: %d/%d | %dm", plr.Name, hp, maxHp, dist)
                    end
                end
            else
                RemoveESP(plr)
            end
        else
            RemoveESP(plr)
        end
    end
end

Janitor:AddConnection(RunService.RenderStepped:Connect(UpdateESP))
Janitor:AddConnection(Players.PlayerRemoving:Connect(RemoveESP))

CreateToggle(VisualsPage, "ESP Player + HP + Distancia", function(enabled)
    espEnabled = enabled
    if not enabled then
        for plr, _ in pairs(espHighlights) do RemoveESP(plr) end
    end
end)

----------------------------------------------------
-- B. CAMERA (CAM LOCK CON RETARDO CERO)
----------------------------------------------------
CreateSectionLabel(CameraPage, "CÁMARA ESPECTADORA")

local camLockEnabled = false
local currentTargetPlayer = nil

local function ResetCamera()
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            Camera.CameraSubject = hum
            Camera.CameraType = Enum.CameraType.Custom
        end
    end
end

CreateToggle(CameraPage, "Activar Modo Espectador", function(enabled)
    camLockEnabled = enabled
    if not enabled then
        ResetCamera()
    end
end)

Janitor:AddConnection(RunService.RenderStepped:Connect(function()
    if camLockEnabled and currentTargetPlayer and currentTargetPlayer.Character then
        local targetHum = currentTargetPlayer.Character:FindFirstChildOfClass("Humanoid")
        if targetHum and targetHum.Health > 0 then
            Camera.CameraSubject = targetHum
        else
            ResetCamera()
        end
    end
end))

----------------------------------------------------
-- C. MOVEMENT (WALK SPEED, FLY, INFINITE JUMP, NOCLIP)
----------------------------------------------------
CreateSectionLabel(MovementPage, "CONTROLES DE MOVIMIENTO")

-- WalkSpeed
local defaultWalkSpeed = 16
local customSpeed = 16
local speedEnabled = false

local function ApplySpeed()
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = speedEnabled and customSpeed or defaultWalkSpeed
        end
    end
end

CreateToggle(MovementPage, "Modificar Velocidad (32)", function(enabled)
    speedEnabled = enabled
    customSpeed = enabled and 32 or 16
    ApplySpeed()
end)

Janitor:AddConnection(LocalPlayer.CharacterAdded:Connect(function(char)
    char:WaitForChild("Humanoid")
    task.wait(0.2)
    ApplySpeed()
end))

-- Infinite Jump
local infJumpEnabled = false
CreateToggle(MovementPage, "Infinite Jump", function(enabled)
    infJumpEnabled = enabled
end)

Janitor:AddConnection(UserInputService.JumpRequest:Connect(function()
    if infJumpEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end))

-- Noclip
local noclipEnabled = false
CreateToggle(MovementPage, "Noclip (Atravesar Paredes)", function(enabled)
    noclipEnabled = enabled
end)

Janitor:AddConnection(RunService.Stepped:Connect(function()
    if noclipEnabled and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end))

