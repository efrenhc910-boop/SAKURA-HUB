-- ==================================================
-- FLY MÓVIL
-- ==================================================
local function stopFly()
	if flyVelocity then
		flyVelocity:Destroy()
		flyVelocity = nil
	end
	if flyGyro then
		flyGyro:Destroy()
		flyGyro = nil
	end
	flyEnabled = false
end

local function startFly()
	if flyEnabled then return end

	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not root then return end

	flyEnabled = true

	flyVelocity = Instance.new("BodyVelocity")
	flyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	flyVelocity.Velocity = Vector3.zero
	flyVelocity.Parent = root

	flyGyro = Instance.new("BodyGyro")
	flyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
	flyGyro.CFrame = root.CFrame
	flyGyro.Parent = root
end

local function updateFly()
	if not flyEnabled then return end

	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not root or not flyVelocity then return end

	local direction = Vector3.zero

	if UserInputService.TouchEnabled then
		local touchVec = joystickVector
		if touchVec.Magnitude > 0 then
			direction = Vector3.new(touchVec.X, 0, touchVec.Y)
		end
	end

	local speed = 25
	local move = Vector3.zero

	if direction.Magnitude > 0 then
		local facing = Camera.CFrame.LookVector
		local right = Camera.CFrame.RightVector

		local forward = Vector3.new(facing.X, 0, facing.Z)
		local side = Vector3.new(right.X, 0, right.Z)

		if forward.Magnitude > 0 then
			forward = forward.Unit
		end
		if side.Magnitude > 0 then
			side = side.Unit
		end

		-- input.x = horizontal
		-- input.y = vertical
		local x = direction.X
		local y = direction.Y

		local moveDir = (forward * -y + side * x)
		if moveDir.Magnitude > 0 then
			moveDir = moveDir.Unit
		end

		move = moveDir * speed
	end

	flyVelocity.Velocity = Vector3.new(move.X, 0, move.Z)
end

local function setFlyHeight(height)
	if flyEnabled and flyVelocity and LocalPlayer.Character then
		local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if root then
			flyVelocity.Velocity = Vector3.new(flyVelocity.Velocity.X, height, flyVelocity.Velocity.Z)
		end
	end
end

-- ==================================================
-- JOYSTICK MÓVIL
-- ==================================================
local function createMobileJoystick()
	local pad = make("Frame", {
		Parent = Screen,
		BackgroundColor3 = Color3.fromRGB(15, 18, 28),
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 28, 1, -110),
		Size = UDim2.fromOffset(110, 110),
	})
	round(pad, 100)

	local inner = make("Frame", {
		Parent = pad,
		BackgroundColor3 = Color3.fromRGB(255, 92, 200),
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		Position = UDim2.new(0.5, -24, 0.5, -24),
		Size = UDim2.fromOffset(48, 48),
	})
	round(inner, 100)

	pad.Visible = UserInputService.TouchEnabled
	inner.Visible = UserInputService.TouchEnabled

	local padCenter = Vector2.new(55, 55)
	local knobRange = 30

	local function updateJoystick(pos)
		local delta = pos - padCenter
		local dist = math.min(delta.Magnitude, knobRange)
		local angle = math.atan2(delta.Y, delta.X)
		local clamped = Vector2.new(math.cos(angle) * dist, math.sin(angle) * dist)

		inner.Position = UDim2.new(0.5, clamped.X - 24, 0.5, clamped.Y - 24)
		joystickVector = Vector2.new(clamped.X / knobRange, -clamped.Y / knobRange)
	end

	pad.InputBegan:Connect(function(input, gp)
		if not UserInputService.TouchEnabled then return end
		if input.UserInputType == Enum.UserInputType.Touch then
			joystickActive = true
			updateJoystick(input.Position - pad.AbsolutePosition)
		end
	end)

	pad.InputChanged:Connect(function(input, gp)
		if not UserInputService.TouchEnabled then return end
		if input.UserInputType == Enum.UserInputType.Touch and joystickActive then
			updateJoystick(input.Position - pad.AbsolutePosition)
		end
	end)

	pad.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			joystickActive = false
			inner.Position = UDim2.new(0.5, -24, 0.5, -24)
			joystickVector = Vector2.zero
		end
	end)

	return pad, inner
end

-- ==================================================
-- CAM LOCK CORREGIDO
-- ==================================================
local function updateCamLock()
	if not camLockEnabled or not selectedTarget then return end

	local targetCharacter = selectedTarget.Character
	if not targetCharacter then return end

	local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
	local myCharacter = LocalPlayer.Character
	local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
	local myHumanoid = myCharacter and myCharacter:FindFirstChildOfClass("Humanoid")

	if not targetRoot or not myRoot or not myHumanoid then return end

	local targetPos = targetRoot.Position + Vector3.new(0, 2, 0)
	local myPos = myRoot.Position

	myHumanoid.AutoRotate = false
	myRoot.CFrame = CFrame.lookAt(myPos, targetPos)

	local behind = -(myRoot.CFrame.LookVector) * 9
	local camPos = myPos + behind + Vector3.new(0, 3.5, 0)
	Camera.CFrame = CFrame.lookAt(camPos, targetPos)
end

local toggleButton = make("TextButton", {
	Parent = Screen,
	Position = UDim2.new(0, 20, 0.5, -28),
	Size = UDim2.fromOffset(58, 58),
	BackgroundColor3 = C.Dark,
	BackgroundTransparency = 0.12,
	Text = "🌸",
	TextColor3 = C.Red,
	TextSize = 26,
	Font = Enum.Font.GothamBlack,
	AutoButtonColor = false,
})
round(toggleButton, 16)
local toggleStroke = stroke(toggleButton, C.Red, 2)

local dragStart
local dragStartPos
local dragging = false

toggleButton.InputBegan:Connect(function(input)
	if buttonsLocked then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		dragStartPos = toggleButton.Position
	elseif input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		dragStartPos = toggleButton.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		toggleButton.Position = UDim2.new(
			dragStartPos.X.Scale,
			dragStartPos.X.Offset + delta.X,
			dragStartPos.Y.Scale,
			dragStartPos.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

toggleButton.Activated:Connect(function()
	menuOpen = not menuOpen
	Main.Visible = menuOpen
	if menuOpen then
		Main.Size = UDim2.fromOffset(10, 10)
		tween(Main, { Size = UDim2.fromOffset(640, 390) }, 0.22)
	else
		tween(Main, { Size = UDim2.fromOffset(10, 10) }, 0.18)
	end
end)

Close.Activated:Connect(function()
	menuOpen = false
	Main.Visible = false
end)

-- ==================================================
-- FPS OUTSIDE MENU
-- ==================================================
local fpsColors = {
	Color3.fromRGB(255, 80, 130),
	Color3.fromRGB(120, 255, 200),
	Color3.fromRGB(90, 180, 255),
	Color3.fromRGB(255, 200, 80),
	Color3.fromRGB(255, 120, 255),
	Color3.fromRGB(100, 255, 120),
}
local fpsIndex = 0
local fpsTimer = 0

RunService.RenderStepped:Connect(function(dt)
	if dt and dt > 0 then
		local fps = math.floor(1 / dt)
		FPSLabel.Text = "FPS: " .. fps

		fpsTimer += dt
		if fpsTimer >= 1 then
			fpsTimer = 0
			fpsIndex = (fpsIndex + 1) % #fpsColors
			FPSLabel.TextColor3 = fpsColors[fpsIndex + 1]
		end
	end

	if flyEnabled then
		updateFly()
	end

	if camLockEnabled then
		updateCamLock()
	end
end)