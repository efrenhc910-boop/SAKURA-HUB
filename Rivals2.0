local lastTick = os.clock()
local frameCount = 0
Janitor:AddConnection(RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    local currentTick = os.clock()
    if currentTick - lastTick >= 1 then
        FpsWidget.Text = "FPS: " .. tostring(frameCount)
        frameCount = 0
        lastTick = currentTick
    end
end))

