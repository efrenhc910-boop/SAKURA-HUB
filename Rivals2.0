searchBar.BackgroundColor3 = C.Row
searchBar.PlaceholderText = "🔍 Buscar usuario..."
searchBar.Text = ""
searchBar.TextColor3 = C.White
searchBar.PlaceholderColor3 = C.Gray
searchBar.TextSize = 12
searchBar.Font = Enum.Font.GothamBold
searchBar.ClearTextOnFocus = false
searchBar.Parent = ListPage
corner(searchBar, 8)

local searchStroke = Instance.new("UIStroke")
searchStroke.Color = C.Blue
searchStroke.Thickness = 1
searchStroke.Parent = searchBar

createSection(ListPage, "JUGADORES CONECTADOS")

local containerList = Instance.new("Frame")
containerList.Size = UDim2.new(1, 0, 0, 0)
containerList.BackgroundTransparency = 1
containerList.AutomaticSize = Enum.AutomaticSize.Y
containerList.Parent = ListPage

local listLayout = Instance.new("UIListLayout")
listLayout.Padding = UDim.new(0, 6)
listLayout.SortOrder = Enum.SortOrder.LayoutOrder
listLayout.Parent = containerList

local function updatePlayerList(filterText)
    filterText = string.lower(filterText or "")

    for _, child in ipairs(containerList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local username = string.lower(plr.Name)

            if filterText == "" or string.find(username, filterText, 1, true) then
                local isTarget = selectedTarget == plr

                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, -4, 0, 34)
                btn.BackgroundColor3 = isTarget and Color3.fromRGB(20, 65, 115) or C.Row
                btn.Text = "  @" .. plr.Name
                btn.TextColor3 = C.White
                btn.TextSize = 12
                btn.Font = Enum.Font.GothamBold
                btn.TextXAlignment = Enum.TextXAlignment.Left
                btn.AutoButtonColor = false
                btn.Parent = containerList
                corner(btn, 8)

                local stroke = Instance.new("UIStroke")
                stroke.Color = isTarget and C.Cyan or C.Blue
                stroke.Thickness = isTarget and 2 or 1
                stroke.Parent = btn

                btn.Activated:Connect(function()
                    selectedTarget = plr
                    camLockEnabled = true
                    setCamToggle(true, true)
                    Status.Text = "Objetivo: @" .. plr.Name
                    updatePlayerList(searchBar.Text)
                    showPage("Funciones")
                end)
            end
        end
    end
end

searchBar:GetPropertyChangedSignal("Text"):Connect(function()
    updatePlayerList(searchBar.Text)
end)

updatePlayerList()

track(Players.PlayerAdded:Connect(function(plr)
    hookPlayer(plr)
    updatePlayerList(searchBar.Text)
end))

track(Players.PlayerRemoving:Connect(function(plr)
    removeESP(plr)
    if selectedTarget == plr then
        selectedTarget = nil
        camLockEnabled = false
        setCamToggle(false, true)
        releaseCamLock()
        Status.Text = "El objetivo salió del juego"
    end
    task.defer(function()
        updatePlayerList(searchBar.Text)
    end)
end))

