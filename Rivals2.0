--==================================================
-- SERPIENTE SAKURA
--==================================================

local Snake = Instance.new("Frame")
Snake.Size = UDim2.fromOffset(100, 22)
Snake.Position = UDim2.new(1, -112, 1, -26)
Snake.BackgroundTransparency = 1
Snake.Parent = Main

local Segments = {}

for i = 1, 11 do
    local segment = Instance.new("Frame")
    local size = i == 1 and 9 or math.max(3, 8 - i * 0.4)

    segment.Size = UDim2.fromOffset(size, size)
    segment.AnchorPoint = Vector2.new(0.5, 0.5)
    segment.BackgroundColor3 = i % 2 == 0 and C.Red or C.Cyan
    segment.BorderSizePixel = 0
    segment.Parent = Snake
    corner(segment, 20)

    Segments[i] = segment
end

local snakeRunning = true

task.spawn(function()
    local clock = 0

    while snakeRunning and Screen.Parent do
        Snake.Visible = snakeEnabled

        if snakeEnabled then
            clock += 0.10

            for i, segment in ipairs(Segments) do
                local phase = clock - i * 0.48
                local x = 95 - i * 8
                local y = 11 + math.sin(phase) * (i * 0.55)

                segment.Position = UDim2.fromOffset(x, y)
                segment.BackgroundColor3 = Color3.fromRGB(
                    255,
                    math.floor(30 + 150 * ((math.sin(clock + i * 0.4) + 1) / 2)),
                    255
                )
            end
        end

        task.wait(0.04)
    end
end)

--==================================================
-- BOTÓN FLOTANTE 🌸
--==================================================

local Toggle = Instance.new("TextButton")
Toggle.Size = UDim2.fromOffset(46, 46)
Toggle.Position = UDim2.new(0, 20, 0.5, -23)
Toggle.BackgroundColor3 = C.Dark
Toggle.BackgroundTransparency = 0.05
Toggle.Text = "🌸"
Toggle.TextSize = 24
Toggle.Font = Enum.Font.GothamBold
Toggle.ZIndex = 10
Toggle.Parent = Screen
corner(Toggle, 14)

local ToggleStroke = Instance.new("UIStroke")
ToggleStroke.Thickness = 2
ToggleStroke.Color = C.Red
ToggleStroke.Parent = Toggle

local Open = true

local function toggleMenu()
    Open = not Open

    if Open then
        Main.Visible = true
        Main.Size = UDim2.fromOffset(10, 10)
        tween(Main, {Size = UDim2.fromOffset(BASE_W, BASE_H)}, 0.3)
    else
        tween(Main, {Size = UDim2.fromOffset(10, 10)}, 0.2)
        task.delay(0.22, function()
            if not Open then
                Main.Visible = false
            end
        end)
    end
end

Toggle.Activated:Connect(toggleMenu)

Close.Activated:Connect(function()
    if Open then
        toggleMenu()
    end
end)

--==================================================
-- BOTÓN DE FPS (arrastrable, arcoíris neón cada segundo)
--==================================================

local FpsButton = Instance.new("TextButton")
FpsButton.Name = "FpsButton"
FpsButton.Size = UDim2.fromOffset(78, 30)
FpsButton.Position = UDim2.new(0.5, -39, 0, 8)
FpsButton.BackgroundColor3 = C.Dark
FpsButton.BackgroundTransparency = 0.1
FpsButton.Text = "-- FPS"
FpsButton.TextColor3 = C.Cyan
FpsButton.TextSize = 13
FpsButton.Font = Enum.Font.GothamBlack
FpsButton.AutoButtonColor = false
FpsButton.ZIndex = 10
FpsButton.Parent = Screen
corner(FpsButton, 10)

local FpsStroke = Instance.new("UIStroke")
FpsStroke.Thickness = 2
FpsStroke.Color = C.Cyan
FpsStroke.Parent = FpsButton

do
    local fpsDragging = false
    local fpsInput, fpsStart, fpsPos

    FpsButton.InputBegan:Connect(function(input)
        if isPointer(input) then
            fpsDragging = true
            fpsInput = input
            fpsStart = input.Position
            fpsPos = FpsButton.Position
        end
    end)

    track(UserInputService.InputChanged:Connect(function(input)
        if fpsDragging and (input == fpsInput
            or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - fpsStart
            FpsButton.Position = UDim2.new(
                fpsPos.X.Scale, fpsPos.X.Offset + delta.X,
                fpsPos.Y.Scale, fpsPos.Y.Offset + delta.Y
            )
        end
    end))

    track(UserInputService.InputEnded:Connect(function(input)
        if isPointer(input) then
            fpsDragging = false
        end
    end))
end

local frameCount = 0
track(RunService.RenderStepped:Connect(function()
    frameCount += 1
end))

task.spawn(function()
    local hue = 0
    while Screen.Parent do
        task.wait(1)
        local fps = frameCount
        frameCount = 0

        hue = (hue + 0.17) % 1
        local color = Color3.fromHSV(hue, 1, 1)

        FpsButton.Text = fps .. " FPS"
        tween(FpsButton, {TextColor3 = color}, 0.3)
        tween(FpsStroke, {Color = color}, 0.3)
    end
end)

--==================================================
-- LED COLOR CYCLE
--==================================================

local LedColors = {C.Red, C.Blue, C.Cyan}
local colorIndex = 1

task.spawn(function()
    while Screen.Parent do
        if ledEnabled then
            colorIndex = colorIndex % #LedColors + 1
            local nextColor = LedColors[colorIndex]

            tween(MainStroke, {Color = nextColor}, 0.8)
            tween(ToggleStroke, {Color = nextColor}, 0.8)
            tween(TitleStroke, {Color = nextColor}, 0.8)
        end

        task.wait(0.8)
    end
end)

--==================================================
-- CLEANUP
--==================================================

Screen.Destroying:Connect(function()
    snakeRunning = false
    camLockEnabled = false
    flyEnabled = false
    espEnabled = false
    setWalkEnabled(false)
    setFpsBoost(false)
    stopFly()
    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    pcall(function() RunService:UnbindFromRenderStep("TargetCamera") end)
    clearESP()
    releaseCamLock()
end)

