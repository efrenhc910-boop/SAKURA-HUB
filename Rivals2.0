local flySliderTrack = make("TextButton", {
	Parent = flySpeedRow,
	BackgroundColor3 = Color3.fromRGB(30, 22, 34),
	BorderSizePixel = 0,
	Position = UDim2.new(0, 12, 0.5, -7),
	Size = UDim2.new(1, -90, 0, 14),
	Text = "",
	AutoButtonColor = false,
})
round(flySliderTrack, 10)
stroke(flySliderTrack, Color3.fromRGB(255, 92, 200), 1)

local flySliderFill = make("Frame", {
	Parent = flySliderTrack,
	BackgroundColor3 = Color3.fromRGB(255, 92, 200),
	BorderSizePixel = 0,
	Position = UDim2.new(0, 0, 0, 0),
	Size = UDim2.new(flySpeed / 50, 0, 1, 0),
})
round(flySliderFill, 10)

local function updateFlySpeedVisual()
	local pct = math.clamp(flySpeed / 50, 0, 1)
	flySliderFill.Size = UDim2.new(pct, 0, 1, 0)
	flySpeedValue.Text = tostring(flySpeed)
end

local function setFlySpeedFromPosition(xPos)
	local trackMin = flySliderTrack.AbsolutePosition.X
	local trackMax = trackMin + flySliderTrack.AbsoluteSize.X
	local pct = (xPos - trackMin) / math.max(trackMax - trackMin, 1)
	pct = math.clamp(pct, 0, 1)
	flySpeed = math.floor(pct * 50) + 1
	if flySpeed > 50 then flySpeed = 50 end
	if flySpeed < 1 then flySpeed = 1 end
	updateFlySpeedVisual()
end

flySliderTrack.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		flySpeedDragging = true
		setFlySpeedFromPosition(input.Position.X)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if flySpeedDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		setFlySpeedFromPosition(input.Position.X)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		flySpeedDragging = false
	end
end)

updateFlySpeedVisual()

