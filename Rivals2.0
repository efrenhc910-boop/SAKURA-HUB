		Parent = sidebar,
		BackgroundColor3 = selected and Color3.fromRGB(255, 92, 200) or Color3.fromRGB(44, 30, 47),
		BorderSizePixel = 0,
		Position = UDim2.new(0, 9, 0, y),
		Size = UDim2.new(1, -18, 0, 42),
		Text = label,
		TextColor3 = selected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 170, 190),
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		AutoButtonColor = false,
	})
	round(btn, 10)
	stroke(btn, Color3.fromRGB(255, 92, 200), selected and 2 or 1)
	return btn
end

