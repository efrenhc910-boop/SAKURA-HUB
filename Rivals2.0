	buttonsLocked = active
end)

local function stopFly()
	if flyVelocity then
		flyVelocity:Destroy()
		flyVelocity = nil
	end
	if flyGyro then
		flyGyro:Destroy()
		flyGyro = nil
	end
	flyEnabled = false
end

local function startFly()
	if flyEnabled then return end
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not root then return end

	flyEnabled = true

	flyVelocity = Instance.new("BodyVelocity")
	flyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	flyVelocity.Velocity = Vector3.zero
	flyVelocity.Parent = root

	flyGyro = Instance.new("BodyGyro")
	flyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
	flyGyro.CFrame = root.CFrame
	flyGyro.Parent = root
end

local function updateFly()
	if not flyEnabled then return end

	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not root or not flyVelocity then return end

	local moveVector = Vector3.zero
	local forward = Camera.CFrame.LookVector
	local right = Camera.CFrame.RightVector

	forward = Vector3.new(forward.X, 0, forward.Z)
	right = Vector3.new(right.X, 0, right.Z)

	if forward.Magnitude > 0 then
		forward = forward.Unit
	end
	if right.Magnitude > 0 then
		right = right.Unit
	end

	for _, input in ipairs(UserInputService:GetKeysPressed()) do
		local key = input.KeyCode
		if key == Enum.KeyCode.W then
			moveVector += forward
		elseif key == Enum.KeyCode.S then
			moveVector -= forward
		elseif key == Enum.KeyCode.A then
			moveVector -= right
		elseif key == Enum.KeyCode.D then
			moveVector += right
		elseif key == Enum.KeyCode.Space then
			moveVector += Vector3.new(0, 1, 0)
		elseif key == Enum.KeyCode.LeftControl then
			moveVector -= Vector3.new(0, 1, 0)
		end
	end

	local speed = 25
	if moveVector.Magnitude > 0 then
		moveVector = moveVector.Unit * speed
	end

	flyVelocity.Velocity = Vector3.new(moveVector.X, moveVector.Y, moveVector.Z)
end

local function updateCamLock()
	if not camLockEnabled or not selectedTarget then return end

	local targetCharacter = selectedTarget.Character
	if not targetCharacter then return end

	local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
	local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

	if not targetRoot or not myRoot then return end

	local targetPos = targetRoot.Position + Vector3.new(0, 2, 0)
	local myPos = myRoot.Position

	myRoot.CFrame = CFrame.lookAt(myPos, targetPos)

	local offset = -(myRoot.CFrame.LookVector) * 9 + Vector3.new(0, 3.5, 0)
	local camPos = myPos + offset

	Camera.CFrame = CFrame.lookAt(camPos, targetPos)
end

local toggleButton = make("TextButton", {
	Parent = Screen,
	Position = UDim2.new(0, 20, 0.5, -28),
	Size = UDim2.fromOffset(58, 58),
	BackgroundColor3 = C.Dark,
	BackgroundTransparency = 0.12,
	Text = "🌸",
	TextColor3 = C.Red,
	TextSize = 26,
	Font = Enum.Font.GothamBlack,
	AutoButtonColor = false,
})
round(toggleButton, 16)
local toggleStroke = stroke(toggleButton, C.Red, 2)

local dragStart
local dragStartPos
local dragging = false

toggleButton.InputBegan:Connect(function(input)
	if buttonsLocked then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		dragStartPos = toggleButton.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		toggleButton.Position = UDim2.new(
			dragStartPos.X.Scale,
			dragStartPos.X.Offset + delta.X,
			dragStartPos.Y.Scale,
			dragStartPos.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

toggleButton.Activated:Connect(function()
	Main.Visible = not Main.Visible
	if Main.Visible then
		Main.Size = UDim2.fromOffset(10, 10)
		tween(Main, { Size = UDim2.fromOffset(660, 390) }, 0.22)
	else
		tween(Main, { Size = UDim2.fromOffset(10, 10) }, 0.18)
	end
end)

Close.Activated:Connect(function()
	Main.Visible = false
end)

local fpsColors = {
	Color3.fromRGB(255, 80, 130),
	Color3.fromRGB(120, 255, 200),
	Color3.fromRGB(90, 180, 255),
	Color3.fromRGB(255, 200, 80),
	Color3.fromRGB(255, 120, 255),
	Color3.fromRGB(100, 255, 120),
}
local fpsIndex = 0
local fpsTimer = 0

RunService.RenderStepped:Connect(function(dt)
	if dt and dt > 0 then
		local fps = math.floor(1 / dt)
		FpsLabel.Text = "FPS: " .. fps

		fpsTimer += dt
		if fpsTimer >= 1 then
			fpsTimer = 0
			fpsIndex = (fpsIndex + 1) % #fpsColors
			FpsLabel.TextColor3 = fpsColors[fpsIndex + 1]
		end
	end

	if flyEnabled then
		updateFly()
	end

	if camLockEnabled then
		updateCamLock()
	end
end)

showPage("Funciones")

print("Sakura Hub cargado")