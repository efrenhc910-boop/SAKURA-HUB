    desc.Font = Enum.Font.Gotham
    desc.TextXAlignment = Enum.TextXAlignment.Left
    desc.Parent = button

    local state = Instance.new("TextLabel")
    state.Size = UDim2.fromOffset(42, 22)
    state.Position = UDim2.new(1, -52, 0.5, -11)
    state.BackgroundColor3 = C.Off
    state.Text = "OFF"
    state.TextColor3 = C.White
    state.TextSize = 10
    state.Font = Enum.Font.GothamBold
    state.Parent = button
    corner(state, 6)

    local enabled = false

    local function setEnabled(value, silent)
        enabled = value
        state.Text = enabled and "ON" or "OFF"

        tween(state, {
            BackgroundColor3 = enabled and C.Blue or C.Off
        }, 0.2)

        tween(stroke, {
            Color = enabled and C.Cyan or C.Blue,
            Thickness = enabled and 2 or 1
        }, 0.2)

        if callback and not silent then
            callback(enabled, state)
        end
    end

    button.Activated:Connect(function()
        setEnabled(not enabled)
    end)

    return button, state, setEnabled
end

