local function createChoice(page, name, options, default, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -4, 0, 46)
    row.BackgroundTransparency = 0.18
    row.LayoutOrder = nextOrder()
    row.Parent = page
