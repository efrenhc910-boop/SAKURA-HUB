    mkLabel(row, name, 11, Enum.Font.GothamBold, "White", UDim2.fromOffset(8, 3), UDim2.new(1, -16, 0, 14))

    local items = {}
    local function paint(sel)
        for key, it in pairs(items) do
            it.Transparency = (key == sel) and 0 or 1
        end
    end

    for i, opt in ipairs(options) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1 / #options, -8, 0, 22)
        b.Position = UDim2.new((i - 1) / #options, 4, 0, 19)
        b.BackgroundColor3 = opt[2]
        b.Text = opt[1]
        b.TextColor3 = Color3.new(1, 1, 1)
        b.TextSize = 10
        b.Font = Enum.Font.GothamBold
        b.AutoButtonColor = false
        b.Parent = row
        corner(b, 6)

        local s = Instance.new("UIStroke")
        s.Color = Color3.new(1, 1, 1)
        s.Thickness = 2
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        s.Parent = b
        items[opt[1]] = s

        b.Activated:Connect(function()
            paint(opt[1])
            callback(opt[1])
        end)
    end
    paint(default)
end

