local function createButton(parent, name, description, callback)
    local row = Instance.new("TextButton")
    row.Size = UDim2.new(1, -4, 0, 30)
    row.BackgroundTransparency = 0.18
    row.Text = ""
    row.AutoButtonColor = false
    row.LayoutOrder = nextOrder()
    row.Parent = parent
    corner(row, 7)
    local st = stroke(row, nil, 1)

    mkLabel(row, name, 11, Enum.Font.GothamBold, "White", UDim2.fromOffset(8, 3), UDim2.new(1, -46, 0, 13))
    local desc = mkLabel(row, description, 8, Enum.Font.Gotham, "Gray", UDim2.fromOffset(8, 16), UDim2.new(1, -46, 0, 11))
    desc.TextTruncate = Enum.TextTruncate.AtEnd

    local state = Instance.new("TextLabel")
    state.Size = UDim2.fromOffset(30, 14)
    state.Position = UDim2.new(1, -36, 0.5, -7)
    state.TextColor3 = C.White
    state.TextSize = 9
    state.Font = Enum.Font.GothamBold
    state.Parent = row
    corner(state, 5)

    local enabled = false
    local function paint()
        row.BackgroundColor3 = enabled and C.RowOn or C.Row
        st.Color = enabled and C.Acc2 or C.Off
        st.Thickness = enabled and 1.6 or 1
        state.BackgroundColor3 = enabled and C.Acc or C.Off
        state.Text = enabled and "ON" or "OFF"
    end
    onTheme(paint)

    local function setEnabled(value, silent)
        enabled = value
        paint()
        if callback and not silent then callback(enabled) end
    end

    row.Activated:Connect(function() setEnabled(not enabled) end)
    return row, setEnabled
end

local function createSlider(page, name, min, max, default, fmt, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -4, 0, 38)
    row.BackgroundTransparency = 0.18
    row.LayoutOrder = nextOrder()
    row.Parent = page
    bind(row, "BackgroundColor3", "Row")
    corner(row, 7)
    stroke(row, "Off", 1)

    mkLabel(row, name, 11, Enum.Font.GothamBold, "White", UDim2.fromOffset(8, 2), UDim2.new(0.6, 0, 0, 15))
    local valueLabel = mkLabel(row, "", 10, Enum.Font.GothamBold, "Acc2",
        UDim2.new(0.6, 0, 0, 2), UDim2.new(0.4, -8, 0, 15), Enum.TextXAlignment.Right)

    local hit = Instance.new("Frame")
    hit.Size = UDim2.new(1, -16, 0, 20)
    hit.Position = UDim2.fromOffset(8, 17)
    hit.BackgroundTransparency = 1
    hit.Parent = row

    local bar = Instance.new("Frame")
    bar.AnchorPoint = Vector2.new(0, 0.5)
    bar.Size = UDim2.new(1, 0, 0, 5)
    bar.Position = UDim2.fromScale(0, 0.5)
    bar.BorderSizePixel = 0
    bar.Parent = hit
    bind(bar, "BackgroundColor3", "Off")
    corner(bar, 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(0, 1)
    fill.BorderSizePixel = 0
    fill.Parent = bar
    bind(fill, "BackgroundColor3", "Acc")
    corner(fill, 3)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(13, 13)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BorderSizePixel = 0
    knob.Parent = bar
    bind(knob, "BackgroundColor3", "White")
    corner(knob, 7)

    local function setRatio(r)
        r = math.clamp(r, 0, 1)
        fill.Size = UDim2.fromScale(r, 1)
        knob.Position = UDim2.fromScale(r, 0.5)
        local value = min + (max - min) * r
        valueLabel.Text = fmt(value)
        if callback then callback(value) end
    end

    local function fromInput(input)
        local w = bar.AbsoluteSize.X
        if w > 0 then
            setRatio((input.Position.X - bar.AbsolutePosition.X) / w)
        end
    end

    hit.InputBegan:Connect(function(input)
        if isPointer(input) then
            fromInput(input)
            beginDrag(input, fromInput)
        end
    end)

    setRatio((default - min) / (max - min))
end

