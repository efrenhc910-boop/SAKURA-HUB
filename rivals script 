local function createSlider(page, name, min, max, default, fmt, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -4, 0, 52)
    row.BackgroundColor3 = C.Row
    row.Parent = page
    corner(row, 8)

    local stroke = Instance.new("UIStroke")
    stroke.Color = C.Blue
    stroke.Thickness = 1
    stroke.Parent = row

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(0.6, 0, 0, 18)
    title.Position = UDim2.fromOffset(10, 4)
    title.BackgroundTransparency = 1
    title.Text = name
    title.TextColor3 = C.White
    title.TextSize = 12
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = row

    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0.3, 0, 0, 18)
    valueLabel.Position = UDim2.new(0.7, -10, 0, 4)
    valueLabel.BackgroundTransparency = 1
    valueLabel.TextColor3 = C.Cyan
    valueLabel.TextSize = 11
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Parent = row

    -- zona táctil amplia
    local hit = Instance.new("Frame")
    hit.Size = UDim2.new(1, -20, 0, 26)
    hit.Position = UDim2.fromOffset(10, 22)
    hit.BackgroundTransparency = 1
    hit.Parent = row

    local track = Instance.new("Frame")
    track.AnchorPoint = Vector2.new(0, 0.5)
    track.Size = UDim2.new(1, 0, 0, 6)
    track.Position = UDim2.new(0, 0, 0.5, 0)
    track.BackgroundColor3 = C.Off
    track.BorderSizePixel = 0
    track.Parent = hit
    corner(track, 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(0, 1)
    fill.BackgroundColor3 = C.Blue
    fill.BorderSizePixel = 0
    fill.Parent = track
    corner(fill, 3)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(16, 16)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BackgroundColor3 = C.White
    knob.BorderSizePixel = 0
    knob.Parent = track
    corner(knob, 8)

    local function setRatio(r)
        r = math.clamp(r, 0, 1)
        fill.Size = UDim2.fromScale(r, 1)
        knob.Position = UDim2.new(r, 0, 0.5, 0)
        local value = min + (max - min) * r
        valueLabel.Text = fmt(value)
        if callback then callback(value) end
    end

    local sliding = false

    local function updateFromInput(input)
        local width = track.AbsoluteSize.X
        if width <= 0 then return end
        setRatio((input.Position.X - track.AbsolutePosition.X) / width)
    end

    hit.InputBegan:Connect(function(input)
        if isPointer(input) then
            sliding = true
            updateFromInput(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if sliding and isMove(input) then
            updateFromInput(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if isPointer(input) then
            sliding = false
        end
    end)

    setRatio((default - min) / (max - min))
end

