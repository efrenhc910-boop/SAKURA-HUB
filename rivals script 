local function toggleMenu()
    Open = not Open

    if Open then
        Main.Visible = true
        Main.Size = UDim2.fromOffset(10, 10)
        tween(Main, {Size = UDim2.fromOffset(BASE_W, BASE_H)}, 0.3)
    else
        tween(Main, {Size = UDim2.fromOffset(10, 10)}, 0.2)
        task.delay(0.22, function()
            if not Open then
                Main.Visible = false
            end
        end)
    end
end

