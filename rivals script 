local function tween(obj, props, time)
    local t = TweenService:Create(obj, TweenInfo.new(time or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function corner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = obj
    return c
end

local function stroke(obj, key, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = obj
    if key then bind(s, "Color", key) end
    return s
end

local function mkLabel(parent, text, size, font, key, pos, sz, alignX)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextSize = size
    l.Font = font
    l.TextXAlignment = alignX or Enum.TextXAlignment.Left
    if pos then l.Position = pos end
    if sz then l.Size = sz end
    l.Parent = parent
    bind(l, "TextColor3", key)
    return l
end

local function isPointer(input)
    return input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1
end

local orderN = 0
local function nextOrder()
    orderN += 1
    return orderN
end

-- Un solo controlador de arrastre para todo (menos conexiones = menos lag)
local activeDrag, activeInput
local function beginDrag(input, handler)
    activeDrag, activeInput = handler, input
end
track(UserInputService.InputChanged:Connect(function(input)
    if activeDrag and (input == activeInput
        or input.UserInputType == Enum.UserInputType.MouseMovement) then
        activeDrag(input)
    end
end))
track(UserInputService.InputEnded:Connect(function(input)
    if activeDrag and (input == activeInput
        or input.UserInputType == Enum.UserInputType.MouseButton1) then
        activeDrag, activeInput = nil, nil
    end
end))

