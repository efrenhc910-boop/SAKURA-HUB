--==================================================
-- CAM LOCK (cámara + personaje apuntan al objetivo)
--==================================================

local function releaseCamLock()
    local cam = getCamera()
    if cam then cam.CameraType = Enum.CameraType.Custom end
    local _, hum = getCharacterParts()
    if hum then hum.AutoRotate = true end
end

local function updateCamLock()
    if not camLockEnabled or not selectedTarget then return end

    local targetChar = selectedTarget.Character
    local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    local root, hum = getCharacterParts()
    local cam = getCamera()
    if not targetRoot or not root or not cam then return end

    local aimPos = targetRoot.Position + Vector3.new(0, 1.5, 0)

    -- dirección horizontal hacia el objetivo
    local flat = Vector3.new(
        targetRoot.Position.X - root.Position.X,
        0,
        targetRoot.Position.Z - root.Position.Z
    )
    if flat.Magnitude < 0.5 then return end
    local dir = flat.Unit

    -- cámara detrás de ti, en línea hacia el objetivo
    local camPos = root.Position - dir * 9 + Vector3.new(0, 3.5, 0)
    cam.CameraType = Enum.CameraType.Scriptable
    cam.CFrame = CFrame.lookAt(camPos, aimPos)

    -- personaje (y lo que sostiene) gira hacia el objetivo
    if hum then hum.AutoRotate = false end
    root.CFrame = CFrame.lookAt(root.Position, root.Position + dir)
end

RunService:BindToRenderStep(
    "TargetCamera",
    Enum.RenderPriority.Camera.Value + 1,
    updateCamLock
)

--==================================================
-- FLY (joystick + dirección de la cámara)
--==================================================

local flyBV

local function stopFly()
    if flyBV then
        flyBV:Destroy()
        flyBV = nil
    end
end

RunService.Heartbeat:Connect(function()
    if not flyEnabled then
        if flyBV then stopFly() end
        return
    end

    local root, hum = getCharacterParts()
    local cam = getCamera()
    if not root or not hum or not cam then
        stopFly()
        return
    end

    if not flyBV or flyBV.Parent ~= root then
        stopFly()
        flyBV = Instance.new("BodyVelocity")
        flyBV.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        flyBV.Velocity = Vector3.zero
        flyBV.Parent = root
    end

    local move = hum.MoveDirection
    local velocity = Vector3.zero

    if move.Magnitude > 0.05 then
        local rel = cam.CFrame:VectorToObjectSpace(move)
        local dir = cam.CFrame.LookVector * (-rel.Z)
            + cam.CFrame.RightVector * rel.X
        if dir.Magnitude > 0.01 then
            velocity = dir.Unit * move.Magnitude * flySpeed
        end
    end

    flyBV.Velocity = velocity
end)

