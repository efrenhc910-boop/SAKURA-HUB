--==================================================
-- CREAR BOTONES / TOGGLES
--==================================================

local function createButton(page, name, description, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -5, 0, 51)
    button.BackgroundColor3 = Color3.fromRGB(16, 40, 80)
    button.Text = ""
    button.AutoButtonColor = false
    button.Parent = page
    corner(button, 8)

    local stroke = Instance.new("UIStroke")
    stroke.Color = C.Blue
    stroke.Thickness = 1
    stroke.Parent = button

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -85, 0, 23)
    title.Position = UDim2.fromOffset(12, 4)
    title.BackgroundTransparency = 1
    title.Text = name
    title.TextColor3 = C.White
    title.TextSize = 13
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = button

    local desc = Instance.new("TextLabel")
    desc.Size = UDim2.new(1, -85, 0, 16)
    desc.Position = UDim2.fromOffset(12, 27)
    desc.BackgroundTransparency = 1
    desc.Text = description
    desc.TextColor3 = C.Gray
    desc.TextSize = 10
    desc.Font = Enum.Font.Gotham
    desc.TextXAlignment = Enum.TextXAlignment.Left
    desc.Parent = button

    local state = Instance.new("TextLabel")
    state.Size = UDim2.fromOffset(49, 25)
    state.Position = UDim2.new(1, -62, 0.5, -12)
    state.BackgroundColor3 = Color3.fromRGB(30, 45, 65)
    state.Text = "OFF"
    state.TextColor3 = C.White
    state.TextSize = 10
    state.Font = Enum.Font.GothamBold
    state.Parent = button
    corner(state, 6)

    local enabled = false

    -- Cambia el estado visual (y lógico) del botón
    local function setEnabled(value)
        enabled = value

        state.Text = enabled and "ON" or "OFF"

        tween(state, {
            BackgroundColor3 = enabled and C.Blue
                or Color3.fromRGB(30, 45, 65)
        }, 0.2)

        tween(stroke, {
            Color = enabled and C.Cyan or C.Blue,
            Thickness = enabled and 2 or 1
        }, 0.2)
    end

    button.MouseEnter:Connect(function()
        tween(button, {
            BackgroundColor3 = Color3.fromRGB(20, 65, 115)
        }, 0.15)
        tween(stroke, {Color = C.Cyan}, 0.15)
    end)

    button.MouseLeave:Connect(function()
        tween(button, {
            BackgroundColor3 = Color3.fromRGB(16, 40, 80)
        }, 0.15)
        tween(stroke, {
            Color = enabled and C.Cyan or C.Blue
        }, 0.15)
    end)

    button.Activated:Connect(function()
        setEnabled(not enabled)

        tween(button, {
            Size = UDim2.new(1, -10, 0, 48)
        }, 0.08)

        task.delay(0.1, function()
            if button.Parent then
                tween(button, {
                    Size = UDim2.new(1, -5, 0, 51)
                }, 0.15)
            end
        end)

        if callback then
            callback(enabled, state)
        end
    end)

    return button, state, setEnabled
end

