    bs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    bs.Parent = bar

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(1, 1)
    fill.BackgroundColor3 = Color3.new(1, 1, 1)
    fill.BorderSizePixel = 0
    fill.Parent = bar
    corner(fill, 4)

    local grad = Instance.new("UIGradient")
    grad.Color = ESP.ok
    grad.Parent = fill

    for i = 1, 3 do
        local tk = Instance.new("Frame")
        tk.Size = UDim2.new(0, 1, 1, 0)
        tk.Position = UDim2.fromScale(i / 4, 0)
        tk.BackgroundColor3 = Color3.new(0, 0, 0)
        tk.BackgroundTransparency = 0.45
        tk.BorderSizePixel = 0
        tk.ZIndex = 2
        tk.Parent = bar
    end

    local hpL = espText(bar, 9, Enum.Font.GothamBlack, Color3.new(1, 1, 1), UDim2.new(), UDim2.fromScale(1, 1))
    hpL.ZIndex = 3
    hpL.TextStrokeTransparency = 0.1

    local distL = espText(bb, 9, Enum.Font.GothamMedium, Color3.fromRGB(150, 200, 255),
        UDim2.fromOffset(0, 31), UDim2.new(1, 0, 0, 12))

    espObjects[plr] = {
        hl = hl, bb = bb, fill = fill, grad = grad, hpL = hpL, distL = distL,
        char = char, hp = -1, mx = -1, dist = -1, low = false,
    }
end

local function hookPlayer(plr)
    if plr == player then return end
    plr.CharacterAdded:Connect(function()
        if S.esp then
            task.wait(1)
            if S.esp then applyESP(plr) end
        end
    end)
end

do
    local acc = 0
    track(RunService.Heartbeat:Connect(function(dt)
        if not S.esp then return end
        acc += dt
        if acc < 0.1 then return end
        acc = 0

        local lr = player.Character and player.Character:FindFirstChild("HumanoidRootPart")

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then
                local char = plr.Character
                local d = espObjects[plr]

                if char and (not d or d.char ~= char) then
                    applyESP(plr)
                    d = espObjects[plr]
                end

                if d and char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local root = char:FindFirstChild("HumanoidRootPart")
                    local head = char:FindFirstChild("Head") or root
                    if head and d.bb.Adornee ~= head then d.bb.Adornee = head end

                    local hp, mx = 0, 100
                    if hum then
                        hp = math.max(0, math.floor(hum.Health + 0.5))
                        mx = math.max(1, math.floor(hum.MaxHealth + 0.5))
                    end

                    if d.hp ~= hp or d.mx ~= mx then
                        d.hp, d.mx = hp, mx
                        local ratio = math.clamp(hp / mx, 0, 1)
                        d.fill.Size = UDim2.fromScale(ratio, 1)
                        d.hpL.Text = "♥ " .. hp .. "/" .. mx
                        local low = ratio < 0.3
                        if d.low ~= low then
                            d.low = low
                            d.grad.Color = low and ESP.low or ESP.ok
                        end
                    end

                    local dist = (root and lr) and math.floor((root.Position - lr.Position).Magnitude + 0.5) or 0
                    if d.dist ~= dist then
                        d.dist = dist
                        d.distL.Text = dist .. " m"
                    end
                end
            end
        end
    end))
end

for _, plr in ipairs(Players:GetPlayers()) do
    hookPlayer(plr)
end

