local cancelBtn

local function showCancel()
	if not cancelBtn then
		cancelBtn = new("TextButton", {
			Size = UDim2.fromOffset(96, 30),
			Position = UDim2.new(1, -108, 0.5, 120),
			BackgroundColor3 = T.Bad,
			BorderSizePixel = 0,
			Text = "DEJAR DE SEGUIR",
			TextColor3 = Color3.new(1, 1, 1),
			Font = Enum.Font.GothamBold,
			TextSize = 9,
			AutoButtonColor = false,
			ZIndex = 9,
		}, gui)
		corner(cancelBtn, 8)
		stroke(cancelBtn, Color3.new(1, 1, 1), 1, 0.5)
		squish(cancelBtn)
		reg(cancelBtn.MouseButton1Click:Connect(function() stopTP() end))
	end
	cancelBtn.Visible = true
end

function stopTP()
	CFG.TPFollow = false
	CFG.TPTarget = nil
	if cancelBtn then cancelBtn.Visible = false end
end

function tpTo(p)
	local myRoot = root()
	local tRoot = p and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot or not tRoot then return end
	myRoot.CFrame = CFrame.new(tRoot.Position + Vector3.new(0, 1, 0))
	CFG.TPTarget = p
	showCancel()
end

--_______________________
-- TP: paso
-------------------------
local tpAcc = 0
local function tpStep(dt)
	if not CFG.TPFollow or not CFG.TPTarget then return end
	local p = CFG.TPTarget
	if not alive(p) then stopTP() return end

	tpAcc += dt
	if tpAcc < 0.12 then return end
	tpAcc = 0

	local myRoot = root()
	local tRoot = p.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot or not tRoot then return end

	local target = tRoot.Position - tRoot.CFrame.LookVector * CFG.TPOffset + Vector3.new(0, 1, 0)
	if (myRoot.Position - target).Magnitude > 2 then
		myRoot.CFrame = myRoot.CFrame:Lerp(CFrame.new(target, target + tRoot.CFrame.LookVector), 0.6)
	end
end

--_______________________
-- FPS y rendimiento
-------------------------
local frames, fpsAcc, fpsVal = 0, 0, 60
local lowStreak = 0

reg(RunService.RenderStepped:Connect(function(dt)
	frames += 1
	fpsAcc += dt
	if fpsAcc >= 0.5 then
		fpsVal = math.floor(frames / fpsAcc)
		frames, fpsAcc = 0, 0
		if CFG.FPS then
			fpsLbl.Text = fpsVal .. " FPS"
			fpsLbl.TextColor3 = fpsVal >= 45 and T.Accent or (fpsVal >= 28 and Color3.fromRGB(255, 200, 70) or T.Bad)
		end
		if not CFG.PerfMode then
			if fpsVal < 26 then
				lowStreak += 1
				if lowStreak >= 4 then
					CFG.PerfMode = true
					applyPerf()
				end
			else
				lowStreak = 0
			end
		end
	end
end))

local espT = 0.12
local wallT = 1.5

function applyPerf()
	espT = CFG.PerfMode and 0.4 or 0.12
	wallT = CFG.PerfMode and 4 or 1.5
	Lighting.GlobalShadows = not CFG.PerfMode
end

--_______________________
-- Bucle maestro
-------------------------
local accEsp, accWall = 0, 0

reg(RunService.Heartbeat:Connect(function(dt)
	if not win.Visible then return end

	accEsp += dt
	if accEsp >= espT then
		accEsp = 0
		if CFG.ESP then espStep() elseif next(espObjs) then clearESP() end
	end

	accWall += dt
	if accWall >= wallT then
		accWall = 0
		if CFG.Walls then wallSweep() end
	end

	tpStep(dt)
	circleStep(dt)
end))

