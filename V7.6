--_______________________
-- Utilidades
-------------------------
local Reg = { conns = {}, insts = {} }
local function reg(c) Reg.conns[#Reg.conns + 1] = c return c end

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then o[k] = v end
	end
	if parent then o.Parent = parent end
	return o
end

local function corner(o, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 6) }, o)
end

local function stroke(o, c, th, trans)
	return new("UIStroke", {
		Color = c or T.Stroke,
		Thickness = th or 1,
		Transparency = trans or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, o)
end

local function grad(o, c1, c2, rot)
	return new("UIGradient", {
		Color = ColorSequence.new(c1, c2),
		Rotation = rot or 90,
	}, o)
end

local function pad(o, n)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, n), PaddingBottom = UDim.new(0, n),
		PaddingLeft = UDim.new(0, n), PaddingRight = UDim.new(0, n),
	}, o)
end

local function tween(o, t, props, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function squish(btn)
	local base = btn.Size
	local function scale(m)
		tween(btn, 0.09, {
			Size = UDim2.new(base.X.Scale * m, base.X.Offset * m, base.Y.Scale * m, base.Y.Offset * m),
		}, Enum.EasingStyle.Quad)
	end
	reg(btn.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			scale(0.95)
		end
	end))
	reg(btn.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			scale(1)
		end
	end))
end

