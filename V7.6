--_______________________
-- Botón con estado
-------------------------
local function button(parent, text, cb, style)
	local b = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = style == "on" and T.Accent2 or T.Panel2,
		BorderSizePixel = 0,
		Text = text,
		TextColor3 = style == "on" and Color3.new(1, 1, 1) or T.Text,
		Font = Enum.Font.GothamMedium,
		TextSize = 11,
		AutoButtonColor = false,
	}, parent)
	corner(b, 6)
	local s = stroke(b, style == "on" and T.Accent or T.Stroke, 1, style == "on" and 0.3 or 0.5)
	squish(b)
	local state = style == "on" and true or false

	local function paint(v)
		state = v
		tween(b, 0.14, { BackgroundColor3 = v and T.Accent2 or T.Panel2 })
		s.Color = v and T.Accent or T.Stroke
		s.Transparency = v and 0.3 or 0.5
		b.TextColor3 = v and Color3.new(1, 1, 1) or T.Text
	end

	reg(b.MouseButton1Click:Connect(function()
		paint(not state)
		if cb then cb(state) end
	end))

	b.set = paint
	b.get = function() return state end
	return b
end

--_______________________
-- Deslizador
-------------------------
local function slider(parent, text, min, max, def, suffix, cb)
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = T.Panel2,
		BorderSizePixel = 0,
	}, parent)
	corner(row, 6)
	stroke(row, T.Stroke, 1, 0.55)

	new("TextLabel", {
		Size = UDim2.new(0.6, 0, 0, 14),
		Position = UDim2.fromOffset(8, 3),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = T.Text,
		Font = Enum.Font.Gotham,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)

	local val = new("TextLabel", {
		Size = UDim2.new(0.35, -10, 0, 14),
		Position = UDim2.new(0.65, 0, 0, 3),
		BackgroundTransparency = 1,
		Text = tostring(def) .. (suffix or ""),
		TextColor3 = T.Accent,
		Font = Enum.Font.GothamBold,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, row)

	local track = new("Frame", {
		Size = UDim2.new(1, -16, 0, 4),
		Position = UDim2.new(0, 8, 0, 23),
		BackgroundColor3 = T.Off,
		BorderSizePixel = 0,
	}, row)
	corner(track, 2)

	local fill = new("Frame", {
		Size = UDim2.new((def - min) / (max - min), 0, 1, 0),
		BackgroundColor3 = T.Accent,
		BorderSizePixel = 0,
	}, track)
	corner(fill, 2)
	grad(fill, T.Accent, T.Accent2, 0)

	local knob = new("Frame", {
		Size = UDim2.fromOffset(8, 8),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		BackgroundColor3 = T.Text,
		BorderSizePixel = 0,
	}, fill)
	corner(knob, 4)
	stroke(knob, T.Accent, 1.5)

	local v = def
	local function set(n)
		v = math.clamp(n, min, max)
		fill.Size = UDim2.new((v - min) / (max - min), 0, 1, 0)
		val.Text = tostring(math.floor(v + 0.5)) .. (suffix or "")
		if cb then cb(v) end
	end

	local dragging = false
	local function fromX(x)
		local rel = (x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
		set(min + (max - min) * math.clamp(rel, 0, 1))
	end

	reg(track.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fromX(i.Position.X)
		end
	end))
	reg(UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			fromX(i.Position.X)
		end
	end))
	reg(UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))

	row.set = set
	return row
end

