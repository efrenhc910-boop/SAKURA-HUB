local espObjs = {}

local function killESP(p)
	local o = espObjs[p]
	if not o then return end
	espObjs[p] = nil
	for _, inst in pairs(o) do
		if typeof(inst) == "Instance" then pcall(function() inst:Destroy() end) end
	end
end

function clearESP()
	for p in pairs(espObjs) do killESP(p) end
end

