				Font = Enum.Font.GothamBlack,
				TextSize = 15,
				AutoButtonColor = false,
				ZIndex = 10,
			}, gui)
			corner(miniBtn, 23)
			stroke(miniBtn, T.Accent, 1.4, 0.3)
