--_______________________
-- ESP: paso
-------------------------
local function espStep()
	local myRoot = root()
	if not myRoot then clearESP() return end
	local myPos = myRoot.Position
	local seen = {}
	local cands = {}

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and alive(p) then
			local c = p.Character
			local hrp = c:FindFirstChild("HumanoidRootPart")
			local d = (hrp.Position - myPos).Magnitude
			if d <= CFG.ESPDist then
				local ally = p.Team == LP.Team
				if CFG.ESPTeam or not ally then
					cands[#cands + 1] = { p = p, d = d, c = c, hrp = hrp }
				end
			end
		end
	end

	table.sort(cands, function(a, b) return a.d < b.d end)
	if #cands > 8 then
		for i = 9, #cands do cands[i] = nil end
	end

	for _, e in ipairs(cands) do
		seen[e.p] = true
		local o = espObjs[e.p]
		if not o then
			buildESP(e.p, e.c, e.hrp)
			o = espObjs[e.p]
		end
		if o then
			o.name.Visible = CFG.ESPName
			o.fill.Parent.Visible = CFG.ESPHealth
			o.dist.Text = math.floor(e.d) .. " m"
			o.hl.Enabled = CFG.ESPBox
		end
	end

	for p in pairs(espObjs) do
		if not seen[p] then killESP(p) end
	end
end

--_______________________
-- Paredes: caché persistente
-------------------------
local wallMap = setmetatable({}, { __mode = "k" })

local function isCharacterPart(part)
	local m = part:FindFirstAncestorOfClass("Model")
	while m do
		if Players:GetPlayerFromCharacter(m) then return true end
		m = m:FindFirstAncestorOfClass("Model")
	end
	return false
end

local function applyWallPart(part, myPos)
	if not CFG.Walls then return end
	if wallMap[part] then return end
	if part.Transparency >= 0.98 then return end
	if part:IsA("Terrain") then return end
	if isCharacterPart(part) then return end
	if (part.Position - myPos).Magnitude > CFG.WallsDist then return end
	wallMap[part] = part.LocalTransparencyModifier
	part.LocalTransparencyModifier = 0.72
end

local function wallSweep()
	local myRoot = root()
	if not myRoot then return end
	local myPos = myRoot.Position
	for _, d in ipairs(WS:GetDescendants()) do
		if d:IsA("BasePart") then
			applyWallPart(d, myPos)
		end
	end
end

local function flushWalls()
	for part, orig in pairs(wallMap) do
		pcall(function() part.LocalTransparencyModifier = orig end)
		wallMap[part] = nil
	end
	if CFG.Walls then wallSweep() end
end

local function restoreWalls()
	CFG.Walls = false
	for part, orig in pairs(wallMap) do
		pcall(function() part.LocalTransparencyModifier = orig or 0 end)
		wallMap[part] = nil
	end
end

