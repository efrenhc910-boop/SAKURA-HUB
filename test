-- ==================================================
-- SLIDER
-- ==================================================
local function createSliderRow(parent, label, y, minValue, maxValue, defaultValue, callback)
	local row = make("Frame", {
		Parent = parent,
		BackgroundColor3 = theme.Card,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 12, 0, y),
		Size = UDim2.new(1, -24, 0, 62),
	})
	round(row, 10)

	local info = make("TextLabel", {
		Parent = row,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 14, 0, 6),
		Size = UDim2.new(1, -64, 0, 18),
		Text = label,
		TextColor3 = theme.Text,
		Font = Enum.Font.GothamSemibold,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	local valueText = make("TextLabel", {
		Parent = row,
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -66, 0, 8),
		Size = UDim2.new(0, 50, 0, 18),
		Text = tostring(defaultValue),
		TextColor3 = theme.Accent,
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	local track = make("Frame", {
		Parent = row,
		BackgroundColor3 = theme.Background,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 14, 0, 36),
		Size = UDim2.new(1, -28, 0, 5),
	})
	round(track, 3)

	local fill = make("Frame", {
		Parent = track,
		BackgroundColor3 = theme.Accent,
		BorderSizePixel = 0,
		Size = UDim2.new((defaultValue - minValue) / (maxValue - minValue), 0, 1, 0),
	})
	round(fill, 3)

	local knob = make("Frame", {
		Parent = track,
		BackgroundColor3 = theme.Text,
		BorderSizePixel = 0,
		Position = UDim2.new((defaultValue - minValue) / (maxValue - minValue), -6, 0.5, -6),
		Size = UDim2.new(0, 12, 0, 12),
	})
	round(knob, 12)

	local dragging = false
	local function updateSlider(inputX)
		local rel = math.clamp((inputX - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local mapped = minValue + (maxValue - minValue) * rel
		local val = math.floor(mapped + 0.5)
		valueText.Text = tostring(val)
		fill.Size = UDim2.new(rel, 0, 1, 0)
		knob.Position = UDim2.new(rel, -6, 0.5, -6)
		if callback then callback(val) end
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateSlider(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateSlider(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	return row
end

