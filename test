local function setOpen(v)
    if v == UI.open then return end
    UI.open = v
    Float.Text = v and "✕" or "🌸"
    if v then
        Main.Position = HOME
        MenuScale.Scale = UI.size * 0.8
        Main.Visible = true
        tween(MenuScale, { Scale = UI.size }, 0.28, Enum.EasingStyle.Back)
    else
        tween(MenuScale, { Scale = UI.size * 0.8 }, 0.15)
        task.delay(0.17, function()
            if not UI.open then Main.Visible = false end
        end)
    end
end

Close.Activated:Connect(function() setOpen(false) end)

-- El botón flotante se arrastra; un toque corto abre/cierra
do
    local moved = false
    Float.InputBegan:Connect(function(input)
        if isPointer(input) then
            moved = false
            local startPos, startMouse = Float.Position, input.Position
            tween(Float, { Size = UDim2.fromOffset(38, 38) }, 0.07)
            beginDrag(input, function(i)
                local d = i.Position - startMouse
                if d.Magnitude > 8 then moved = true end
                if moved then
                    Float.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
                end
            end)
        end
    end)
    Float.InputEnded:Connect(function(input)
        if isPointer(input) then
            tween(Float, { Size = UDim2.fromOffset(44, 44) }, 0.16, Enum.EasingStyle.Back)
            if not moved then setOpen(not UI.open) end
        end
    end)
end

--==================================================
-- ANIMACIÓN CENTRAL (una sola conexión, 15 veces por segundo)
--==================================================

do
    local clock, acc = 0, 0
    track(RunService.Heartbeat:Connect(function(dt)
        acc += dt
        if acc < 1 / 15 then return end
        clock += acc
        acc = 0
        if UI.open and UI.anim then
            MainGrad.Rotation = (clock * 50) % 360
            GlowGrad.Offset = Vector2.new(math.sin(clock * 1.5) * 0.45, 0)
        end
    end))
end

