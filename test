local function createToggle(parent, name, desc, cb)
    local row = Instance.new("TextButton")
    row.Size = UDim2.new(1, -4, 0, 30)
    row.BackgroundTransparency = 0.15
    row.Text = ""
    row.AutoButtonColor = false
    row.LayoutOrder = nextOrder()
    row.Parent = parent
    corner(row, 8)
    local st = stroke(row, nil, 1)
    squish(row)

    mkLabel(row, name, 11, Enum.Font.GothamBold, "Text", UDim2.fromOffset(8, 3), UDim2.new(1, -50, 0, 13))
    local d = mkLabel(row, desc, 8, Enum.Font.Gotham, "Dim", UDim2.fromOffset(8, 16), UDim2.new(1, -50, 0, 11))
    d.TextTruncate = Enum.TextTruncate.AtEnd

    local track_ = Instance.new("Frame")
    track_.Size = UDim2.fromOffset(30, 14)
    track_.Position = UDim2.new(1, -38, 0.5, -7)
    track_.BorderSizePixel = 0
    track_.Parent = row
    corner(track_, 7)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(10, 10)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    knob.Parent = track_
    corner(knob, 5)

    local on = false
    local function paint(animated)
        local targets = {
            { row, { BackgroundColor3 = on and T.On or T.Card } },
            { st, { Color = on and T.Accent2 or T.Off, Thickness = on and 1.6 or 1 } },
            { track_, { BackgroundColor3 = on and T.Accent or T.Off } },
            { knob, { Position = on and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5) } },
        }
        for _, t in ipairs(targets) do
            if animated then
                tween(t[1], t[2], 0.18)
            else
                for k, v in pairs(t[2]) do t[1][k] = v end
            end
        end
    end
    onTheme(function() paint(false) end)

    local api = {}
    function api.Set(v, silent)
        on = v
        paint(true)
        if cb and not silent then cb(on) end
    end
    row.Activated:Connect(function() api.Set(not on) end)
    return api
end

local function createSlider(page, name, min, max, default, fmt, cb)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -4, 0, 38)
    row.BackgroundTransparency = 0.15
    row.LayoutOrder = nextOrder()
    row.Parent = page
    bind(row, "BackgroundColor3", "Card")
    corner(row, 8)
    stroke(row, "Off", 1)

    mkLabel(row, name, 11, Enum.Font.GothamBold, "Text", UDim2.fromOffset(8, 2), UDim2.new(0.6, 0, 0, 15))
    local valueLabel = mkLabel(row, "", 10, Enum.Font.GothamBold, "Accent2",
        UDim2.new(0.6, 0, 0, 2), UDim2.new(0.4, -8, 0, 15), Enum.TextXAlignment.Right)

    local hit = Instance.new("Frame")
    hit.Size = UDim2.new(1, -16, 0, 20)
    hit.Position = UDim2.fromOffset(8, 17)
    hit.BackgroundTransparency = 1
    hit.Parent = row

    local bar = Instance.new("Frame")
    bar.AnchorPoint = Vector2.new(0, 0.5)
    bar.Size = UDim2.new(1, 0, 0, 5)
    bar.Position = UDim2.fromScale(0, 0.5)
    bar.BorderSizePixel = 0
    bar.Parent = hit
    bind(bar, "BackgroundColor3", "Off")
    corner(bar, 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(0, 1)
    fill.BorderSizePixel = 0
    fill.Parent = bar
    bind(fill, "BackgroundColor3", "Accent")
    corner(fill, 3)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(13, 13)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BorderSizePixel = 0
    knob.Parent = bar
    bind(knob, "BackgroundColor3", "Text")
    corner(knob, 7)

    local function setRatio(r)
        r = math.clamp(r, 0, 1)
        fill.Size = UDim2.fromScale(r, 1)
        knob.Position = UDim2.fromScale(r, 0.5)
        local value = min + (max - min) * r
        valueLabel.Text = fmt(value)
        if cb then cb(value) end
    end

    local function fromInput(input)
        local w = bar.AbsoluteSize.X
        if w > 0 then setRatio((input.Position.X - bar.AbsolutePosition.X) / w) end
    end

    hit.InputBegan:Connect(function(input)
        if isPointer(input) then
            fromInput(input)
            beginDrag(input, fromInput)
        end
    end)

    setRatio((default - min) / (max - min))
end

