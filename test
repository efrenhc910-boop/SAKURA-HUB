local T = {}
local binds, painters, conns = {}, {}, {}

local function track(c)
    conns[#conns + 1] = c
    return c
end

local function bind(obj, prop, key)
    binds[#binds + 1] = { obj, prop, key }
    obj[prop] = T[key]
    return obj
end

local function onTheme(fn)
    painters[#painters + 1] = fn
    fn()
end

local function applyTheme(name)
    local p = PRESETS[name]
    if not p then return end
    for k, v in pairs(p) do T[k] = v end
    T.On = p.Card:Lerp(p.Accent, 0.35)
    T.Off = p.Card:Lerp(Color3.new(1, 1, 1), 0.07)
    for i = 1, #binds do
        local b = binds[i]
        pcall(function() b[1][b[2]] = T[b[3]] end)
    end
    for i = 1, #painters do pcall(painters[i]) end
end
applyTheme("Rosa")

