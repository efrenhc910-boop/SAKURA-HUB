		label = label,
		distLabel = distLabel,
		rootPart = rootPart,
	}
end

local function clearFathomESP()
	for plr, v in pairs(fathomESPObjects) do
		if v.highlight then v.highlight:Destroy() end
		if v.billboard then v.billboard:Destroy() end
		fathomESPObjects[plr] = nil
