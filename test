local function updateFathomESP()
	for plr, v in pairs(fathomESPObjects) do
		if plr and plr.Character and v.rootPart and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local dist = math.floor((player.Character.HumanoidRootPart.Position - v.rootPart.Position).Magnitude)
			v.distLabel.Text = tostring(dist) .. " studs"
		end
	end
end

