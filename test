local function createChoice(page, name, options, default, cb)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -4, 0, 46)
    row.BackgroundTransparency = 0.15
    row.LayoutOrder = nextOrder()
    row.Parent = page
    bind(row, "BackgroundColor3", "Card")
    corner(row, 8)
    stroke(row, "Off", 1)

    mkLabel(row, name, 11, Enum.Font.GothamBold, "Text", UDim2.fromOffset(8, 3), UDim2.new(1, -16, 0, 14))

    local rings = {}
    local function select(key)
        for k, s in pairs(rings) do
            tween(s, { Transparency = (k == key) and 0 or 1 }, 0.15)
        end
    end

    for i, opt in ipairs(options) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1 / #options, -6, 0, 22)
        b.Position = UDim2.new((i - 1) / #options, 3, 0, 19)
        b.BackgroundColor3 = opt[2]
        b.Text = opt[1]
        b.TextColor3 = Color3.new(1, 1, 1)
        b.TextSize = 10
        b.Font = Enum.Font.GothamBold
        b.AutoButtonColor = false
        b.Parent = row
        corner(b, 6)
        squish(b)

        local s = Instance.new("UIStroke")
        s.Color = Color3.new(1, 1, 1)
        s.Thickness = 2
        s.Transparency = 1
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        s.Parent = b
        rings[opt[1]] = s

        b.Activated:Connect(function()
            select(opt[1])
            cb(opt[1])
        end)
    end
    rings[default].Transparency = 0
end

