-- ESTADO Y ESP (NPCs "grins" y jugadores)
--==================================================

local S = { esp = false, espP = false, full = false, noclip = false, walk = false, walkSpeed = 32, defWalk = 16 }

local function getParts()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid")
end

local keywords = { "grins", "worth", "grin", "whord", "whod", "ginsworth" }
local espNPC, espPlr = {}, {}
local BLUE, CYAN = Color3.fromRGB(0, 140, 255), Color3.fromRGB(0, 230, 255)

local function parseKeywords(text)
    local list = {}
    for w in string.gmatch(string.lower(text or ""), "[^,%s]+") do list[#list + 1] = w end
    if #list > 0 then keywords = list end
end

local function isTargetNPC(model)
    local n = string.lower(model.Name)
    for _, k in ipairs(keywords) do
        if string.find(n, k, 1, true) then return true end
    end
    return false
end

local function makeTag(adornee, nameText, nameColor)
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.fromOffset(160, 30)
    bb.StudsOffset = Vector3.new(0, 3.2, 0)
    bb.AlwaysOnTop = true
    bb.LightInfluence = 0
    bb.Adornee = adornee
    bb.Parent = Workspace

    local function lbl(y, size, font, color, text)
        local l = Instance.new("TextLabel")
        l.BackgroundTransparency = 1
        l.Position = UDim2.fromOffset(0, y)
        l.Size = UDim2.new(1, 0, 0, 15)
        l.Font = font
        l.TextSize = size
        l.TextColor3 = color
        l.TextStrokeTransparency = 0.25
        l.TextStrokeColor3 = Color3.new(0, 0, 0)
        l.Text = text
        l.Parent = bb
        return l
    end
    local nameL = lbl(0, 12, Enum.Font.GothamBold, nameColor, nameText)
    local infoL = lbl(14, 10, Enum.Font.GothamMedium, Color3.fromRGB(215, 230, 255), "")
    return bb, infoL
end

local function makeHighlight(adornee, fill, outline)
    local h = Instance.new("Highlight")
    h.Adornee = adornee
    h.FillColor = fill
    h.OutlineColor = outline
    h.FillTransparency = 0.4
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = Workspace
    return h
end

local function refreshInfo(d, model, myPos)
    if not d.hum or not d.hum.Parent then d.hum = model:FindFirstChildOfClass("Humanoid") end
    local dist = (myPos and d.part) and math.floor((d.part.Position - myPos).Magnitude + 0.5) or 0
    local text
    if d.hum then
        text = "♥ " .. math.floor(d.hum.Health + 0.5) .. "/" .. math.floor(d.hum.MaxHealth + 0.5) .. "  •  " .. dist .. "m"
    else
        text = dist .. " m"
    end
    if d.text ~= text then
        d.text = text
        d.info.Text = text
    end
end

-- NPCs
local function removeNPC(model)
    local d = espNPC[model]
    if d then
        if d.hl then d.hl:Destroy() end
        if d.bb then d.bb:Destroy() end
        espNPC[model] = nil
    end
end

local function clearNPC()
    for m in pairs(espNPC) do removeNPC(m) end
end

local function addNPC(model)
    if espNPC[model] or not model.Parent then return end
    if Players:GetPlayerFromCharacter(model) or not isTargetNPC(model) then return end
    local part = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if not part then return end
    local bb, info = makeTag(part, model.Name, T.Accent2)
    espNPC[model] = { hl = makeHighlight(model, T.Accent, T.Accent2), bb = bb, info = info, part = part, text = "" }
end

local scanToken = 0
local function scanNPCs()
    scanToken += 1
    local mine = scanToken
    task.spawn(function()
        local n = 0
        for _, o in ipairs(Workspace:GetDescendants()) do
            if mine ~= scanToken or not S.esp then return end
            if o:IsA("Model") then addNPC(o) end
            n += 1
            if n % 400 == 0 then task.wait() end
        end
    end)
end

track(Workspace.DescendantAdded:Connect(function(o)
    if S.esp and o:IsA("Model") then
        task.delay(0.4, function()
            if S.esp then addNPC(o) end
        end)
    end
end))

-- Jugadores
local function removePlayerESP(plr)
    local d = espPlr[plr]
    if d then
        if d.hl then d.hl:Destroy() end
        if d.bb then d.bb:Destroy() end
        espPlr[plr] = nil
    end
end

local function clearPlayers()
    for p in pairs(espPlr) do removePlayerESP(p) end
end

local function addPlayerESP(plr)
    local char = plr.Character
    if not char then return end
    removePlayerESP(plr)
    local part = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    local bb, info = makeTag(part, plr.Name, CYAN)
    espPlr[plr] = { hl = makeHighlight(char, BLUE, CYAN), bb = bb, info = info, part = part, char = char, text = "" }
end

track(Players.PlayerRemoving:Connect(removePlayerESP))

do
    local acc = 0
    track(RunService.Heartbeat:Connect(function(dt)
        if not (S.esp or S.espP) then return end
        acc += dt
        if acc < 0.1 then return end
        acc = 0

        local my = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local myPos = my and my.Position

        if S.esp then
            for model, d in pairs(espNPC) do
                if model.Parent and d.part.Parent then
                    refreshInfo(d, model, myPos)
                else
                    removeNPC(model)
                end
            end
        end

        if S.espP then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player then
                    local char = plr.Character
                    local d = espPlr[plr]
                    if char and (not d or d.char ~= char) then
                        addPlayerESP(plr)
                        d = espPlr[plr]
                    end
                    if d and char then
                        local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                        if head and d.part ~= head then
                            d.part = head
                            d.bb.Adornee = head
                        end
                        refreshInfo(d, char, myPos)
                    end
                end
            end
        end
    end))
end
