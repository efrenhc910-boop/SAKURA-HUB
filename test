-- DETECCIÓN DE NPC
-- ==================================================
local function isEnemyNPC(model)
	if not model or not model:IsA("Model") then return false end
	local name = string.lower(model.Name)

	local patterns = {
		"grins",
		"grin",
		"ginsworth",
		"gins",
		"worth",
		"whort",
		"wort",
		"npc",
		"enemy",
		"bot",
		"grunt",
		"mob",
		"guard"
	}

	for _, pattern in ipairs(patterns) do
		if string.find(name, pattern, 1, true) then
			return true
		end
	end

	return false
end

-- ==================================================
-- ESP
-- ==================================================
local function applyESP(model)
	if not model or not model:IsA("Model") then return end
	if espObjects[model] then return end
	if Players:GetPlayerFromCharacter(model) then return end
	if not isEnemyNPC(model) then return end

	local rootPart = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso") or model.PrimaryPart
	if not rootPart then return end

	local highlight = make("Highlight", {
		Parent = Workspace,
		Adornee = model,
		FillColor = theme.Accent,
		OutlineColor = theme.Accent2,
		FillTransparency = 0.45,
		OutlineTransparency = 0,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
	})

	local billboard = make("BillboardGui", {
		Parent = Workspace,
		Adornee = rootPart,
		AlwaysOnTop = true,
		Size = UDim2.new(0, 160, 0, 24),
		StudsOffset = Vector3.new(0, 3.2, 0),
	})

	local label = make("TextLabel", {
		Parent = billboard,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Text = model.Name,
		TextColor3 = theme.Text,
		TextStrokeTransparency = 0.3,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
	})

	espObjects[model] = { highlight = highlight, billboard = billboard, label = label }
end

local function clearESP()
	for model, v in pairs(espObjects) do
		if v.highlight then v.highlight:Destroy() end
		if v.billboard then v.billboard:Destroy() end
		espObjects[model] = nil
	end
end

local function scanESP()
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Model") then
			applyESP(obj)
		end
	end
end

-- ==================================================
-- NO CLIP
-- ==================================================
local function toggleNoClip(state)
	if state then
		if player.Character then
			for _, part in ipairs(player.Character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
		end
	else
		if player.Character then
			for _, part in ipairs(player.Character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = true
				end
			end
		end
	end
end

-- ==================================================
-- FULLBRIGHT
-- ==================================================
local function toggleFullbright(state)
	if state then
		Lighting.Brightness = 2.5
		Lighting.ClockTime = 14
		Lighting.FogEnd = 100000
		Lighting.GlobalShadows = false
	else
		Lighting.Brightness = originalBrightness
		Lighting.ClockTime = originalClockTime
		Lighting.FogEnd = originalFogEnd
		Lighting.GlobalShadows = originalGlobalShadows
	end
end

-- ==================================================
-- PLAYER ESP
-- ==================================================
local function togglePlayerESP(state)
	if state then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player and plr.Character then
				local h = make("Highlight", {
					Parent = Workspace,
					Adornee = plr.Character,
					FillColor = theme.Accent,
					OutlineColor = theme.Accent2,
					FillTransparency = 0.35,
					OutlineTransparency = 0,
				})
				playerHighlightObjects[plr] = h
			end
		end
	else
		for _, h in pairs(playerHighlightObjects) do
			if h then h:Destroy() end
		end
		playerHighlightObjects = {}
	end
end

