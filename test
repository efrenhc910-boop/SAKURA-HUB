local function isNPCName(name)
	if not name then return false end
	local n = string.lower(name)
	return string.find(n, "grins", 1, true)
		or string.find(n, "worth", 1, true)
		or string.find(n, "grin", 1, true)
		or string.find(n, "ginsworth", 1, true)
		or string.find(n, "whort", 1, true)
end

local function isFathomPlayer(plr)
	if not plr or not plr:IsA("Player") then return false end
	local name = string.lower(plr.Name)
	return string.find(name, "fathom", 1, true) ~= nil
end

-- ==================================================
-- NPC ESP
-- ==================================================
local function addNPCESP(model)
	if not model or not model:IsA("Model") then return end
	if npcEspObjects[model] then return end
	if Players:GetPlayerFromCharacter(model) then return end
	if not isNPCName(model.Name) then return end

	local rootPart = model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChild("Torso")
		or model:FindFirstChild("UpperTorso")
		or model.PrimaryPart

	if not rootPart then return end

	local highlight = make("Highlight", {
		Parent = Workspace,
		Adornee = model,
		FillColor = theme.Accent,
		OutlineColor = theme.Accent2,
		FillTransparency = 0.45,
		OutlineTransparency = 0,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
	})

	local billboard = make("BillboardGui", {
		Parent = Workspace,
		Adornee = rootPart,
		AlwaysOnTop = true,
		Size = UDim2.new(0, 180, 0, 32),
		StudsOffset = Vector3.new(0, 3.5, 0),
	})

	local label = make("TextLabel", {
		Parent = billboard,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0.5, 0),
		Position = UDim2.new(0, 0, 0, 0),
		Text = model.Name,
		TextColor3 = theme.Text,
		TextStrokeTransparency = 0.2,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
	})

	local distLabel = make("TextLabel", {
		Parent = billboard,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0.5, 0),
		Position = UDim2.new(0, 0, 0.5, 0),
		Text = "0 studs",
		TextColor3 = theme.Accent,
		TextStrokeTransparency = 0.2,
		Font = Enum.Font.Gotham,
		TextSize = 11,
	})

	npcEspObjects[model] = {
		highlight = highlight,
		billboard = billboard,
		label = label,
		distLabel = distLabel,
		rootPart = rootPart,
	}
end

local function clearNPCESP()
	for model, v in pairs(npcEspObjects) do
		if v.highlight then v.highlight:Destroy() end
		if v.billboard then v.billboard:Destroy() end
		npcEspObjects[model] = nil
	end
end

local function scanNPCESP()
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Model") then
			addNPCESP(obj)
		end
	end
end

