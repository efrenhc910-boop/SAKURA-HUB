local skinHL, skinLight, skinFx
local coloresGuardados, ropaOculta = {}, {}

local function limpiarSkin()
    if skinHL then pcall(function() skinHL:Destroy() end) skinHL = nil end
    if skinLight then pcall(function() skinLight:Destroy() end) skinLight = nil end
    if skinFx then pcall(function() skinFx:Destroy() end) skinFx = nil end
end

local function restaurarCuerpo()
    for p, d in pairs(coloresGuardados) do
        if p.Parent then
            pcall(function()
                p.Color = d.Color
                p.Material = d.Material
            end)
        end
    end
    table.clear(coloresGuardados)

    local char = player.Character
    for inst in pairs(ropaOculta) do
        if char and not inst.Parent then
            pcall(function() inst.Parent = char end)
        end
    end
    table.clear(ropaOculta)
end

local function pintarCuerpo(char, s)
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            local n = p.Name
            local col = s.torso
            if n:find("Torso") then
                col = s.torso
            elseif n:find("Arm") then
                col = s.brazos
            elseif n:find("Leg") then
                col = s.piernas
            elseif n == "Head" then
                col = s.cabeza
            end
            coloresGuardados[p] = { Color = p.Color, Material = p.Material }
            pcall(function()
                p.Color = col
                p.Material = Enum.Material.SmoothPlastic
            end)
        elseif p:IsA("Shirt") or p:IsA("Pants") then
            ropaOculta[p] = true
            pcall(function() p.Parent = nil end)
        end
    end
end

local function aplicarSkin(clave)
    limpiarSkin()
    if not clave then
        restaurarCuerpo()
        return
    end

    local s = POR_CLAVE[clave]
    local aura = s and AURAS[s.tipo]
    local char, root = getParts()
    local r = root or (char and char:FindFirstChild("HumanoidRootPart"))
    if not s or not aura or not char or not r then return end

    restaurarCuerpo()
    pintarCuerpo(char, s)

    skinHL = Instance.new("Highlight")
    skinHL.Name = "DestroyaSkin"
    skinHL.Adornee = char
    skinHL.FillColor = aura.linea
    skinHL.FillTransparency = 0.6
    skinHL.OutlineColor = aura.linea
    skinHL.OutlineTransparency = 0.05
    skinHL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    skinHL.Parent = char

    skinLight = Instance.new("PointLight")
    skinLight.Color = aura.linea
    skinLight.Range = 20
    skinLight.Brightness = 2.2
    skinLight.Shadows = false
    skinLight.Parent = r

    skinFx = Instance.new("ParticleEmitter")
    skinFx.Texture = aura.tex
    skinFx.Color = ColorSequence.new(aura.linea)
    skinFx.Size = NumberSequence.new(aura.tam)
    skinFx.Transparency = NumberSequence.new(0.25, 1)
    skinFx.Lifetime = NumberRange.new(0.6, 1.2)
    skinFx.Rate = aura.rate
    skinFx.Speed = NumberRange.new(aura.vel * 0.4, aura.vel)
    skinFx.SpreadAngle = Vector2.new(180, 180)
    skinFx.LightEmission = 0.8
    skinFx.Parent = r

    if s.tipo == "insano" then
        task.spawn(function()
            local cols = { Color3.fromRGB(255, 90, 240), Color3.fromRGB(90, 220, 255), Color3.fromRGB(255, 220, 90) }
            local i = 0
            while skinHL and skinHL.Parent do
                i = i % #cols + 1
                skinHL.FillColor = cols[i]
                skinHL.OutlineColor = cols[i]
                task.wait(1.2)
            end
        end)
    end
end

local setSkin = function(clave)
    S.skin = clave
    aplicarSkin(clave)
end

track(player.CharacterAdded:Connect(function()
    task.wait(1)
    table.clear(coloresGuardados)
    table.clear(ropaOculta)
    if S.neon then pcall(aplicarNeon) end
    if S.glow then pcall(aplicarGlow) end
    if S.skin then pcall(aplicarSkin, S.skin) end
end))

