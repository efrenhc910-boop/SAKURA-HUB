local function esconderAccesorios(char)
    if not char then return end
    local caja = char:FindFirstChild("DestroyaOrig")
    if not caja then
        caja = Instance.new("Folder")
        caja.Name = "DestroyaOrig"
        caja.Parent = char
    end
    for _, a in ipairs(char:GetChildren()) do
        if a:IsA("Accoutrement") then
            SK.orig[a] = nil
            a.Parent = caja
            table.insert(SK.puestas, a)
        end
    end
end

local function devolverAccesorios(char)
    if not char then return end
    local caja = char:FindFirstChild("DestroyaOrig")
    if caja then
        for _, a in ipairs(caja:GetChildren()) do
            if a:IsA("Accoutrement") then a.Parent = char end
        end
        pcall(function() caja:Destroy() end)
    end
end

local function bajarAccesorio(id)
    if not id then return nil end
    local ok, res = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(id))
    end)
    if ok and res and res[1] then
        local obj = res[1]
        if obj:IsA("Accoutrement") then return obj end
        local dentro = obj:FindFirstChildWhichIsA("Accoutrement", true)
        if dentro then return dentro end
    end
    local ok2, modelo = pcall(function()
        return InsertService:LoadAsset(id)
    end)
    if ok2 and modelo then
        local dentro = modelo:FindFirstChildWhichIsA("Accoutrement", true)
        if dentro then return dentro end
    end
    return nil
end

local function montar(char, hum, id)
    if not char or not hum then return false end
    local acc = bajarAccesorio(id)
    if not acc then
        warn("[DestroyaHub] accesorio no cargado: " .. tostring(id))
        return false
    end
    acc.Parent = char
    local ok = pcall(function() hum:AddAccessory(acc) end)
    if not ok then
        local h = acc:FindFirstChild("Handle")
        local base = char:FindFirstChild("Head") or char:FindFirstChild("UpperTorso")
        if h and base then
            pcall(function()
                h.CFrame = base.CFrame
                h.CanCollide = false
                local w = Instance.new("WeldConstraint")
                w.Part0 = h
                w.Part1 = base
                w.Parent = h
            end)
        end
    end
    SK.puestas[#SK.puestas + 1] = acc
    return true
end

local function limpiarPuestas()
    for _, a in ipairs(SK.puestas) do
        if a and a.Parent and a:IsA("Accoutrement") then
            pcall(function() a:Destroy() end)
        end
    end
    SK.puestas = {}
end

local function clearSkin(silencioso)
    local char = player.Character
    limpiarPuestas()
    if char then
        despintar()
        devolverRopa()
        devolverAccesorios(char)
    else
        SK.orig, SK.ropa = {}, {}
    end
    S.skin = nil
    if not silencioso then notify("Skin quitada") end
end

local function setSkin(nombre)
    if SK.candado then return end
    local skin = SKINS[nombre]
    if not skin then return end

    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum or hum.Health <= 0 then
        notify("Sin personaje")
        return
    end

    SK.candado = true
    local ok, err = pcall(function()
        if S.skin then clearSkin(true) end
        S.skin = nombre

        esconderAccesorios(char)
        guardarRopa(char)
        pintar(char, skin)
        ponerRopa(char, skin.shirt, skin.pants)

        local pre = {}
        for _, id in ipairs(skin.acc or {}) do
            pre[#pre + 1] = "rbxassetid://" .. tostring(id)
        end
        if #pre > 0 then pcall(function() ContentProvider:PreloadAsync(pre) end) end

        local fallas = 0
        for _, id in ipairs(skin.acc or {}) do
            if not montar(char, hum, id) then fallas = fallas + 1 end
            task.wait(0.12)
        end
        if fallas > 0 then
            notify(nombre .. " con " .. fallas .. " fallas")
        else
            notify(nombre .. " puesta")
        end
    end)
    SK.candado = false
    if not ok then
        warn("[DestroyaHub] skin: " .. tostring(err))
        notify("Error aplicando " .. nombre)
    end
end

track(player.CharacterAdded:Connect(safe(function()
    SK.candado = false
    limpiarPuestas()
    SK.orig, SK.ropa = {}, {}
    task.wait(2.5)
    if S.skin then
