local function crear(clase, props, padre)
  local o = Instance.new(clase)
  local destino = padre
  for k, v in pairs(props or {}) do
    if k == "Parent" then
      destino = v
    else
      o[k] = v
    end
  end
  if destino then
    o.Parent = destino
  end
  return o
end

local function esquina(o, r)
  crear("UICorner", {CornerRadius = UDim.new(0, r)}, o)
  return o
end

local function trazo(o, c, t)
  crear("UIStroke", {Color = c or Color3.fromRGB(45, 45, 58), Thickness = t or 1}, o)
  return o
end

local function ejecutar(f)
  return function()
    local ok, err = pcall(f)
    if not ok then
      warn(err)
    end
  end
end

