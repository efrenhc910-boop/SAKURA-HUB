local camHeld, camPrev, camErr = false, nil, 0
local camParams = RaycastParams.new()
camParams.FilterType = Enum.RaycastFilterType.Exclude
camParams.IgnoreWater = true
camParams.RespectCanCollide = true

local CAM_DIST = 9
local CAM_UP = 3.4
local PIVOT_UP = 2.2

local lastDir = Vector3.new(0, 0, -1)
local waitTime, botMiss = 0, 0

local function releaseCamera()
    local cam = getCamera()
    local _, hum = getParts()
    if camHeld and cam then
        pcall(function()
            cam.CameraType = camPrev or Enum.CameraType.Custom
            if hum then cam.CameraSubject = hum end
        end)
    end
    camHeld = false
    if hum then pcall(function() hum.AutoRotate = true end) end
end

local function nearestPlayer(radio)
    local root = getParts()
    if not root then return nil end
    local best, bestD = nil, radio or CONFIG.BOT_RANGE
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Parent == Players then
            local c = plr.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = (r.Position - root.Position).Magnitude
                if d <= bestD then
                    best, bestD = plr, d
                end
            end
        end
    end
    return best
end
UI.nearestPlayer = nearestPlayer

local function camStep(dt)
    local cam = getCamera()
    local root, hum = getParts()

    if not cam or not root then
        if camHeld then releaseCamera() end
        return
    end

    local lockPlr = S.fijado
    local tChar = lockPlr and lockPlr.Parent == Players and lockPlr.Character

    if not tChar then
        if camHeld then releaseCamera() end
        return
    end

    local tRoot = tChar:FindFirstChild("HumanoidRootPart")
    local tHead = tChar:FindFirstChild("Head")
    if not tRoot or not tHead then
        waitTime += dt
        if waitTime > 0.8 and lockPlr then
            UI.setStatus("Esperando a @" .. lockPlr.Name .. "...")
        end
        if camHeld then releaseCamera() end
        return
    end
    waitTime = 0

    if not camHeld then
        camHeld = true
        camPrev = cam.CameraType
    end
    if cam.CameraType ~= Enum.CameraType.Scriptable then cam.CameraType = Enum.CameraType.Scriptable end
    if hum and hum.AutoRotate then hum.AutoRotate = false end

    local flat = Vector3.new(tRoot.Position.X - root.Position.X, 0, tRoot.Position.Z - root.Position.Z)
    local dir
    if flat.Magnitude >= 0.4 then
        dir = flat.Unit
        lastDir = dir
    else
        dir = lastDir
    end

    if not S.fly then
        root.CFrame = CFrame.lookAt(root.Position, root.Position + dir)
    end

    local focus = tHead.Position
    local pivot = root.Position + Vector3.new(0, PIVOT_UP, 0)
    local want = root.Position - dir * CAM_DIST + Vector3.new(0, CAM_UP, 0)

    camParams.FilterDescendantsInstances = { player.Character }
    local delta = want - pivot
    if delta.Magnitude > 0.2 then
        local hit = Workspace:Raycast(pivot, delta, camParams)
        if hit then
            local back = (pivot - hit.Position).Unit
            want = hit.Position + back * 0.35
            if (want - pivot).Magnitude < 1.2 then
                want = pivot + back * 1.2
            end
        end
    end

    cam.CFrame = CFrame.lookAt(want, focus)
end

-- Cámara enganchada de verdad al render
RunService:BindToRenderStep("DestroyaCam", Enum.RenderPriority.Camera.Value + 1, function(dt)
    if not alive() then return end
    local ok, err = pcall(camStep, dt)
    if ok then
        camErr = 0
    else
        camErr += 1
        if camErr == 1 then warn("[DestroyaHub] cámara: " .. tostring(err)) end
        if camErr > 30 then
            camErr = 0
            pcall(function() setBot(false) end)
            S.fijado = nil
            notify("Cámara apagada por un error")
        end
    end
end)

local function botStatus()
    if S.fijado then return "Fijo: @" .. S.fijado.Name end
    if not S.bot then return "I'm bot desactivado" end
    if S.target then return "I'm bot: @" .. S.target.Name end
    return "I'm bot: buscando objetivo"
end

local function syncBot()
    if UI.botToggle then UI.botToggle.Set(S.bot, true) end
    if UI.showCamStop then UI.showCamStop(S.bot or S.fijado ~= nil) end
    if UI.showFijoStop then UI.showFijoStop(S.fijado ~= nil) end
    UI.setStatus(botStatus())
    if UI.refreshLists then UI.refreshLists() end
end

local function setBot(on)
    on = on and true or false
    if on == S.bot then return end
    S.bot = on

    if on then
        if not S.fijado then
            local pick = nearestPlayer()
            if pick then
                S.target = pick
                notify("I'm bot: @" .. pick.Name)
            else
                S.target = nil
                notify("Nadie a menos de " .. CONFIG.BOT_RANGE .. " studs")
            end
        end
        botMiss = 0
    else
        S.target = nil
        waitTime, botMiss = 0, 0
        if not S.fijado then pcall(releaseCamera) end
    end

    syncBot()
end

local function selectTarget(plr)
    if not plr or plr.Parent ~= Players then
        notify("Jugador no disponible")
        return
    end
    if S.fijado and S.fijado ~= plr then
        S.fijado = nil
        if UI.showFijoStop then UI.showFijoStop(false) end
    end
    S.target = plr
    botMiss = 0
    if not S.bot then
        setBot(true)
        S.target = plr
    end
    syncBot()
end

local function fijar(plr)
    if not plr or plr.Parent ~= Players then
        notify("Jugador no disponible")
        return
    end

    if S.fijado == plr then
        S.fijado = nil
        S.target = nil
        syncBot()
        notify("Cámara libre")
        return
    end

    if not S.bot then
        S.bot = true
        if UI.botToggle then UI.botToggle.Set(true, true) end
    end

    S.fijado = plr
    S.target = plr
    botMiss, waitTime = 0, 0
    syncBot()
    notify("Fijo en @" .. plr.Name)
end

local function soltarFijo()
    if not S.fijado then return end
    S.fijado = nil
    S.target = nil
    syncBot()
    notify("Fijo liberado, el bot sigue")
end

