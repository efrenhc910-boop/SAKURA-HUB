    pcall(function()
        Lighting.Brightness, Lighting.ClockTime = L_SNAP.Brightness, L_SNAP.ClockTime
        Lighting.Ambient, Lighting.OutdoorAmbient = L_SNAP.Ambient, L_SNAP.Outdoor
        Lighting.FogEnd, Lighting.FogStart = L_SNAP.FogEnd, L_SNAP.FogStart
