        pcall(function() neonLight:Destroy() end)
        neonLight = nil
    end
end

local glowHL

local function aplicarGlow()
    local char = player.Character
    if not char or not char.Parent then return end
    if glowHL then pcall(function() glowHL:Destroy() end) end
    glowHL = Instance.new("Highlight")
    glowHL.Name = "DestroyaGlow"
    glowHL.Adornee = char
    glowHL.FillColor = C.Oro
    glowHL.FillTransparency = 0.72
    glowHL.OutlineColor = C.Oro
    glowHL.OutlineTransparency = 0
    glowHL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    glowHL.Parent = char
end

local function setGlow(on)
    S.glow = on and true or false
    if S.glow then
        pcall(aplicarGlow)
    elseif glowHL then
        pcall(function() glowHL:Destroy() end)
        glowHL = nil
    end
end

track(player.CharacterAdded:Connect(safe(function()
    task.wait(1)
    if S.neon then pcall(aplicarNeon) end
    if S.glow then pcall(aplicarGlow) end
    if S.oro then pcall(prenderOro) end
    if S.aura then pcall(prenderAura) end
end, "decoRespawn")))

