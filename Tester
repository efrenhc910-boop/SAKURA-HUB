do
    local parts, changed, refreshAt = {}, {}, 0

    local function restore()
        for p in pairs(changed) do
            if p and p.Parent then
                pcall(function() p.CanCollide = true end)
            end
        end
        table.clear(changed)
        table.clear(parts)
    end

    setNoclip = function(on)
        on = on and true or false
        S.noclip = on
        if on then
            refreshAt = 0
        else
            restore()
        end
    end

    track(RunService.Stepped:Connect(safe(function()
        if not S.noclip then
            if next(changed) then restore() end
            return
        end
        local now = os.clock()
        if now >= refreshAt then
            refreshAt = now + 1
            table.clear(parts)
            local char = player.Character
            if char then
                for _, d in ipairs(char:GetDescendants()) do
                    if d:IsA("BasePart") then parts[#parts + 1] = d end
                end
            end
        end
        for i = 1, #parts do
            local p = parts[i]
            if p and p.Parent and p.CanCollide then
                changed[p] = true
                pcall(function() p.CanCollide = false end)
            end
        end
    end, "noclip")))

    track(player.CharacterAdded:Connect(function()
        table.clear(changed)
        table.clear(parts)
        refreshAt = 0
