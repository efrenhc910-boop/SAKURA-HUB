local function createSlider(page, name, min, max, default, fmt, callback)
    local cb = callback and safe(callback, name or "slider", 8)
    min = num(min, 0)
    max = num(max, 100)
    if max <= min then max = min + 1 end
    default = math.clamp(num(default, min), min, max)
    fmt = fmt or function(v) return tostring(math.floor(v + 0.5)) end

    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -4, 0, 46)
    row.BackgroundTransparency = 0.5
    row.LayoutOrder = nextOrder()
    row.Parent = page
    bind(row, "BackgroundColor3", "Row")
    corner(row, 10)

    local glass = Instance.new("UIStroke")
    glass.Color = Color3.fromRGB(220, 250, 255)
    glass.Thickness = 1
    glass.Transparency = 0.78
    glass.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    glass.Parent = row

    mkLabel(row, string.upper(name or ""), 12, F.head, "White",
        UDim2.fromOffset(12, 5), UDim2.new(0.62, 0, 0, 16)).TextTruncate = Enum.TextTruncate.AtEnd
    local valueL = mkLabel(row, "", 12, F.head, "OroClaro", UDim2.new(0.62, 0, 0, 5),
        UDim2.new(0.38, -12, 0, 16), Enum.TextXAlignment.Right)

    local hit = Instance.new("Frame")
    hit.Size = UDim2.new(1, -24, 0, 24)
    hit.Position = UDim2.fromOffset(12, 21)
    hit.BackgroundTransparency = 1
    hit.Parent = row

    local barF = Instance.new("Frame")
    barF.AnchorPoint = Vector2.new(0, 0.5)
    barF.Position = UDim2.fromScale(0, 0.5)
    barF.Size = UDim2.new(1, 0, 0, 6)
    barF.BackgroundTransparency = 0.35
    barF.BorderSizePixel = 0
    barF.Parent = hit
    bind(barF, "BackgroundColor3", "Off")
    corner(barF, 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(0, 1)
    fill.BorderSizePixel = 0
    fill.Parent = barF
    bind(fill, "BackgroundColor3", "Oro")
    corner(fill, 3)

    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Size = UDim2.fromOffset(15, 15)
    knob.BorderSizePixel = 0
    knob.Parent = barF
    bind(knob, "BackgroundColor3", "White")
    corner(knob, 8)

    local function setRatio(r, silencioso)
        r = math.clamp(tonumber(r) or 0, 0, 1)
        if not fill.Parent then return end
        fill.Size = UDim2.fromScale(r, 1)
        knob.Position = UDim2.fromScale(r, 0.5)
        local value = min + (max - min) * r
        valueL.Text = fmt(value)
        if cb and not silencioso then cb(value) end
    end

    local function fromInput(input)
        local w = barF.AbsoluteSize.X
        if w > 0 then setRatio((input.Position.X - barF.AbsolutePosition.X) / w) end
    end

    hit.InputBegan:Connect(safe(function(input)
        if not isPointer(input) then return end
        fromInput(input)
        tween(knob, { Size = UDim2.fromOffset(20, 20) }, 0.12, Enum.EasingStyle.Back)
        beginDrag(input, fromInput, true, function()
            tween(knob, { Size = UDim2.fromOffset(15, 15) }, 0.16)
        end)
    end, "slider", 8))

    setRatio((default - min) / (max - min), true)
    return row
end

