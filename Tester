local function unhookPlayer(plr)
    local c = playerConns[plr]
    if c then
        pcall(function() c:Disconnect() end)
        playerConns[plr] = nil
    end
end

local function hookPlayer(plr)
    if not plr or plr == player then return end
    unhookPlayer(plr)
    playerConns[plr] = track(plr.CharacterAdded:Connect(safe(function()
        if S.esp and alive() then
            task.wait(1)
            if S.esp then pcall(applyESP, plr) end
        end
    end, "espRespawn")))
end

do
    local acc = 0
    track(RunService.Heartbeat:Connect(safe(function(dt)
        if not S.esp or not alive() then return end
        acc += dt
        if acc < ESP_TICK then return end
        acc = 0

        local lr = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local cands = {}

        if lr then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player then
                    local char = plr.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if root and hum and hum.Health > 0 then
                        local dist = math.floor((root.Position - lr.Position).Magnitude + 0.5)
                        if dist <= ESP_MAX then
                            cands[#cands + 1] = { plr = plr, char = char, root = root, hum = hum, dist = dist }
                        end
                    end
                end
            end
            table.sort(cands, function(a, b) return a.dist < b.dist end)
        end

        local shown = {}
        for i = 1, math.min(#cands, CONFIG.MAX_TARGETS) do
            shown[cands[i].plr] = cands[i]
        end

        for plr, d in pairs(espObjects) do
            if not shown[plr] then
                if d.bb and d.bb.Enabled then d.bb.Enabled = false end
                if d.hl and d.hl.Enabled then d.hl.Enabled = false end
            end
        end

        for plr, c in pairs(shown) do
            local d = espObjects[plr]
            if not d or d.char ~= c.char then
                applyESP(plr)
                d = espObjects[plr]
            end
            if d then
                if not d.bb.Enabled then d.bb.Enabled = true end
                if not d.hl.Enabled then d.hl.Enabled = true end

                local head = c.char:FindFirstChild("Head") or c.root
                if head and d.bb.Adornee ~= head then d.bb.Adornee = head end

                local hp = math.max(0, math.floor(c.hum.Health + 0.5))
                local mx = math.max(1, math.floor(c.hum.MaxHealth + 0.5))
                if d.hp ~= hp or d.mx ~= mx then
                    d.hp, d.mx = hp, mx
                    d.fill.Size = UDim2.fromScale(math.clamp(hp / mx, 0, 1), 1)
                    d.hpL.Text = hp .. " / " .. mx
                end
                if d.dist ~= c.dist then
                    d.dist = c.dist
                    d.distL.Text = c.dist .. " studs"
                end
            end
        end
    end, "espLoop")))
end

