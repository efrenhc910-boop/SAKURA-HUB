    track(RunService.Heartbeat:Connect(safe(function(dt)
        frames += 1
        fpsAcc += dt
        if fpsAcc < 0.5 then return end
        local fps = math.floor(frames / fpsAcc + 0.5)
        if FpsText.Parent then FpsText.Text = "FPS " .. fps end
        frames, fpsAcc = 0, 0
        if UI.autoLow and fps < 24 and not S.boost then
            pcall(function() setFpsBoost(true) end)
            UI.setStatus("Modo seguro: FPS Boost automático")
        end
    end, "fps")))
end

