        corner(w, 1)
    end

    local sc = Instance.new("UIScale")
    sc.Scale = 0
    sc.Parent = b

    local function pulsar(on)
        if arriba then S.up = on else S.down = on end
        tween(sc, { Scale = on and 0.88 or 1 }, 0.1, Enum.EasingStyle.Quad)
    end

    b.InputBegan:Connect(safe(function(i)
        if isPointer(i) then pulsar(true) end
    end, "pad"))
    b.InputEnded:Connect(safe(function(i)
        if isPointer(i) then pulsar(false) end
    end, "pad"))
    b.MouseLeave:Connect(safe(function() pulsar(false) end, "pad"))

    return b, sc
end

local UpBtn, UpScale = padButton(-88, true)
local DownBtn, DownScale = padButton(24, false)

do
    local last = false
    track(RunService.Heartbeat:Connect(safe(function()
        if last == S.fly then return end
        last = S.fly
        if S.fly then
            UpBtn.Visible, DownBtn.Visible = true, true
            tween(UpScale, { Scale = 1 }, 0.28, Enum.EasingStyle.Back)
            tween(DownScale, { Scale = 1 }, 0.28, Enum.EasingStyle.Back)
        else
            S.up, S.down = false, false
            tween(UpScale, { Scale = 0 }, 0.16)
            tween(DownScale, { Scale = 0 }, 0.16)
            task.delay(0.18, function()
                if not S.fly then
                    UpBtn.Visible, DownBtn.Visible = false, false
                end
            end)
        end
    end, "pads")))
end

local closing = false

local function destroyHub()
    if closing then return end
    closing = true
    UI.open = false
    pcall(function()
        tween(MenuScale, { Scale = 0.5 }, 0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        tween(Backdrop, { ImageTransparency = 1 }, 0.2)
    end)
    task.delay(0.22, function()
        if Screen.Parent then Screen:Destroy() end
    end)
end

do
    local confirmUntil = 0
    DestroyBtn.Activated:Connect(safe(function()
        local now = os.clock()
        if now < confirmUntil then
            destroyHub()
            return
        end
        confirmUntil = now + 2.5
        notify("Toca la X otra vez para destruir todo")
        tween(DestroyBtn, { BackgroundColor3 = Color3.fromRGB(255, 30, 55) }, 0.15)
        task.delay(2.5, function()
            if DestroyBtn.Parent then
                tween(DestroyBtn, { BackgroundColor3 = Color3.fromRGB(24, 84, 104) }, 0.3)
            end
        end)
    end, "destruir"))
end

