local function pintar(char, skin)
    if not char or not skin then return end
    for _, par in ipairs(PARTES) do
        local p = char:FindFirstChild(par[1])
        local col = skin[par[2]]
        if p and p:IsA("BasePart") and col then
            if not SK.orig[p] then
                SK.orig[p] = { Color = p.Color, Material = p.Material }
            end
            pcall(function()
                p.Color = col
                p.Material = skin.mat or Enum.Material.SmoothPlastic
            end)
        end
    end
end

local function despintar()
    for p, d in pairs(SK.orig) do
        if p and p.Parent then
            pcall(function()
                p.Color = d.Color
                p.Material = d.Material
            end)
        end
    end
    SK.orig = setmetatable({}, { __mode = "k" })
end

local function guardarRopa(char)
    if not char then return end
    for _, clase in ipairs({ "Shirt", "Pants" }) do
        local o = char:FindFirstChildOfClass(clase)
        if o then
            local campo = clase .. "Template"
            SK.ropa[#SK.ropa + 1] = { campo = campo, valor = o[campo], nuevo = false }
            pcall(function() o:Destroy() end)
        else
            SK.ropa[#SK.ropa + 1] = { campo = clase .. "Template", valor = "", nuevo = true }
        end
    end
end

local function ponerRopa(char, shirt, pants)
    if not char then return end
    local sh = char:FindFirstChildOfClass("Shirt")
    if not sh then
        sh = Instance.new("Shirt")
        sh.Parent = char
    end
    pcall(function() sh.ShirtTemplate = "rbxassetid://" .. tostring(shirt) end)

    local pa = char:FindFirstChildOfClass("Pants")
    if not pa then
        pa = Instance.new("Pants")
        pa.Parent = char
    end
    pcall(function() pa.PantsTemplate = "rbxassetid://" .. tostring(pants) end)
end

local function devolverRopa(char)
    if char then
        for _, clase in ipairs({ "Shirt", "Pants" }) do
            local o = char:FindFirstChildOfClass(clase)
            if o then pcall(function() o:Destroy() end) end
        end
    end
    for _, d in ipairs(SK.ropa) do
        if char and d.valor and d.valor ~= "" then
            local obj = Instance.new(d.campo == "ShirtTemplate" and "Shirt" or "Pants")
            pcall(function() obj[d.campo] = d.valor end)
            obj.Parent = char
        end
    end
    SK.ropa = {}
end

local function esconderAccesorios(char)
    if not char then return end
    local caja = char:FindFirstChild("DestroyaOrig")
    if not caja then
        caja = Instance.new("Folder")
        caja.Name = "DestroyaOrig"
        caja.Parent = char
    end
    for _, a in ipairs(char:GetChildren()) do
        if a:IsA("Accoutrement") then
            local h = a:FindFirstChild("Handle")
            if h and h:IsA("BasePart") then
                if SK.origAcc[h] == nil then SK.origAcc[h] = h.Transparency end
                pcall(function() h.Transparency = 1 end)
            end
            a.Parent = caja
        end
    end
end

local function devolverAccesorios(char)
    if not char then return end
    local caja = char:FindFirstChild("DestroyaOrig")
    if caja then
        for _, a in ipairs(caja:GetChildren()) do
            if a:IsA("Accoutrement") then
                local h = a:FindFirstChild("Handle")
                if h and h:IsA("BasePart") and SK.origAcc[h] ~= nil then
                    pcall(function() h.Transparency = SK.origAcc[h] end)
                    SK.origAcc[h] = nil
                end
                a.Parent = char
            end
        end
        pcall(function() caja:Destroy() end)
    end
    table.clear(SK.origAcc)
end

local function bajarAccesorio(id)
    if not id then return nil end
    local ok, res = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(id))
    end)
    if ok and res and res[1] then
        local obj = res[1]
        if obj:IsA("Accoutrement") then return obj end
        local dentro = obj:FindFirstChildWhichIsA("Accoutrement", true)
        if dentro then return dentro end
    end
    local ok2, modelo = pcall(function()
        return InsertService:LoadAsset(id)
    end)
    if ok2 and modelo then
        local dentro = modelo:FindFirstChildWhichIsA("Accoutrement", true)
        if dentro then return dentro end
    end
    return nil
end

