    else
        Content.Position = UDim2.fromOffset(8, HEADER_H + 60)
        Content.Size = UDim2.new(1, -16, 1, -(HEADER_H + 60 + 24))
    end
end

TabReveal.Activated:Connect(safe(function()
    plegarPestanas(UI.tabsOpen)
end, "tabs", 6))

