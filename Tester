task.spawn(function()
    while alive() do
        task.wait(0.5)
        if S.tag then
            local char = player.Character
            local head = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
            if head then
                if not tagGui or tagGui.Parent ~= head then pcall(aplicarTag) end
            elseif tagGui then
                quitarTag()
            end
        elseif tagGui then
            quitarTag()
        end
    end
end)

