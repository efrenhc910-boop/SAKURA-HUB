    Head = "Head", Hat = "Head", Hair = "Head", Face = "Head", Front = "Head",
    Torso = "UpperTorso", Body = "UpperTorso", Back = "UpperTorso", Waist = "UpperTorso",
    Left = "LeftUpperArm", Right = "RightUpperArm", LeftHand = "LeftHand", RightHand = "RightHand",
    LeftFoot = "LeftFoot", RightFoot = "RightFoot",
}

local function huesoDe(acc)
    local ap = acc:FindFirstChildOfClass("Attachment")
    local punto = ap and ap.Name or ""
    punto = punto:gsub("%d+", "")
    return BONE[punto] or "Head"
end

local function montar(char, hum, id)
    if not char or not hum then return false end
    local acc = bajarAccesorio(id)
    if not acc then
        warn("[DestroyaHub] PARTE 10 / montar: accesorio no cargado " .. tostring(id))
        return false
    end
    acc.Parent = char
    local ok = pcall(function() hum:AddAccessory(acc) end)
    if not ok then
        local h = acc:FindFirstChild("Handle")
        local hueso = char:FindFirstChild(huesoDe(acc))
        if h and hueso then
            pcall(function()
                h.CFrame = hueso.CFrame
                h.CanCollide = false
                local w = Instance.new("WeldConstraint")
                w.Part0 = h
                w.Part1 = hueso
                w.Parent = h
            end)
        end
    end
    if not table.find(SK.puestas, acc) then
        SK.puestas[#SK.puestas + 1] = acc
    end
    return true
end

local function limpiarPuestas()
    for _, a in ipairs(SK.puestas) do
        if a and a.Parent and a:IsA("Accoutrement") then
            pcall(function() a:Destroy() end)
        end
    end
    SK.puestas = {}
end

local function clearSkin(silencioso)
    local char = player.Character
    limpiarPuestas()
    if char then
        despintar()
        devolverRopa(char)
        devolverAccesorios(char)
    else
        SK.orig, SK.ropa = setmetatable({}, { __mode = "k" }), {}
    end
    S.skin = nil
    if UI.refrescarSkins then pcall(UI.refrescarSkins) end
    if UI.pintarActual then pcall(UI.pintarActual) end
    if not silencioso then notify("Skin quitada") end
end

local function setSkin(nombre)
    if SK.candado then return end
    local skin = SKINS[nombre]
    if not skin then
        notify("Skin desconocida")
        return
    end

    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum or hum.Health <= 0 then
        notify("Sin personaje")
        return
    end

    SK.candado = true
    local ok, err = pcall(function()
        if S.skin then clearSkin(true) end
        S.skin = nombre

        esconderAccesorios(char)
        guardarRopa(char)
        pintar(char, skin)
        ponerRopa(char, skin.shirt, skin.pants)

        local accs = skin.acc or {}
        local pre = {}
        for _, id in ipairs(accs) do
            pre[#pre + 1] = "rbxassetid://" .. tostring(id)
        end
        if #pre > 0 then pcall(function() ContentProvider:PreloadAsync(pre) end) end

        local fallas = 0
        for _, id in ipairs(accs) do
            if not montar(char, hum, id) then fallas = fallas + 1 end
            task.wait(0.12)
        end
        notify(fallas > 0 and (nombre .. " con " .. fallas .. " fallas") or (nombre .. " puesta"))
    end)
    SK.candado = false
    if not ok then
        warn("[DestroyaHub] PARTE 10 / skin: " .. tostring(err))
        notify("Error aplicando " .. nombre)
    end
    if UI.refrescarSkins then pcall(UI.refrescarSkins) end
    if UI.pintarActual then pcall(UI.pintarActual) end
end

