                btn.LayoutOrder = n
                btn.Size = UDim2.new(1, 0, 0, 34)
                btn.BackgroundColor3 = isTarget and C.RowOn or C.Row
                btn.BackgroundTransparency = 0.55
                btn.Text = ""
                btn.AutoButtonColor = false
                btn.Parent = container
                corner(btn, 10)
                squish(btn, 0.96)

                local accent = Instance.new("Frame")
                accent.AnchorPoint = Vector2.new(0, 0.5)
                accent.Position = UDim2.fromScale(0, 0.5)
                accent.Size = UDim2.fromOffset(3, isTarget and 20 or 0)
                accent.BackgroundColor3 = C.Acc2
                accent.BorderSizePixel = 0
                accent.Parent = btn
                corner(accent, 2)

                plain(btn, "@" .. plr.Name, 13, F.head, C.White,
                    UDim2.fromOffset(12, 0), UDim2.new(1, -66, 1, 0)).TextTruncate = Enum.TextTruncate.AtEnd

                if isTarget then
                    plain(btn, "OBJETIVO", 9, F.section, C.Acc2, UDim2.new(1, -104, 0, 0),
                        UDim2.fromOffset(46, 34), Enum.TextXAlignment.Right)
                end

                local plus = createMiniButton(btn, "plus", 24)
                plus.AnchorPoint = Vector2.new(1, 0.5)
                plus.Position = UDim2.new(1, -8, 0.5, 0)
                plus.BackgroundTransparency = isSel and 0.72 or 0.2

                btn.Activated:Connect(safe(function() selectTarget(plr) end, "lista"))
                plus.Activated:Connect(safe(function()
                    if selAdd(plr) then
                        notify("@" .. plr.Name .. " en Seleccionados")
                        showPage("Seleccionados")
