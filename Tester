local function createButton(parent, name, desc, callback)
    local cb = callback and safe(callback, name or "boton")

    local row = Instance.new("TextButton")
    row.Size = UDim2.new(1, -4, 0, CONFIG.CELL_H)
    row.BackgroundTransparency = CONFIG.BTN_T
    row.Text = ""
    row.AutoButtonColor = false
    row.LayoutOrder = nextOrder()
    row.ZIndex = 3
    row.Parent = parent
    bind(row, "BackgroundColor3", "Row")
    corner(row, 9)
    squish(row, 0.95)

    local glass = Instance.new("UIStroke")
    glass.Color = Color3.fromRGB(220, 250, 255)
    glass.Thickness = 1
    glass.Transparency = 0.72
    glass.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    glass.Parent = row

    local sheen = Instance.new("UIGradient")
    sheen.Rotation = 90
    sheen.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(180, 235, 250))
    sheen.Parent = row

    local accent = Instance.new("Frame")
    accent.AnchorPoint = Vector2.new(0, 0.5)
    accent.Position = UDim2.fromScale(0, 0.5)
    accent.Size = UDim2.fromOffset(3, 0)
    accent.BorderSizePixel = 0
    accent.ZIndex = 4
    accent.Parent = row
    corner(accent, 2)

    local nameL = plain(row, string.upper(name or "?"), 11, F.head, C.White,
        UDim2.fromOffset(10, 2), UDim2.new(1, -52, 0, 15))
    nameL.TextTruncate = Enum.TextTruncate.AtEnd
    nameL.ZIndex = 4

    local descL = plain(row, desc or "", 7, F.body, C.Gray,
        UDim2.fromOffset(10, 17), UDim2.new(1, -52, 0, 11))
    descL.TextTruncate = Enum.TextTruncate.AtEnd
    descL.ZIndex = 4

    local pill = Instance.new("Frame")
    pill.Position = UDim2.new(1, -38, 0.5, -8)
    pill.Size = UDim2.fromOffset(30, 16)
    pill.BackgroundTransparency = 0.35
    pill.BorderSizePixel = 0
    pill.ZIndex = 4
    pill.Parent = row
    corner(pill, 8)
    bind(pill, "BackgroundColor3", "Off")

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(12, 12)
    knob.Position = UDim2.fromOffset(2, 2)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BackgroundTransparency = 0.15
    knob.BorderSizePixel = 0
    knob.ZIndex = 5
    knob.Parent = pill
    corner(knob, 6)

    local flash = Instance.new("Frame")
    flash.Size = UDim2.fromScale(1, 1)
    flash.BackgroundColor3 = Color3.new(1, 1, 1)
    flash.BackgroundTransparency = 1
    flash.BorderSizePixel = 0
    flash.ZIndex = 6
    flash.Parent = row
    corner(flash, 9)

    local enabled = false
    local function paint(animated)
        local on = enabled
        local set = {
            { row, { BackgroundColor3 = on and C.RowOn or C.Row, BackgroundTransparency = on and CONFIG.BTN_T_ON or CONFIG.BTN_T }, 0.25, Enum.EasingStyle.Quint },
            { accent, { Size = UDim2.fromOffset(3, on and 18 or 0), BackgroundColor3 = C.Acc2 }, 0.3, Enum.EasingStyle.Back },
            { pill, { BackgroundColor3 = on and C.Acc or C.Off }, 0.22, Enum.EasingStyle.Quint },
            { knob, { Position = on and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6) }, 0.28, Enum.EasingStyle.Back },
            { nameL, { TextColor3 = on and C.White or Color3.fromRGB(206, 240, 250) }, 0.2, Enum.EasingStyle.Quad },
        }
        for _, s in ipairs(set) do
            if s[1].Parent then
                if animated then
                    tween(s[1], s[2], s[3], s[4])
                else
                    for k, v in pairs(s[2]) do s[1][k] = v end
                end
            end
        end
    end
    paint(false)

    local api = {}
    function api.Set(v, silent)
        if type(v) ~= "boolean" then v = not enabled end
        if v == enabled then return end
        if not row.Parent then enabled = v; return end
        enabled = v
        paint(true)
        if v then
            flash.BackgroundTransparency = 0.8
            tween(flash, { BackgroundTransparency = 1 }, 0.4)
        end
        if cb and not silent then cb(enabled) end
    end
    function api.Get() return enabled end
    api.Row = row

    row.Activated:Connect(safe(function() api.Set(not enabled) end, "boton"))
    return api, row
end

