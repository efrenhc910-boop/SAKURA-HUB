local function releaseCamera()
    local cam = getCamera()
    local _, hum = getParts()
    if camHeld and cam then
        pcall(function()
            cam.CameraType = camPrev or Enum.CameraType.Custom
            if hum then cam.CameraSubject = hum end
        end)
    end
    camHeld = false
    if hum then
        pcall(function() hum.AutoRotate = (camPrevRot == nil) and true or camPrevRot end)
    end
    camPrevRot = nil
end

local function nearestPlayer(radio)
    local root = getParts()
    if not root then return nil end
    local best, bestD = nil, radio or CONFIG.BOT_RANGE
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Parent == Players then
            local c = plr.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = (r.Position - root.Position).Magnitude
                if d <= bestD then
                    best, bestD = plr, d
                end
            end
        end
    end
    return best
end
UI.nearestPlayer = nearestPlayer

local function camStep(dt)
    local cam = getCamera()
    local root, hum = getParts()

    if not cam or not root then
        if camHeld then releaseCamera() end
        return
    end

    local lockPlr = S.fijado
    local tChar = lockPlr and lockPlr.Parent == Players and lockPlr.Character

    if not tChar then
        if camHeld then releaseCamera() end
        return
    end

    local tRoot = tChar:FindFirstChild("HumanoidRootPart")
    local tHead = tChar:FindFirstChild("Head")
    if not tRoot or not tHead then
        waitTime += dt
        if waitTime > 0.8 and lockPlr then
            setStatusTemp("Esperando a @" .. lockPlr.Name .. "...", 1)
        end
        if camHeld then releaseCamera() end
        return
    end
    waitTime = 0

    if not camHeld then
        camHeld = true
        camPrev = cam.CameraType
        camPrevRot = hum and hum.AutoRotate or true
    end
    if cam.CameraType ~= Enum.CameraType.Scriptable then cam.CameraType = Enum.CameraType.Scriptable end
    if hum and hum.AutoRotate then hum.AutoRotate = false end

    local flat = Vector3.new(tRoot.Position.X - root.Position.X, 0, tRoot.Position.Z - root.Position.Z)
    local dir
    if flat.Magnitude >= 0.4 then
        dir = flat.Unit
        lastDir = dir
    else
        dir = lastDir
    end

    if not S.fly then
        local actual = root.CFrame.LookVector
        if (Vector3.new(actual.X, 0, actual.Z).Unit - dir).Magnitude > 0.05 then
            root.CFrame = CFrame.lookAt(root.Position, root.Position + dir)
        end
    end

    local focus = tHead.Position
    local pivot = root.Position + Vector3.new(0, PIVOT_UP, 0)
    local want = root.Position - dir * CAM_DIST + Vector3.new(0, CAM_UP, 0)

    camParams.FilterDescendantsInstances = { player.Character }
    local delta = want - pivot
    if delta.Magnitude > 0.2 then
        local hit = Workspace:Raycast(pivot, delta, camParams)
        if hit then
            local back = (pivot - hit.Position).Unit
            want = hit.Position + back * 0.35
            if (want - pivot).Magnitude < 1.2 then
                want = pivot + back * 1.2
            end
        end
    end

    cam.CFrame = CFrame.lookAt(want, focus)
end

RunService:BindToRenderStep("DestroyaCam", Enum.RenderPriority.Camera.Value + 1, function(dt)
