local function listaUrls(assetIds)
    local ids = type(assetIds) == "table" and assetIds or { assetIds }
    local urls = {}
    for _, id in ipairs(ids) do
        urls[#urls + 1] = "rbxassetid://" .. tostring(id)
        urls[#urls + 1] = "rbxthumb://type=Asset&id=" .. tostring(id) .. "&w=420&h=420"
    end
    return urls
end

local function applyTextureSafe(label, assetIds, opciones)
    if not label or not assetIds then return end
    opciones = opciones or {}

    local urls = listaUrls(assetIds)
    if #urls == 0 then return end

    local maxIntentos = opciones.max or 12
    local intentos, indice = 0, 1
    local vivo = true
    local cargada = label.IsLoaded

    local function pintar()
        if not vivo or not label.Parent then return false end
        local url = urls[indice]
        indice = indice % #urls + 1
        local ok = pcall(function() label.Image = url end)
        if not ok then return false end
        pcall(function() ContentProvider:PreloadAsync({ label }) end)
        return true
    end

    local connImg, connLoad
    connImg = label:GetPropertyChangedSignal("Image"):Connect(safe(function()
        if not vivo then return end
        if label.Image == "" or label.Image == nil then
            intentos = 0
            task.delay(0.5, function()
                if vivo and label.Parent then pintar() end
            end)
        end
    end, "textura", 4))

    connLoad = label:GetPropertyChangedSignal("IsLoaded"):Connect(safe(function()
        if label.IsLoaded then cargada = true end
end, "textura", 4))

    label.Destroying:Connect(safe(function()
        vivo = false
        if connImg then pcall(function() connImg:Disconnect() end) end
        if connLoad then pcall(function() connLoad:Disconnect() end) end
    end, "textura", 4))

    task.spawn(function()
        while vivo and label.Parent and not cargada and intentos < maxIntentos do
            intentos += 1
            pintar()
            if label.IsLoaded then
                cargada = true
                break
            end
            task.wait(0.5)
        end
    end)
end

local function ajustarEscala()
    local cam = getCamera()
    local vs = cam and cam.ViewportSize or Vector2.new(CONFIG.BASE_W, CONFIG.BASE_H)
    local fit = math.min(1, (vs.X - 24) / CONFIG.BASE_W, (vs.Y - 24) / CONFIG.BASE_H)
    UI.fit = math.clamp(fit, 0.35, 1)
end

local function aplicarEscala()
    if UI.closing or not MenuScale or not MenuScale.Parent then return end
    local objetivo = UI.size * UI.fit
    if math.abs(MenuScale.Scale - objetivo) > 0.02 then
        MenuScale.Scale = objetivo
    end
end

