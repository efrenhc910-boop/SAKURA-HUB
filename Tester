local guardado = {}
local origAcc = {}
local origRopa = {}
local puestas = {}
local candado = false

local function parte(char, nombre)
  return char:FindFirstChild(nombre)
end

local function pintarCuerpo(char, s)
  for grupo, lista in pairs(PARTES) do
    local c = s[grupo]
    if c then
      for _, nombre in ipairs(lista) do
        local p = parte(char, nombre)
        if p and p:IsA("BasePart") then
          if not guardado[p] then
            guardado[p] = {Color = p.Color, Material = p.Material}
          end
          p.Color = c
          p.Material = s.mat or Enum.Material.SmoothPlastic
        end
      end
    end
  end
end

local function restaurarCuerpo()
  for p, d in pairs(guardado) do
    if p and p.Parent then
      pcall(function()
        p.Color = d.Color
        p.Material = d.Material
      end)
    end
  end
  guardado = {}
end

local function guardarRopa(char)
  for _, clase in ipairs({"Shirt", "Pants"}) do
    local o = char:FindFirstChildOfClass(clase)
    if o then
      table.insert(origRopa, {obj = o, campo = clase .. "Template", valor = o[clase .. "Template"], nuevo = false})
      o[clase .. "Template"] = ""
    end
  end
end

local function ponerRopa(char, shirt, pants)
  local sh = char:FindFirstChildOfClass("Shirt")
  if not sh then
    sh = crear("Shirt", {}, char)
    table.insert(origRopa, {obj = sh, campo = "ShirtTemplate", valor = "", nuevo = true})
  end
  sh.ShirtTemplate = "rbxassetid://" .. shirt

  local pa = char:FindFirstChildOfClass("Pants")
  if not pa then
    pa = crear("Pants", {}, char)
    table.insert(origRopa, {obj = pa, campo = "PantsTemplate", valor = "", nuevo = true})
  end
  pa.PantsTemplate = "rbxassetid://" .. pants
end

local function restaurarRopa()
  for _, d in ipairs(origRopa) do
    if d.obj and d.obj.Parent then
      if d.nuevo then
        d.obj:Destroy()
      else
        pcall(function()
          d.obj[d.campo] = d.valor
        end)
      end
    end
  end
  origRopa = {}
end

local function esconderAccesorios(char)
  local caja = char:FindFirstChild("DESTROYA_ORIG")
  if not caja then
    caja = crear("Folder", {Name = "DESTROYA_ORIG"}, char)
  end
  for _, a in ipairs(char:GetChildren()) do
    if a:IsA("Accoutrement") then
      table.insert(origAcc, a)
      a.Parent = caja
    end
  end
end

local function devolverAccesorios(char)
  local caja = char:FindFirstChild("DESTROYA_ORIG")
  for _, a in ipairs(origAcc) do
    if a and a.Parent then
      a.Parent = char
    end
  end
  origAcc = {}
  if caja then
    caja:Destroy()
  end
end

local function bajarAccesorio(id)
  local ok, res = pcall(function()
    return game:GetObjects("rbxassetid://" .. id)
  end)
  if ok and res and res[1] then
    local obj = res[1]
    if obj:IsA("Accoutrement") then
      return obj
    end
    local dentro = obj:FindFirstChildWhichIsA("Accoutrement", true)
    if dentro then
      return dentro
    end
  end
  local ok2, modelo = pcall(function()
    return InsertService:LoadAsset(id)
  end)
  if ok2 and modelo then
    local dentro = modelo:FindFirstChildWhichIsA("Accoutrement", true)
    if dentro then
      return dentro
    end
  end
  return nil
end

local function montar(char, hum, id)
  local acc = bajarAccesorio(id)
  if not acc then
    return false
  end
  acc.Parent = char
  local ok = pcall(function()
    hum:AddAccessory(acc)
  end)
  if not ok then
    local h = acc:FindFirstChild("Handle")
    local base = parte(char, "Head") or parte(char, "UpperTorso")
    if h and base then
      h.CFrame = base.CFrame
      h.CanCollide = false
      crear("WeldConstraint", {Part0 = h, Part1 = base}, h)
    end
  end
  table.insert(puestas, acc)
  return true
end

local function limpiarPuestas()
  for _, a in ipairs(puestas) do
    if a and a.Parent then
      a:Destroy()
    end
  end
  puestas = {}
end

local function quitarSkin(silencio)
  local char = jugador.Character
  limpiarPuestas()
  if char then
    restaurarCuerpo()
    restaurarRopa()
    devolverAccesorios(char)
  else
    guardado = {}
    origRopa = {}
    origAcc = {}
  end
  S.skin = nil
  if not silencio then
    aviso("Skin quitada")
  end
end

local function ponerSkin(nombre)
  if candado then
    return
  end
  local s = SKINS[nombre]
  if not s then
    return
  end
  local char = jugador.Character
  local hum = char and char:FindFirstChildOfClass("Humanoid")
  if not char or not hum then
    aviso("Sin personaje")
    return
  end
  candado = true
  if S.skin then
    quitarSkin(true)
  end
  S.skin = nombre
  esconderAccesorios(char)
  guardarRopa(char)
  pintarCuerpo(char, s)
  ponerRopa(char, s.shirt, s.pants)

  local pendientes = {}
  for _, id in ipairs(s.acc) do
    table.insert(pendientes, "rbxassetid://" .. id)
  end
  pcall(function()
    ContentProvider:PreloadAsync(pendientes)
  end)

  for _, id in ipairs(s.acc) do
    montar(char, hum, id)
    task.wait(0.15)
