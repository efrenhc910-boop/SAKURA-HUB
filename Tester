local function padButton(y, arriba)
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(54, 54)
    b.Position = UDim2.new(1, -74, 0.5, y)
    b.BackgroundColor3 = Color3.fromRGB(16, 46, 58)
    b.BackgroundTransparency = 0.25
    b.Text = ""
    b.AutoButtonColor = false
    b.Visible = false
    b.ZIndex = 10
    b.Parent = Screen
    corner(b, 27)
    stroke(b, "Acc2", 2, 0.15)

    for i = 0, 2 do
        local w = Instance.new("Frame")
        w.AnchorPoint = Vector2.new(0.5, 0.5)
        w.Position = UDim2.new(0.5, 0, 0.5, (arriba and -1 or 1) * (i * 4 - 4))
        w.Size = UDim2.fromOffset(16 - i * 4, 3)
        w.BackgroundColor3 = Color3.fromRGB(235, 252, 255)
        w.BorderSizePixel = 0
        w.ZIndex = 11
        w.Parent = b
        corner(w, 1)
    end

    local sc = Instance.new("UIScale")
    sc.Scale = 0
    sc.Parent = b

    local function pulsar(on)
        if arriba then S.up = on else S.down = on end
        tween(sc, { Scale = on and 0.88 or 1 }, 0.1, Enum.EasingStyle.Quad)
    end

    b.InputBegan:Connect(safe(function(i)
        if isPointer(i) then pulsar(true) end
    end, "pad"))
    b.InputEnded:Connect(safe(function(i)
        if isPointer(i) then pulsar(false) end
    end, "pad"))
    b.MouseLeave:Connect(safe(function() pulsar(false) end, "pad"))

    return b, sc
end

local UpBtn, UpScale = padButton(-88, true)
local DownBtn, DownScale = padButton(24, false)

do
    local last = false
    track(RunService.Heartbeat:Connect(safe(function()
        if last == S.fly then return end
        last = S.fly
        if S.fly then
            UpBtn.Visible, DownBtn.Visible = true, true
            tween(UpScale, { Scale = 1 }, 0.28, Enum.EasingStyle.Back)
            tween(DownScale, { Scale = 1 }, 0.28, Enum.EasingStyle.Back)
        else
            S.up, S.down = false, false
            tween(UpScale, { Scale = 0 }, 0.16)
            tween(DownScale, { Scale = 0 }, 0.16)
            task.delay(0.18, function()
                if not S.fly then
                    UpBtn.Visible, DownBtn.Visible = false, false
                end
            end)
        end
    end, "pads")))
end

