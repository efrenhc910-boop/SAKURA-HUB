local errCount = {}
local function safe(fn, label, parte)
    label = tostring(label or "?")
    local sitio = tostring(parte or "?")
    return function(...)
        local ok, err = pcall(fn, ...)
        if not ok then
            local n = (errCount[label] or 0) + 1
            errCount[label] = n
            if n <= 10 or n % 25 == 0 then
                warn("[DestroyaHub] PARTE " .. sitio .. " / " .. label .. ": " .. tostring(err))
            end
        end
        return ok
    end
end

local function debounced(fn)
    local pending = false
    return function()
        if pending then return end
        pending = true
        task.defer(function()
            pending = false
            local ok, err = pcall(fn)
            if not ok then warn("[DestroyaHub] PARTE 3 / debounced: " .. tostring(err)) end
        end)
    end
end

local function verify(name, fn)
    local ok, res = pcall(fn)
    if not ok or res == false then
        warn("[DestroyaHub] PARTE 21 / verify: comprobación fallida: " .. name)
        return false
    end
    return true
end

local function squish(btn, depth)
    local sc = Instance.new("UIScale")
    sc.Parent = btn
    btn.InputBegan:Connect(safe(function(i)
        if isPointer(i) then tween(sc, { Scale = depth or 0.95 }, 0.08, Enum.EasingStyle.Quad) end
    end, "squish", 3))
    btn.InputEnded:Connect(safe(function(i)
        if isPointer(i) then tween(sc, { Scale = 1 }, 0.22, Enum.EasingStyle.Back) end
    end, "squish", 3))
    return sc
end

local activeDrag, activeInput, activeEnd

local function endDrag()
    if not activeDrag then return end
    local fin = activeEnd
    activeDrag, activeInput, activeEnd = nil, nil, nil
    if UI.setScrollLock then pcall(UI.setScrollLock, false) end
    if fin then pcall(fin) end
end

local function beginDrag(input, handler, lockScroll, onEnd)
    endDrag()
    activeDrag, activeInput, activeEnd = handler, input, onEnd
    if lockScroll and UI.setScrollLock then pcall(UI.setScrollLock, true) end
end

