local errCount = {}
local function safe(fn, label)
    label = tostring(label or "?")
    return function(...)
        local ok, err = pcall(fn, ...)
        if not ok then
            local n = (errCount[label] or 0) + 1
            errCount[label] = n
            if n <= 3 or n % 25 == 0 then
                warn("[DestroyaHub] " .. label .. ": " .. tostring(err))
            end
        end
        return ok
    end
end

-- Cargador forzado: insiste hasta que IsLoaded, y ahí se detiene solo.
local function forzarImagen(label, urls, maxIntentos)
    if not label or not urls or #urls == 0 then return end
    maxIntentos = maxIntentos or 8
    if label.IsLoaded then return end

    local vivo, intentos, idx = true, 0, 1
    local conn

    local function parar()
        if not vivo then return end
        vivo = false
        if conn then
            pcall(function() conn:Disconnect() end)
            conn = nil
        end
    end

    conn = label:GetPropertyChangedSignal("IsLoaded"):Connect(function()
        if label.IsLoaded then parar() end
    end)

    task.spawn(function()
        while vivo and label.Parent and intentos < maxIntentos do
            if label.IsLoaded then break end
            intentos += 1
            local url = urls[idx]
            idx = idx % #urls + 1
            pcall(function() label.Image = url end)
            pcall(function() ContentProvider:PreloadAsync({ label }) end)
            if label.IsLoaded then break end
            task.wait(0.25 + intentos * 0.2)
        end
        parar()
    end)
end

