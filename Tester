local ultimoImpulso = 0

local function impulso()
    local root, hum = getParts()
    if not root or not hum then return end

    local ahora = os.clock()
    if ahora - ultimoImpulso < 0.2 then return end
    ultimoImpulso = ahora

    local g = Workspace.Gravity
    if not g or g <= 0 then g = 196.2 end
    local v = math.sqrt(2 * g * CONFIG.JUMP_HEIGHT)

    local vel = root.AssemblyLinearVelocity
    local horiz = Vector3.new(vel.X, 0, vel.Z)
    if horiz.Magnitude > 2 then horiz = horiz * 1.2 end

    task.defer(function()
        if root.Parent then
            root.AssemblyLinearVelocity = Vector3.new(horiz.X, v, horiz.Z)
        end
    end)
end

