local function pintar(char, skin)
    if not char or not skin then return end
    for _, par in ipairs(PARTES) do
        local p = char:FindFirstChild(par[1])
        local col = skin[par[2]]
        if p and p:IsA("BasePart") and col then
            if not SK.orig[p] then
                SK.orig[p] = { Color = p.Color, Material = p.Material }
            end
            pcall(function()
                p.Color = col
                p.Material = skin.mat or Enum.Material.SmoothPlastic
            end)
        end
    end
end

local function despintar()
    for p, d in pairs(SK.orig) do
        if p and p.Parent then
            pcall(function()
                p.Color = d.Color
                p.Material = d.Material
            end)
        end
    end
    SK.orig = {}
end

local function guardarRopa(char)
    if not char then return end
    for _, clase in ipairs({ "Shirt", "Pants" }) do
        local o = char:FindFirstChildOfClass(clase)
        if o then
            local campo = clase .. "Template"
            SK.ropa[#SK.ropa + 1] = { obj = o, campo = campo, valor = o[campo], nuevo = false }
            pcall(function() o[campo] = "" end)
        end
    end
end

local function ponerRopa(char, shirt, pants)
    if not char then return end
    local sh = char:FindFirstChildOfClass("Shirt")
    if not sh then
        sh = Instance.new("Shirt")
        sh.Parent = char
        SK.ropa[#SK.ropa + 1] = { obj = sh, campo = "ShirtTemplate", valor = "", nuevo = true }
    end
    pcall(function() sh.ShirtTemplate = "rbxassetid://" .. tostring(shirt) end)

    local pa = char:FindFirstChildOfClass("Pants")
    if not pa then
        pa = Instance.new("Pants")
        pa.Parent = char
        SK.ropa[#SK.ropa + 1] = { obj = pa, campo = "PantsTemplate", valor = "", nuevo = true }
    end
    pcall(function() pa.PantsTemplate = "rbxassetid://" .. tostring(pants) end)
end

local function devolverRopa()
    for _, d in ipairs(SK.ropa) do
        if d.obj and d.obj.Parent then
            if d.nuevo then
                pcall(function() d.obj:Destroy() end)
            else
                pcall(function() d.obj[d.campo] = d.valor end)
            end
        end
    end
    SK.ropa = {}
end

local function esconderAccesorios(char)
    if not char then return end
    local caja = char:FindFirstChild("DestroyaOrig")
    if not caja then
        caja = Instance.new("Folder")
        caja.Name = "DestroyaOrig"
        caja.Parent = char
    end
    for _, a in ipairs(char:GetChildren()) do
        if a:IsA("Accoutrement") then
            a.Parent = caja
            table.insert(SK.puestas, a)
        end
    end
end

local function devolverAccesorios(char)
    if not char then return end
    local caja = char:FindFirstChild("DestroyaOrig")
    if caja then
        for _, a in ipairs(caja:GetChildren()) do
            if a:IsA("Accoutrement") then a.Parent = char end
        end
        pcall(function() caja:Destroy() end)
    end
end

local function bajarAccesorio(id)
    if not id then return nil end
    local ok, res = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(id))
    end)
    if ok and res and res[1] then
        local obj = res[1]
        if obj:IsA("Accoutrement") then return obj end
        local dentro = obj:FindFirstChildWhichIsA("Accoutrement", true)
        if dentro then return dentro end
    end
    local ok2, modelo = pcall(function()
        return InsertService:LoadAsset(id)
    end)
    if ok2 and modelo then
        local dentro = modelo:FindFirstChildWhichIsA("Accoutrement", true)
        if dentro then return dentro end
    end
    return nil
end

local function montar(char, hum, id)
    if not char or not hum then return false end
    local acc = bajarAccesorio(id)
    if not acc then
        warn("[DestroyaHub] accesorio no cargado: " .. tostring(id))
        return false
    end
    acc.Parent = char
    local ok = pcall(function() hum:AddAccessory(acc) end)
    if not ok then
        local h = acc:FindFirstChild("Handle")
        local base = char:FindFirstChild("Head") or char:FindFirstChild("UpperTorso")
        if h and base then
            pcall(function()
                h.CFrame = base.CFrame
                h.CanCollide = false
                local w = Instance.new("WeldConstraint")
                w.Part0 = h
                w.Part1 = base
                w.Parent = h
            end)
        end
    end
    SK.puestas[#SK.puestas + 1] = acc
    return true
end

local function limpiarPuestas()
    for _, a in ipairs(SK.puestas) do
        if a and a.Parent and a:IsA("Accoutrement") then
            pcall(function() a:Destroy() end)
        end
    end
    SK.puestas = {}
end

local function clearSkin(silencioso)
    local char = player.Character
    limpiarPuestas()
    if char then
        despintar()
        devolverRopa()
        devolverAccesorios(char)
    else
        SK.orig, SK.ropa = {}, {}
    end
    S.skin = nil
    if UI.refrescarSkins then pcall(UI.refrescarSkins) end
    if UI.pintarActual then pcall(UI.pintarActual) end
    if not silencioso then notify("Skin quitada") end
end

local function setSkin(nombre)
    if SK.candado then return end
    local skin = SKINS[nombre]
    if not skin then
        notify("Skin desconocida")
        return
    end

    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum or hum.Health <= 0 then
        notify("Sin personaje")
        return
    end

    SK.candado = true
    local ok, err = pcall(function()
        if S.skin then clearSkin(true) end
        S.skin = nombre

        esconderAccesorios(char)
        guardarRopa(char)
        pintar(char, skin)
        ponerRopa(char, skin.shirt, skin.pants)

        local accs = skin.acc or {}
        local pre = {}
        for _, id in ipairs(accs) do
            pre[#pre + 1] = "rbxassetid://" .. tostring(id)
        end
        if #pre > 0 then pcall(function() ContentProvider:PreloadAsync(pre) end) end

        local fallas = 0
        for _, id in ipairs(accs) do
            if not montar(char, hum, id) then fallas = fallas + 1 end
            task.wait(0.12)
        end
        notify(fallas > 0 and (nombre .. " con " .. fallas .. " fallas") or (nombre .. " puesta"))
    end)
    SK.candado = false
    if not ok then
        warn("[DestroyaHub] skin: " .. tostring(err))
        notify("Error aplicando " .. nombre)
    end
    if UI.refrescarSkins then pcall(UI.refrescarSkins) end
    if UI.pintarActual then pcall(UI.pintarActual) end
end

