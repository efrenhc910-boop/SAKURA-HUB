local function bind(obj, prop, key)
    if obj and C[key] then obj[prop] = C[key] end
    return obj
end

local function tween(obj, props, time, style, dir)
    if not obj or not obj.Parent then return end
    local ok, t = pcall(function()
        return TweenService:Create(obj,
            TweenInfo.new(time or 0.2, style or Enum.EasingStyle.Quint,
                dir or Enum.EasingDirection.Out), props)
    end)
    if ok and t then
        pcall(function() t:Play() end)
        return t
    end
end

local function corner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = obj
    return c
end

local function stroke(obj, key, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = obj
    if key then bind(s, "Color", key) end
    return s
end

