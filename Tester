    if os.clock() >= statusUntil then UI.setStatus(botStatus()) end
    if UI.refreshLists then UI.refreshLists() end
end

setBot = function(on, forzar)
    on = on and true or false
    if on == S.bot then return end
    S.bot = on

    if on then
        if not S.fijado and not forzar then
            local pick = nearestPlayer()
            if pick then
                S.target = pick
                notify("I'm bot: @" .. pick.Name)
            else
                S.target = nil
                notify("Nadie a menos de " .. CONFIG.BOT_RANGE .. " studs")
            end
        end
        botMiss = 0
    else
        S.target = nil
        waitTime, botMiss = 0, 0
        if not S.fijado then pcall(releaseCamera) end
    end

    syncBot()
end

local function selectTarget(plr)
    if not plr or plr.Parent ~= Players then
        notify("Jugador no disponible")
        return
    end
    if S.fijado and S.fijado ~= plr then
        S.fijado = nil
        if UI.showFijoStop then UI.showFijoStop(false) end
    end
    if not S.bot then
        S.bot = true
        if UI.botToggle then UI.botToggle.Set(true, true) end
    end
    S.target = plr
    botMiss = 0
    syncBot()
end

local function fijar(plr)
    if not plr or plr.Parent ~= Players then
        notify("Jugador no disponible")
        return
    end

    if S.fijado == plr then
        S.fijado = nil
        S.target = nil
        syncBot()
        notify("Cámara libre")
        return
    end

    if not S.bot then
        S.bot = true
        if UI.botToggle then UI.botToggle.Set(true, true) end
    end

    S.fijado = plr
    S.target = plr
    botMiss, waitTime = 0, 0
    syncBot()
    notify("Fijo en @" .. plr.Name)
end

local function soltarFijo()
    if not S.fijado then return end
    S.fijado = nil
    S.target = nil
    syncBot()
    setStatusTemp("Fijo liberado, el bot sigue", 2.5)
end

local tpTarget

local function stopTP()
    if not S.tp then return end
    S.tp = false
    tpTarget = nil
    notify("TP detenido")
end

local function teletransportar(plr)
    if not plr or plr.Parent ~= Players then
        notify("Jugador no disponible")
        return
    end
    if S.tp then stopTP() end
    tpTarget = plr
    S.tp = true
    notify("TP a @" .. plr.Name)
    task.spawn(function()
        while S.tp and alive() and tpTarget == plr do
            local root = getParts()
            local c = plr.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            if root and r then
                pcall(function()
                    root.CFrame = r.CFrame + Vector3.new(0, 1.5, 0)
                end)
            end
            task.wait(0.35)
        end
    end)
end

local function tpSeleccionados()
    local primero = Sel.list[1]
    if not primero then
        notify("No hay seleccionados")
        return
    end
    teletransportar(primero)
end

