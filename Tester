    dcGui.Parent = char

    local fondo = Instance.new("Frame")
    fondo.Size = UDim2.fromScale(1, 1)
    fondo.BackgroundColor3 = Color3.fromRGB(20, 6, 10)
    fondo.BackgroundTransparency = 0.35
    fondo.BorderSizePixel = 0
    fondo.Parent = dcGui
    corner(fondo, 8)

    local borde = Instance.new("UIStroke")
    borde.Color = Color3.fromRGB(255, 60, 70)
    borde.Thickness = 1.4
    borde.Transparency = 0.25
    borde.Parent = fondo

    local l = Instance.new("TextLabel")
    l.Size = UDim2.fromScale(1, 1)
    l.BackgroundTransparency = 1
    l.Text = CONFIG.DISCORD
    l.TextSize = 14
    l.Font = F.head
    l.TextColor3 = Color3.fromRGB(255, 70, 80)
    l.TextStrokeTransparency = 0.4
    l.TextStrokeColor3 = Color3.new(0, 0, 0)
    l.Parent = fondo

    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 70)),
        ColorSequenceKeypoint.new(0.42, Color3.fromRGB(255, 60, 70)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.58, Color3.fromRGB(255, 60, 70)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 60, 70)),
    })
    g.Offset = Vector2.new(-1, 0)
    g.Parent = l

    if dcLoop then task.cancel(dcLoop) end
    dcLoop = task.spawn(function()
        while dcGui and dcGui.Parent do
            g.Offset = Vector2.new(-1, 0)
            tween(g, { Offset = Vector2.new(1, 0) }, 1.2, Enum.EasingStyle.Linear)
            task.wait(10)
        end
    end)
end

local function setDiscord(on)
    S.dc = on
    if on then
        aplicarDiscord()
        task.spawn(function()
            for _ = 1, 20 do
                task.wait(0.5)
                if not S.dc or (dcGui and dcGui.Parent) then return end
                aplicarDiscord()
            end
        end)
    else
        if dcLoop then task.cancel(dcLoop) dcLoop = nil end
        if dcGui then pcall(function() dcGui:Destroy() end) dcGui = nil end
    end
end

task.spawn(function()
    task.wait(2)
    if S.dc then pcall(aplicarDiscord) end
end)

