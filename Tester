            elseif kind == "tex" then
                if isCharacter(inst) then return end
                saved = { Transparency = inst.Transparency }
                inst.Transparency = 1
            elseif kind == "atmo" then
                saved = { Density = inst.Density, Haze = inst.Haze }
                inst.Density, inst.Haze = 0, 0
            elseif kind == "sa" then
                if isCharacter(inst) then return end
                saved = { Parent = inst.Parent }
                inst.Parent = nil
            elseif kind == "boom" then
                saved = { Visible = inst.Visible }
                inst.Visible = false
            else
                if isCharacter(inst) then return end
                saved = { Material = inst.Material, Reflectance = inst.Reflectance, CastShadow = inst.CastShadow }
                inst.Material = Enum.Material.SmoothPlastic
                inst.Reflectance = 0
                inst.CastShadow = false
                if inst:IsA("MeshPart") then
                    saved.TextureID = inst.TextureID
                    saved.RenderFidelity = inst.RenderFidelity
                    inst.TextureID = ""
                    inst.RenderFidelity = Enum.RenderFidelity.Performance
                end
            end
        end)
        if saved then orig[inst] = saved end
    end

    local function sweep(list, myToken)
        local t0 = os.clock()
        for i = 1, #list do
            if myToken ~= token or not S.boost then return end
            boost(list[i])
            if os.clock() - t0 > 0.008 then
                RunService.Heartbeat:Wait()
                t0 = os.clock()
            end
        end
    end

    local function applyGlobal()
        pcall(function()
            glob.Quality = settings().Rendering.QualityLevel
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)
        pcall(function()
            glob.Mesh = settings().Rendering.MeshPartDetailLevel
            settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04
        end)
        pcall(function()
            glob.Shadows = Lighting.GlobalShadows
            Lighting.GlobalShadows = false
        end)
        pcall(function()
            glob.Soft = Lighting.ShadowSoftness
            Lighting.ShadowSoftness = 0
        end)
        pcall(function()
            glob.EnvD, glob.EnvS = Lighting.EnvironmentDiffuseScale, Lighting.EnvironmentSpecularScale
            Lighting.EnvironmentDiffuseScale = 0
            Lighting.EnvironmentSpecularScale = 0
        end)
        pcall(function()
            local ms = game:GetService("MaterialService")
            glob.Mat = ms.Use2022Materials
            ms.Use2022Materials = false
        end)
        pcall(function()
            local t = Workspace.Terrain
            glob.Terrain = { WaterWaveSize = t.WaterWaveSize, WaterWaveSpeed = t.WaterWaveSpeed, WaterReflectance = t.WaterReflectance }
            glob.Decoration = t.Decoration
            t.WaterWaveSize, t.WaterWaveSpeed, t.WaterReflectance = 0, 0, 0
            t.Decoration = false
        end)
        pcall(function()
            if sethiddenproperty and gethiddenproperty then
                glob.Tech = gethiddenproperty(Lighting, "Technology")
                sethiddenproperty(Lighting, "Technology", Enum.Technology.Compatibility)
            end
        end)
    end

    local function restoreGlobal()
        pcall(function() if glob.Quality then settings().Rendering.QualityLevel = glob.Quality end end)
        pcall(function() if glob.Mesh then settings().Rendering.MeshPartDetailLevel = glob.Mesh end end)
        pcall(function() if glob.Shadows ~= nil then Lighting.GlobalShadows = glob.Shadows end end)
        pcall(function() if glob.Soft ~= nil then Lighting.ShadowSoftness = glob.Soft end end)
        pcall(function()
            if glob.EnvD then
                Lighting.EnvironmentDiffuseScale = glob.EnvD
                Lighting.EnvironmentSpecularScale = glob.EnvS
            end
        end)
        pcall(function()
            if glob.Mat ~= nil then game:GetService("MaterialService").Use2022Materials = glob.Mat end
        end)
        pcall(function()
            if glob.Terrain then
                for k, v in pairs(glob.Terrain) do Workspace.Terrain[k] = v end
            end
            if glob.Decoration ~= nil then Workspace.Terrain.Decoration = glob.Decoration end
        end)
        pcall(function()
            if glob.Tech and sethiddenproperty then sethiddenproperty(Lighting, "Technology", glob.Tech) end
        end)
        glob = {}
    end

    setFpsBoost = function(enabled)
        enabled = enabled and true or false
        if enabled == S.boost then return end
        S.boost = enabled
        token += 1
        local myToken = token
        if enabled then
            applyGlobal()
            if conn then pcall(function() conn:Disconnect() end) end
            conn = Workspace.DescendantAdded:Connect(safe(function(inst)
                if S.boost then task.defer(boost, inst) end
            end, "boostNew"))
            task.spawn(function()
                sweep(Lighting:GetDescendants(), myToken)
                local cam = Workspace.CurrentCamera
                if cam then sweep(cam:GetDescendants(), myToken) end
                sweep(Workspace:GetDescendants(), myToken)
            end)
        else
            if conn then
                pcall(function() conn:Disconnect() end)
                conn = nil
            end
            for inst, saved in pairs(orig) do
                pcall(function()
                    for prop, value in pairs(saved) do inst[prop] = value end
                end)
            end
            table.clear(orig)
            restoreGlobal()
        end
    end
end

local WALL_RADIUS = CONFIG.WALL_RADIUS
local WALL_ALPHA = CONFIG.WALL_ALPHA
local LIMITE = CONFIG.STRUCT_LIMIT

local function esPiso(part)
    if not part then return true end
    local sz = part.Size
    if sz.Y <= 1.5 and (sz.X >= 8 or sz.Z >= 8) then return true end
    local n = string.lower(part.Name)
    return n:find("floor") ~= nil or n:find("piso") ~= nil
        or n:find("ground") ~= nil or n:find("suelo") ~= nil or n:find("base") ~= nil
end

local function estructurasCerca(root)
    local p = OverlapParams.new()
    p.FilterType = Enum.RaycastFilterType.Exclude
    p.FilterDescendantsInstances = { player.Character }
    p.MaxParts = 4000

    local hits = Workspace:GetPartBoundsInRadius(root.Position, WALL_RADIUS, p)
    local list = {}
    for _, part in ipairs(hits) do
        if part:IsA("BasePart") and part.Parent and not esPiso(part) then
            local c = part.ClassName
            if c == "WedgePart" or c == "TrussPart" or c == "MeshPart" or c == "Part" then
                list[#list + 1] = { part = part, d = (part.Position - root.Position).Magnitude }
            end
        end
    end
    table.sort(list, function(a, b) return a.d < b.d end)
    return list
end

do
    local saved = {}
    local running = false
    local lastPos, lastScan = nil, 0

    local function restore(part)
        local t = saved[part]
        if t ~= nil then
            saved[part] = nil
            pcall(function() part.Transparency = t end)
        end
    end

    local function restoreAll()
        for part in pairs(saved) do restore(part) end
        table.clear(saved)
    end

    local function apagar(aviso)
        restoreAll()
        S.walls = false
        if UI.wallsToggle then UI.wallsToggle.Set(false, true) end
        if UI.setStatus then UI.setStatus(aviso) end
        notify(aviso)
    end

    local function debeEscanear(root)
        local now = os.clock()
        if now - lastScan < 0.5 then return false end
        if lastPos and (root.Position - lastPos).Magnitude < 6 then return false end
        lastScan = now
        lastPos = root.Position
        return true
    end

    local function cycle()
        local root = getParts()
        if not root then return true end
        if not debeEscanear(root) then return true end

        local list = estructurasCerca(root)
        if #list > LIMITE then
            apagar("Paredes apagadas: " .. #list .. " estructuras en " .. WALL_RADIUS .. " studs")
            return false
        end

        local seen = {}
        for i = 1, math.min(#list, LIMITE) do
            local part = list[i].part
            if part.Parent then
                seen[part] = true
                if saved[part] == nil then
                    local t = part.Transparency
                    if t < 0.6 then
                        saved[part] = t
                        pcall(function() part.Transparency = WALL_ALPHA end)
                    end
                end
            end
        end

        for part in pairs(saved) do
            if not seen[part] or not part.Parent then
                if part.Parent then restore(part) else saved[part] = nil end
            end
        end
        return true
    end

    setWalls = function(on)
        on = on and true or false
        if on == S.walls then return end
        S.walls = on
        if on then
            lastPos, lastScan = nil, 0
            if running then return end
            running = true
            task.spawn(function()
                while S.walls and alive() do
                    local ok = cycle()
                    if ok == false then break end
                    task.wait(0.35)
                end
                running = false
                restoreAll()
            end)
        else
            restoreAll()
        end
    end
end

