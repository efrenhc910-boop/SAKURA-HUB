local tagGui, tagShine

local function quitarTag()
    if tagGui then
        pcall(function() tagGui:Destroy() end)
        tagGui = nil
    end
    if tagShine then
        pcall(function() tagShine:Cancel() end)
        tagShine = nil
    end
end

local function aplicarTag()
    local char = player.Character
    if not char or not char.Parent or not S.tag then return end
    quitarTag()

    local head = char:FindFirstChild("Head")
    if not head then return end

    tagGui = Instance.new("BillboardGui")
    tagGui.Name = "DestroyaTag"
    tagGui.Size = UDim2.fromOffset(200, 36)
    tagGui.StudsOffset = Vector3.new(0, 5.6, 0)
    tagGui.AlwaysOnTop = true
    tagGui.LightInfluence = 0
    tagGui.MaxDistance = 800
    tagGui.Adornee = head
    tagGui.Parent = head

    -- Si los nombres están ocultos, la etiqueta nace apagada pero no se borra
    if hideSaved[player] then tagGui.Enabled = false end

    local marco = Instance.new("Frame")
    marco.Size = UDim2.fromScale(1, 1)
    marco.BackgroundColor3 = Color3.fromRGB(30, 6, 10)
    marco.BackgroundTransparency = 0.15
    marco.BorderSizePixel = 0
    marco.Parent = tagGui
    corner(marco, 9)

    local borde = Instance.new("UIStroke")
    borde.Color = Color3.fromRGB(255, 70, 90)
    borde.Thickness = 1.8
    borde.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    borde.Parent = marco

    local brillo = Instance.new("UIGradient")
    brillo.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(60, 8, 14)),
        ColorSequenceKeypoint.new(0.45, Color3.fromRGB(200, 40, 60)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 190, 200)),
        ColorSequenceKeypoint.new(0.55, Color3.fromRGB(200, 40, 60)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(60, 8, 14)),
    })
    brillo.Offset = Vector2.new(-0.6, 0)
    brillo.Parent = marco

    pcall(function()
        tagShine = TweenService:Create(brillo,
            TweenInfo.new(1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
            { Offset = Vector2.new(0.6, 0) })
        tagShine:Play()
    end)

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.fromScale(1, 1)
    txt.BackgroundTransparency = 1
    txt.Font = F.head
    txt.TextSize = 12
    txt.TextColor3 = Color3.fromRGB(255, 236, 238)
    txt.Text = "discord.gg/ykHwgmQnD"
    txt.Parent = marco

    local boton = Instance.new("TextButton")
    boton.Size = UDim2.fromScale(1, 1)
    boton.BackgroundTransparency = 1
    boton.Text = ""
    boton.Parent = marco
    boton.Activated:Connect(safe(function()
        pcall(function() setclipboard(CONFIG.DISCORD) end)
        notify("Enlace copiado")
    end, "tag"))
end

