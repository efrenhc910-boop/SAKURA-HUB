local camHeld, camPrev, camPrevRot, camErr = false, nil, nil, 0
local camParams = RaycastParams.new()
camParams.FilterType = TIPO_FILTRO
camParams.IgnoreWater = true
camParams.RespectCanCollide = true

local CAM_DIST = 9
local CAM_UP = 3.4
local PIVOT_UP = 2.2

local lastDir = Vector3.new(0, 0, -1)
local waitTime, botMiss = 0, 0
local statusUntil = 0

local function setStatusTemp(t, seg)
