local function forzarImagen(label, lista, maxIntentos)
    if not label or not lista or #lista == 0 then return end
    maxIntentos = maxIntentos or 6
    if label.IsLoaded then return end

    local vivo, intentos, idx = true, 0, 1
    local connCarga

    local function parar()
        if not vivo then return end
        vivo = false
        if connCarga then
            pcall(function() connCarga:Disconnect() end)
            connCarga = nil
        end
    end

    connCarga = label:GetPropertyChangedSignal("IsLoaded"):Connect(function()
        if label.IsLoaded then parar() end
    end)

    task.spawn(function()
        while vivo and label.Parent and intentos < maxIntentos do
            if label.IsLoaded then break end
            intentos += 1
            local url = lista[idx]
            idx = idx % #lista + 1
            pcall(function() label.Image = url end)
            pcall(function() ContentProvider:PreloadAsync({ label }) end)
            if label.IsLoaded then break end
            task.wait(0.4 + intentos * 0.25)
        end
        parar()
    end)
end

local function ajustarEscala()
    local cam = getCamera()
    local vs = cam and cam.ViewportSize or Vector2.new(CONFIG.BASE_W, CONFIG.BASE_H)
    local fit = math.min(1, (vs.X - 24) / CONFIG.BASE_W, (vs.Y - 24) / CONFIG.BASE_H)
    UI.fit = math.clamp(fit, 0.35, 1)
end

local function aplicarEscala()
    if UI.closing or not MenuScale or not MenuScale.Parent then return end
    local objetivo = UI.size * UI.fit
    if math.abs(MenuScale.Scale - objetivo) > 0.02 then
        MenuScale.Scale = objetivo
    end
end

