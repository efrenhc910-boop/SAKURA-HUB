local hideSaved = {}

local function restaurarNombre(plr)
    local d = hideSaved[plr]
    if not d then return end
    hideSaved[plr] = nil
    if d.hum and d.hum.Parent and d.tipo then
        pcall(function() d.hum.DisplayDistanceType = d.tipo end)
    end
    for _, g in ipairs(d.guis or {}) do
        if g and g.Parent then pcall(function() g.Enabled = true end) end
    end
end

local function restaurarTodos()
    for plr in pairs(hideSaved) do restaurarNombre(plr) end
    table.clear(hideSaved)
    if S.tag then pcall(aplicarTag) end
end

local function ocultarNombre(plr)
    if not plr or plr == player or hideSaved[plr] then return end
    local char = plr.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local reg = { hum = hum, tipo = hum and hum.DisplayDistanceType, guis = {} }
    hideSaved[plr] = reg
    if hum then pcall(function() hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end) end
    for _, g in ipairs(char:GetDescendants()) do
        if g:IsA("BillboardGui") and g.Enabled then
            local n = g.Name
            if n ~= "DestroyaTag" and n ~= "DestroyaESP" then
                reg.guis[#reg.guis + 1] = g
                pcall(function() g.Enabled = false end)
            end
        end
    end
end

do
    local parts, changed = {}, {}

    local function restore()
        for p in pairs(changed) do
            if p and p.Parent then
                pcall(function() p.CanCollide = true end)
            end
        end
        table.clear(changed)
        table.clear(parts)
    end

    local function cachear()
        table.clear(parts)
        local char = player.Character
        if char then
            for _, d in ipairs(char:GetDescendants()) do
                if d:IsA("BasePart") then parts[#parts + 1] = d end
            end
        end
    end

    setNoclip = function(on)
        on = on and true or false
        S.noclip = on
        if on then
            cachear()
        else
            restore()
        end
    end

    track(RunService.Stepped:Connect(safe(function()
        if not S.noclip then
            if next(changed) then restore() end
            return
        end
        for i = 1, #parts do
            local p = parts[i]
            if p and p.Parent and p.CanCollide then
                changed[p] = true
                pcall(function() p.CanCollide = false end)
            end
        end
    end, "noclip", 13)))

    track(player.CharacterAdded:Connect(function()
        table.clear(changed)
        table.clear(parts)
        if S.noclip then task.delay(1, cachear) end
    end))
end

local function impulso()
    local root, hum = getParts()
    if not root or not hum then return end
    if hum.FloorMaterial == Enum.Material.Air then return end
    local g = Workspace.Gravity
    if g <= 0 then g = 196.2 end
    local v = math.sqrt(2 * g * CONFIG.JUMP_HEIGHT)
    local hx = math.clamp(root.AssemblyLinearVelocity.X * 1.15, -60, 60)
    local hz = math.clamp(root.AssemblyLinearVelocity.Z * 1.15, -60, 60)
    pcall(function()
        root.AssemblyLinearVelocity = Vector3.new(hx, v, hz)
    end)
end

local function setJumpPower(on)
    on = on and true or false
    S.jumpPower = on
    local _, hum = getParts()
    if not hum then return end
    if on then
        if not S.jumpPowerPrevio then
            S.jumpPowerPrevio = { Use = hum.UseJumpPower, Power = hum.JumpPower }
        end
        pcall(function() hum.UseJumpPower = false end)
    elseif S.jumpPowerPrevio then
        pcall(function()
            hum.UseJumpPower = S.jumpPowerPrevio.Use
            hum.JumpPower = S.jumpPowerPrevio.Power
        end)
        S.jumpPowerPrevio = nil
    end
end

track(UserInputService.JumpRequest:Connect(safe(function()
    local _, hum = getParts()
    if S.jumpPower then impulso() end
    if S.infJump and hum and hum.Health > 0 then
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
    end
end, "salto", 13)))

local flyBV, flyBG

setFly = function(on)
    on = on and true or false
    local yaVolaba = S.fly
    S.fly = on
    if not yaVolaba then S.up, S.down = false, false end
    local root, hum = getParts()

    if on and root and hum then
        pcall(function()
            if flyBV then flyBV:Destroy() end
            if flyBG then flyBG:Destroy() end
            flyBV, flyBG = nil, nil

            flyBV = Instance.new("BodyVelocity")
            flyBV.Name = "DestroyaFly"
            flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            flyBV.Velocity = Vector3.zero
            flyBV.Parent = root

            flyBG = Instance.new("BodyGyro")
            flyBG.Name = "DestroyaGyro"
            flyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
            flyBG.P = 2500
            flyBG.D = 120
            flyBG.CFrame = root.CFrame
            flyBG.Parent = root

            hum.PlatformStand = true
        end)
    else
        if flyBV then
            pcall(function() flyBV:Destroy() end)
            flyBV = nil
        end
        if flyBG then
            pcall(function() flyBG:Destroy() end)
            flyBG = nil
        end
        if hum then pcall(function() hum.PlatformStand = false end) end
    end
end