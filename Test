end

local function watchDeath(plr)
    clearDeathWatch()
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    TP.died = hum.Died:Connect(function()
        if TP.target == plr then stopTP("El objetivo murió") end
    end)
end

local function startTP(plr)
    if TP.target == plr then
        stopTP("TP cancelado")
        return
    end
    if not plr or plr.Parent ~= Players then
        notify("Jugador no disponible")
        return
    end
    if not getParts() then
        notify("Tu personaje no está listo")
        return
    end
    TP.target = plr
    TP.missing = 0
    S.tpActive = true
    watchDeath(plr)
    notify("TP activo en @" .. plr.Name)
    if UI.showTpStop then UI.showTpStop(true) end
    if UI.refreshLists then UI.refreshLists() end
end

track(RunService.Heartbeat:Connect(function(dt)
    local plr = TP.target
    if not plr then return end
    local ok, err = pcall(function()
        local root = getParts()
        if not root then return end
        if plr.Parent ~= Players then
            stopTP("El jugador salió del juego")
            return
        end
        local tChar = plr.Character
        local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if tHum and tHum.Health <= 0 then
            stopTP("El objetivo murió")
            return
        end
        if not tRoot then
            TP.missing += dt
            if TP.missing > 3 then stopTP("El jugador no tiene personaje") end
            return
        end
        TP.missing = 0

        local look = tRoot.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
        flat = flat.Unit

        local goal = tRoot.Position - flat * 3.2
        local diff = goal - root.Position
        local dist = diff.Magnitude

        if dist <= 1.5 then
            root.CFrame = CFrame.lookAt(goal, goal + flat)
            root.AssemblyLinearVelocity = Vector3.zero
            return
        end

        local dir = diff.Unit
        local newPos = root.Position + dir * math.min(dist, S.tpSpeed * dt)
