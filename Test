local function project(cam, pos)
    local sp, on = cam:WorldToViewportPoint(pos)
    if not on or sp.Z <= 0 then return nil end
    return Vector2.new(sp.X, sp.Y)
end

local function stepESP()
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local myChar = player.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local char = plr.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local d = espData[plr]

            if not (char and root) then
                if d then removeESP(plr) end
            else
                if not d or d.char ~= char then
                    removeESP(plr)
                    d = newData(char)
                    espData[plr] = d
                end

                local dist = myRoot and math.floor((root.Position - myRoot.Position).Magnitude + 0.5) or 0
                if dist > ESP_MAX then
                    if d.txt ~= "" then
                        d.txt = ""
                        for _, l in ipairs(d.lines) do l.Visible = false end
                        txtSet(d, "", PAL.enemy, false)
                    end
                else
                    local ally = isAlly(plr)
                    local col = ally and PAL.ally or PAL.enemy
                    if d.ally ~= ally then
                        d.ally = ally
                        for _, l in ipairs(d.lines) do l.Color = col end
                    end

                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local pct = 0
                    if hum and hum.MaxHealth > 0 then
                        pct = math.floor(math.max(0, hum.Health) / hum.MaxHealth * 100 + 0.5)
                    end
                    local s = plr.Name .. " | " .. dist .. " m | " .. pct .. "%"
                    if d.txt ~= s then
                        d.txt = s
                        txtSet(d, s, col, true)
                    elseif d.text and not d.text.Visible then
                        d.text.Visible = true
                    elseif d.label and not d.bb.Enabled then
                        d.bb.Enabled = true
                    end

                    local head = char:FindFirstChild("Head") or root
                    if HAS_DRAWING then
                        local hp = project(cam, head.Position + Vector3.new(0, 0.9, 0))
                        if hp then d.text.Position = hp else d.text.Visible = false end
                        for i, bone in ipairs(d.bones) do
                            local l = d.lines[i]
                            local a = project(cam, bone[1].Position)
                            local b = project(cam, bone[2].Position)
                            if a and b then
                                l.From = a
                                l.To = b
                                l.Visible = true
                            else
                                l.Visible = false
                            end
                        end
                    else
                        if d.bb.Adornee ~= head then d.bb.Adornee = head end
                    end
                end
            end
        end
    end
end

