    ally = Color3.fromRGB(60, 145, 255),
}
local espData = {}
local espAcc = 0

local function isAlly(plr)
    if player.Team ~= nil and plr.Team ~= nil then return plr.Team == player.Team end
    local a, b = player:GetAttribute("Team"), plr:GetAttribute("Team")
    if a ~= nil and b ~= nil then return a == b end
    return false
end

local function findPart(char, ...)
    for i = 1, select("#", ...) do
        local p = char:FindFirstChild((select(i, ...)))
        if p and p:IsA("BasePart") then return p end
    end
    return nil
end

local function buildBones(char)
    local list = {}
    local head = findPart(char, "Head")
    local torso = findPart(char, "UpperTorso", "Torso")
    local lower = findPart(char, "LowerTorso", "Torso")
    local la = findPart(char, "LeftUpperArm", "Left Arm")
    local ra = findPart(char, "RightUpperArm", "Right Arm")
    local lf = findPart(char, "LeftLowerArm", "Left Arm")
    local rf = findPart(char, "RightLowerArm", "Right Arm")
    local lul = findPart(char, "LeftUpperLeg", "Left Leg")
    local rul = findPart(char, "RightUpperLeg", "Right Leg")
    local lll = findPart(char, "LeftLowerLeg", "Left Leg")
    local rll = findPart(char, "RightLowerLeg", "Right Leg")

    local function add(a, b)
        if a and b then list[#list + 1] = { a, b } end
    end
    add(head, torso)
    add(torso, lower)
    add(torso, la)
    add(la, lf)
    add(torso, ra)
    add(ra, rf)
    add(lower, lul)
    add(lul, lll)
    add(lower, rul)
    add(rul, rll)
    return list
end

local function removeESP(plr)
    local d = espData[plr]
    if not d then return end
    espData[plr] = nil
    for _, l in ipairs(d.lines) do
