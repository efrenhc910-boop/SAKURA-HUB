local binds, painters, slowPainters, conns = {}, {}, {}, {}
local UI = { led = true, open = true, size = 1, anim = true }

local function track(c)
    conns[#conns + 1] = c
    return c
end

local function bind(obj, prop, key)
    binds[#binds + 1] = { obj, prop, key }
    obj[prop] = C[key]
    return obj
end

local function onTheme(fn)
    painters[#painters + 1] = fn
    fn()
end

local function onThemeSlow(fn)
    slowPainters[#slowPainters + 1] = fn
end

local slowPending = false
local function scheduleSlow()
    if slowPending then return end
    slowPending = true
    task.delay(0.35, function()
        slowPending = false
        for i = 1, #slowPainters do pcall(slowPainters[i]) end
    end)
end

local function applyTheme(t)
    for k, v in pairs(t) do C[k] = v end
    C.RowOn = t.Row:Lerp(t.Acc, 0.35)
    for i = 1, #binds do
        local b = binds[i]
        pcall(function() b[1][b[2]] = C[b[3]] end)
    end
    for i = 1, #painters do pcall(painters[i]) end
    scheduleSlow()
end
applyTheme(CIAN)

local function makeTheme(h, s, v)
    local acc = Color3.fromHSV(h, s, math.max(v, 0.6))
    return {
        Acc = acc, Acc2 = acc:Lerp(Color3.new(1, 1, 1), 0.45),
        Dark = Color3.fromHSV(h, s * 0.7, 0.09), Panel = Color3.fromHSV(h, s * 0.7, 0.15),
        Row = Color3.fromHSV(h, s * 0.7, 0.24), Off = Color3.fromHSV(h, s * 0.5, 0.32),
        Tab = Color3.fromHSV(h, s * 0.7, 0.18),
    }
end

local function tween(obj, props, time, style)
    local t = TweenService:Create(obj, TweenInfo.new(time or 0.2, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function corner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = obj
    return c
end

local function stroke(obj, key, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = obj
    if key then bind(s, "Color", key) end
    return s
end

local function plain(parent, text, size, font, color, pos, sz, alignX)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextSize = size
    l.Font = font
    l.TextColor3 = color
    l.TextXAlignment = alignX or Enum.TextXAlignment.Left
    if pos then l.Position = pos end
    if sz then l.Size = sz end
    l.Parent = parent
    return l
end

local function mkLabel(parent, text, size, font, key, pos, sz, alignX)
    local l = plain(parent, text, size, font, C[key], pos, sz, alignX)
    bind(l, "TextColor3", key)
    return l
end

local function isPointer(input)
    return input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1
end

local function screenPos(input)
    local inset = GuiService:GetGuiInset()
    return Vector2.new(input.Position.X + inset.X, input.Position.Y + inset.Y)
end

local orderN = 0
local function nextOrder()
    orderN += 1
    return orderN
end

local function safe(fn, label)
    return function(...)
        local ok, err = pcall(fn, ...)
        if not ok then warn("[DestroyaHub] " .. tostring(label) .. ": " .. tostring(err)) end
    end
end

local function debounced(fn)
    local pending = false
    return function()
        if pending then return end
        pending = true
        task.defer(function()
            pending = false
            local ok, err = pcall(fn)
            if not ok then warn("[DestroyaHub] " .. tostring(err)) end
        end)
    end
end

local function squish(btn)
    local sc = Instance.new("UIScale")
    sc.Parent = btn
    btn.InputBegan:Connect(function(i)
        if isPointer(i) then tween(sc, { Scale = 0.94 }, 0.07) end
    end)
    btn.InputEnded:Connect(function(i)
        if isPointer(i) then tween(sc, { Scale = 1 }, 0.16, Enum.EasingStyle.Back) end
    end)
end

local activeDrag, activeInput
local function beginDrag(input, handler)
    activeDrag, activeInput = handler, input
end
track(UserInputService.InputChanged:Connect(function(input)
    if activeDrag and (input == activeInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
        local ok, err = pcall(activeDrag, input)
        if not ok then
            activeDrag, activeInput = nil, nil
            warn("[DestroyaHub] arrastre: " .. tostring(err))
        end
    end
end))
track(UserInputService.InputEnded:Connect(function(input)
    if activeDrag and (input == activeInput or input.UserInputType == Enum.UserInputType.MouseButton1) then
        activeDrag, activeInput = nil, nil
    end
end))

