local function project(cam, pos)
    local sp, on = cam:WorldToViewportPoint(pos)
    if not on or sp.Z <= 0 then return nil end
    return Vector2.new(sp.X, sp.Y)
end

local function stepESP()
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local myChar = player.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local char = plr.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local d = espData[plr]

            if not (char and root) then
                if d then removeESP(plr) end
            else
                if not d or d.char ~= char then
                    removeESP(plr)
                    d = newData(char)
                    espData[plr] = d
                end

                local dist = myRoot and math.floor((root.Position - myRoot.Position).Magnitude + 0.5) or 0
                if dist > ESP_MAX then
                    if d.txt ~= "" then
                        d.txt = ""
                        setVisible(d, false)
                    end
                else
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local hp, mx = 0, 100
                    if hum then
                        hp = math.max(0, math.floor(hum.Health + 0.5))
                        mx = math.max(1, math.floor(hum.MaxHealth + 0.5))
                    end
                    local s = plr.Name .. "  |  " .. hp .. " HP  |  " .. dist .. " studs"
                    if d.txt ~= s then
                        d.txt = s
                        txtSet(d, s, true)
                    elseif d.text and not d.text.Visible then
                        setVisible(d, true)
                    end

                    local head = char:FindFirstChild("Head") or root
                    if HAS_DRAWING then
                        local tp = project(cam, head.Position + Vector3.new(0, 1.25, 0))
                        if tp then
                            d.text.Position = tp
                            d.shadow.Position = tp + Vector2.new(1.5, 1.5)
                            local w = math.clamp(#s * 5.4, 110, 320)
                            d.bar.From = Vector2.new(tp.X - w / 2, tp.Y + 12)
                            d.bar.To = Vector2.new(tp.X + w / 2, tp.Y + 12)
                        else
                            setVisible(d, false)
                        end
                        for i, bone in ipairs(d.bones) do
                            local l = d.lines[i]
                            local a = project(cam, bone[1].Position)
                            local b = project(cam, bone[2].Position)
                            if a and b then
                                l.From = a
                                l.To = b
                                l.Visible = true
                            else
                                l.Visible = false
                            end
                        end
                    else
                        if d.bb.Adornee ~= head then d.bb.Adornee = head end
                    end
                end
            end
        end
    end
end

