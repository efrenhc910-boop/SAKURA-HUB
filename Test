        d.label.TextColor3 = col
        d.bb.Enabled = show
    end
end

local function newData(char)
    local d = { char = char, bones = buildBones(char), lines = {}, ally = nil, txt = "", dist = -1 }

    if HAS_DRAWING then
        for _ = 1, #d.bones do
            local l = Drawing.new("Line")
            l.Thickness = 1.6
            l.Transparency = 1
