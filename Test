        local dir = diff.Unit
        local newPos = root.Position + dir * math.min(dist, S.tpSpeed * dt)
        root.CFrame = CFrame.lookAt(newPos, newPos + Vector3.new(dir.X, 0, dir.Z))
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)
    if not ok then
        warn("[DestroyaHub] TP: " .. tostring(err))
        stopTP("TP detenido por un error")
