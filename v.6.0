--==================================================
--            DESTROYA HUB  •  PARTE 5 / 14
--        COMPONENTES: BARRAS Y SECCIONES DESLIZANTES
--==================================================

local function createSlider(page, name, min, max, default, fmt, callback)
    local cb = callback and safe(callback, name)

    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -4, 0, 46)
    row.BackgroundTransparency = 0.06
    row.LayoutOrder = nextOrder()
    row.Parent = page
    bind(row, "BackgroundColor3", "Row")
    corner(row, 10)

    mkLabel(row, string.upper(name), 12, F.head, "White", UDim2.fromOffset(12, 5), UDim2.new(0.62, 0, 0, 16))
    local valueL = mkLabel(row, "", 12, F.head, "Acc2", UDim2.new(0.62, 0, 0, 5),
        UDim2.new(0.38, -12, 0, 16), Enum.TextXAlignment.Right)

    local hit = Instance.new("Frame")
    hit.Size = UDim2.new(1, -24, 0, 24)
    hit.Position = UDim2.fromOffset(12, 21)
    hit.BackgroundTransparency = 1
    hit.Parent = row

    local barF = Instance.new("Frame")
    barF.AnchorPoint = Vector2.new(0, 0.5)
    barF.Position = UDim2.fromScale(0, 0.5)
    barF.Size = UDim2.new(1, 0, 0, 6)
    barF.BorderSizePixel = 0
    barF.Parent = hit
    bind(barF, "BackgroundColor3", "Off")
    corner(barF, 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(0, 1)
    fill.BorderSizePixel = 0
    fill.Parent = barF
    bind(fill, "BackgroundColor3", "Acc")
    corner(fill, 3)

    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Size = UDim2.fromOffset(15, 15)
    knob.BorderSizePixel = 0
    knob.Parent = barF
    bind(knob, "BackgroundColor3", "White")
    corner(knob, 8)

    local function setRatio(r)
        r = math.clamp(r, 0, 1)
        fill.Size = UDim2.fromScale(r, 1)
        knob.Position = UDim2.fromScale(r, 0.5)
        local value = min + (max - min) * r
        valueL.Text = fmt(value)
        if cb then cb(value) end
    end

    local function fromInput(input)
        local w = barF.AbsoluteSize.X
        if w > 0 then setRatio((input.Position.X - barF.AbsolutePosition.X) / w) end
    end

    hit.InputBegan:Connect(function(input)
        if isPointer(input) then
            fromInput(input)
            tween(knob, { Size = UDim2.fromOffset(20, 20) }, 0.12, Enum.EasingStyle.Back)
            beginDrag(input, fromInput, true, function()
                tween(knob, { Size = UDim2.fromOffset(15, 15) }, 0.16)
            end)
        end
    end)

    setRatio((default - min) / (max - min))
    return row
end

-- Sección deslizante: al tocarla se despliega (el contenido se arma una sola vez)
local function createCollapsible(page, title, height, onFirstOpen)
    local HEAD = 38
    local contentH = height or 0
    local open, built = false, false

    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -4, 0, HEAD)
    holder.BackgroundTransparency = 0.06
    holder.ClipsDescendants = true
    holder.LayoutOrder = nextOrder()
    holder.Parent = page
    bind(holder, "BackgroundColor3", "Row")
    corner(holder, 10)

    local head = Instance.new("TextButton")
    head.Size = UDim2.new(1, 0, 0, HEAD)
    head.BackgroundTransparency = 1
    head.Text = ""
    head.AutoButtonColor = false
    head.Parent = holder
    squish(head, 0.98)

    local dia = Instance.new("Frame")
    dia.AnchorPoint = Vector2.new(0.5, 0.5)
    dia.Position = UDim2.fromOffset(18, HEAD / 2)
    dia.Size = UDim2.fromOffset(9, 9)
    dia.Rotation = 45
    dia.BorderSizePixel = 0
    dia.Parent = head
    bind(dia, "BackgroundColor3", "Acc2")

    mkLabel(head, string.upper(title), 13, F.head, "White", UDim2.fromOffset(34, 0), UDim2.new(1, -70, 1, 0))
    local chev = drawChevron(head, "Acc2", 1)
    chev.Position = UDim2.new(1, -22, 0.5, 0)

    local body = Instance.new("Frame")
    body.Position = UDim2.fromOffset(0, HEAD)
    body.Size = UDim2.new(1, 0, 0, contentH)
    body.BackgroundTransparency = 1
    body.Parent = holder

    local api = { body = body, holder = holder }
    local function target() return open and (HEAD + contentH + 10) or HEAD end

    function api.setHeight(h)
        contentH = h
        body.Size = UDim2.new(1, 0, 0, h)
        if open then tween(holder, { Size = UDim2.new(1, -4, 0, target()) }, 0.22) end
    end

    head.Activated:Connect(safe(function()
        open = not open
        if open and not built then
            built = true
            if onFirstOpen then onFirstOpen(body) end
        end
        tween(chev, { Rotation = open and 180 or 0 }, 0.3, Enum.EasingStyle.Back)
        tween(holder, { Size = UDim2.new(1, -4, 0, target()) }, 0.3, Enum.EasingStyle.Quint)
    end, title))

    return api
end

-- Fila de colores para los botones + y -
local function createSwatches(page, title, colors, defaultIdx, kind, onPick)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -4, 0, 58)
    row.BackgroundTransparency = 0.06
    row.LayoutOrder = nextOrder()
    row.Parent = page
    bind(row, "BackgroundColor3", "Row")
    corner(row, 10)

    mkLabel(row, string.upper(title), 12, F.head, "White", UDim2.fromOffset(12, 6), UDim2.new(1, -60, 0, 16))

    local rings = {}
    local function mark(idx)
        for i, s in pairs(rings) do
            tween(s, { Transparency = (i == idx) and 0 or 1 }, 0.18)
        end
    end

    for i, c in ipairs(colors) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.fromOffset(24, 24)
        b.Position = UDim2.fromOffset(12 + (i - 1) * 32, 29)
        b.BackgroundColor3 = c[2]
        b.Text = ""
        b.AutoButtonColor = false
        b.Parent = row
        corner(b, 12)
        squish(b, 0.85)
        local s = Instance.new("UIStroke")
        s.Color = Color3.new(1, 1, 1)
        s.Thickness = 2
        s.Transparency = (i == defaultIdx) and 0 or 1
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        s.Parent = b
        rings[i] = s
        b.Activated:Connect(safe(function()
            mark(i)
            onPick(c[2])
        end, "color"))
    end

    local prev = createMiniButton(row, kind, 30)
    prev.AnchorPoint = Vector2.new(1, 0)
    prev.Position = UDim2.new(1, -12, 0, 6)
    return row
end

print("[DestroyaHub] parte 5 lista")
--==================================================
--            DESTROYA HUB  •  PARTE 6 / 14
--         RUEDA DE COLORES Y ESTADO GENERAL
--==================================================

local hh, ss, vv = AZUL.Acc:ToHSV()
local custom = { h = hh, s = ss, v = vv }
local customBusy = false

local function applyCustom()
    if customBusy then return end
    customBusy = true
    task.delay(0.06, function()
        customBusy = false
        applyTheme(makeTheme(custom.h, custom.s, custom.v))
    end)
end

local function createColorPicker(page)
    local R, r0, N = 56, 24, 72
    local mid = (R + r0) / 2
    local midRatio = mid / (2 * R)
    local BODY_H = 4 + 2 * R + 10 + 46 + 6 + 46

    createCollapsible(page, "Color del menú", BODY_H, function(body)
        local wheel = Instance.new("Frame")
        wheel.AnchorPoint = Vector2.new(0.5, 0)
        wheel.Position = UDim2.new(0.5, 0, 0, 4)
        wheel.Size = UDim2.fromOffset(2 * R, 2 * R)
        wheel.BackgroundTransparency = 1
        wheel.Parent = body

        local len = R - r0
        local thick = math.ceil(2 * math.pi * R / N) + 1
        for i = 0, N - 1 do
            local hue = i / N
            local ang = hue * 2 * math.pi
            local s = Instance.new("Frame")
            s.AnchorPoint = Vector2.new(0.5, 0.5)
            s.Size = UDim2.fromOffset(len, thick)
            s.Position = UDim2.fromOffset(R + math.cos(ang) * mid, R + math.sin(ang) * mid)
            s.Rotation = math.deg(ang)
            s.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
            s.BorderSizePixel = 0
            s.Parent = wheel
        end

        local preview = Instance.new("Frame")
        preview.AnchorPoint = Vector2.new(0.5, 0.5)
        preview.Position = UDim2.fromScale(0.5, 0.5)
        preview.Size = UDim2.fromOffset(2 * (r0 - 4), 2 * (r0 - 4))
        preview.BorderSizePixel = 0
        preview.Parent = wheel
        corner(preview, r0)
        local function updatePreview()
            preview.BackgroundColor3 = Color3.fromHSV(custom.h, custom.s, math.max(custom.v, 0.55))
        end
        updatePreview()

        local marker = Instance.new("Frame")
        marker.AnchorPoint = Vector2.new(0.5, 0.5)
        marker.Size = UDim2.fromOffset(14, 14)
        marker.BackgroundTransparency = 1
        marker.ZIndex = 5
        marker.Parent = wheel
        corner(marker, 7)
        local ms = Instance.new("UIStroke")
        ms.Color = Color3.new(1, 1, 1)
        ms.Thickness = 2.4
        ms.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        ms.Parent = marker
        local a0 = custom.h * 2 * math.pi
        marker.Position = UDim2.fromScale(0.5 + math.cos(a0) * midRatio, 0.5 + math.sin(a0) * midRatio)

        -- Zona táctil más grande que la rueda
        local hit = Instance.new("TextButton")
        hit.Position = UDim2.fromOffset(-14, -14)
        hit.Size = UDim2.new(1, 28, 1, 28)
        hit.BackgroundTransparency = 1
        hit.Text = ""
        hit.AutoButtonColor = false
        hit.ZIndex = 6
        hit.Parent = wheel

        local function pick(input)
            local size = wheel.AbsoluteSize.X
            if size <= 0 then return end
            local p = screenPos(input)
            local dx = p.X - (wheel.AbsolutePosition.X + size / 2)
            local dy = p.Y - (wheel.AbsolutePosition.Y + size / 2)
            if dx * dx + dy * dy < 1 then return end
            local ang = math.atan2(dy, dx)
            custom.h = (math.deg(ang) % 360) / 360
            marker.Position = UDim2.fromScale(0.5 + math.cos(ang) * midRatio, 0.5 + math.sin(ang) * midRatio)
            updatePreview()
            applyCustom()
        end

        hit.InputBegan:Connect(function(input)
            if isPointer(input) then
                pick(input)
                beginDrag(input, pick, true)
            end
        end)

        local ready = false
        local r1 = createSlider(body, "Saturación", 0, 1, custom.s,
            function(v) return string.format("%d%%", math.floor(v * 100 + 0.5)) end,
            function(v)
                custom.s = v
                if ready then
                    updatePreview()
                    applyCustom()
                end
            end)
        r1.BackgroundTransparency = 1
        r1.Position = UDim2.fromOffset(2, 4 + 2 * R + 10)

        local r2 = createSlider(body, "Brillo", 0.4, 1, custom.v,
            function(v) return string.format("%d%%", math.floor(v * 100 + 0.5)) end,
            function(v)
                custom.v = v
                if ready then
                    updatePreview()
                    applyCustom()
                end
            end)
        r2.BackgroundTransparency = 1
        r2.Position = UDim2.fromOffset(2, 4 + 2 * R + 10 + 52)
        ready = true
    end)
end

