local function createSection(page, text)
    local h = Instance.new("Frame")
    h.Size = UDim2.new(1, -4, 0, 28)
    h.BackgroundTransparency = 1
    h.LayoutOrder = nextOrder()
    h.Parent = page

    local barF = Instance.new("Frame")
    barF.Position = UDim2.fromOffset(2, 12)
    barF.Size = UDim2.fromOffset(3, 12)
    barF.BorderSizePixel = 0
    barF.Parent = h
    bind(barF, "BackgroundColor3", "Acc")
    corner(barF, 2)

    local up = string.upper(text)
    mkLabel(h, up, 9, F.section, "Acc2", UDim2.fromOffset(12, 11), UDim2.fromOffset(320, 14))
    local w = TextService:GetTextSize(up, 9, F.section, Vector2.new(600, 20)).X
    local line = Instance.new("Frame")
    line.Position = UDim2.fromOffset(12 + w + 10, 18)
    line.Size = UDim2.new(1, -(12 + w + 10) - 8, 0, 1)
    line.BorderSizePixel = 0
    line.Parent = h
    bind(line, "BackgroundColor3", "Acc")
    local lg = Instance.new("UIGradient")
    lg.Transparency = NumberSequence.new(0.2, 1)
    lg.Parent = line
    return h
end

local function createGrid(page)
    local grid = Instance.new("Frame")
    grid.Size = UDim2.new(1, -4, 0, 0)
    grid.BackgroundTransparency = 1
    grid.AutomaticSize = Enum.AutomaticSize.Y
    grid.LayoutOrder = nextOrder()
    grid.Parent = page

    local layout = Instance.new("UIGridLayout")
    layout.CellSize = UDim2.new(0.5, -4, 0, 40)
    layout.CellPadding = UDim2.fromOffset(8, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = grid
    return grid
end

-- Flecha dibujada con dos barras (no usa símbolos de fuente)
local function drawChevron(parent, color, k)
    k = k or 1
    local box = Instance.new("Frame")
    box.AnchorPoint = Vector2.new(0.5, 0.5)
    box.Size = UDim2.fromOffset(14 * k, 12 * k)
    box.BackgroundTransparency = 1
    box.Parent = parent
    local parts = {}
    for i, s in ipairs({ { 4, 6, 45 }, { 10, 6, -45 } }) do
        local p = Instance.new("Frame")
        p.AnchorPoint = Vector2.new(0.5, 0.5)
        p.Size = UDim2.fromOffset(9 * k, 2 * k)
        p.Position = UDim2.fromOffset(s[1] * k, s[2] * k)
        p.Rotation = s[3]
        p.BorderSizePixel = 0
        p.Parent = box
        corner(p, 1)
        if typeof(color) == "string" then bind(p, "BackgroundColor3", color) else p.BackgroundColor3 = color end
        parts[i] = p
    end
    return box, parts
end

-- Botones + y - (colores personalizables en Configuración)
local miniSets = {
    plus = setmetatable({}, { __mode = "k" }),
    minus = setmetatable({}, { __mode = "k" }),
}

local function createMiniButton(parent, kind, size)
    size = size or 26
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(size, size)
    b.BackgroundColor3 = (kind == "plus") and C.Plus or C.Minus
    b.Text = ""
    b.AutoButtonColor = false
    b.Parent = parent
    corner(b, math.floor(size * 0.3))
    squish(b, 0.86)
    local len = math.floor(size * 0.5)
    local h = Instance.new("Frame")
    h.AnchorPoint = Vector2.new(0.5, 0.5)
    h.Position = UDim2.fromScale(0.5, 0.5)
    h.Size = UDim2.fromOffset(len, 2)
    h.BackgroundColor3 = Color3.new(1, 1, 1)
    h.BorderSizePixel = 0
    h.Parent = b
    corner(h, 1)
    if kind == "plus" then
        local v = h:Clone()
        v.Size = UDim2.fromOffset(2, len)
        v.Parent = b
    end
    miniSets[kind][b] = true
    return b
end

local function recolorMini(kind)
    local col = (kind == "plus") and C.Plus or C.Minus
    for b in pairs(miniSets[kind]) do
        if b.Parent then tween(b, { BackgroundColor3 = col }, 0.2) end
    end
end

-- Interruptor animado. Devuelve api: Set(valor, silencioso) y Get()
local function createButton(parent, name, desc, callback)
    local cb = callback and safe(callback, name)

    local row = Instance.new("TextButton")
    row.Size = UDim2.new(1, -4, 0, 40)
    row.BackgroundTransparency = 0.06
    row.Text = ""
    row.AutoButtonColor = false
    row.LayoutOrder = nextOrder()
    row.Parent = parent
    corner(row, 10)
    squish(row, 0.95)

    local sheen = Instance.new("UIGradient")
    sheen.Rotation = 90
    sheen.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(165, 170, 185))
    sheen.Parent = row

    local accent = Instance.new("Frame")
    accent.AnchorPoint = Vector2.new(0, 0.5)
    accent.Position = UDim2.fromScale(0, 0.5)
    accent.Size = UDim2.fromOffset(3, 0)
    accent.BorderSizePixel = 0
    accent.Parent = row
    corner(accent, 2)

    local nameL = plain(row, string.upper(name), 13, F.head, C.White, UDim2.fromOffset(12, 4), UDim2.new(1, -62, 0, 18))
    local descL = plain(row, desc, 8, F.body, C.Gray, UDim2.fromOffset(12, 22), UDim2.new(1, -62, 0, 12))
    descL.TextTruncate = Enum.TextTruncate.AtEnd

    local pill = Instance.new("Frame")
    pill.Position = UDim2.new(1, -44, 0.5, -9)
    pill.Size = UDim2.fromOffset(34, 18)
    pill.BorderSizePixel = 0
    pill.Parent = row
    corner(pill, 9)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(14, 14)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    knob.Parent = pill
    corner(knob, 7)

    local flash = Instance.new("Frame")
    flash.Size = UDim2.fromScale(1, 1)
    flash.BackgroundColor3 = Color3.new(1, 1, 1)
    flash.BackgroundTransparency = 1
    flash.BorderSizePixel = 0
    flash.ZIndex = 5
    flash.Parent = row
    corner(flash, 10)

    local enabled = false
    local function paint(animated)
        local on = enabled
        local set = {
            { row, { BackgroundColor3 = on and C.RowOn or C.Row }, 0.25, Enum.EasingStyle.Quint },
            { accent, { Size = UDim2.fromOffset(3, on and 22 or 0), BackgroundColor3 = C.Acc2 }, 0.3, Enum.EasingStyle.Back },
            { pill, { BackgroundColor3 = on and C.Acc or C.Off }, 0.22, Enum.EasingStyle.Quint },
            { knob, { Position = on and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7) }, 0.28, Enum.EasingStyle.Back },
            { nameL, { TextColor3 = on and C.White or Color3.fromRGB(196, 204, 222) }, 0.2, Enum.EasingStyle.Quad },
        }
        for _, s in ipairs(set) do
            if animated then
                tween(s[1], s[2], s[3], s[4])
            else
                for k, v in pairs(s[2]) do s[1][k] = v end
            end
        end
    end
    onTheme(function() paint(false) end)

    local api = {}
    function api.Set(v, silent)
        if v == enabled then return end
        enabled = v
        paint(true)
        if v then
            flash.BackgroundTransparency = 0.8
            tween(flash, { BackgroundTransparency = 1 }, 0.4)
        end
        if cb and not silent then cb(enabled) end
    end
    function api.Get() return enabled end

    row.Activated:Connect(function() api.Set(not enabled) end)
    return api
end

