local function iconButton(kind, pos, bgColor)
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(26, 26)
    b.Position = pos
    b.BackgroundColor3 = bgColor
    b.BackgroundTransparency = 0.05
    b.Text = ""
    b.AutoButtonColor = false
    b.ZIndex = 5
    b.Parent = Header
    corner(b, 8)
    squish(b, 0.88)
    local function glyph(w, rot)
        local f = Instance.new("Frame")
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.Position = UDim2.fromScale(0.5, 0.5)
        f.Size = UDim2.fromOffset(w, 2)
        f.Rotation = rot
        f.BackgroundColor3 = WHITE
        f.BorderSizePixel = 0
        f.ZIndex = 6
        f.Parent = b
        corner(f, 1)
    end
    if kind == "x" then
        glyph(13, 45)
        glyph(13, -45)
    else
        glyph(12, 0)
    end
    return b
end

local DestroyBtn = iconButton("x", UDim2.fromOffset(8, 10), Color3.fromRGB(120, 12, 28))
local HideBtn = iconButton("minus", UDim2.new(1, -34, 0, 10), Color3.fromRGB(38, 26, 38))

local DragZone = Instance.new("Frame")
DragZone.Position = UDim2.fromOffset(42, 0)
DragZone.Size = UDim2.new(1, -84, 1, 0)
DragZone.BackgroundTransparency = 1
DragZone.ZIndex = 4
DragZone.Parent = Header
DragZone.InputBegan:Connect(function(input)
    if isPointer(input) then
        local startPos, startMouse = Main.Position, input.Position
        beginDrag(input, function(i)
            local d = i.Position - startMouse
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end)
    end
end)

