local Title = plain(Header, 'DESTROYA <font color="#FF2A44">HUB</font>', 27, F.title, WHITE,
    UDim2.fromOffset(TITLE_X, TITLE_Y), UDim2.fromOffset(titleW + 24, 32))
Title.RichText = true
Title.ZIndex = 3

local TitleStroke = Instance.new("UIStroke")
TitleStroke.Color = RED
TitleStroke.Thickness = 1.3
TitleStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
TitleStroke.Parent = Title

-- Trazos hechos a mano, garras y gotas
local Fx = { claws = {}, drips = {} }

local function bar(x, y, w, h, rot, color, tr)
    local f = Instance.new("Frame")
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.Position = UDim2.fromOffset(x, y)
    f.Size = UDim2.fromOffset(w, h)
    f.Rotation = rot or 0
    f.BackgroundColor3 = color
    f.BackgroundTransparency = tr or 0
    f.BorderSizePixel = 0
    f.ZIndex = 3
    f.Parent = Header
    return f
end

local ul = titleW * 0.95
bar(TITLE_X + ul / 2, 37, ul, 2, -1.2, RED)
bar(TITLE_X + ul / 2 + 6, 39, ul * 0.78, 1, 1.4, WHITE, 0.15)
bar(TITLE_X + ul * 0.3, 41, ul * 0.5, 1, -0.7, RED, 0.45)

local cx = TITLE_X + titleW + 24
for i = 1, 3 do
    local x = cx + (i - 1) * 11
    Fx.claws[i] = { bar(x, 23, 3, 30, 22, RED, 0.55), bar(x, 23, 1, 26, 22, WHITE, 0.7) }
end

for i, f in ipairs({ 0.12, 0.38, 0.62, 0.88 }) do
    local d = Instance.new("Frame")
    d.AnchorPoint = Vector2.new(0.5, 0)
    d.Position = UDim2.fromOffset(TITLE_X + ul * f, 38)
    d.Size = UDim2.fromOffset(3, 3)
    d.BackgroundColor3 = RED
    d.BorderSizePixel = 0
    d.ZIndex = 3
    d.Parent = Header
    corner(d, 2)
    Fx.drips[i] = d
end

-- Movimiento cada 10 segundos (solo con el menú visible)
local function playFx()
    local base = UDim2.fromOffset(TITLE_X, TITLE_Y)
    local baseSh = UDim2.fromOffset(TITLE_X + 2, TITLE_Y + 2)
    for i = 1, 8 do
        if not UI.open then break end
        local dx = (i % 2 == 0 and 1 or -1) * math.random(1, 3)
        local dy = math.random(-1, 1)
        Title.Position = UDim2.fromOffset(TITLE_X + dx, TITLE_Y + dy)
        TitleShadow.Position = UDim2.fromOffset(TITLE_X + 2 - dx, TITLE_Y + 2 - dy)
        Title.Rotation = (i % 2 == 0) and 1.2 or -1.2
        TitleStroke.Color = (i % 2 == 0) and WHITE or RED
        task.wait(0.045)
    end
    Title.Position, TitleShadow.Position, Title.Rotation = base, baseSh, 0
    TitleStroke.Color = RED

    for _, pair in ipairs(Fx.claws) do
        tween(pair[1], { BackgroundTransparency = 0, Size = UDim2.fromOffset(4, 42) }, 0.1, Enum.EasingStyle.Back)
        tween(pair[2], { BackgroundTransparency = 0, Size = UDim2.fromOffset(1, 38) }, 0.1)
        task.wait(0.07)
    end
    for i, d in ipairs(Fx.drips) do
        tween(d, { Size = UDim2.fromOffset(3, 8 + (i % 2) * 2) }, 0.8, Enum.EasingStyle.Sine)
    end
    task.wait(1.2)
    for _, pair in ipairs(Fx.claws) do
        tween(pair[1], { BackgroundTransparency = 0.55, Size = UDim2.fromOffset(3, 30) }, 0.5)
        tween(pair[2], { BackgroundTransparency = 0.7, Size = UDim2.fromOffset(1, 26) }, 0.5)
    end
    for _, d in ipairs(Fx.drips) do
        tween(d, { Size = UDim2.fromOffset(3, 3) }, 0.7, Enum.EasingStyle.Sine)
    end
end

task.spawn(function()
    task.wait(2)
    while Screen.Parent do
        if UI.open and UI.anim then pcall(playFx) end
        task.wait(10)
    end
end)

--==================================================
-- BOTONES DE LA CABECERA (cerrar a la izquierda, ocultar a la derecha)
