local FunctionPage = addTab("Funciones")
local ListPage = addTab("Lista")
local SelPage = addTab("Seleccionados")
local SettingsPage = addTab("Configuración")

--==================================================
-- FUNCIONES
--==================================================

createSection(FunctionPage, "Funciones principales")
do
    local grid = createGrid(FunctionPage)

    createButton(grid, "ESP Player", "Rojo enemigo, azul aliado", function(v)
        S.esp = v
        if v then
            for _, plr in ipairs(Players:GetPlayers()) do applyESP(plr) end
        else
            clearESP()
        end
    end)

    UI.headToggle = createButton(grid, "Cam Lock Cabeza", "Apunta a la cabeza", function(v)
        setLockMode(v and "head" or nil)
    end)

    UI.chestToggle = createButton(grid, "Cam Lock Pecho", "Apunta al pecho", function(v)
        setLockMode(v and "chest" or nil)
    end)

    createButton(grid, "Fly", "Vuela con botones", function(v)
        S.fly = v
        if UI.flyPad then UI.flyPad.Visible = v end
        if not v then
            if UI.resetFlyInput then UI.resetFlyInput() end
            stopFly()
        end
    end)

    createButton(grid, "Walk Speed", "Corre más rápido", function(v)
        setWalkEnabled(v)
    end)

    createButton(grid, "Infinite Jump", "Salta sin parar", function(v)
        S.infJump = v
    end)

    createButton(grid, "Noclip", "Atraviesa paredes", function(v)
        setNoclip(v)
    end)

    createButton(grid, "Fullbright", "Todo iluminado", function(v)
        setFullbright(v)
    end)
end

--==================================================
-- LISTA (toca un jugador para fijarlo)
--==================================================

local refreshList
do
    createSection(ListPage, "Buscar jugador")

    local search = Instance.new("TextBox")
    search.Size = UDim2.new(1, -4, 0, 34)
    search.BackgroundTransparency = 0.06
    search.PlaceholderText = "Escribe un nombre..."
    search.Text = ""
    search.TextSize = 12
    search.Font = F.bold
    search.ClearTextOnFocus = false
    search.LayoutOrder = nextOrder()
    search.Parent = ListPage
    bind(search, "BackgroundColor3", "Row")
    bind(search, "TextColor3", "White")
    bind(search, "PlaceholderColor3", "Gray")
    corner(search, 10)
    stroke(search, "Acc", 1, 0.5)

    UI.filter = ""
    search:GetPropertyChangedSignal("Text"):Connect(function()
        UI.filter = string.lower(search.Text)
        if UI.refreshLists then UI.refreshLists() end
    end)

    createSection(ListPage, "Jugadores conectados")

    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -4, 0, 0)
    container.BackgroundTransparency = 1
    container.AutomaticSize = Enum.AutomaticSize.Y
    container.LayoutOrder = nextOrder()
    container.Parent = ListPage
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 7)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = container

    refreshList = function()
        for _, c in ipairs(container:GetChildren()) do
            if c:IsA("GuiObject") then c:Destroy() end
        end
        local n = 0
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and (UI.filter == "" or string.find(string.lower(plr.Name), UI.filter, 1, true)) then
                n += 1
                local isTarget = S.target == plr

                local btn = Instance.new("TextButton")
                btn.LayoutOrder = n
                btn.Size = UDim2.new(1, 0, 0, 34)
                btn.BackgroundColor3 = isTarget and C.RowOn or C.Row
                btn.BackgroundTransparency = 0.06
                btn.Text = ""
                btn.AutoButtonColor = false
                btn.Parent = container
                corner(btn, 10)
                squish(btn, 0.96)

                local accent = Instance.new("Frame")
                accent.AnchorPoint = Vector2.new(0, 0.5)
                accent.Position = UDim2.fromScale(0, 0.5)
                accent.Size = UDim2.fromOffset(3, isTarget and 20 or 0)
                accent.BackgroundColor3 = C.Acc2
                accent.BorderSizePixel = 0
                accent.Parent = btn
                corner(accent, 2)

                plain(btn, "@" .. plr.Name, 13, F.head, C.White, UDim2.fromOffset(12, 0), UDim2.new(1, -100, 1, 0)).TextTruncate = Enum.TextTruncate.AtEnd
                if isTarget then
                    plain(btn, "OBJETIVO", 10, F.section, C.Acc2, UDim2.new(1, -86, 0, 0), UDim2.fromOffset(78, 34), Enum.TextXAlignment.Right)
                end

                btn.Activated:Connect(safe(function() selectTarget(plr) end, "lista"))
            end
        end
        if n == 0 then
            local e = plain(container, "No hay jugadores", 11, F.body, C.Gray, nil, UDim2.new(1, 0, 0, 30), Enum.TextXAlignment.Center)
            e.LayoutOrder = 1
        end
    end
end

print("[DestroyaHub] parte 11 lista")
--==================================================
--            DESTROYA HUB  •  PARTE 12 / 14
--      PESTAÑA SELECCIONADOS Y EVENTOS DE JUGADORES
--==================================================

local refreshAdd, refreshSel
do
    createSection(SelPage, "Gestionar")
    local addCol = createCollapsible(SelPage, "Agregar jugadores", 44)
    local addBody = addCol.body

    createSection(SelPage, "Tu lista")
    local selContainer = Instance.new("Frame")
    selContainer.Size = UDim2.new(1, -4, 0, 0)
    selContainer.BackgroundTransparency = 1
    selContainer.AutomaticSize = Enum.AutomaticSize.Y
    selContainer.LayoutOrder = nextOrder()
    selContainer.Parent = SelPage
    local sl = Instance.new("UIListLayout")
    sl.Padding = UDim.new(0, 10)
    sl.SortOrder = Enum.SortOrder.LayoutOrder
    sl.Parent = selContainer

    -- Lista completa con botones + y -
    refreshAdd = function()
        for _, c in ipairs(addBody:GetChildren()) do
            if c:IsA("GuiObject") then c:Destroy() end
        end
        local n = 0
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then
                n += 1
                local has = Sel.set[plr] ~= nil

                local row = Instance.new("Frame")
                row.Position = UDim2.fromOffset(8, 2 + (n - 1) * 40)
                row.Size = UDim2.new(1, -16, 0, 34)
                row.BackgroundColor3 = C.Panel
                row.BackgroundTransparency = 0.35
                row.BorderSizePixel = 0
                row.Parent = addBody
                corner(row, 9)

                plain(row, "@" .. plr.Name, 13, F.head, C.White, UDim2.fromOffset(10, 0), UDim2.new(1, -90, 1, 0)).TextTruncate = Enum.TextTruncate.AtEnd

                local plus = createMiniButton(row, "plus", 26)
                plus.Position = UDim2.new(1, -62, 0.5, -13)
                plus.BackgroundTransparency = has and 0.7 or 0
                local minus = createMiniButton(row, "minus", 26)
                minus.Position = UDim2.new(1, -32, 0.5, -13)
                minus.BackgroundTransparency = has and 0 or 0.7

                plus.Activated:Connect(safe(function()
                    if selAdd(plr) then notify("@" .. plr.Name .. " agregado") else notify("Ya está en tu lista") end
                end, "agregar"))
                minus.Activated:Connect(safe(function()
                    if selRemove(plr) then notify("@" .. plr.Name .. " quitado") else notify("No estaba en tu lista") end
                end, "quitar"))
            end
        end
        if n == 0 then
            local e = plain(addBody, "No hay otros jugadores", 11, F.body, C.Gray,
                UDim2.fromOffset(8, 2), UDim2.new(1, -16, 0, 34), Enum.TextXAlignment.Center)
            addCol.setHeight(44)
        else
            addCol.setHeight(n * 40 + 6)
        end
    end

    -- Seleccionados: tocar el nombre activa el Cam Lock, - quita, TP te lleva a su espalda
    refreshSel = function()
        for _, c in ipairs(selContainer:GetChildren()) do
            if c:IsA("GuiObject") then c:Destroy() end
        end
        if #Sel.list == 0 then
            local e = plain(selContainer, "Aún no hay jugadores seleccionados", 11, F.body, C.Gray,
                nil, UDim2.new(1, 0, 0, 30), Enum.TextXAlignment.Center)
            e.LayoutOrder = 1
            return
        end
        for i, plr in ipairs(Sel.list) do
            local isTarget = S.target == plr
            local tping = TP.target == plr

            local entry = Instance.new("Frame")
            entry.LayoutOrder = i
            entry.Size = UDim2.new(1, 0, 0, 70)
            entry.BackgroundTransparency = 1
            entry.Parent = selContainer

            local nameBtn = Instance.new("TextButton")
            nameBtn.Size = UDim2.new(1, -38, 0, 34)
            nameBtn.BackgroundColor3 = isTarget and C.RowOn or C.Row
            nameBtn.BackgroundTransparency = 0.06
            nameBtn.Text = ""
            nameBtn.AutoButtonColor = false
            nameBtn.Parent = entry
            corner(nameBtn, 10)
            squish(nameBtn, 0.96)

            local accent = Instance.new("Frame")
            accent.AnchorPoint = Vector2.new(0, 0.5)
            accent.Position = UDim2.fromScale(0, 0.5)
            accent.Size = UDim2.fromOffset(3, isTarget and 20 or 0)
            accent.BackgroundColor3 = C.Acc2
            accent.BorderSizePixel = 0
            accent.Parent = nameBtn
            corner(accent, 2)

            plain(nameBtn, "@" .. plr.Name, 13, F.head, C.White, UDim2.fromOffset(12, 0), UDim2.new(1, -100, 1, 0)).TextTruncate = Enum.TextTruncate.AtEnd
            if isTarget then
                plain(nameBtn, "OBJETIVO", 10, F.section, C.Acc2, UDim2.new(1, -86, 0, 0), UDim2.fromOffset(78, 34), Enum.TextXAlignment.Right)
            end
            nameBtn.Activated:Connect(safe(function() selectTarget(plr) end, "seleccionado"))

            local minus = createMiniButton(entry, "minus", 30)
            minus.Position = UDim2.new(1, -30, 0, 2)
            minus.Activated:Connect(safe(function()
                if selRemove(plr) then notify("@" .. plr.Name .. " quitado") end
            end, "quitar"))

            local tpBtn = Instance.new("TextButton")
            tpBtn.Position = UDim2.fromOffset(0, 40)
            tpBtn.Size = UDim2.new(1, 0, 0, 28)
            tpBtn.BackgroundColor3 = tping and Color3.fromRGB(170, 24, 44) or C.Btn
            tpBtn.BackgroundTransparency = 0.06
            tpBtn.Text = ""
            tpBtn.AutoButtonColor = false
            tpBtn.Parent = entry
            corner(tpBtn, 10)
            squish(tpBtn, 0.96)
            plain(tpBtn, tping and "CANCELAR TP" or "TP A SU ESPALDA", 13, F.head, C.White,
                nil, UDim2.fromScale(1, 1), Enum.TextXAlignment.Center)
            tpBtn.Activated:Connect(safe(function() startTP(plr) end, "tp"))
        end
    end
end

UI.refreshLists = debounced(function()
    if refreshList then refreshList() end
    if refreshAdd then refreshAdd() end
    if refreshSel then refreshSel() end
end)
onThemeSlow(UI.refreshLists)
UI.refreshLists()

-- Eventos de jugadores
track(Players.PlayerAdded:Connect(safe(function(plr)
    hookPlayer(plr)
    UI.refreshLists()
end, "PlayerAdded")))

track(Players.PlayerRemoving:Connect(safe(function(plr)
    removeESP(plr)
    if TP.target == plr then stopTP("El jugador salió del juego") end
    if Sel.set[plr] then
        selRemove(plr)
        notify("@" .. plr.Name .. " salió y se quitó de tu lista")
    end
    if S.target == plr then
        setLockMode(nil)
        UI.setStatus("El objetivo salió del juego")
    end
    task.delay(0.25, UI.refreshLists)
end, "PlayerRemoving")))

print("[DestroyaHub] parte 12 lista")
--==================================================
--            DESTROYA HUB  •  PARTE 13 / 14
--      CONFIGURACIÓN Y BOTÓN DEL MENÚ (garras)
--==================================================

do
    createSection(SettingsPage, "Estilo")

    createSlider(SettingsPage, "Tamaño del menú", 0.6, 1.2, 1,
        function(v) return string.format("%d%%", math.floor(v * 100 + 0.5)) end,
        function(v)
            UI.size = v
            if UI.open then MenuScale.Scale = v end
        end)

    createSlider(SettingsPage, "Transparencia", 0, 0.85, MENU_T,
        function(v) return string.format("%d%%", math.floor(v * 100 + 0.5)) end,
        setMenuTransparency)

    createColorPicker(SettingsPage)

    createSection(SettingsPage, "Botones + y -")

    createSwatches(SettingsPage, "Color del botón +", {
        { "Verde", Color3.fromRGB(60, 220, 120) }, { "Cian", Color3.fromRGB(0, 220, 255) },
        { "Amarillo", Color3.fromRGB(255, 210, 40) }, { "Rosa", Color3.fromRGB(255, 90, 170) },
        { "Morado", Color3.fromRGB(160, 90, 255) }, { "Blanco", Color3.fromRGB(225, 232, 245) },
    }, 1, "plus", function(col)
        C.Plus = col
        recolorMini("plus")
    end)

    createSwatches(SettingsPage, "Color del botón -", {
        { "Rojo", Color3.fromRGB(255, 60, 80) }, { "Naranja", Color3.fromRGB(255, 140, 30) },
        { "Rosa", Color3.fromRGB(255, 90, 170) }, { "Morado", Color3.fromRGB(160, 90, 255) },
        { "Gris", Color3.fromRGB(130, 140, 160) }, { "Blanco", Color3.fromRGB(225, 232, 245) },
    }, 1, "minus", function(col)
        C.Minus = col
        recolorMini("minus")
    end)

    createSection(SettingsPage, "Velocidades")

    createSlider(SettingsPage, "Velocidad de Fly", 20, 150, 60,
        function(v) return tostring(math.floor(v + 0.5)) end,
        function(v) S.flySpeed = v end)

    createSlider(SettingsPage, "Velocidad de caminar", 16, 200, 32,
        function(v) return tostring(math.floor(v + 0.5)) end,
        function(v) S.walkSpeed = v end)

    createSlider(SettingsPage, "Velocidad del TP", 40, 400, 120,
        function(v) return tostring(math.floor(v + 0.5)) end,
        function(v) S.tpSpeed = v end)

    createSection(SettingsPage, "Vista")

    local cam0 = getCamera()
    local fov0 = math.clamp(cam0 and cam0.FieldOfView or 70, 40, 120)
    createSlider(SettingsPage, "Campo de visión", 40, 120, fov0,
        function(v) return tostring(math.floor(v + 0.5)) end,
        function(v)
            local c = getCamera()
            if c then c.FieldOfView = v end
        end)

    createSection(SettingsPage, "Opciones")
    local grid = createGrid(SettingsPage)

    createButton(grid, "FPS Boost", "Quita lag y detalles", function(v)
        setFpsBoost(v)
        UI.setStatus(v and "FPS Boost activado" or "FPS Boost desactivado")
        notify(v and "FPS Boost activado" or "FPS Boost desactivado")
    end)

    createButton(grid, "Animaciones", "Apágalas si hay lag", function(v)
        UI.anim = v
    end).Set(true, true)
end

showPage("Funciones")

--==================================================
-- BOTÓN DEL MENÚ (garras dibujadas, sin emojis)
--==================================================

local Toggle = Instance.new("TextButton")
Toggle.Name = "MenuButton"
Toggle.Size = UDim2.fromOffset(48, 48)
Toggle.Position = UDim2.new(0, 14, 0.5, -24)
Toggle.BackgroundColor3 = Color3.fromRGB(16, 5, 9)
Toggle.BackgroundTransparency = 0.05
Toggle.Text = ""
Toggle.AutoButtonColor = false
Toggle.ZIndex = 10
Toggle.Parent = Screen
corner(Toggle, 14)
squish(Toggle, 0.9)

local ring = Instance.new("UIStroke")
ring.Color = RED
ring.Thickness = 2.2
ring.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
ring.Parent = Toggle
-- Pulso suave del aro (animación del motor, muy liviana)
TweenService:Create(ring, TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
    { Transparency = 0.55 }):Play()

-- Garras dibujadas con barras
local claws = Instance.new("Frame")
claws.AnchorPoint = Vector2.new(0.5, 0.5)
claws.Position = UDim2.fromScale(0.5, 0.5)
claws.Size = UDim2.fromOffset(30, 30)
claws.BackgroundTransparency = 1
claws.ZIndex = 11
claws.Parent = Toggle

for i = -1, 1 do
    for j = 1, 2 do
        local f = Instance.new("Frame")
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.Position = UDim2.fromOffset(15 + i * 8, 15)
        f.Size = (j == 1) and UDim2.fromOffset(4, 26) or UDim2.fromOffset(1, 22)
        f.Rotation = 20
        f.BackgroundColor3 = (j == 1) and RED or WHITE
        f.BorderSizePixel = 0
        f.ZIndex = 11 + j
        f.Parent = claws
        corner(f, 2)
    end
end

local function setOpen(v)
    if v == UI.open then return end
    UI.open = v
    claws.Rotation = 0
    tween(claws, { Rotation = 360 }, 0.55, Enum.EasingStyle.Back)
    if v then
        Main.Position = HOME
        MenuScale.Scale = UI.size * 0.8
        Main.Visible = true
        tween(MenuScale, { Scale = UI.size }, 0.32, Enum.EasingStyle.Back)
    else
        tween(MenuScale, { Scale = UI.size * 0.8 }, 0.16)
        task.delay(0.18, function()
            if not UI.open then Main.Visible = false end
        end)
    end
end

Toggle.Activated:Connect(function() setOpen(not UI.open) end)
HideBtn.Activated:Connect(function() setOpen(false) end)

--==================================================
-- BOTÓN DESACTIVAR CAM LOCK (debajo del botón del menú, fijo)
--==================================================

local CamStop = Instance.new("TextButton")
CamStop.Name = "CamStop"
CamStop.Size = UDim2.fromOffset(120, 42)
CamStop.Position = UDim2.new(0, 14, 0.5, 34)
CamStop.BackgroundColor3 = Color3.new(1, 1, 1)
CamStop.Text = ""
CamStop.AutoButtonColor = false
CamStop.Visible = false
CamStop.ZIndex = 10
CamStop.Parent = Screen
corner(CamStop, 13)

local csGrad = Instance.new("UIGradient")
csGrad.Color = ColorSequence.new(Color3.fromRGB(120, 10, 26), Color3.fromRGB(34, 4, 10))
csGrad.Rotation = 90
csGrad.Parent = CamStop

local StopScale = Instance.new("UIScale")
StopScale.Scale = 0
StopScale.Parent = CamStop

local StopStroke = Instance.new("UIStroke")
StopStroke.Color = RED
StopStroke.Thickness = 2
StopStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
StopStroke.Parent = CamStop

local xBox = Instance.new("Frame")
xBox.Position = UDim2.fromOffset(8, 9)
xBox.Size = UDim2.fromOffset(24, 24)
xBox.BackgroundColor3 = RED
xBox.BorderSizePixel = 0
xBox.ZIndex = 11
xBox.Parent = CamStop
corner(xBox, 12)
for _, rot in ipairs({ 45, -45 }) do
    local f = Instance.new("Frame")
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.Position = UDim2.fromScale(0.5, 0.5)
    f.Size = UDim2.fromOffset(12, 2)
    f.Rotation = rot
    f.BackgroundColor3 = WHITE
    f.BorderSizePixel = 0
    f.ZIndex = 12
    f.Parent = xBox
    corner(f, 1)
end

local csL1 = plain(CamStop, "DESACTIVAR", 14, F.head, C.White, UDim2.fromOffset(40, 6), UDim2.fromOffset(76, 17))
csL1.ZIndex = 11
local csL2 = plain(CamStop, "CAM LOCK", 9, F.section, Color3.fromRGB(255, 150, 160), UDim2.fromOffset(40, 24), UDim2.fromOffset(76, 12))
csL2.ZIndex = 11

local stopPulse
UI.showCamStop = function(v)
    if v then
        CamStop.Visible = true
        tween(StopScale, { Scale = 1 }, 0.32, Enum.EasingStyle.Back)
        if not stopPulse then
            stopPulse = TweenService:Create(StopStroke,
                TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
                { Transparency = 0.7 })
            stopPulse:Play()
        end
    else
        if stopPulse then
            stopPulse:Cancel()
            stopPulse = nil
            StopStroke.Transparency = 0
        end
        tween(StopScale, { Scale = 0 }, 0.18)
        task.delay(0.2, function()
            if not S.lockMode then CamStop.Visible = false end
        end)
    end
end

CamStop.InputBegan:Connect(function(i)
    if isPointer(i) then tween(StopScale, { Scale = 0.9 }, 0.08) end
end)
CamStop.InputEnded:Connect(function(i)
    if isPointer(i) and S.lockMode then tween(StopScale, { Scale = 1 }, 0.2, Enum.EasingStyle.Back) end
end)
CamStop.Activated:Connect(safe(function()
    setLockMode(nil)
    notify("Cam Lock desactivado")
end, "camstop"))

print("[DestroyaHub] parte 13 lista")
