--==================================================
--            DESTROYA HUB  •  PARTE 7 / 14
--             ESP (ENEMIGOS ROJO, ALIADOS AZUL)
--==================================================

local PAL = {
    enemy = { main = Color3.fromRGB(255, 35, 45), light = Color3.fromRGB(255, 130, 130), dark = Color3.fromRGB(120, 0, 8) },
    ally = { main = Color3.fromRGB(35, 120, 255), light = Color3.fromRGB(130, 200, 255), dark = Color3.fromRGB(0, 40, 140) },
}
local espObjects = {}

local function isAlly(plr)
    if player.Team ~= nil and plr.Team ~= nil then return plr.Team == player.Team end
    local a, b = player:GetAttribute("Team"), plr:GetAttribute("Team")
    if a ~= nil and b ~= nil then return a == b end
    return false
end

local function removeESP(plr)
    local d = espObjects[plr]
    if d then
        if d.hl then d.hl:Destroy() end
        if d.bb then d.bb:Destroy() end
        espObjects[plr] = nil
    end
end

local function clearESP()
    for plr in pairs(espObjects) do removeESP(plr) end
end

local function espLabel(parent, size, font, pos, sz)
    local l = plain(parent, "", size, font, Color3.new(1, 1, 1), pos, sz, Enum.TextXAlignment.Center)
    l.TextStrokeTransparency = 0.2
    l.TextStrokeColor3 = Color3.new(0, 0, 0)
    return l
end

local function paintESP(d, ally)
    local p = ally and PAL.ally or PAL.enemy
    d.ally = ally
    d.hl.FillColor = p.main
    d.hl.OutlineColor = p.light
    d.nameL.TextColor3 = p.main
    d.distL.TextColor3 = p.light
    d.barStroke.Color = p.light
    d.barBack.BackgroundColor3 = p.dark:Lerp(Color3.new(0, 0, 0), 0.65)
    d.grad.Color = ColorSequence.new(p.dark, p.main)
end

local function applyESP(plr)
    if plr == player then return end
    local char = plr.Character
    if not char then return end
    removeESP(plr)

    local hl = Instance.new("Highlight")
    hl.Adornee = char
    hl.FillTransparency = 0.2
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = Workspace

    local bb = Instance.new("BillboardGui")
    bb.Name = "DestroyaESP"
    bb.Size = UDim2.fromOffset(150, 46)
    bb.StudsOffset = Vector3.new(0, 3.1, 0)
    bb.AlwaysOnTop = true
    bb.LightInfluence = 0
    bb.Adornee = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    bb.Parent = Workspace

    local nameL = espLabel(bb, 14, F.head, UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, 15))
    nameL.Text = string.upper(plr.Name)

    local barBack = Instance.new("Frame")
    barBack.AnchorPoint = Vector2.new(0.5, 0)
    barBack.Position = UDim2.new(0.5, 0, 0, 17)
    barBack.Size = UDim2.new(0.9, 0, 0, 13)
    barBack.BackgroundTransparency = 0.1
    barBack.BorderSizePixel = 0
    barBack.Parent = bb
    corner(barBack, 4)

    local barStroke = Instance.new("UIStroke")
    barStroke.Thickness = 1.4
    barStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    barStroke.Parent = barBack

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(1, 1)
    fill.BackgroundColor3 = Color3.new(1, 1, 1)
    fill.BorderSizePixel = 0
    fill.Parent = barBack
    corner(fill, 4)
    local grad = Instance.new("UIGradient")
    grad.Parent = fill

    for i = 1, 3 do
        local tk = Instance.new("Frame")
        tk.Size = UDim2.new(0, 1, 1, 0)
        tk.Position = UDim2.fromScale(i / 4, 0)
        tk.BackgroundColor3 = Color3.new(0, 0, 0)
        tk.BackgroundTransparency = 0.45
        tk.BorderSizePixel = 0
        tk.ZIndex = 2
        tk.Parent = barBack
    end

    local hpL = espLabel(barBack, 10, F.head, UDim2.new(), UDim2.fromScale(1, 1))
    hpL.ZIndex = 3
    hpL.TextStrokeTransparency = 0.1
    local distL = espLabel(bb, 11, F.head, UDim2.fromOffset(0, 32), UDim2.new(1, 0, 0, 12))

    local d = {
        hl = hl, bb = bb, nameL = nameL, distL = distL, barBack = barBack, barStroke = barStroke,
        fill = fill, grad = grad, hpL = hpL, char = char, hp = -1, mx = -1, dist = -1, ally = nil,
    }
    espObjects[plr] = d
    paintESP(d, isAlly(plr))
end

local function hookPlayer(plr)
    if plr == player then return end
    track(plr.CharacterAdded:Connect(function()
        if S.esp then
            task.wait(1)
            if S.esp then pcall(applyESP, plr) end
        end
    end))
end

do
    local acc = 0
    track(RunService.Heartbeat:Connect(function(dt)
        if not S.esp then return end
        acc += dt
        if acc < 0.12 then return end
        acc = 0
        pcall(function()
            local lr = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player then
                    local char = plr.Character
                    local d = espObjects[plr]
                    if char and (not d or d.char ~= char) then
                        applyESP(plr)
                        d = espObjects[plr]
                    end
                    if d and char then
                        local ally = isAlly(plr)
                        if d.ally ~= ally then paintESP(d, ally) end
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        local root = char:FindFirstChild("HumanoidRootPart")
                        local head = char:FindFirstChild("Head") or root
                        if head and d.bb.Adornee ~= head then d.bb.Adornee = head end
                        local hp, mx = 0, 100
                        if hum then
                            hp = math.max(0, math.floor(hum.Health + 0.5))
                            mx = math.max(1, math.floor(hum.MaxHealth + 0.5))
                        end
                        if d.hp ~= hp or d.mx ~= mx then
                            d.hp, d.mx = hp, mx
                            d.fill.Size = UDim2.fromScale(math.clamp(hp / mx, 0, 1), 1)
                            d.hpL.Text = hp .. " / " .. mx
                        end
                        local dist = (root and lr) and math.floor((root.Position - lr.Position).Magnitude + 0.5) or 0
                        if d.dist ~= dist then
                            d.dist = dist
                            d.distL.Text = dist .. " m"
                        end
                    end
                end
            end
        end)
    end))
end

for _, plr in ipairs(Players:GetPlayers()) do hookPlayer(plr) end

print("[DestroyaHub] parte 7 lista")
--==================================================
--            DESTROYA HUB  •  PARTE 8 / 14
--        TP, SELECCIONADOS Y CAM LOCK (cabeza / pecho)
--==================================================

--==================================================
-- TP PLAYER (te arrastra hasta su espalda)
--==================================================

local TP = { target = nil, missing = 0 }

local function stopTP(msg)
    local was = TP.target
    TP.target = nil
    TP.missing = 0
    S.tpActive = false
    if msg then notify(msg) end
    if was and UI.refreshLists then UI.refreshLists() end
end

local function startTP(plr)
    if TP.target == plr then
        stopTP("TP cancelado")
        return
    end
    if not plr or plr.Parent ~= Players then
        notify("Jugador no disponible")
        return
    end
    if not getParts() then
        notify("Tu personaje no está listo")
        return
    end
    TP.target = plr
    TP.missing = 0
    S.tpActive = true
    notify("TP hacia @" .. plr.Name)
    if UI.refreshLists then UI.refreshLists() end
end

track(RunService.Heartbeat:Connect(function(dt)
    local plr = TP.target
    if not plr then return end
    local ok, err = pcall(function()
        local root = getParts()
        if not root then return end
        if plr.Parent ~= Players then
            stopTP("El jugador salió del juego")
            return
        end
        local tChar = plr.Character
        local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
        if not tRoot then
            TP.missing += dt
            if TP.missing > 3 then stopTP("El jugador no tiene personaje") end
            return
        end
        TP.missing = 0

        local look = tRoot.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
        flat = flat.Unit

        local goal = tRoot.Position - flat * 3.2
        local diff = goal - root.Position
        local dist = diff.Magnitude

        if dist <= 1.5 then
            root.CFrame = CFrame.lookAt(goal, goal + flat)
            root.AssemblyLinearVelocity = Vector3.zero
            stopTP("Estás en la espalda de @" .. plr.Name)
            return
        end

        local dir = diff.Unit
        local newPos = root.Position + dir * math.min(dist, S.tpSpeed * dt)
        local face = Vector3.new(dir.X, 0, dir.Z)
        if face.Magnitude < 0.05 then face = flat end
        root.CFrame = CFrame.lookAt(newPos, newPos + face)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)
    if not ok then
        warn("[DestroyaHub] TP: " .. tostring(err))
        stopTP("TP detenido por un error")
    end
end))

--==================================================
-- SELECCIONADOS (lista de jugadores guardados)
--==================================================

local Sel = { list = {}, set = {} }

local function selAdd(plr)
    if not plr or plr.Parent ~= Players or Sel.set[plr] then return false end
    Sel.set[plr] = true
    Sel.list[#Sel.list + 1] = plr
    if UI.refreshLists then UI.refreshLists() end
    return true
end

local function selRemove(plr)
    if not Sel.set[plr] then return false end
    Sel.set[plr] = nil
    for i = #Sel.list, 1, -1 do
        if Sel.list[i] == plr then table.remove(Sel.list, i) end
    end
    if TP.target == plr then stopTP() end
    if UI.refreshLists then UI.refreshLists() end
    return true
end

--==================================================
-- CAM LOCK (un solo estado: "head", "chest" o apagado)
--==================================================

local camHeld, camPrev, camErr = false, nil, 0

local function releaseCamera()
    local cam = getCamera()
    local _, hum = getParts()
    if camHeld and cam then
        cam.CameraType = camPrev or Enum.CameraType.Custom
        if hum then cam.CameraSubject = hum end
    end
    camHeld = false
    if hum then hum.AutoRotate = true end
end

local function aimPoint(char, mode, rootPart)
    if mode == "head" then
        local h = char:FindFirstChild("Head")
        return h and h.Position or (rootPart.Position + Vector3.new(0, 2, 0))
    end
    local t = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    return t and t.Position or (rootPart.Position + Vector3.new(0, 0.5, 0))
end

local function camStep()
    if not S.lockMode or not S.target then
        if camHeld then releaseCamera() end
        return
    end
    local cam = getCamera()
    local root, hum = getParts()
    if not cam or not root then return end

    local tChar = S.target.Character
    local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
    if not tRoot then
        if camHeld then releaseCamera() end
        return
    end

    local flat = Vector3.new(tRoot.Position.X - root.Position.X, 0, tRoot.Position.Z - root.Position.Z)
    if flat.Magnitude < 0.6 then return end
    local dir = flat.Unit

    if not camHeld then
        camHeld = true
        camPrev = cam.CameraType
    end
    if cam.CameraType ~= Enum.CameraType.Scriptable then cam.CameraType = Enum.CameraType.Scriptable end
    cam.CFrame = CFrame.lookAt(root.Position - dir * 9 + Vector3.new(0, 3.5, 0), aimPoint(tChar, S.lockMode, tRoot))

    if hum and hum.AutoRotate then hum.AutoRotate = false end
    root.CFrame = CFrame.lookAt(root.Position, root.Position + dir)
end

local function lockStatus()
    if not S.lockMode then return "Cam Lock desactivado" end
    local where = (S.lockMode == "head") and "cabeza" or "pecho"
    if S.target then return "Objetivo: @" .. S.target.Name .. " (" .. where .. ")" end
    return "Elige un objetivo (" .. where .. ")"
end

local function syncLock()
    if UI.headToggle then UI.headToggle.Set(S.lockMode == "head", true) end
    if UI.chestToggle then UI.chestToggle.Set(S.lockMode == "chest", true) end
    if UI.showCamStop then UI.showCamStop(S.lockMode ~= nil) end
    UI.setStatus(lockStatus())
    if UI.refreshLists then UI.refreshLists() end
end

local function setLockMode(mode)
    S.lockMode = mode
    if not mode then S.target = nil end
    syncLock()
    if not mode then pcall(releaseCamera) end
end

-- Al elegir un jugador: pecho automático, salvo que ya estuviera en cabeza
local function selectTarget(plr)
    if not plr or plr.Parent ~= Players then
        notify("Jugador no disponible")
        return
    end
    S.target = plr
    if S.lockMode ~= "head" then S.lockMode = "chest" end
    syncLock()
end

-- Corre al final del frame para ganarle a la cámara del juego
RunService:BindToRenderStep("DestroyaCam", Enum.RenderPriority.Last.Value, function()
    local ok, err = pcall(camStep)
    if ok then
        camErr = 0
    else
        camErr += 1
        if camErr == 1 then warn("[DestroyaHub] cámara: " .. tostring(err)) end
        if camErr > 30 then
            camErr = 0
            S.lockMode, S.target = nil, nil
            pcall(releaseCamera)
            notify("Cam Lock apagado por un error")
        end
    end
end)

print("[DestroyaHub] parte 8 lista")
--==================================================
--            DESTROYA HUB  •  PARTE 9 / 14
--    FLY, NOCLIP, WALK SPEED, SALTO INFINITO, LUZ
--==================================================

-- FLY
local flyBV

local function stopFly()
    if flyBV then
        flyBV:Destroy()
        flyBV = nil
    end
end

track(RunService.Heartbeat:Connect(function()
    if not S.fly then
        if flyBV then stopFly() end
        return
    end
    local root, hum = getParts()
    local cam = getCamera()
    if not root or not hum or not cam then
        stopFly()
        return
    end
    if not flyBV or flyBV.Parent ~= root then
        stopFly()
        flyBV = Instance.new("BodyVelocity")
        flyBV.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        flyBV.Velocity = Vector3.zero
        flyBV.Parent = root
    end
    local move = hum.MoveDirection
    local velocity = Vector3.zero
    if move.Magnitude > 0.05 then
        local rel = cam.CFrame:VectorToObjectSpace(move)
        local dir = cam.CFrame.LookVector * (-rel.Z) + cam.CFrame.RightVector * rel.X
        if dir.Magnitude > 0.01 then velocity = dir.Unit * move.Magnitude * S.flySpeed end
    end
    local vertical = (flyInput.up and 1 or 0) - (flyInput.down and 1 or 0)
    if vertical ~= 0 then velocity += Vector3.new(0, vertical * S.flySpeed, 0) end
    flyBV.Velocity = velocity
end))

-- NOCLIP (también se usa mientras dura el TP)
local setNoclip
do
    local parts, changed, refreshAt = {}, {}, 0

    local function restore()
        for p in pairs(changed) do
            if p.Parent then p.CanCollide = true end
        end
        table.clear(changed)
    end

    setNoclip = function(on)
        S.noclip = on
        if on then refreshAt = 0 end
    end

    track(RunService.Stepped:Connect(function()
        if not (S.noclip or S.tpActive) then
            if next(changed) then restore() end
            return
        end
        local now = os.clock()
        if now >= refreshAt then
            refreshAt = now + 1
            table.clear(parts)
            local char = player.Character
            if char then
                for _, d in ipairs(char:GetDescendants()) do
                    if d:IsA("BasePart") then parts[#parts + 1] = d end
                end
            end
        end
        for i = 1, #parts do
            local p = parts[i]
            if p.Parent and p.CanCollide then
                changed[p] = true
                p.CanCollide = false
            end
        end
    end))

    track(player.CharacterAdded:Connect(function()
        table.clear(changed)
        refreshAt = 0
    end))
end

-- WALK SPEED (refuerzo + respaldo si el juego lo resetea)
local setWalkEnabled
do
    local humConn, reverts, fallback = nil, 0, false

    local function unbind()
        if humConn then
            humConn:Disconnect()
            humConn = nil
        end
    end

    local function bindHum(hum)
        unbind()
        if not hum then return end
        humConn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            if S.walk and hum.WalkSpeed ~= S.walkSpeed and reverts < 20 then
                reverts += 1
                hum.WalkSpeed = S.walkSpeed
            end
        end)
    end

    setWalkEnabled = function(value)
        local _, hum = getParts()
        if value then
            if hum and not S.walk and hum.WalkSpeed ~= S.walkSpeed then S.defWalk = hum.WalkSpeed end
            S.walk = true
            reverts = 0
            bindHum(hum)
            if hum then hum.WalkSpeed = S.walkSpeed end
        else
            S.walk = false
            fallback = false
            unbind()
            if hum then hum.WalkSpeed = S.defWalk end
        end
    end

    track(player.CharacterAdded:Connect(function(char)
        local hum = char:WaitForChild("Humanoid", 10)
        if S.walk and hum then
            bindHum(hum)
            hum.WalkSpeed = S.walkSpeed
        end
    end))

    track(RunService.Heartbeat:Connect(function(dt)
        if not S.walk then return end
        local root, hum = getParts()
        if not root or not hum then return end
        if hum.WalkSpeed ~= S.walkSpeed then hum.WalkSpeed = S.walkSpeed end
        if fallback and not S.fly and not S.tpActive and hum.MoveDirection.Magnitude > 0.05 then
            local v = root.AssemblyLinearVelocity
            local extra = S.walkSpeed - Vector3.new(v.X, 0, v.Z).Magnitude
            if extra > 1 then root.CFrame = root.CFrame + hum.MoveDirection * extra * dt end
        end
    end))

    task.spawn(function()
        while Screen.Parent do
            task.wait(1)
            fallback = S.walk and reverts >= 15
            reverts = 0
        end
    end)
end

-- SALTO INFINITO
track(UserInputService.JumpRequest:Connect(function()
    if S.infJump then
        local _, hum = getParts()
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end))

-- FULLBRIGHT
local FB, atmos = {}, {}

local function setFullbright(on)
    if on == S.full then return end
    S.full = on
    if on then
        FB.Brightness, FB.ClockTime, FB.FogEnd = Lighting.Brightness, Lighting.ClockTime, Lighting.FogEnd
        FB.FogStart, FB.Shadows = Lighting.FogStart, Lighting.GlobalShadows
        FB.Ambient, FB.Outdoor = Lighting.Ambient, Lighting.OutdoorAmbient
        for _, a in ipairs(Lighting:GetChildren()) do
            if a:IsA("Atmosphere") then
                atmos[a] = a.Density
                a.Density = 0
            end
        end
    else
        pcall(function()
            Lighting.Brightness, Lighting.ClockTime, Lighting.FogEnd = FB.Brightness, FB.ClockTime, FB.FogEnd
            Lighting.FogStart, Lighting.GlobalShadows = FB.FogStart, FB.Shadows
            Lighting.Ambient, Lighting.OutdoorAmbient = FB.Ambient, FB.Outdoor
        end)
        for a, v in pairs(atmos) do
            pcall(function() a.Density = v end)
        end
        atmos = {}
    end
end

task.spawn(function()
    while Screen.Parent do
        task.wait(0.6)
        if S.full then
            pcall(function()
                Lighting.Brightness = 2.5
                Lighting.ClockTime = 14
                Lighting.FogEnd = 100000
                Lighting.FogStart = 100000
                Lighting.GlobalShadows = false
                Lighting.Ambient = Color3.fromRGB(190, 190, 190)
                Lighting.OutdoorAmbient = Color3.fromRGB(190, 190, 190)
            end)
        end
    end
end)

