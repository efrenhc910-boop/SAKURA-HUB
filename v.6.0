print("[DestroyaHub] cargando...")

if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local GuiService = game:GetService("GuiService")
local TextService = game:GetService("TextService")

local player = Players.LocalPlayer
while not player do
    task.wait()
    player = Players.LocalPlayer
end
local playerGui = player:WaitForChild("PlayerGui")

local function getGuiParent()
    local ok, ui = pcall(function() return gethui and gethui() end)
    if ok and ui then return ui end
    local okCore, core = pcall(function() return game:GetService("CoreGui") end)
    if okCore and core then
        local canUse = pcall(function()
            local f = Instance.new("Folder")
            f.Parent = core
            f:Destroy()
        end)
        if canUse then return core end
    end
    return playerGui
end

local guiParent = getGuiParent()
for _, container in ipairs({ guiParent, playerGui }) do
    for _, name in ipairs({ "DestroyaHub", "EfrenHub" }) do
        local old = container:FindFirstChild(name)
        if old then old:Destroy() end
    end
end
pcall(function() RunService:UnbindFromRenderStep("TargetCamera") end)
pcall(function() RunService:UnbindFromRenderStep("DestroyaCam") end)

local Screen = Instance.new("ScreenGui")
Screen.Name = "DestroyaHub"
Screen.ResetOnSpawn = false
Screen.IgnoreGuiInset = true
Screen.DisplayOrder = 9999
Screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
Screen.Parent = guiParent

--==================================================
-- FUENTES (cámbialas aquí si quieres otro estilo)
--==================================================

local function pickFont(name, fallback)
    local ok, f = pcall(function() return Enum.Font[name] end)
    return (ok and f) or fallback
end

local F = {
    title = pickFont("Creepster", Enum.Font.GothamBlack),
    head = pickFont("Oswald", Enum.Font.GothamBold),
    section = pickFont("Michroma", Enum.Font.GothamBold),
    body = Enum.Font.GothamMedium,
    bold = Enum.Font.GothamBold,
}

--==================================================
-- TEMA (azul por defecto, el resto sale de la rueda)
--==================================================

local AZUL = {
    Acc = Color3.fromRGB(40, 130, 255), Acc2 = Color3.fromRGB(95, 205, 255),
    Dark = Color3.fromRGB(8, 12, 26), Panel = Color3.fromRGB(14, 22, 42),
    Row = Color3.fromRGB(18, 38, 76), Off = Color3.fromRGB(34, 50, 78),
    Tab = Color3.fromRGB(17, 26, 48),
}

local C = {
    White = Color3.fromRGB(240, 245, 255), Gray = Color3.fromRGB(160, 172, 196),
    Plus = Color3.fromRGB(60, 220, 120), Minus = Color3.fromRGB(255, 60, 80),
}

local UI = { open = true, size = 1, anim = true }
local binds, painters, slowPainters, conns = {}, {}, {}, {}

local function track(c)
    conns[#conns + 1] = c
    return c
end

local function bind(obj, prop, key)
    binds[#binds + 1] = { obj, prop, key }
    obj[prop] = C[key]
    return obj
end

local function onTheme(fn)
    painters[#painters + 1] = fn
    fn()
end

local function onThemeSlow(fn)
    slowPainters[#slowPainters + 1] = fn
end

local slowToken = 0
local function scheduleSlow()
    slowToken += 1
    local mine = slowToken
    task.delay(0.45, function()
        if mine ~= slowToken then return end
        for i = 1, #slowPainters do pcall(slowPainters[i]) end
    end)
end

local function applyTheme(t)
    for k, v in pairs(t) do C[k] = v end
    C.RowOn = t.Row:Lerp(t.Acc, 0.3)
    C.Btn = t.Acc:Lerp(t.Dark, 0.5)
    pcall(function()
        for i = 1, #binds do
            local b = binds[i]
            b[1][b[2]] = C[b[3]]
        end
    end)
    for i = 1, #painters do pcall(painters[i]) end
    scheduleSlow()
end
applyTheme(AZUL)

local function makeTheme(h, s, v)
    local acc = Color3.fromHSV(h, s, math.max(v, 0.55))
    return {
        Acc = acc, Acc2 = acc:Lerp(Color3.new(1, 1, 1), 0.4),
        Dark = Color3.fromHSV(h, s * 0.7, 0.09), Panel = Color3.fromHSV(h, s * 0.7, 0.14),
        Row = Color3.fromHSV(h, s * 0.7, 0.22), Off = Color3.fromHSV(h, s * 0.5, 0.30),
        Tab = Color3.fromHSV(h, s * 0.7, 0.17),
    }
end

--==================================================
-- UTILIDADES
--==================================================

local function tween(obj, props, time, style, dir)
    local t = TweenService:Create(obj,
        TweenInfo.new(time or 0.2, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function corner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = obj
    return c
end

local function stroke(obj, key, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = obj
    if key then bind(s, "Color", key) end
    return s
end

local function plain(parent, text, size, font, color, pos, sz, alignX)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextSize = size
    l.Font = font
    l.TextColor3 = color
    l.TextXAlignment = alignX or Enum.TextXAlignment.Left
    if pos then l.Position = pos end
    if sz then l.Size = sz end
    l.Parent = parent
    return l
end

local function mkLabel(parent, text, size, font, key, pos, sz, alignX)
    local l = plain(parent, text, size, font, C[key], pos, sz, alignX)
    bind(l, "TextColor3", key)
    return l
end

local function isPointer(input)
    return input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1
end

local function screenPos(input)
    local inset = GuiService:GetGuiInset()
    return Vector2.new(input.Position.X + inset.X, input.Position.Y + inset.Y)
end

local orderN = 0
local function nextOrder()
    orderN += 1
    return orderN
end

local function safe(fn, label)
    return function(...)
        local ok, err = pcall(fn, ...)
        if not ok then
            warn("[DestroyaHub] error en " .. tostring(label) .. ": " .. tostring(err))
        end
    end
end

local function debounced(fn)
    local pending = false
    return function()
        if pending then return end
        pending = true
        task.defer(function()
            pending = false
            local ok, err = pcall(fn)
            if not ok then warn("[DestroyaHub] " .. tostring(err)) end
        end)
    end
end

-- Animación al tocar: se hunde y rebota
local function squish(btn, depth)
    local sc = Instance.new("UIScale")
    sc.Parent = btn
    btn.InputBegan:Connect(function(i)
        if isPointer(i) then tween(sc, { Scale = depth or 0.95 }, 0.08, Enum.EasingStyle.Quad) end
    end)
    btn.InputEnded:Connect(function(i)
        if isPointer(i) then tween(sc, { Scale = 1 }, 0.22, Enum.EasingStyle.Back) end
    end)
    return sc
end

-- Un solo controlador de arrastre (bloquea el scroll de las páginas si hace falta)
local activeDrag, activeInput, activeEnd
local function endDrag()
    if not activeDrag then return end
    local fin = activeEnd
    activeDrag, activeInput, activeEnd = nil, nil, nil
    if UI.setScrollLock then UI.setScrollLock(false) end
    if fin then pcall(fin) end
end
local function beginDrag(input, handler, lockScroll, onEnd)
    endDrag()
    activeDrag, activeInput, activeEnd = handler, input, onEnd
    if lockScroll and UI.setScrollLock then UI.setScrollLock(true) end
end
track(UserInputService.InputChanged:Connect(function(input)
    if activeDrag and (input == activeInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
        local ok, err = pcall(activeDrag, input)
        if not ok then
            endDrag()
            warn("[DestroyaHub] arrastre: " .. tostring(err))
        end
    end
end))
track(UserInputService.InputEnded:Connect(function(input)
    if activeDrag and (input == activeInput or input.UserInputType == Enum.UserInputType.MouseButton1) then
        endDrag()
    end
end))

local lastToast
local function notify(text)
    if lastToast and lastToast.Parent then lastToast:Destroy() end
    local toast = Instance.new("Frame")
    lastToast = toast
    toast.AnchorPoint = Vector2.new(0.5, 1)
    toast.Size = UDim2.fromOffset(260, 30)
    toast.Position = UDim2.new(0.5, 0, 1, 14)
    toast.BackgroundColor3 = Color3.fromRGB(12, 8, 12)
    toast.BackgroundTransparency = 0.08
    toast.BorderSizePixel = 0
    toast.ZIndex = 30
    toast.Parent = Screen
    corner(toast, 9)
    local bar = Instance.new("Frame")
    bar.Position = UDim2.fromOffset(0, 7)
    bar.Size = UDim2.fromOffset(3, 16)
    bar.BackgroundColor3 = C.Acc
    bar.BorderSizePixel = 0
    bar.ZIndex = 31
    bar.Parent = toast
    local l = plain(toast, text, 12, F.head, C.White, UDim2.fromOffset(12, 0), UDim2.new(1, -18, 1, 0))
    l.ZIndex = 31
    tween(toast, { Position = UDim2.new(0.5, 0, 1, -16) }, 0.35, Enum.EasingStyle.Back)
    task.delay(2.2, function()
        if toast.Parent then
            tween(toast, { Position = UDim2.new(0.5, 0, 1, 44) }, 0.25)
            task.delay(0.28, function() toast:Destroy() end)
        end
    end)
end

