--==================================================
-- FPS: TEXTO FLOTANTE ARCOÍRIS NEÓN (arrastrable)
--==================================================

local FpsText = Instance.new("TextButton")
FpsText.Name = "FpsText"
FpsText.Size = UDim2.fromOffset(100, 28)
FpsText.Position = UDim2.new(0.5, -50, 0, 6)
FpsText.BackgroundTransparency = 1
FpsText.AutoButtonColor = false
FpsText.Text = "FPS --"
FpsText.TextColor3 = Color3.new(1, 1, 1)
FpsText.TextSize = 19
FpsText.Font = F.head
FpsText.ZIndex = 10
FpsText.Parent = Screen

local FpsStroke = Instance.new("UIStroke")
FpsStroke.Color = Color3.new(0, 0, 0)
FpsStroke.Thickness = 2
FpsStroke.Transparency = 0.05
FpsStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
FpsStroke.Parent = FpsText

local FpsGrad = Instance.new("UIGradient")
FpsGrad.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 60)),
    ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 200, 0)),
    ColorSequenceKeypoint.new(0.4, Color3.fromRGB(0, 255, 90)),
    ColorSequenceKeypoint.new(0.6, Color3.fromRGB(0, 230, 255)),
    ColorSequenceKeypoint.new(0.8, Color3.fromRGB(120, 60, 255)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 200)),
})
FpsGrad.Offset = Vector2.new(-0.5, 0)
FpsGrad.Parent = FpsText
TweenService:Create(FpsGrad, TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
    { Offset = Vector2.new(0.5, 0) }):Play()

FpsText.InputBegan:Connect(function(input)
    if isPointer(input) then
        local startPos, startMouse = FpsText.Position, input.Position
        beginDrag(input, function(i)
            local d = i.Position - startMouse
            FpsText.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end)
    end
end)

--==================================================
-- BOTONES DEL FLY (solo con Fly activo, arcoíris neón)
--==================================================

UI.padItems = {}
local heldInputs = {}

do
    local PAD_BG = Color3.fromRGB(12, 6, 14)
    local PAD_ON = Color3.fromRGB(70, 18, 40)

    local pad = Instance.new("Frame")
    pad.Name = "FlyPad"
    pad.Size = UDim2.fromOffset(64, 160)
    pad.Position = UDim2.new(1, -90, 0.5, -80)
    pad.BackgroundTransparency = 1
    pad.Visible = false
    pad.ZIndex = 10
    pad.Parent = Screen
    UI.flyPad = pad

    local function addItem(strokeObj, parts)
        UI.padItems[#UI.padItems + 1] = { stroke = strokeObj, parts = parts or {} }
    end

    local handle = Instance.new("TextButton")
    handle.Size = UDim2.fromOffset(64, 22)
    handle.BackgroundColor3 = PAD_BG
    handle.BackgroundTransparency = 0.12
    handle.AutoButtonColor = false
    handle.Text = "FLY"
    handle.TextSize = 13
    handle.Font = F.head
    handle.TextColor3 = WHITE
    handle.ZIndex = 10
    handle.Parent = pad
    corner(handle, 11)
    local hs = Instance.new("UIStroke")
    hs.Thickness = 1.6
    hs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    hs.Parent = handle
    addItem(hs)

    handle.InputBegan:Connect(function(input)
        if isPointer(input) then
            local startPos, startMouse = pad.Position, input.Position
            beginDrag(input, function(i)
                local d = i.Position - startMouse
                pad.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end)
        end
    end)

    local padBtns = {}
    local function makePadButton(key, y, pointUp)
        local b = Instance.new("TextButton")
        b.Size = UDim2.fromOffset(64, 64)
        b.Position = UDim2.fromOffset(0, y)
        b.BackgroundColor3 = PAD_BG
        b.BackgroundTransparency = 0.15
        b.AutoButtonColor = false
        b.Text = ""
        b.ZIndex = 10
        b.Parent = pad
        corner(b, 18)

        local sheen = Instance.new("UIGradient")
        sheen.Rotation = 90
        sheen.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(120, 110, 130))
        sheen.Parent = b

        local s = Instance.new("UIStroke")
        s.Thickness = 2.6
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        s.Parent = b

        local sc = Instance.new("UIScale")
        sc.Parent = b

        local chev, parts = drawChevron(b, WHITE, 2.4)
        chev.Position = UDim2.fromScale(0.5, 0.5)
        chev.Rotation = pointUp and 180 or 0
        chev.ZIndex = 11
        for _, p in ipairs(parts) do p.ZIndex = 11 end

        addItem(s, parts)
        padBtns[key] = b

        b.InputBegan:Connect(function(input)
            if isPointer(input) then
                flyInput[key] = true
                heldInputs[key] = input
                b.BackgroundColor3 = PAD_ON
                tween(sc, { Scale = 0.9 }, 0.08)
            end
        end)
    end
    makePadButton("up", 28, true)
    makePadButton("down", 96, false)

    local function releaseKey(key)
        heldInputs[key] = nil
        flyInput[key] = false
        local b = padBtns[key]
        if b then
            b.BackgroundColor3 = PAD_BG
            local sc = b:FindFirstChildOfClass("UIScale")
            if sc then tween(sc, { Scale = 1 }, 0.2, Enum.EasingStyle.Back) end
        end
    end

    UI.resetFlyInput = function()
        for key in pairs(flyInput) do releaseKey(key) end
    end

    track(UserInputService.InputEnded:Connect(function(input)
        for key, held in pairs(heldInputs) do
            if held == input or input.UserInputType == Enum.UserInputType.MouseButton1 then
                releaseKey(key)
            end
        end
    end))
end

--==================================================
-- BUCLE CENTRAL (15 veces por segundo, solo lo necesario)
--==================================================

do
    local clock, acc, frames, fpsAcc = 0, 0, 0, 0
    track(RunService.Heartbeat:Connect(function(dt)
        frames += 1
        fpsAcc += dt
        if fpsAcc >= 0.5 then
            FpsText.Text = "FPS " .. math.floor(frames / fpsAcc + 0.5)
            frames, fpsAcc = 0, 0
        end

        acc += dt
        if acc < 1 / 15 then return end
        clock += acc
        acc = 0

        if UI.flyPad and UI.flyPad.Visible then
            for i, it in ipairs(UI.padItems) do
                local c = UI.anim and Color3.fromHSV((clock * 0.4 + i * 0.17) % 1, 1, 1) or RED
                it.stroke.Color = c
                for _, p in ipairs(it.parts) do p.BackgroundColor3 = c end
            end
        end
    end))
end

--==================================================
-- DESTRUIR TODO (con doble toque para evitar accidentes)
--==================================================

local closing = false
local function destroyHub()
    if closing then return end
    closing = true
    UI.open = false
    pcall(function()
        tween(MenuScale, { Scale = 0.5 }, 0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        tween(Main, { BackgroundTransparency = 1 }, 0.2)
    end)
    task.delay(0.22, function()
        if Screen.Parent then Screen:Destroy() end
    end)
end

do
    local confirmUntil = 0
    DestroyBtn.Activated:Connect(safe(function()
        local now = os.clock()
        if now < confirmUntil then
            destroyHub()
            return
        end
        confirmUntil = now + 2.5
        notify("Toca la X otra vez para destruir todo")
        tween(DestroyBtn, { BackgroundColor3 = Color3.fromRGB(255, 30, 55) }, 0.15)
        task.delay(2.5, function()
            if DestroyBtn.Parent then
                tween(DestroyBtn, { BackgroundColor3 = Color3.fromRGB(120, 12, 28) }, 0.3)
            end
        end)
    end, "destruir"))
end

--==================================================
-- LIMPIEZA (se ejecuta al destruir el hub)
--==================================================

Screen.Destroying:Connect(function()
    S.esp, S.fly, S.infJump = false, false, false
    S.lockMode, S.target = nil, nil
    S.noclip, S.tpActive = false, false
    pcall(releaseCamera)
    pcall(stopTP)
    pcall(setWalkEnabled, false)
    pcall(setNoclip, false)
    pcall(setFpsBoost, false)
    pcall(setFullbright, false)
    pcall(stopFly)
    pcall(clearESP)
    -- Un frame de gracia para que el Noclip devuelva las colisiones
    pcall(function() RunService.Stepped:Wait() end)
    for _, c in ipairs(conns) do
        pcall(function() c:Disconnect() end)
    end
    pcall(function() RunService:UnbindFromRenderStep("DestroyaCam") end)
end)

notify("Destroya Hub cargado")
print("DESTROYA HUB v6.0 CARGADO")