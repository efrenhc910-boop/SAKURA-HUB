--==================================================
-- TÍTULO: DESTROYA HUB
--==================================================

local TITLE_X, TITLE_Y = 40, 2
local titleW = TextService:GetTextSize("DESTROYA HUB", 27, F.title, Vector2.new(500, 40)).X

local TitleShadow = plain(Header, "DESTROYA HUB", 27, F.title, Color3.new(0, 0, 0),
    UDim2.fromOffset(TITLE_X + 2, TITLE_Y + 2), UDim2.fromOffset(titleW + 24, 32))
