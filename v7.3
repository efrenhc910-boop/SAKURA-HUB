function X.buildCirculo()
    if X.Circulo.frame then
        X.applyCirculoLook()
        return
    end
    local f = Instance.new("Frame")
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.Position = UDim2.fromScale(0.5, 0.5)
    f.BackgroundColor3 = X.EXTRA.CirculoColor
    f.BackgroundTransparency = X.EXTRA.CirculoRelleno
    f.BorderSizePixel = 0
    f.ZIndex = 0
    f.Parent = Screen
    corner(f, 9999)

