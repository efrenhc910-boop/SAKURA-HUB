local setWalls
do
    local saved = {}
    local running = false
    local lastPos
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.MaxParts = 1200

    local function restore(part)
        local t = saved[part]
        if t ~= nil then
            saved[part] = nil
            pcall(function() part.Transparency = t end)
        end
    end

    local function restoreAll()
        for part in pairs(saved) do restore(part) end
        table.clear(saved)
    end

    local function cycle()
        local root = getParts()
        if not root then return end
        if lastPos and (root.Position - lastPos).Magnitude < CONFIG.WALL_MOVE then return end
        lastPos = root.Position

        params.FilterDescendantsInstances = { player.Character }
        local hits = Workspace:GetPartBoundsInRadius(root.Position, CONFIG.WALL_RADIUS, params)
        local seen = {}

        for _, part in ipairs(hits) do
            if part:IsA("BasePart") and part.Parent and saved[part] == nil then
                seen[part] = true
                local t = part.Transparency
                if t < 0.6 then
                    saved[part] = t
                    part.Transparency = CONFIG.WALL_ALPHA
                end
            end
        end

        for part in pairs(saved) do
            if not seen[part] or not part.Parent then restore(part) end
        end
    end

    setWalls = function(on)
        if on == S.walls then return end
        S.walls = on
        if on then
            if running then return end
            running = true
            lastPos = nil
            task.spawn(function()
                while S.walls and Screen.Parent do
                    pcall(cycle)
                    task.wait(CONFIG.WALL_TICK)
                end
                running = false
                restoreAll()
            end)
        else
            restoreAll()
        end
    end
end

