function X.clearBot()
    if X.Bot.folder and X.Bot.folder.Parent then X.Bot.folder:Destroy() end
    if X.Bot.tag and X.Bot.tag.Parent then X.Bot.tag:Destroy() end
    X.Bot.folder, X.Bot.tag, X.Bot.sub, X.Bot.char = nil, nil, nil, nil
    table.clear(X.Bot.nodes)
end

function X.buildBot()
    X.clearBot()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    X.Bot.char = char

    local folder = Instance.new("Folder")
    folder.Name = "DestroyaBot"
    folder.Parent = Workspace
    X.Bot.folder = folder

    local style = "aro"
    if X.EXTRA.BotStyle == "ninguno" then
        return
    end
    style = X.EXTRA.BotStyle

    local n = (style == "disco") and 28 or 16
    for i = 1, n do
        local a = (i / n) * math.pi * 2
        local p = Instance.new("Part")
        p.Size = (style == "disco") and Vector3.new(0.55, 0.55, 0.55) or Vector3.new(0.5, 0.5, 0.5)
        p.Shape = Enum.PartType.Ball
        p.Anchored = true
        p.CanCollide = false
        p.CanQuery = false
        p.CastShadow = false
        p.Material = Enum.Material.Neon
        p.Color = X.EXTRA.BotColor
        p.Transparency = 0.05
        p.CFrame = root.CFrame * CFrame.new(math.cos(a) * X.EXTRA.BotRadius, -2.8, math.sin(a) * X.EXTRA.BotRadius)
        p.Parent = folder
        X.Bot.nodes[#X.Bot.nodes + 1] = { part = p, a = a }
    end

    local head = char:FindFirstChild("Head") or root
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.fromOffset(150, 34)
    bb.StudsOffset = Vector3.new(0, 3.4, 0)
    bb.AlwaysOnTop = true
    bb.LightInfluence = 0
    bb.Adornee = head
    bb.Parent = Workspace
    local l = plain(bb, X.EXTRA.BotTag, 16, F.head, X.EXTRA.BotColor,
        UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, 18), Enum.TextXAlignment.Center)
    l.TextStrokeTransparency = 0.1
    l.TextStrokeColor3 = Color3.new(0, 0, 0)
    local sub = plain(bb, "", 11, F.body, C.White,
        UDim2.fromOffset(0, 18), UDim2.new(1, 0, 0, 14), Enum.TextXAlignment.Center)
    sub.TextStrokeTransparency = 0.3
    X.Bot.tag, X.Bot.sub = bb, sub
end

track(RunService.Heartbeat:Connect(function(dt)
    if not S.botVisual then return end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        X.Bot.miss += dt
        if X.Bot.miss > 0.6 and X.Bot.char then X.clearBot() end
        return
    end
    X.Bot.miss = 0

    if X.Bot.char ~= char or not X.Bot.folder or not X.Bot.folder.Parent then
        if os.clock() >= X.Bot.rebuildAt then
            X.Bot.rebuildAt = os.clock() + 0.5
            X.buildBot()
        end
        return
    end

    X.Bot.spin += dt * 1.4
    local n = #X.Bot.nodes
    for i = 1, n do
        local it = X.Bot.nodes[i]
        local a = it.a + X.Bot.spin
        it.part.CFrame = root.CFrame * CFrame.new(math.cos(a) * X.EXTRA.BotRadius, -2.8, math.sin(a) * X.EXTRA.BotRadius)
    end
end))

track(player.CharacterAdded:Connect(function()
    X.clearBot()
    if S.botVisual then
        task.wait(1)
        if S.botVisual then X.buildBot() end
    end
end))

function X.pickTarget()
    local root = getParts()
    if not root then return end
    local best, bestScore
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and not (X.EXTRA.BotIgnoreAllies and isAlly(plr)) then
            local char = plr.Character
            local h = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if h and hrp and h.Health > 0 then
                local dist = (hrp.Position - root.Position).Magnitude
                if dist <= X.EXTRA.BotKillRange then
                    local score = (X.EXTRA.BotMode == "debil") and h.Health or dist
                    if not bestScore or score < bestScore then
                        best, bestScore = char, score
                    end
                end
            end
        end
    end
    return best
end

task.spawn(function()
    while Screen.Parent do
        task.wait(CONFIG.BOT_TICK)
        if not S.botKill then continue end
        local target = X.pickTarget()
        if target and X.fireHit(target) then
            if X.EXTRA.BotCountHits then
                X.Bot.hits += 1
                if X.Bot.sub and X.Bot.sub.Parent then X.Bot.sub.Text = X.Bot.hits .. " golpes" end
            end
        end
    end
end)

