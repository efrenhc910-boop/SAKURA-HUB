            if isPointer(i) then
                flyInput[key] = true
                heldInputs[key] = i
            end
        end)
    end
    makeBtn("up", 28, true)
    makeBtn("down", 96, false)

    track(UserInputService.InputEnded:Connect(function(input)
        for key, held in pairs(heldInputs) do
            if held == input or input.UserInputType == Enum.UserInputType.MouseButton1 then
                heldInputs[key] = nil
                flyInput[key] = false
            end
        end
    end))
    UI.resetFlyInput = function()
        for k in pairs(flyInput) do flyInput[k] = false end
    end
end

