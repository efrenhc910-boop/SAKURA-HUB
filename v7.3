X.saved, X.patchedKeys, X.filled = {}, {}, setmetatable({}, { __mode = "k" })
X.unlocked = false

local function patchTable(tbl, depth)
    if type(tbl) ~= "table" or depth > 3 then return end
    for k, v in pairs(tbl) do
        if type(v) == "function" then
            local n = string.lower(tostring(k))
            if string.find(n, "owned", 1, true) or string.find(n, "owns", 1, true)
                or string.find(n, "hasitem", 1, true) or string.find(n, "unlock", 1, true) then
                local key = tostring(tbl) .. tostring(k)
                if not X.patchedKeys[key] then
                    X.patchedKeys[key] = true
                    X.saved[#X.saved + 1] = { tbl = tbl, key = k, fn = v }
                    tbl[k] = function() return true end
                end
            end
        elseif type(v) == "table" then
            patchTable(v, depth + 1)
        end
    end
end

local function fillOwned(tbl, depth, pool)
    if type(tbl) ~= "table" or depth > 3 then return end
    for k, v in pairs(tbl) do
        local n = string.lower(tostring(k))
        if type(v) == "table" and (n == "owned" or n == "ownedskins" or n == "unlocked" or n == "inventory") then
            if not X.filled[v] then
                X.filled[v] = true
                for _, id in ipairs(pool) do
                    pcall(function() v[id] = true end)
                end
            end
        elseif type(v) == "table" then
            fillOwned(v, depth + 1, pool)
        end
    end
end

function X.collectIds()
    local pool, seen = {}, {}
    for _, lib in ipairs(X.findModules({ "skin", "item", "cosmetic" })) do
        local ok, mod = pcall(require, lib)
        if ok and type(mod) == "table" then
            local function walk(t, d)
                if type(t) ~= "table" or d > 4 then return end
                for k, v in pairs(t) do
                    if type(v) == "string" and #v > 1 and #v < 40 and not seen[v] then
                        seen[v] = true
                        pool[#pool + 1] = v
                    elseif type(v) == "table" then
                        if type(v.Name) == "string" and not seen[v.Name] then
                            seen[v.Name] = true
                            pool[#pool + 1] = v.Name
                        end
                        walk(v, d + 1)
                    end
                end
            end
            walk(mod, 0)
        end
    end
    return pool
end

function X.unlockAll(silent)
    local ok, err = pcall(function()
        local pool = X.collectIds()
        for _, lib in ipairs(X.findModules({ "skin", "item", "cosmetic", "shop" })) do
            local rok, mod = pcall(require, lib)
            if rok and type(mod) == "table" then
                patchTable(mod, 0)
                fillOwned(mod, 0, pool)
            end
        end
        for _, id in ipairs(pool) do
            pcall(function() player:SetAttribute("Owned_" .. id, true) end)
        end
        X.unlocked = true
        print("[DestroyaHub] ids marcados: " .. #pool)
    end)
    if not ok then warn("[DestroyaHub] skins: " .. tostring(err)) end
    if not silent then notify(X.unlocked and "Skins desbloqueadas" or "Error, revisa consola") end
end

function X.relockAll()
