    return grid
end

local function drawChevron(parent, color, k)
    k = k or 1
    local box = Instance.new("Frame")
    box.AnchorPoint = Vector2.new(0.5, 0.5)
    box.Size = UDim2.fromOffset(14 * k, 12 * k)
    box.BackgroundTransparency = 1
    box.Parent = parent
    local parts = {}
    for i, s in ipairs({ { 4, 6, 45 }, { 10, 6, -45 } }) do
        local p = Instance.new("Frame")
        p.AnchorPoint = Vector2.new(0.5, 0.5)
        p.Size = UDim2.fromOffset(9 * k, 2 * k)
        p.Position = UDim2.fromOffset(s[1] * k, s[2] * k)
        p.Rotation = s[3]
        p.BorderSizePixel = 0
        p.Parent = box
        corner(p, 1)
        if typeof(color) == "string" then bind(p, "BackgroundColor3", color) else p.BackgroundColor3 = color end
        parts[i] = p
    end
    return box, parts
end

local miniSets = {
