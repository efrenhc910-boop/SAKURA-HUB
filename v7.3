function X.setPerf(on)
    PERF.mode = on
    if on then
        UI.anim = false
        CONFIG.ESP_TICK = 0.6
        CONFIG.BOT_TICK = 0.35
        CONFIG.CIRC_TICK = 0.3
        CONFIG.WALL_TICK = 2
        if S.walls then setWalls(false) end
        pcall(clearESP)
        if S.esp then
            for _, plr in ipairs(Players:GetPlayers()) do applyESP(plr) end
        end
        notify("Modo rendimiento activado")
    else
        UI.anim = true
        CONFIG.ESP_TICK = 0.25
        CONFIG.BOT_TICK = 0.26
        CONFIG.CIRC_TICK = 0.2
        CONFIG.WALL_TICK = 1.1
        pcall(clearESP)
        if S.esp then
            for _, plr in ipairs(Players:GetPlayers()) do applyESP(plr) end
        end
        notify("Modo rendimiento apagado")
    end
end

--==================================================
-- VIGÍA DE FPS: se auto-degrada si baja
--==================================================

do
    local frames, acc, avg = 0, 0, 60
    local low = 0
    track(RunService.Heartbeat:Connect(function(dt)
        frames += 1
        acc += dt
        if acc < 1 then return end
        avg = frames / acc
        frames, acc = 0, 0
        if UI.open then FpsText.Text = "FPS " .. math.floor(avg + 0.5) end
        if PERF.building then return end
        if avg < 28 then
            low += 1
            if low >= 3 and not PERF.mode then
                low = 0
                pcall(X.setPerf, true)
            end
        else
            low = 0
        end
    end))
end

