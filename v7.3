--# ► PARTE 7 — ESP LIGERO
--#   Máximo 8 objetos y refresco lento. En modo
--#   rendimiento solo pone Highlight, sin etiquetas.
--##################################################

local espObjects = {}
local espCapped = false
local espAcc = 0

local PAL = {
    enemy = Color3.fromRGB(255, 35, 45),
    ally = Color3.fromRGB(35, 120, 255),
}

local function isAlly(plr)
    if player.Team ~= nil and plr.Team ~= nil then return plr.Team == player.Team end
    local a, b = player:GetAttribute("Team"), plr:GetAttribute("Team")
    if a ~= nil and b ~= nil then return a == b end
    return false
end

local function removeESP(plr)
    local d = espObjects[plr]
    if d then
        if d.hl then d.hl:Destroy() end
        if d.bb then d.bb:Destroy() end
        espObjects[plr] = nil
    end
end

local function clearESP()
    for plr in pairs(espObjects) do removeESP(plr) end
    espCapped = false
end

local function applyESP(plr)
    if plr == player then return end
    local char = plr.Character
    if not char then return end
    removeESP(plr)

    local hl = Instance.new("Highlight")
    hl.Adornee = char
    hl.FillTransparency = 0.25
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor = isAlly(plr) and PAL.ally or PAL.enemy
    hl.OutlineColor = Color3.new(1, 1, 1)
    hl.Parent = Workspace

    local d = { hl = hl, char = char, hp = -1 }

    if not PERF.mode then
        local bb = Instance.new("BillboardGui")
        bb.Name = "DestroyaESP"
        bb.Size = UDim2.fromOffset(140, 34)
        bb.StudsOffset = Vector3.new(0, 3.1, 0)
        bb.AlwaysOnTop = true
        bb.LightInfluence = 0
        bb.Adornee = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
        bb.Parent = Workspace

        local nameL = plain(bb, string.upper(plr.Name), 13, F.head, Color3.new(1, 1, 1),
            UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, 16), Enum.TextXAlignment.Center)
        nameL.TextStrokeTransparency = 0.2
        nameL.TextStrokeColor3 = Color3.new(0, 0, 0)

        local distL = plain(bb, "", 11, F.head, Color3.new(1, 1, 1),
            UDim2.fromOffset(0, 18), UDim2.new(1, 0, 0, 14), Enum.TextXAlignment.Center)
        distL.TextStrokeTransparency = 0.2
        distL.TextStrokeColor3 = Color3.new(0, 0, 0)

        d.bb, d.nameL, d.distL = bb, nameL, distL
    end

    espObjects[plr] = d
end

local function hideAllESP()
    for _, d in pairs(espObjects) do
        if d.hl.Enabled then d.hl.Enabled = false end
        if d.bb and d.bb.Enabled then d.bb.Enabled = false end
    end
end

local function hookPlayer(plr)
    if plr == player then return end
    track(plr.CharacterAdded:Connect(function()
        if S.esp then
            task.wait(1)
            if S.esp then pcall(applyESP, plr) end
        end
    end))
end

track(RunService.Heartbeat:Connect(function(dt)
    if not S.esp then return end
    espAcc += dt
    local tick = PERF.mode and CONFIG.ESP_TICK_PERF or CONFIG.ESP_TICK
    if espAcc < tick then return end
    espAcc = 0

    local lr = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not lr then return end

    local near = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if root and (root.Position - lr.Position).Magnitude <= CONFIG.ESP_MAX then
                near[#near + 1] = plr
            end
        end
    end

    if #near > CONFIG.ESP_LIMIT then
        if not espCapped then
            espCapped = true
            hideAllESP()
            UI.setStatus("ESP pausado: " .. #near .. " en rango")
        end
        return
    end
    if espCapped then
        espCapped = false
        UI.setStatus("ESP activo")
    end

    for i, plr in ipairs(near) do
        if i > CONFIG.ESP_MAX_OBJ then break end
        local char = plr.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local d = espObjects[plr]

        if char and root then
            if not d or d.char ~= char then
                applyESP(plr)
                d = espObjects[plr]
            end
            if d then
                if not d.hl.Enabled then d.hl.Enabled = true end
                if d.bb and not d.bb.Enabled then d.bb.Enabled = true end
                d.hl.FillColor = isAlly(plr) and PAL.ally or PAL.enemy
                if d.distL then
                    d.distL.Text = math.floor((root.Position - lr.Position).Magnitude + 0.5) .. " m"
                end
                if d.nameL and d.bb then
                    local head = char:FindFirstChild("Head") or root
                    if d.bb.Adornee ~= head then d.bb.Adornee = head end
                end
            end
        end
    end

    for plr, d in pairs(espObjects) do
        local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        if not root then
            removeESP(plr)
        elseif (root.Position - lr.Position).Magnitude > CONFIG.ESP_MAX then
            if d.hl.Enabled then d.hl.Enabled = false end
            if d.bb and d.bb.Enabled then d.bb.Enabled = false end
        end
    end
end))

for _, plr in ipairs(Players:GetPlayers()) do hookPlayer(plr) end

