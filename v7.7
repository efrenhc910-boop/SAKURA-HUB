local lista = page("Lista")
do
	section(lista, "Buscar")
	local box = searchBox(lista, "Nombre o parte del nombre...", function(txt)
		if rebuildList then rebuildList(txt) end
	end)

	section(lista, "Jugadores")
	local list = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, 190),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = T.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ZIndex = 5,
	}, lista)
	new("UIListLayout", {
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, list)

	local counter = label(lista, "0 jugadores", 14)

	--_______________________
	-- Fila de jugador
	-------------------------
	local function row(p)
		local myRoot = root()
		local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		local d = (myRoot and hrp) and math.floor(dist(myRoot, hrp)) or 0
		local ally = p.Team == LP.Team

		local f = new("Frame", {
			Size = UDim2.new(1, 0, 0, 40),
			BackgroundColor3 = T.Panel2,
			BorderSizePixel = 0,
			ZIndex = 5,
		}, list)
		corner(f, 6)
		stroke(f, ally and T.Ally or T.Stroke, 1, 0.55)

		new("Frame", {
			Size = UDim2.new(0, 3, 0.7, 0),
			Position = UDim2.new(0, 0, 0.15, 0),
			BackgroundColor3 = ally and T.Ally or T.Accent,
			BorderSizePixel = 0,
			ZIndex = 6,
		}, f)

		new("TextLabel", {
			Size = UDim2.new(1, -110, 0, 14),
			Position = UDim2.fromOffset(9, 4),
			BackgroundTransparency = 1,
			Text = p.Name,
			TextColor3 = T.Text,
			Font = Enum.Font.GothamBold,
			TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 6,
		}, f)

		local h = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
		local bg = new("Frame", {
			Size = UDim2.new(0.55, 0, 0, 4),
			Position = UDim2.fromOffset(9, 22),
			BackgroundColor3 = T.Off,
			BorderSizePixel = 0,
			ZIndex = 6,
		}, f)
		corner(bg, 2)
		local fill = new("Frame", {
			Size = UDim2.fromScale(h and math.clamp(h.Health / h.MaxHealth, 0, 1) or 1, 1),
			BackgroundColor3 = ally and T.Ally or T.Good,
			BorderSizePixel = 0,
			ZIndex = 7,
		}, bg)
		corner(fill, 2)

		new("TextLabel", {
			Size = UDim2.new(0, 40, 0, 12),
			Position = UDim2.new(0.55, 16, 0, 21),
			BackgroundTransparency = 1,
			Text = d .. " m",
			TextColor3 = T.Muted,
			Font = Enum.Font.Gotham,
			TextSize = 9,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 6,
		}, f)

		local function mini(txt, x, col, cb)
			local b = new("TextButton", {
				Size = UDim2.fromOffset(28, 18),
				Position = UDim2.new(1, x, 0, 5),
				BackgroundColor3 = T.Panel3,
				BorderSizePixel = 0,
				Text = txt,
				TextColor3 = col or T.Text,
				Font = Enum.Font.GothamBold,
				TextSize = 9,
				AutoButtonColor = false,
				ZIndex = 7,
			}, f)
			corner(b, 4)
			stroke(b, col or T.Stroke, 1, 0.5)
			squish(b)
			reg(b.MouseButton1Click:Connect(cb))
			return b
		end

		mini("TP", -98, T.Accent, function()
			CFG.TPTarget = p
			if _G.DH_TARGET then _G.DH_TARGET(p.Name) end
			tpTo(p)
		end)
		mini("SEG", -68, T.Good, function()
			CFG.TPTarget = p
			if _G.DH_TARGET then _G.DH_TARGET(p.Name) end
			CFG.TPFollow = true
			showCancel()
		end)
		mini("⧉", -38, T.Muted, function()
			if setclipboard then setclipboard(p.Name) end
		end)
	end

	--_______________________
	-- Reconstruir
	-------------------------
	function rebuildList(txt)
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end

		local q = (txt or box.input.Text or ""):lower()
		local found = 0
		local myRoot = root()

		local cands = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LP then
				if q == "" or p.Name:lower():find(q, 1, true) then
					local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
					cands[#cands + 1] = { p = p, d = (myRoot and hrp) and dist(myRoot, hrp) or 9999 }
				end
			end
		end
		table.sort(cands, function(a, b) return a.d < b.d end)

		for _, c in ipairs(cands) do
			row(c.p)
			found += 1
		end

		counter.Text = found .. " jugador" .. (found == 1 and "" or "es")
	end

	reg(Players.PlayerAdded:Connect(function() task.wait(0.5) rebuildList() end))
	reg(Players.PlayerRemoving:Connect(function() task.wait(0.2) rebuildList() end))
	task.defer(function() rebuildList("") end)
end

