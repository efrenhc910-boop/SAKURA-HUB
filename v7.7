--==================================================
-- ► PARTE 6 — CÁMARA, MOVILIDAD Y LUZ
--==================================================

local function getCamera()
    return Workspace.CurrentCamera
end

local function getParts()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid"), char
end

local function alive(p)
    local c = p and p.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local camHeld, camPrev, camErr = false, nil, 0
local camParams = RaycastParams.new()
camParams.FilterType = Enum.RaycastFilterType.Exclude
camParams.IgnoreWater = true
camParams.RespectCanCollide = true

local losParams = RaycastParams.new()
losParams.FilterType = Enum.RaycastFilterType.Exclude
losParams.IgnoreWater = true

local CAM_DIST, CAM_UP, PIVOT_UP = 8.5, 3.2, 2.2
local lastDir = Vector3.new(0, 0, -1)
local waitTime, camMiss = 0, 0

local function releaseCamera()
    local cam = getCamera()
    local _, hum = getParts()
    if camHeld and cam then
        cam.CameraType = camPrev or Enum.CameraType.Custom
        if hum then cam.CameraSubject = hum end
    end
    camHeld = false
    if hum then hum.AutoRotate = true end
end

local function aimPoint(char, mode, rootPart)
    if mode == "head" then
        local h = char:FindFirstChild("Head")
        return h and h.Position or (rootPart.Position + Vector3.new(0, 2, 0))
    end
    local t = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    return t and t.Position or (rootPart.Position + Vector3.new(0, 0.5, 0))
end

local function nearestEnemy()
    local root = getParts()
    if not root then return nil end
    local best, bestD = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and not isAlly(plr) then
            local c = plr.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = (r.Position - root.Position).Magnitude
                if d < bestD then
                    best, bestD = plr, d
                end
            end
        end
    end
    return best
end
UI.nearestEnemy = nearestEnemy

local function camStep(dt)
    if not S.lockMode then
        if camHeld then releaseCamera() end
        return
    end

    local cam = getCamera()
    local root, hum = getParts()
    if not cam or not root then
        if camHeld then releaseCamera() end
        return
    end

    local tChar = S.target and S.target.Character
    local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
    if not tRoot then
        waitTime += dt
        if waitTime > 0.8 and S.target then
            UI.setStatus("Esperando a @" .. S.target.Name .. "...")
        end
        if camHeld then releaseCamera() end
        return
    end
    waitTime = 0

    local flat = Vector3.new(tRoot.Position.X - root.Position.X, 0, tRoot.Position.Z - root.Position.Z)
    local dir
    if flat.Magnitude >= 0.4 then
        dir = flat.Unit
        lastDir = dir
    else
        dir = lastDir
    end

    if S.wallCheck then
        losParams.FilterDescendantsInstances = { player.Character, tChar }
        local hit = Workspace:Raycast(cam.CFrame.Position,
            tRoot.Position - cam.CFrame.Position, losParams)
        UI.setStatus(hit and "Objetivo tras pared" or lockStatus())
    end

    if not camHeld then
        camHeld = true
        camPrev = cam.CameraType
    end
    if cam.CameraType ~= Enum.CameraType.Scriptable then cam.CameraType = Enum.CameraType.Scriptable end
    if hum and hum.AutoRotate then hum.AutoRotate = false end

    if not S.fly and not S.tpFollow then
        root.CFrame = CFrame.lookAt(root.Position, root.Position + dir)
    end

    local focus = aimPoint(tChar, S.lockMode, tRoot)
    local pivot = root.Position + Vector3.new(0, PIVOT_UP, 0)
    local want = root.Position - dir * CAM_DIST + Vector3.new(0, CAM_UP, 0)

    camParams.FilterDescendantsInstances = { player.Character }
    local delta = want - pivot
    if delta.Magnitude > 0.2 then
        local hit = Workspace:Raycast(pivot, delta, camParams)
        if hit then
            local back = (pivot - hit.Position).Unit
            want = hit.Position + back * 0.35
            if (want - pivot).Magnitude < 1.2 then want = pivot + back * 1.2 end
        end
    end

    cam.CFrame = CFrame.lookAt(want, focus)
end

function lockStatus()
    if not S.lockMode then return "Cam Lock desactivado" end
    local where = (S.lockMode == "head") and "cabeza" or "pecho"
    if S.target then return "Objetivo: @" .. S.target.Name .. " (" .. where .. ")" end
    return "Buscando objetivo (" .. where .. ")"
end

local function syncLock()
    if UI.headToggle then UI.headToggle.Set(S.lockMode == "head", true) end
    if UI.chestToggle then UI.chestToggle.Set(S.lockMode == "chest", true) end
    if UI.showCamStop then UI.showCamStop(S.lockMode ~= nil) end
    UI.setStatus(lockStatus())
    if UI.refreshLists then UI.refreshLists() end
end

local noclipPrev = false
local setNoclip

function setLockMode(mode)
    if busyLock then return end
    busyLock = true
    local wasLocked = S.lockMode ~= nil
    S.lockMode = mode
    if not mode then
        S.target = nil
        waitTime, camMiss = 0, 0
    end

    if mode and not wasLocked then
        noclipPrev = S.noclip
        setNoclip(true)
        if UI.noclipToggle then UI.noclipToggle.Set(true, true) end
        if not S.target or S.target.Parent ~= Players then
            local pick = nearestEnemy()
            if pick then S.target = pick else notify("Sin jugadores cerca") end
        end
    elseif not mode and wasLocked then
        setNoclip(noclipPrev)
        if UI.noclipToggle then UI.noclipToggle.Set(noclipPrev, true) end
    end

    syncLock()
    if not mode then pcall(releaseCamera) end
    busyLock = false
end

function selectTarget(plr)
    if not plr or plr.Parent ~= Players then
        notify("Jugador no disponible")
        return
    end
    S.target = plr
    camMiss = 0
    if S.lockMode ~= "head" then S.lockMode = "chest" end
    syncLock()
end

track(RunService.Heartbeat:Connect(function(dt)
    if not S.lockMode then return end
    local t = S.target
    local tChar = t and t.Character
    local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
    local ok = t and t.Parent == Players and tChar and tChar:FindFirstChild("HumanoidRootPart")
        and (not tHum or tHum.Health > 0)

    if ok then
        camMiss = 0
        return
    end

    camMiss += dt
    if camMiss < 1.2 then return end
    camMiss = 0

    local pick = nearestEnemy()
    if pick and pick ~= t then
        S.target = pick
        syncLock()
        notify("Objetivo cambiado a @" .. pick.Name)
    elseif not pick then
        S.target = nil
        UI.setStatus("Sin jugadores cerca")
    end
end))

RunService:BindToRenderStep("DestroyaCam", Enum.RenderPriority.Last.Value, function(dt)
    local ok, err = pcall(camStep, dt)
    if ok then
        camErr = 0
    else
        camErr += 1
        if camErr == 1 then warn("[DestroyaHub] cámara: " .. tostring(err)) end
        if camErr > 30 then
            camErr = 0
            setLockMode(nil)
            notify("Cam Lock apagado por un error")
