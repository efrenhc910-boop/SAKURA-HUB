function stopTP()
	CFG.TPFollow = false
	CFG.TPTarget = nil
	if cancelBtn then cancelBtn.Visible = false end
	if _G.DH_TARGET then _G.DH_TARGET(nil) end
end

function tpTo(p)
	local myRoot = root()
	local tRoot = p and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot or not tRoot then return end
	myRoot.CFrame = CFrame.new(tRoot.Position + Vector3.new(0, 1, 0))
	CFG.TPTarget = p
	showCancel()
end

local tpAcc = 0
function tpStep(dt)
	if not CFG.TPFollow or not CFG.TPTarget then return end
	local p = CFG.TPTarget
	if not alive(p) then stopTP() return end

	tpAcc += dt
	if tpAcc < 0.12 then return end
	tpAcc = 0

	local myRoot = root()
	local tRoot = p.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot or not tRoot then return end

	local target = tRoot.Position - tRoot.CFrame.LookVector * CFG.TPOffset + Vector3.new(0, 1, 0)
	if (myRoot.Position - target).Magnitude > 2 then
		myRoot.CFrame = myRoot.CFrame:Lerp(CFrame.new(target, target + tRoot.CFrame.LookVector), 0.6)
	end
end

