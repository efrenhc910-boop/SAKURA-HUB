            if plr ~= player and (UI.filter == "" or string.find(string.lower(plr.Name), UI.filter, 1, true)) then
                n += 1
                local isTarget = S.tpTarget == plr

                local btn = Instance.new("TextButton")
                btn.LayoutOrder = n
                btn.Size = UDim2.new(1, 0, 0, 34)
                btn.BackgroundColor3 = isTarget and C.RowOn or C.Row
                btn.BackgroundTransparency = 0.55
                btn.Text = ""
                btn.AutoButtonColor = false
                btn.Parent = container
                corner(btn, 10)
                squish(btn, 0.96)

                plain(btn, "@" .. plr.Name, 13, F.head, C.White,
                    UDim2.fromOffset(12, 0), UDim2.new(1, -70, 1, 0)).TextTruncate = Enum.TextTruncate.AtEnd

                local go = Instance.new("TextButton")
                go.Size = UDim2.fromOffset(26, 22)
                go.AnchorPoint = Vector2.new(1, 0.5)
                go.Position = UDim2.new(1, -8, 0.5, 0)
                go.BackgroundColor3 = C.Acc
                go.BackgroundTransparency = 0.3
                go.Text = "GO"
                go.TextColor3 = C.Dark
                go.Font = F.head
                go.TextSize = 9
                go.AutoButtonColor = false
                go.Parent = btn
                corner(go, 6)
                squish(go, 0.9)

                btn.Activated:Connect(safe(function() seguir(plr) end, "seguir"))
                go.Activated:Connect(safe(function() seguir(plr) end, "go"))
            end
        end
        if n == 0 then
            local e = plain(container, "No hay jugadores", 11, F.body, C.Gray,
                nil, UDim2.new(1, 0, 0, 30), Enum.TextXAlignment.Center)
            e.LayoutOrder = 1
        end
    end

    UI.refreshList()
end)

UI.refreshLists = debounced(function()
    if UI.refreshList then UI.refreshList() end
end)

track(Players.PlayerAdded:Connect(safe(function(plr)
    hookPlayer(plr)
    UI.refreshLists()
end, "PlayerAdded")))

track(Players.PlayerRemoving:Connect(safe(function(plr)
    removeESP(plr)
