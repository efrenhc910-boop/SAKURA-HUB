print("[DESTROYA] Cargando sistema de skins")

local skinKeys = { "Owned", "Unlocked", "IsOwned", "Bought", "Purchased", "Equipped" }
local patched = {}

local function markTable(tbl, depth)
	if type(tbl) ~= "table" or depth > 4 then return end
	for k, v in pairs(tbl) do
		if type(v) == "boolean" then
			tbl[k] = true
		elseif type(v) == "table" then
			markTable(v, depth + 1)
		end
	end
end

local function patchModule(mod)
	if not mod or patched[mod] then return end
	patched[mod] = true
	local ok, data = pcall(require, mod)
	if not ok or type(data) ~= "table" then return end
	for _, key in ipairs(skinKeys) do
		if data[key] ~= nil then data[key] = true end
	end
	markTable(data, 0)
end

function unlockAllSkins()
	if _G.DH_STATUS then _G.DH_STATUS("Aplicando...", T.Accent) end
	local n, fired = 0, 0

	for _, d in ipairs(RS:GetDescendants()) do
		local name = d.Name:lower()
		if name:find("skin") or name:find("camo") or name:find("weapon") then
			if d:IsA("ModuleScript") then
				patchModule(d)
				n += 1
			end
			for _, key in ipairs(skinKeys) do
				pcall(function() d:SetAttribute(key, true) end)
			end
		end
	end

	for _, key in ipairs({ "AllSkins", "SkinsUnlocked", "UnlockedAll" }) do
		pcall(function() LP:SetAttribute(key, true) end)
	end

	for _, d in ipairs(RS:GetDescendants()) do
		if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
			local name = d.Name:lower()
			if name:find("skin") or name:find("unlock") or name:find("camo") then
				pcall(function()
					if d:IsA("RemoteEvent") then
						d:FireServer("All")
						d:FireServer()
					else
						d:InvokeServer("All")
					end
				end)
				fired += 1
			end
		end
	end

	CFG.Skins = true
	print("[DESTROYA] Skins: " .. n .. " módulos, " .. fired .. " remotes")
	if _G.DH_STATUS then
		_G.DH_STATUS("Listo: " .. n .. " módulos, " .. fired .. " remotes.", T.Accent)
	end
end

function forceSkinRefresh()
	local c = char()
	if not c then return end
	for _, tool in ipairs(c:GetChildren()) do
		if tool:IsA("Tool") then tool.Parent = c end
	end
	if _G.DH_STATUS then _G.DH_STATUS("Personaje refrescado.", T.Accent) end
end

