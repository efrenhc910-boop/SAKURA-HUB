local accEsp, accWall, accStatus = 0, 0, 0

reg(RunService.Heartbeat:Connect(function(dt)
	if not win.Visible then return end

	accEsp += dt
	if accEsp >= espT then
		accEsp = 0
		if CFG.ESP then espStep() elseif next(espObjs) then clearESP() end
	end

	accWall += dt
	if accWall >= wallT then
		accWall = 0
		if CFG.Walls then wallSweep() end
	end

	accStatus += dt
	if accStatus >= 1 then
		accStatus = 0
		refreshStatus()
	end

	tpStep(dt)
	circleStep(dt)
	flyStep()
	noclipStep()
	aimStep(dt)
	hitboxStep()
end))

