--_______________________
-- Círculo
-------------------------
function pixelRadius(d)
	local fov = math.rad(Cam.FieldOfView)
	return (CFG.CircleRadius * (Cam.ViewportSize.Y / 2)) / math.max(d * math.tan(fov / 2), 1)
end

local function enemiesInArea()
	local myRoot = root()
	if not myRoot then return {} end
	local myPos = myRoot.Position
	local out = {}

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and alive(p) and p.Team ~= LP.Team then
			local c = p.Character
			local hrp = c:FindFirstChild("HumanoidRootPart")
			local hd = c:FindFirstChild("Head")
			if hrp and hd then
				local flat = (Vector3.new(hrp.Position.X, myPos.Y, hrp.Position.Z) - myPos).Magnitude
				if flat <= CFG.CircleRadius then
					local sp, on = Cam:WorldToViewportPoint(hd.Position)
					if on and sp.Z > 0 then
						local center = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
						if (Vector2.new(sp.X, sp.Y) - center).Magnitude <= pixelRadius(sp.Z) then
							out[#out + 1] = { head = hd, dist = flat }
						end
					end
				end
			end
		end
	end

	table.sort(out, function(a, b) return a.dist < b.dist end)
	return out
end

function circleStep(dt)
	local active = CFG.Circle or CFG.Bot
	circleRing.Visible = active and win.Visible
	if not active then return end
	if not root() then return end

	local list = enemiesInArea()
	local near = list[1]

	if not near then
		ringStroke.Transparency = 0.45
		ringGlow.Transparency = 0.9
		return
	end

	ringStroke.Transparency = 0.05
	ringGlow.Transparency = 0.6

	local sp = Cam:WorldToViewportPoint(near.head.Position)
	local r = math.clamp(pixelRadius(sp.Z), 20, 420)
	circleRing.Size = UDim2.fromOffset(r * 2, r * 2)

	if not equipped() then return end

	if CFG.CircleAim then
		local goal = CFrame.lookAt(Cam.CFrame.Position, near.head.Position)
		Cam.CFrame = Cam.CFrame:Lerp(goal, math.clamp(dt * 9, 0, 1))
	end

	if os.clock() - lastHit >= CFG.CircleRate then
		lastHit = os.clock()
		local tool = equipped()
		if tool then pcall(function() tool:Activate() end) end
	end
end

