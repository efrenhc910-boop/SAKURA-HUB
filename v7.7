local function track(c)
    conns[#conns + 1] = c
    return c
end

local function bind(obj, prop, key)
    obj[prop] = C[key]
    return obj
end

local function tween(obj, props, time, style, dir)
    local t = TweenService:Create(obj,
        TweenInfo.new(time or 0.2, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function corner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = obj
    return c
end

local function stroke(obj, key, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = obj
    if key then bind(s, "Color", key) end
    return s
end

local function plain(parent, text, size, font, color, pos, sz, alignX)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextSize = size
    l.Font = font
    l.TextColor3 = color
    l.TextXAlignment = alignX or Enum.TextXAlignment.Left
    if pos then l.Position = pos end
    if sz then l.Size = sz end
    l.Parent = parent
    return l
end

local function mkLabel(parent, text, size, font, key, pos, sz, alignX)
    local l = plain(parent, text, size, font, C[key], pos, sz, alignX)
    bind(l, "TextColor3", key)
    return l
end

local function isPointer(input)
    return input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1
end

local orderN = 0
local function nextOrder()
    orderN += 1
    return orderN
end

local function safe(fn, label)
    return function(...)
        local ok, err = pcall(fn, ...)
        if not ok then
            warn("[DestroyaHub] error en " .. tostring(label) .. ": " .. tostring(err))
        end
    end
end

local function debounced(fn)
    local pending = false
    return function()
        if pending then return end
        pending = true
        task.defer(function()
            pending = false
            local ok, err = pcall(fn)
            if not ok then warn("[DestroyaHub] " .. tostring(err)) end
        end)
    end
end

local function lowFx()
    return UI.low or UI.autoLow
end

local function squish(btn, depth)
    local sc = Instance.new("UIScale")
    sc.Parent = btn
    btn.InputBegan:Connect(function(i)
        if isPointer(i) and UI.anim then tween(sc, { Scale = depth or 0.95 }, 0.08, Enum.EasingStyle.Quad) end
    end)
    btn.InputEnded:Connect(function(i)
        if isPointer(i) then tween(sc, { Scale = 1 }, 0.24, Enum.EasingStyle.Back) end
    end)
    return sc
end

local activeDrag, activeInput, activeEnd
local function endDrag()
    if not activeDrag then return end
    local fin = activeEnd
    activeDrag, activeInput, activeEnd = nil, nil, nil
    if UI.setScrollLock then UI.setScrollLock(false) end
    if fin then pcall(fin) end
end
local function beginDrag(input, handler, lockScroll, onEnd)
    endDrag()
    activeDrag, activeInput, activeEnd = handler, input, onEnd
    if lockScroll and UI.setScrollLock then UI.setScrollLock(true) end
end
track(UserInputService.InputChanged:Connect(function(input)
    if activeDrag and (input == activeInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
        local ok, err = pcall(activeDrag, input)
        if not ok then
            endDrag()
            warn("[DestroyaHub] arrastre: " .. tostring(err))
        end
    end
end))
track(UserInputService.InputEnded:Connect(function(input)
    if activeDrag and (input == activeInput or input.UserInputType == Enum.UserInputType.MouseButton1) then
        endDrag()
    end
end))

local lastToast
local function notify(text)
    if lastToast and lastToast.Parent then lastToast:Destroy() end
    local toast = Instance.new("Frame")
    lastToast = toast
    toast.AnchorPoint = Vector2.new(0.5, 1)
    toast.Size = UDim2.fromOffset(300, 32)
    toast.Position = UDim2.new(0.5, 0, 1, 14)
    toast.BackgroundColor3 = Color3.fromRGB(8, 22, 30)
    toast.BackgroundTransparency = 0.05
    toast.BorderSizePixel = 0
    toast.ZIndex = 30
    toast.Parent = Screen
    corner(toast, 10)
    stroke(toast, "Acc", 1, 0.55)
    local bar = Instance.new("Frame")
    bar.Position = UDim2.fromOffset(0, 8)
    bar.Size = UDim2.fromOffset(3, 16)
    bar.BackgroundColor3 = C.Acc
    bar.BorderSizePixel = 0
    bar.ZIndex = 31
    bar.Parent = toast
    corner(bar, 2)
    local l = plain(toast, text, 12, F.head, C.White, UDim2.fromOffset(12, 0), UDim2.new(1, -20, 1, 0))
    l.ZIndex = 31
    tween(toast, { Position = UDim2.new(0.5, 0, 1, -16) }, 0.35, Enum.EasingStyle.Back)
    task.delay(2.2, function()
        if toast.Parent then
            tween(toast, { Position = UDim2.new(0.5, 0, 1, 48) }, 0.25)
            task.delay(0.28, function() toast:Destroy() end)
        end
    end)
end

local function verify(label, fn, delay)
    task.delay(delay or 0.3, function()
        if not alive then return end
        local ok, res = pcall(fn)
        if ok and res then
            notify("OK · " .. label)
        else
            notify("FALLO · " .. label)
            warn("[DestroyaHub] comprobación fallida: " .. label)
        end
    end)
end

