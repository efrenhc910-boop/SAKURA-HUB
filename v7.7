local flyBV, flyBG

local function stopFly()
    if flyBV then flyBV:Destroy() flyBV = nil end
    if flyBG then flyBG:Destroy() flyBG = nil end
    local _, hum = getParts()
    if hum then hum.PlatformStand = false end
    S.flyUp, S.flyDown = false, false
    if S.noclip and not S.flyNoclipPrev then
        setNoclip(false)
        if UI.noclipToggle then UI.noclipToggle.Set(false, true) end
    end
    S.fly = false
end

local function startFly()
    local root, hum = getParts()
    if not root then
        notify("Sin personaje")
        return false
    end
    stopFly()
    S.flyNoclipPrev = S.noclip
    if not S.noclip then
        setNoclip(true)
        if UI.noclipToggle then UI.noclipToggle.Set(true, true) end
    end

    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(1, 1, 1) * 100000
    flyBV.P = 1250
    flyBV.Velocity = Vector3.zero
    flyBV.Parent = root

    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(1, 1, 1) * 100000
    flyBG.P = 3000
    flyBG.CFrame = root.CFrame
    flyBG.Parent = root

    if hum then hum.PlatformStand = true end
    S.fly = true
    return true
end

track(RunService.RenderStepped:Connect(function()
    if not S.fly then return end
    local ok, err = pcall(function()
        local root, hum = getParts()
        local cam = getCamera()
        if not root or not flyBV or not flyBG then return end

        local dir = Vector3.zero
        if hum then
            local move = hum.MoveDirection
            if move.Magnitude > 0.05 then dir = move.Unit end
        end
        if S.flyUp then dir += Vector3.yAxis end
        if S.flyDown then dir -= Vector3.yAxis end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end

        flyBV.Velocity = dir.Magnitude > 0 and dir.Unit * S.flySpeed or Vector3.zero
        if cam then flyBG.CFrame = CFrame.lookAt(root.Position, root.Position + cam.CFrame.LookVector) end
    end)
    if not ok then warn("[DestroyaHub] fly: " .. tostring(err)) end
end))

track(player.CharacterAdded:Connect(function()
    S.flyUp, S.flyDown = false, false
    if S.fly then
        task.wait(1.5)
        if S.fly then startFly() end
    end
end))

