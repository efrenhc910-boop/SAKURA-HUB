local setFpsBoost
do
    local orig = setmetatable({}, { __mode = "k" })
    local glob, conn, token = {}, nil, 0

    local KIND = {
        ParticleEmitter = "fx", Trail = "fx", Smoke = "fx", Fire = "fx", Sparkles = "fx", Beam = "fx",
        PointLight = "fx", SpotLight = "fx", SurfaceLight = "fx", Clouds = "fx",
        BloomEffect = "fx", BlurEffect = "fx", ColorCorrectionEffect = "fx",
        DepthOfFieldEffect = "fx", SunRaysEffect = "fx",
        Decal = "tex", Texture = "tex",
        Atmosphere = "atmo", SurfaceAppearance = "sa", Explosion = "boom",
    }

    local function esPersonaje(inst)
        local m = inst:FindFirstAncestorOfClass("Model")
        return m ~= nil and Players:GetPlayerFromCharacter(m) ~= nil
    end

    local function boost(inst)
        if not S.boost or orig[inst] then return end
        local kind = KIND[inst.ClassName]
        if not kind then
            if inst.ClassName == "Terrain" or not inst:IsA("BasePart") then return end
            kind = "part"
        end
        local saved
        pcall(function()
            if kind == "fx" then
                saved = { Enabled = inst.Enabled }
                inst.Enabled = false
            elseif kind == "tex" then
                if esPersonaje(inst) then return end
                saved = { Transparency = inst.Transparency }
                inst.Transparency = 1
            elseif kind == "atmo" then
                saved = { Density = inst.Density, Haze = inst.Haze }
                inst.Density, inst.Haze = 0, 0
            elseif kind == "sa" then
                if esPersonaje(inst) then return end
                saved = { Parent = inst.Parent }
                inst.Parent = nil
            elseif kind == "boom" then
                saved = { Visible = inst.Visible }
                inst.Visible = false
            else
                if esPersonaje(inst) then return end
                saved = { Material = inst.Material, Reflectance = inst.Reflectance, CastShadow = inst.CastShadow }
                inst.Material = Enum.Material.SmoothPlastic
                inst.Reflectance = 0
                inst.CastShadow = false
            end
        end)
        if saved then orig[inst] = saved end
    end

    local function sweep(list, myToken)
        local t0 = os.clock()
        for i = 1, #list do
            if myToken ~= token or not S.boost then return end
            boost(list[i])
            if os.clock() - t0 > 0.008 then
                RunService.Heartbeat:Wait()
                t0 = os.clock()
            end
        end
    end

    local function aplicarGlobal()
        pcall(function()
            glob.Q = settings().Rendering.QualityLevel
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)
        pcall(function()
            glob.M = settings().Rendering.MeshPartDetailLevel
            settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04
        end)
        pcall(function()
            glob.S = Lighting.GlobalShadows
            Lighting.GlobalShadows = false
            glob.So = Lighting.ShadowSoftness
            Lighting.ShadowSoftness = 0
        end)
        pcall(function()
            glob.E1, glob.E2 = Lighting.EnvironmentDiffuseScale, Lighting.EnvironmentSpecularScale
            Lighting.EnvironmentDiffuseScale = 0
            Lighting.EnvironmentSpecularScale = 0
        end)
    end

    local function restaurarGlobal()
        pcall(function() if glob.Q then settings().Rendering.QualityLevel = glob.Q end end)
        pcall(function() if glob.M then settings().Rendering.MeshPartDetailLevel = glob.M end end)
        pcall(function()
            if glob.S ~= nil then Lighting.GlobalShadows = glob.S end
            if glob.So ~= nil then Lighting.ShadowSoftness = glob.So end
        end)
        pcall(function()
            if glob.E1 then
                Lighting.EnvironmentDiffuseScale = glob.E1
                Lighting.EnvironmentSpecularScale = glob.E2
            end
        end)
        glob = {}
    end

    setFpsBoost = function(on)
        if not on then
            S.boost = false
            token += 1
            if conn then conn:Disconnect() conn = nil end
            for inst, saved in pairs(orig) do
                pcall(function()
                    for prop, value in pairs(saved) do inst[prop] = value end
                end)
            end
            table.clear(orig)
            restaurarGlobal()
            return
        end
        if S.boost then return end
        S.boost = true
        token += 1
        local myToken = token
        aplicarGlobal()
        if conn then conn:Disconnect() end
        conn = Workspace.DescendantAdded:Connect(function(inst)
            if S.boost then task.defer(boost, inst) end
        end)
        task.spawn(function()
            sweep(Lighting:GetDescendants(), myToken)
            local cam = Workspace.CurrentCamera
            if cam then sweep(cam:GetDescendants(), myToken) end
            sweep(Workspace:GetDescendants(), myToken)
        end)
    end
end

--==================================================
-- PAREDES CON LÍMITE DE ESTRUCTURAS
--==================================================
local setWalls
do
    local saved = {}
    local running = false
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.MaxParts = 4000

    local function esPiso(part, yRef)
        local sz = part.Size
        local minA = math.min(sz.X, sz.Y, sz.Z)
        local maxA = math.max(sz.X, sz.Y, sz.Z)
        if minA < 2 and maxA > 5 and sz.Y == minA then
            return part.Position.Y < yRef - 1.5
        end
        return false
    end

    local function contarEstructuras(root, lista)
        local n = 0
        for _, p in ipairs(lista) do
            if p:IsA("BasePart") and p.Parent and p.Transparency < 0.95 then
                local deco = p:FindFirstChildOfClass("SpecialMesh")
                    or p:FindFirstChildOfClass("Decal")
                    or p:FindFirstChildOfClass("Texture")
                if p:IsA("WedgePart") or p:IsA("TrussPart") or deco then
                    n += 1
                elseif not esPiso(p, root.Position.Y) then
                    local sz = p.Size
                    local minA = math.min(sz.X, sz.Y, sz.Z)
                    local maxA = math.max(sz.X, sz.Y, sz.Z)
                    if maxA > 5 and minA < 4 then n += 1 end
                end
            end
        end
        return n
    end

    local function restore(part)
        local t = saved[part]
        if t ~= nil then
            saved[part] = nil
            pcall(function() part.Transparency = t end)
        end
    end

    local function restoreAll()
        for part in pairs(saved) do restore(part) end
        table.clear(saved)
    end

    local function cycle()
        local root = getParts()
        if not root then return true end
        params.FilterDescendantsInstances = { player.Character }
        local hits = Workspace:GetPartBoundsInRadius(root.Position, CONFIG.WALL_RADIUS, params)

        local n = contarEstructuras(root, hits)
        if n > CONFIG.STRUCT_LIMIT then
            restoreAll()
            S.walls = false
            if UI.wallsToggle then UI.wallsToggle.Set(false, true) end
            notify("Paredes: " .. n .. " estructuras, límite " .. CONFIG.STRUCT_LIMIT)
            UI.setStatus("Paredes apagadas por exceso de estructuras")
            return false
        end

        local seen = {}
        for _, part in ipairs(hits) do
            if part:IsA("BasePart") and part.Parent then
                seen[part] = true
                if saved[part] == nil and part.Transparency < 0.6 then
                    saved[part] = part.Transparency
                    pcall(function() part.Transparency = CONFIG.WALL_ALPHA end)
                end
            end
        end

        for part in pairs(saved) do
            if not seen[part] or not part.Parent then
                if part.Parent then restore(part) else saved[part] = nil end
            end
        end
        return true
    end

    setWalls = function(on)
        if not on then
            S.walls = false
            restoreAll()
            return
        end
        if S.walls then return end
        S.walls = true
        if running then return end
        running = true
        task.spawn(function()
            while S.walls and Screen.Parent do
                local ok, cont = pcall(cycle)
                if not ok or not cont then break end
                task.wait(0.4)
            end
            running = false
            restoreAll()
        end)
    end
end

