FpsText.InputBegan:Connect(function(input)
    if isPointer(input) then
        local startPos, startMouse = FpsText.Position, input.Position
        beginDrag(input, function(i)
            local d = i.Position - startMouse
            FpsText.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end)
    end
end)

do
    local frames, fpsAcc, lowStreak, recover = 0, 0, 0, 0
    track(RunService.Heartbeat:Connect(function(dt)
        frames += 1
        fpsAcc += dt
        if fpsAcc >= 0.5 then
            local fps = math.floor(frames / fpsAcc + 0.5)
            FpsText.Text = "FPS " .. fps
            frames, fpsAcc = 0, 0
            if S.perf then return end
            if fps < 26 then
                lowStreak += 1
                recover = 0
                if lowStreak >= 4 and not UI.autoLow then
                    UI.autoLow = true
                    shineTween:Pause()
                end
            elseif fps > 40 then
                lowStreak = 0
                recover += 1
                if recover >= 8 and UI.autoLow then
                    UI.autoLow = false
                    shineTween:Play()
                end
            end
        end
    end))
end

