function stopTP()
    S.tpFollow = false
    S.tpTarget = nil
    if cancelBtn then cancelBtn.Visible = false end
    UI.setStatus("Seguimiento detenido")
end

local function tpDetras(plr)
    local myRoot = getParts()
    local tRoot = plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot or not tRoot then return false end
    local pos = tRoot.Position - tRoot.CFrame.LookVector * CONFIG.TP_OFFSET + Vector3.new(0, 1.5, 0)
    myRoot.CFrame = CFrame.new(pos, tRoot.Position)
    return true
end

function seguir(plr)
    if not plr or plr.Parent ~= Players or not alive(plr) then
        notify("Jugador no disponible")
        return
    end
    S.tpTarget = plr
    S.tpFollow = true
    tpDetras(plr)
    mostrarCancelar()
    UI.setStatus("Siguiendo a @" .. plr.Name)
end

local function tpStep(dt)
    if not S.tpFollow or not S.tpTarget then return end
    if not alive(S.tpTarget) then
        stopTP()
        return
    end
    tpAcc += dt
    if tpAcc < CONFIG.TP_TICK then return end
    tpAcc = 0

    local myRoot = getParts()
    local tRoot = S.tpTarget.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot or not tRoot then return end

    local pos = tRoot.Position - tRoot.CFrame.LookVector * CONFIG.TP_OFFSET + Vector3.new(0, 1.5, 0)
    if (myRoot.Position - pos).Magnitude > 2 then
        myRoot.CFrame = myRoot.CFrame:Lerp(CFrame.new(pos, tRoot.Position), 0.7)
    end
end

track(RunService.Heartbeat:Connect(function(dt)
    if not S.tpFollow then return end
    local ok, err = pcall(tpStep, dt)
    if not ok then warn("[DestroyaHub] tp: " .. tostring(err)) end
end))

local function autoEspalda()
    if not S.autoBack then return end
    task.delay(2.2, function()
        if not S.autoBack or not alive then return end
        local pick = nearestEnemy()
        if pick then
            tpDetras(pick)
            UI.setStatus("TP automático a @" .. pick.Name)
        end
    end)
end

