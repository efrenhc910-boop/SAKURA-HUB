local function killESP(p)
	local o = espObjs[p]
	if not o then return end
	espObjs[p] = nil
	for _, inst in pairs(o) do
		if typeof(inst) == "Instance" then pcall(function() inst:Destroy() end) end
	end
end

function clearESP()
	for p in pairs(espObjs) do killESP(p) end
end

local function buildESP(p, c, hrp)
	local ally = p.Team == LP.Team
	local col = ally and T.Ally or T.ESP
	local o = {}

	o.hl = new("Highlight", {
		FillColor = col,
		FillTransparency = 0.68,
		OutlineColor = col,
		OutlineTransparency = 0,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		Adornee = c,
	}, c)

	local bb = new("BillboardGui", {
		Size = UDim2.fromOffset(110, 42),
		StudsOffset = Vector3.new(0, 2.6, 0),
		AlwaysOnTop = true,
		MaxDistance = CFG.ESPDist + 25,
		Adornee = hrp,
	}, hrp)
	o.bb = bb

	local holder = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
	}, bb)

	o.name = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 13),
		BackgroundTransparency = 1,
		Text = p.Name,
		TextColor3 = col,
		Font = Enum.Font.GothamBold,
		TextSize = 10,
		TextStrokeTransparency = 0.35,
		TextStrokeColor3 = Color3.new(0, 0, 0),
	}, holder)

	local bg = new("Frame", {
		Size = UDim2.new(1, 0, 0, 5),
		Position = UDim2.new(0, 0, 0, 15),
		BackgroundColor3 = Color3.fromRGB(8, 12, 18),
		BorderSizePixel = 0,
	}, holder)
	corner(bg, 2)
	stroke(bg, col, 1, 0.3)

	o.fill = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = col,
		BorderSizePixel = 0,
	}, bg)
	corner(o.fill, 2)

	o.dist = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 12),
		Position = UDim2.new(0, 0, 0, 22),
		BackgroundTransparency = 1,
		Text = "0 m",
		TextColor3 = col,
		Font = Enum.Font.Gotham,
		TextSize = 9,
		TextStrokeTransparency = 0.35,
		TextStrokeColor3 = Color3.new(0, 0, 0),
	}, holder)

	local h = c:FindFirstChildOfClass("Humanoid")
	if h then
		o.hp = h.HealthChanged:Connect(function()
			if o.fill then
				o.fill.Size = UDim2.fromScale(math.clamp(h.Health / h.MaxHealth, 0, 1), 1)
			end
		end)
		o.fill.Size = UDim2.fromScale(math.clamp(h.Health / h.MaxHealth, 0, 1), 1)
	end

	espObjs[p] = o
end

function espStep()
	local myRoot = root()
	if not myRoot then clearESP() return end
	local myPos = myRoot.Position
	local seen = {}
	local cands = {}

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and alive(p) then
			local c = p.Character
			local hrp = c:FindFirstChild("HumanoidRootPart")
			local d = dist(myRoot, hrp)
			if d <= CFG.ESPDist then
				local ally = p.Team == LP.Team
				if CFG.ESPTeam or not ally then
					cands[#cands + 1] = { p = p, d = d, c = c, hrp = hrp }
				end
			end
		end
	end

	table.sort(cands, function(a, b) return a.d < b.d end)
	for i = 9, #cands do cands[i] = nil end

	for _, e in ipairs(cands) do
		seen[e.p] = true
		local o = espObjs[e.p]
		if not o then
			buildESP(e.p, e.c, e.hrp)
			o = espObjs[e.p]
		end
		if o then
			o.name.Visible = CFG.ESPName
			o.fill.Parent.Visible = CFG.ESPHealth
			o.dist.Text = math.floor(e.d) .. " m"
			o.hl.Enabled = CFG.ESPBox
		end
	end

	for p in pairs(espObjs) do
		if not seen[p] then killESP(p) end
	end
end

