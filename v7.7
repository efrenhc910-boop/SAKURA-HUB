end

--_______________________
-- Pestaña con icono
-------------------------
local function tab(name, icon, display, order)
	local b = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 27),
		BackgroundColor3 = T.Panel2,
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = order or 0,
		ZIndex = 5,
	}, side)
	corner(b, 6)

	new("TextLabel", {
		Size = UDim2.fromOffset(16, 27),
		Position = UDim2.fromOffset(6, 0),
		BackgroundTransparency = 1,
		Text = icon,
		TextColor3 = T.Muted,
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		ZIndex = 6,
	}, b)

	local txt = new("TextLabel", {
		Size = UDim2.new(1, -26, 1, 0),
		Position = UDim2.fromOffset(24, 0),
		BackgroundTransparency = 1,
		Text = display,
		TextColor3 = T.Muted,
		Font = Enum.Font.GothamMedium,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 6,
	}, b)

	local s = stroke(b, T.Stroke, 1, 0.6)
	local bar = new("Frame", {
		Size = UDim2.new(0, 2, 0.55, 0),
		Position = UDim2.new(0, 0, 0.22, 0),
		BackgroundColor3 = T.Accent,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 7,
	}, b)
	corner(bar, 1)

	squish(b)
	Tabs[name] = { btn = b, bar = bar, stroke = s, txt = txt }

	reg(b.MouseButton1Click:Connect(function()
		for n, t in pairs(Tabs) do
			t.btn.BackgroundTransparency = 0.45
			t.txt.TextColor3 = T.Muted
			t.bar.Visible = false
			t.stroke.Transparency = 0.6
			if Pages[n] then Pages[n].Visible = false end
		end
		b.BackgroundTransparency = 0
		txt.TextColor3 = T.Text
		bar.Visible = true
		s.Transparency = 0.2
		if Pages[name] then Pages[name].Visible = true end
	end))

	return b
end

