local playerConns = setmetatable({}, { __mode = "k" })

local function hookPlayer(plr)
    if plr == player then return end
    if playerConns[plr] then playerConns[plr]:Disconnect() end
    playerConns[plr] = plr.CharacterAdded:Connect(function()
        if S.esp then
            task.wait(1)
            if S.esp then pcall(applyESP, plr) end
        end
    end)
end

local function unhookPlayer(plr)
    local c = playerConns[plr]
    if c then
        c:Disconnect()
        playerConns[plr] = nil
    end
end

local function espTick()
    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then
        if next(espObjects) then clearESP() end
        return
    end

    local cands = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and (not isAlly(plr) or S.espTeam) then
            local char = plr.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                local d = (root.Position - myRoot.Position).Magnitude
                if d <= S.espDist then
                    cands[#cands + 1] = { p = plr, d = d, c = char, root = root }
                end
            end
        end
    end

    table.sort(cands, function(a, b) return a.d < b.d end)
    for i = CONFIG.MAX_TARGETS + 1, #cands do cands[i] = nil end

    local seen = {}
    for _, e in ipairs(cands) do
        seen[e.p] = true
        local o = espObjects[e.p]
        if not o or o.char ~= e.c then
            applyESP(e.p)
            o = espObjects[e.p]
        end
        if o then
            if not o.bb.Enabled then o.bb.Enabled = true end
            if not o.hl.Enabled then o.hl.Enabled = true end
            local head = e.c:FindFirstChild("Head") or e.root
            if head and o.bb.Adornee ~= head then o.bb.Adornee = head end

            local hum = e.c:FindFirstChildOfClass("Humanoid")
            local hp, mx = 0, 100
            if hum then
                hp = math.max(0, math.floor(hum.Health + 0.5))
                mx = math.max(1, math.floor(hum.MaxHealth + 0.5))
            end
            if o.hp ~= hp or o.mx ~= mx then
                o.hp, o.mx = hp, mx
                o.fill.Size = UDim2.fromScale(math.clamp(hp / mx, 0, 1), 1)
                o.hpL.Text = hp .. " / " .. mx
            end
            local dInt = math.floor(e.d)
            if o.dist ~= dInt then
                o.dist = dInt
                o.distL.Text = dInt .. " m"
            end
        end
    end

    for p in pairs(espObjects) do
        if not seen[p] then removeESP(p) end
    end
end

do
    local acc = 0
    track(RunService.Heartbeat:Connect(function(dt)
        if not S.esp then return end
        acc += dt
        if acc < CONFIG.ESP_TICK then return end
        acc = 0
        local ok, err = pcall(espTick)
        if not ok then warn("[DestroyaHub] esp: " .. tostring(err)) end
    end))
end

