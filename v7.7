-- Vuelo
-------------------------
local flyBV, flyBG

function stopFly()
	if flyBV then flyBV:Destroy() flyBV = nil end
	if flyBG then flyBG:Destroy() flyBG = nil end
	local h = hum()
	if h then h.PlatformStand = false end
end

function startFly()
	local hrp = root()
	if not hrp then return end
	stopFly()
	flyBV = new("BodyVelocity", {
		MaxForce = Vector3.new(1, 1, 1) * 100000,
		P = 1250,
		Velocity = Vector3.zero,
	}, hrp)
	flyBG = new("BodyGyro", {
		MaxTorque = Vector3.new(1, 1, 1) * 100000,
		P = 3000,
		CFrame = hrp.CFrame,
	}, hrp)
	local h = hum()
	if h then h.PlatformStand = true end
end

function flyStep()
	if not (CFG.Fly and flyBV and flyBG) then return end
	local cf = Cam.CFrame
	local dir = Vector3.zero
	if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cf.LookVector end
	if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cf.LookVector end
	if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cf.RightVector end
	if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cf.RightVector end
	if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
	if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
	flyBV.Velocity = dir.Magnitude > 0 and dir.Unit * CFG.FlySpeed or Vector3.zero
	flyBG.CFrame = cf
end

function noclipStep()
	if not CFG.Noclip then return end
	local c = char()
	if not c then return end
	for _, d in ipairs(c:GetDescendants()) do
		if d:IsA("BasePart") then d.CanCollide = false end
	end
end

--_______________________
-- Aimbot
-------------------------
local function aimTarget()
	local center = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
	local best, bestD = nil, CFG.AimFov
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and alive(p) and p.Team ~= LP.Team then
			local hd = p.Character:FindFirstChild("Head")
			if hd then
				local sp, on = Cam:WorldToViewportPoint(hd.Position)
				if on and sp.Z > 0 then
					local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
					if d < bestD then best, bestD = hd, d end
				end
			end
		end
	end
	return best
end

function aimStep(dt)
	if not CFG.Aim then return end
	local hd = aimTarget()
	if not hd then return end

	local goal = CFrame.lookAt(Cam.CFrame.Position, hd.Position)
	Cam.CFrame = Cam.CFrame:Lerp(goal, math.clamp(dt / math.max(CFG.AimSmooth, 0.02), 0, 1))

	if CFG.AimFire then
		local tool = equipped()
		if tool and os.clock() - lastHit >= 0.12 then
			lastHit = os.clock()
			pcall(function() tool:Activate() end)
		end
	end
end

