local TabButtons, Pages, tabOrder, builders, built = {}, {}, {}, {}, {}
local CurrentPage

local function moveIndicator(animated)
    local b = TabButtons[CurrentPage]
    if not b then return end
    if animated and UI.anim then
        tween(TabIndicator, { Position = b.Position, Size = b.Size }, 0.34, Enum.EasingStyle.Quint)
    else
        TabIndicator.Position = b.Position
        TabIndicator.Size = b.Size
    end
end

local function paintTabs(animated)
    for name, b in pairs(TabButtons) do
        local col = (name == CurrentPage) and C.Dark or C.Gray
        if animated and UI.anim then tween(b, { TextColor3 = col }, 0.24) else b.TextColor3 = col end
    end
    moveIndicator(animated)
end

local function layoutTabs()
    local n = #tabOrder
    if n == 0 then return end
    local gap = 4
    local w = math.max(100, (BASE_W - 16 - 6 - gap * (n - 1)) / n)
    for i, name in ipairs(tabOrder) do
        local b = TabButtons[name]
        b.Size = UDim2.fromOffset(w, 26)
        b.Position = UDim2.fromOffset(3 + (i - 1) * (w + gap), 2)
    end
    TabScroll.CanvasSize = UDim2.fromOffset(6 + n * (w + gap), 0)
    moveIndicator(false)
end

local function showPage(name)
    if CurrentPage == name then return end
    CurrentPage = name
    if builders[name] and not built[name] then
        built[name] = true
        local ok, err = pcall(builders[name], Pages[name])
        if not ok then warn("[DestroyaHub] construyendo " .. name .. ": " .. tostring(err)) end
    end
    for pageName, page in pairs(Pages) do
        local vis = pageName == name
        page.Visible = vis
        if vis then
            if UI.anim and not lowFx() then
                page.Position = UDim2.fromOffset(0, 12)
                tween(page, { Position = UDim2.fromOffset(0, 0) }, 0.28, Enum.EasingStyle.Quint)
            else
                page.Position = UDim2.fromOffset(0, 0)
            end
        end
    end
    paintTabs(true)
end

local function addTab(name, build)
    local b = Instance.new("TextButton")
    b.Name = name
    b.Text = string.upper(name)
    b.TextSize = 13
    b.Font = F.head
    b.BackgroundTransparency = 1
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    b.ZIndex = 2
    b.Parent = TabScroll
    squish(b, 0.94)
    TabButtons[name] = b
    tabOrder[#tabOrder + 1] = name

    local page = Instance.new("ScrollingFrame")
    page.Name = name
    page.Size = UDim2.fromScale(1, 1)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 3
    page.CanvasSize = UDim2.new()
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible = false
    page.ZIndex = 4
    page.Parent = Content
    bind(page, "ScrollBarImageColor3", "Acc")

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 10)
    pad.PaddingBottom = UDim.new(0, 12)
    pad.PaddingLeft = UDim.new(0, 8)
    pad.PaddingRight = UDim.new(0, 8)
    pad.Parent = page

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 12)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = page

    Pages[name] = page
    builders[name] = build
    b.Activated:Connect(function() showPage(name) end)
    layoutTabs()
    paintTabs(false)
    return page
end

