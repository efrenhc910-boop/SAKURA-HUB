-- NOCLIP
--==================================================
do
    local parts, changed, refreshAt = {}, {}, 0

    local function restore()
        for p in pairs(changed) do
            if p.Parent then p.CanCollide = true end
        end
        table.clear(changed)
    end

    setNoclip = function(on)
        S.noclip = on
        if on then refreshAt = 0 end
        if not on then restore() end
    end

    track(RunService.Heartbeat:Connect(function()
        if not S.noclip then return end
        local now = os.clock()
        if now >= refreshAt then
            refreshAt = now + 1
            table.clear(parts)
            local char = player.Character
            if char then
                for _, d in ipairs(char:GetDescendants()) do
                    if d:IsA("BasePart") then parts[#parts + 1] = d end
                end
            end
        end
        for i = 1, #parts do
            local p = parts[i]
            if p.Parent and p.CanCollide then
                changed[p] = true
                p.CanCollide = false
            end
        end
    end))

    track(player.CharacterAdded:Connect(function()
        table.clear(changed)
        refreshAt = 0
    end))
end

