local function iconButton(kind, pos, bgColor)
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(30, 30)
    b.Position = pos
    b.BackgroundColor3 = bgColor
    b.BackgroundTransparency = 0.05
    b.Text = ""
    b.AutoButtonColor = false
    b.ZIndex = 6
    b.Parent = Header
    corner(b, 9)
    squish(b, 0.88)
    local function glyph(w, rot)
        local f = Instance.new("Frame")
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.Position = UDim2.fromScale(0.5, 0.5)
        f.Size = UDim2.fromOffset(w, 2)
        f.Rotation = rot
        f.BackgroundColor3 = Color3.fromRGB(235, 252, 255)
        f.BorderSizePixel = 0
        f.ZIndex = 7
        f.Parent = b
        corner(f, 1)
    end
    if kind == "x" then
        glyph(15, 45)
        glyph(15, -45)
    else
        glyph(14, 0)
    end
    return b
end

