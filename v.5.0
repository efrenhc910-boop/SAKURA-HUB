TabScroll.Size = UDim2.fromScale(1, 1)
TabScroll.BackgroundTransparency = 1
TabScroll.BorderSizePixel = 0
TabScroll.ScrollBarThickness = 0
TabScroll.ScrollingDirection = Enum.ScrollingDirection.X
TabScroll.CanvasSize = UDim2.new()
TabScroll.Parent = TabBar

local TabIndicator = Instance.new("Frame")
TabIndicator.Size = UDim2.fromOffset(0, 20)
TabIndicator.Position = UDim2.fromOffset(3, 2)
TabIndicator.BorderSizePixel = 0
TabIndicator.ZIndex = 1
TabIndicator.Parent = TabScroll
bind(TabIndicator, "BackgroundColor3", "Acc")
corner(TabIndicator, 7)

local Content = Instance.new("Frame")
Content.Position = UDim2.fromOffset(8, HEADER_H + 36)
Content.Size = UDim2.new(1, -16, 1, -(HEADER_H + 36 + 24))
Content.BackgroundTransparency = 0.5
Content.BorderSizePixel = 0
