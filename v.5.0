--==================================================

local FpsText = Instance.new("TextButton")
FpsText.Name = "FpsText"
FpsText.Size = UDim2.fromOffset(96, 26)
FpsText.Position = UDim2.new(0.5, -48, 0, 6)
FpsText.BackgroundTransparency = 1
FpsText.AutoButtonColor = false
FpsText.Text = "FPS --"
FpsText.TextColor3 = Color3.new(1, 1, 1)
FpsText.TextSize = 18
FpsText.Font = Enum.Font.GothamBold
FpsText.ZIndex = 10
FpsText.Parent = Screen

local FpsStroke = Instance.new("UIStroke")
FpsStroke.Color = Color3.new(0, 0, 0)
FpsStroke.Thickness = 2
FpsStroke.Transparency = 0.05
FpsStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
FpsStroke.Parent = FpsText

local FpsGrad = Instance.new("UIGradient")
FpsGrad.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 60)),
    ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 200, 0)),
    ColorSequenceKeypoint.new(0.4, Color3.fromRGB(0, 255, 90)),
    ColorSequenceKeypoint.new(0.6, Color3.fromRGB(0, 230, 255)),
    ColorSequenceKeypoint.new(0.8, Color3.fromRGB(120, 60, 255)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 200)),
})
FpsGrad.Parent = FpsText

FpsText.InputBegan:Connect(function(input)
    if isPointer(input) then
        local startPos, startMouse = FpsText.Position, input.Position
        beginDrag(input, function(i)
            local d = i.Position - startMouse
            FpsText.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end)
    end
end)

--==================================================
-- BUCLE CENTRAL (15 veces por segundo, se pausa solo)
--==================================================

do
    local clock, acc, frames, fpsAcc = 0, 0, 0, 0

    track(RunService.Heartbeat:Connect(function(dt)
        frames += 1
        fpsAcc += dt
        if fpsAcc >= 0.5 then
            FpsText.Text = "FPS " .. math.floor(frames / fpsAcc + 0.5)
            frames, fpsAcc = 0, 0
        end

        acc += dt
        if acc < 1 / 15 then return end
        clock += acc
        acc = 0

        -- Siempre visibles (livianos)
        FpsGrad.Offset = Vector2.new(math.sin(clock * 1.8) * 0.5, 0)

        if CamStop.Visible then
            StopStroke.Transparency = 0.35 + 0.3 * math.sin(clock * 5)
        end

        if UI.flyPad.Visible then
            for i, it in ipairs(UI.padItems) do
                local c = Color3.fromHSV((clock * 0.4 + i * 0.17) % 1, 1, 1)
                it.stroke.Color = c
                it.btn.TextColor3 = c
            end
        end

        -- Decoración: se apaga con FPS Boost o con el interruptor Animaciones
        if not UI.anim or S.boost then return end

        ringGrad.Rotation = (clock * 80) % 360
        if os.clock() > UI.spinUntil then
            icon.Rotation = math.sin(clock * 2.2) * 8
        end

        -- Solo con el menú abierto
        if not UI.open then return end

        TitleGrad.Offset = Vector2.new(math.sin(clock * 1.4) * 0.5, 0)
        Scan.Position = UDim2.fromOffset((math.sin(clock * 1.3) * 0.5 + 0.5) * (BASE_W - 70), HEADER_H - 2)
        if UI.led then
            MainGrad.Rotation = (clock * 50) % 360
        end
    end))
end

--==================================================
-- LIMPIEZA (se ejecuta al cerrar con la X)
--==================================================

Screen.Destroying:Connect(function()
    S.camLock, S.fly, S.esp, S.infJump = false, false, false, false
    setWalkEnabled(false)
    setNoclip(false)
    setFpsBoost(false)
    setFullbright(false)
    stopFly()
    for _, c in ipairs(conns) do
        pcall(function() c:Disconnect() end)
    end
    pcall(function() RunService:UnbindFromRenderStep("TargetCamera") end)
    clearESP()
    releaseCamLock()
end)

notify("Efrén Hub v5.0 cargado 🌸")
print("🌸 EFRÉN HUB v5.0 CARGADO")