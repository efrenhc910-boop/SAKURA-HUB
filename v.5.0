-- BOTÓN DEL MENÚ (aro giratorio + flor)
--==================================================

local Toggle = Instance.new("TextButton")
Toggle.Name = "MenuButton"
Toggle.Size = UDim2.fromOffset(44, 44)
Toggle.Position = UDim2.new(0, 16, 0.5, -22)
Toggle.BackgroundTransparency = 0.12
Toggle.Text = ""
Toggle.AutoButtonColor = false
Toggle.ZIndex = 10
Toggle.Parent = Screen
bind(Toggle, "BackgroundColor3", "Dark")
corner(Toggle, 14)
squish(Toggle)

local ring = Instance.new("UIStroke")
ring.Thickness = 2.5
ring.Color = Color3.new(1, 1, 1)
ring.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
ring.Parent = Toggle
local ringGrad = Instance.new("UIGradient")
ringGrad.Parent = ring
onTheme(function()
    ringGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, C.Acc),
        ColorSequenceKeypoint.new(0.5, C.Acc2),
        ColorSequenceKeypoint.new(1, C.Acc),
    })
end)

local icon = Instance.new("TextLabel")
icon.Size = UDim2.fromScale(1, 1)
icon.BackgroundTransparency = 1
icon.Text = "🌸"
icon.TextSize = 24
icon.Font = Enum.Font.GothamBold
icon.ZIndex = 11
icon.Parent = Toggle

UI.spinUntil = 0

local function setOpen(v)
    if v == UI.open then return end
    UI.open = v
    UI.spinUntil = os.clock() + 0.6
    icon.Rotation = 0
    tween(icon, { Rotation = 360 }, 0.5, Enum.EasingStyle.Back)
    if v then
        Main.Position = HOME
        MenuScale.Scale = UI.size * 0.8
        Main.Visible = true
        tween(MenuScale, { Scale = UI.size }, 0.3, Enum.EasingStyle.Back)
    else
        tween(MenuScale, { Scale = UI.size * 0.8 }, 0.15)
        task.delay(0.17, function()
            if not UI.open then Main.Visible = false end
        end)
    end
end

local closing = false
local function destroyHub()
    if closing then return end
    closing = true
    UI.open = false
    tween(MenuScale, { Scale = 0.6 }, 0.15)
    tween(Main, { BackgroundTransparency = 1 }, 0.15)
    task.delay(0.17, function()
        if Screen.Parent then Screen:Destroy() end
    end)
end

Toggle.Activated:Connect(function() setOpen(not UI.open) end)
HideBtn.Activated:Connect(function() setOpen(false) end)
Close.Activated:Connect(destroyHub)

