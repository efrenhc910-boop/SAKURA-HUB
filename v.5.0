corner(Content, 9)

local Status = mkLabel(Main, "Listo  •  Toca 🌸 para ocultar", 9, Enum.Font.Gotham, "Gray",
    UDim2.new(0, 12, 1, -20), UDim2.fromOffset(300, 14))

local TabButtons, Pages, tabOrder = {}, {}, {}
local CurrentPage

local function moveIndicator(animated)
    local b = TabButtons[CurrentPage]
    if not b then return end
    if animated then
        tween(TabIndicator, { Position = b.Position, Size = b.Size }, 0.28, Enum.EasingStyle.Quint)
    else
        TabIndicator.Position = b.Position
        TabIndicator.Size = b.Size
    end
end

local function paintTabs(animated)
    for name, b in pairs(TabButtons) do
        local col = (name == CurrentPage) and C.Dark or C.Gray
        if animated then
            tween(b, { TextColor3 = col }, 0.2)
        else
            b.TextColor3 = col
        end
    end
    moveIndicator(animated)
end
onTheme(function() paintTabs(false) end)

local function layoutTabs()
    local n = #tabOrder
    if n == 0 then return end
    local gap = 3
    local w = (TAB_BAR_W - 6 - gap * (n - 1)) / n
    if w < 84 then w = 84 end
    for i, name in ipairs(tabOrder) do
        local b = TabButtons[name]
        b.Size = UDim2.fromOffset(w, 20)
        b.Position = UDim2.fromOffset(3 + (i - 1) * (w + gap), 2)
    end
    TabScroll.CanvasSize = UDim2.fromOffset(6 + n * (w + gap), 0)
    moveIndicator(false)
end

local function showPage(name)
    if CurrentPage == name then return end
    CurrentPage = name
    for pageName, page in pairs(Pages) do
        page.Visible = pageName == name
    end
    paintTabs(true)
end

local function createPage(name)
    local page = Instance.new("ScrollingFrame")
    page.Name = name
    page.Size = UDim2.fromScale(1, 1)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 3
    page.CanvasSize = UDim2.new()
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible = false
    page.Parent = Content
    bind(page, "ScrollBarImageColor3", "Acc")

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 6)
    pad.PaddingBottom = UDim.new(0, 6)
    pad.PaddingLeft = UDim.new(0, 6)
    pad.PaddingRight = UDim.new(0, 6)
    pad.Parent = page

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = page

    Pages[name] = page
    return page
end

local function addTab(name)
    local b = Instance.new("TextButton")
    b.Name = name
    b.Text = name
    b.TextSize = 11
    b.Font = Enum.Font.GothamBold
    b.BackgroundTransparency = 1
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    b.ZIndex = 2
    b.Parent = TabScroll
    squish(b)
    TabButtons[name] = b
    tabOrder[#tabOrder + 1] = name
    local page = createPage(name)
    b.Activated:Connect(function() showPage(name) end)
    layoutTabs()
    paintTabs(false)
    return page
end

local function setMenuTransparency(v)
    Main.BackgroundTransparency = v
    Content.BackgroundTransparency = math.min(0.95, v + 0.15)
    TabBar.BackgroundTransparency = math.min(0.95, v)
    Header.BackgroundTransparency = math.min(0.9, 0.1 + v * 0.5)
end

