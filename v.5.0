--==================================================
-- DECORACIÓN (esquinas y línea de escaneo)
--==================================================

do
    local function bracket(ax, ay, px, py)
        for i = 1, 2 do
            local f = Instance.new("Frame")
            f.AnchorPoint = Vector2.new(ax, ay)
            f.Position = UDim2.new(px, ax == 0 and 5 or -5, py, ay == 0 and 5 or -5)
            f.Size = i == 1 and UDim2.fromOffset(10, 2) or UDim2.fromOffset(2, 10)
            f.BorderSizePixel = 0
            f.ZIndex = 6
            f.Parent = Main
            bind(f, "BackgroundColor3", "Acc2")
        end
    end
    bracket(0, 0, 0, 0)
    bracket(1, 0, 1, 0)
    bracket(0, 1, 0, 1)
    bracket(1, 1, 1, 1)
end

local Scan = Instance.new("Frame")
Scan.Size = UDim2.fromOffset(70, 2)
Scan.Position = UDim2.fromOffset(0, HEADER_H - 2)
Scan.BorderSizePixel = 0
Scan.ZIndex = 5
Scan.Parent = Main
bind(Scan, "BackgroundColor3", "Acc2")
do
    local sg = Instance.new("UIGradient")
    sg.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.5, 0),
        NumberSequenceKeypoint.new(1, 1),
    })
    sg.Parent = Scan
end

--==================================================
-- BOTONES DE FLY (solo con Fly activo, arcoíris neón)
--==================================================

UI.padItems = {}
local heldInputs = {}

do
    local PAD_BG = Color3.fromRGB(8, 12, 30)
    local PAD_ON = Color3.fromRGB(38, 46, 92)

    local pad = Instance.new("Frame")
    pad.Name = "FlyPad"
    pad.Size = UDim2.fromOffset(54, 138)
    pad.Position = UDim2.new(1, -76, 0.5, -69)
    pad.BackgroundTransparency = 1
    pad.Visible = false
    pad.ZIndex = 10
    pad.Parent = Screen
    UI.flyPad = pad

    local function styleItem(btn, thickness)
        local s = Instance.new("UIStroke")
        s.Thickness = thickness
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        s.Parent = btn
        UI.padItems[#UI.padItems + 1] = { btn = btn, stroke = s }
    end

    local handle = Instance.new("TextButton")
    handle.Size = UDim2.fromOffset(54, 16)
    handle.BackgroundColor3 = PAD_BG
    handle.BackgroundTransparency = 0.15
    handle.AutoButtonColor = false
    handle.Text = "FLY"
    handle.TextSize = 9
    handle.Font = Enum.Font.GothamBlack
    handle.ZIndex = 10
    handle.Parent = pad
    corner(handle, 8)
    styleItem(handle, 1.4)

    handle.InputBegan:Connect(function(input)
        if isPointer(input) then
            local startPos, startMouse = pad.Position, input.Position
            beginDrag(input, function(i)
                local d = i.Position - startMouse
                pad.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y
                )
            end)
        end
    end)

    local padBtns = {}
    local function makePadButton(text, y, key)
        local b = Instance.new("TextButton")
        b.Size = UDim2.fromOffset(54, 54)
        b.Position = UDim2.fromOffset(0, y)
        b.BackgroundColor3 = PAD_BG
        b.BackgroundTransparency = 0.2
        b.AutoButtonColor = false
        b.Text = text
        b.TextSize = 22
        b.Font = Enum.Font.GothamBlack
        b.ZIndex = 10
        b.Parent = pad
        corner(b, 14)
        styleItem(b, 2)
        padBtns[key] = b

        b.InputBegan:Connect(function(input)
            if isPointer(input) then
                flyInput[key] = true
                heldInputs[key] = input
                b.BackgroundColor3 = PAD_ON
            end
        end)
    end
    makePadButton("▲", 20, "up")
    makePadButton("▼", 80, "down")

    UI.resetFlyInput = function()
        for key in pairs(flyInput) do
            flyInput[key] = false
            heldInputs[key] = nil
            if padBtns[key] then padBtns[key].BackgroundColor3 = PAD_BG end
        end
    end

    track(UserInputService.InputEnded:Connect(function(input)
        for key, held in pairs(heldInputs) do
            if held == input or input.UserInputType == Enum.UserInputType.MouseButton1 then
                heldInputs[key] = nil
                flyInput[key] = false
                if padBtns[key] then padBtns[key].BackgroundColor3 = PAD_BG end
            end
        end
    end))
end

