--==================================================
-- COMPONENTES
--==================================================

-- Título de sección: barra de color + texto + línea (sin símbolos raros)
local function createSection(page, text)
    local h = Instance.new("Frame")
    h.Size = UDim2.new(1, -4, 0, 16)
    h.BackgroundTransparency = 1
    h.LayoutOrder = nextOrder()
    h.Parent = page

    local bar = Instance.new("Frame")
    bar.Size = UDim2.fromOffset(3, 11)
    bar.Position = UDim2.fromOffset(2, 2)
    bar.BorderSizePixel = 0
    bar.Parent = h
    bind(bar, "BackgroundColor3", "Acc")
    corner(bar, 2)

    mkLabel(h, text, 10, Enum.Font.GothamBold, "Acc2", UDim2.fromOffset(11, 0), UDim2.fromOffset(300, 15))

    local w = TextService:GetTextSize(text, 10, Enum.Font.GothamBold, Vector2.new(400, 20)).X
    local line = Instance.new("Frame")
    line.Position = UDim2.fromOffset(11 + w + 8, 7)
    line.Size = UDim2.new(1, -(11 + w + 8) - 4, 0, 1)
    line.BackgroundTransparency = 0.7
    line.BorderSizePixel = 0
    line.Parent = h
    bind(line, "BackgroundColor3", "Acc")
    return h
end

local function createGrid(page)
    local grid = Instance.new("Frame")
    grid.Size = UDim2.new(1, -4, 0, 0)
    grid.BackgroundTransparency = 1
    grid.AutomaticSize = Enum.AutomaticSize.Y
    grid.LayoutOrder = nextOrder()
    grid.Parent = page

    local layout = Instance.new("UIGridLayout")
    layout.CellSize = UDim2.new(0.5, -3, 0, 32)
    layout.CellPadding = UDim2.fromOffset(6, 6)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = grid
    return grid
end

-- Botón interruptor: barra de color + interruptor deslizante
-- Devuelve: botón, setEnabled(valor, silencioso)
local function createButton(parent, name, description, callback)
    local row = Instance.new("TextButton")
    row.Size = UDim2.new(1, -4, 0, 32)
    row.BackgroundTransparency = 0.1
    row.Text = ""
    row.AutoButtonColor = false
    row.LayoutOrder = nextOrder()
    row.Parent = parent
    corner(row, 8)
    squish(row)

    local accent = Instance.new("Frame")
    accent.AnchorPoint = Vector2.new(0, 0.5)
    accent.Position = UDim2.new(0, 0, 0.5, 0)
    accent.Size = UDim2.fromOffset(3, 0)
    accent.BorderSizePixel = 0
    accent.Parent = row
    corner(accent, 2)

    mkLabel(row, name, 11, Enum.Font.GothamBold, "White", UDim2.fromOffset(11, 3), UDim2.new(1, -58, 0, 14))
    local desc = mkLabel(row, description, 8, Enum.Font.Gotham, "Gray", UDim2.fromOffset(11, 17), UDim2.new(1, -58, 0, 11))
    desc.TextTruncate = Enum.TextTruncate.AtEnd

    local pill = Instance.new("Frame")
    pill.Size = UDim2.fromOffset(32, 16)
    pill.Position = UDim2.new(1, -42, 0.5, -8)
    pill.BorderSizePixel = 0
    pill.Parent = row
    corner(pill, 8)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(12, 12)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    knob.Parent = pill
    corner(knob, 6)

    local enabled = false
    local function paint(animated)
        local targets = {
            { row, { BackgroundColor3 = enabled and C.RowOn or C.Row } },
            { accent, { Size = UDim2.fromOffset(3, enabled and 18 or 0), BackgroundColor3 = C.Acc2 } },
            { pill, { BackgroundColor3 = enabled and C.Acc or C.Off } },
            { knob, { Position = enabled and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6) } },
        }
        for _, t in ipairs(targets) do
            if animated then
                tween(t[1], t[2], 0.18)
            else
                for k, v in pairs(t[2]) do t[1][k] = v end
            end
        end
    end
    onTheme(function() paint(false) end)

    local function setEnabled(value, silent)
        enabled = value
        paint(true)
        if callback and not silent then callback(enabled) end
    end

    row.Activated:Connect(function() setEnabled(not enabled) end)
    return row, setEnabled
end

-- Barra deslizante compacta (táctil). Devuelve la fila
local function createSlider(page, name, min, max, default, fmt, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -4, 0, 36)
    row.BackgroundTransparency = 0.1
    row.LayoutOrder = nextOrder()
    row.Parent = page
    bind(row, "BackgroundColor3", "Row")
    corner(row, 8)

    mkLabel(row, name, 11, Enum.Font.GothamBold, "White", UDim2.fromOffset(10, 2), UDim2.new(0.6, 0, 0, 15))
    local valueLabel = mkLabel(row, "", 10, Enum.Font.GothamBold, "Acc2",
        UDim2.new(0.6, 0, 0, 2), UDim2.new(0.4, -10, 0, 15), Enum.TextXAlignment.Right)

    local hit = Instance.new("Frame")
    hit.Size = UDim2.new(1, -20, 0, 18)
    hit.Position = UDim2.fromOffset(10, 16)
    hit.BackgroundTransparency = 1
    hit.Parent = row

    local bar = Instance.new("Frame")
    bar.AnchorPoint = Vector2.new(0, 0.5)
    bar.Size = UDim2.new(1, 0, 0, 5)
    bar.Position = UDim2.fromScale(0, 0.5)
    bar.BorderSizePixel = 0
    bar.Parent = hit
    bind(bar, "BackgroundColor3", "Off")
    corner(bar, 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(0, 1)
    fill.BorderSizePixel = 0
    fill.Parent = bar
    bind(fill, "BackgroundColor3", "Acc")
    corner(fill, 3)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(13, 13)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BorderSizePixel = 0
    knob.Parent = bar
    bind(knob, "BackgroundColor3", "White")
    corner(knob, 7)

    local function setRatio(r)
        r = math.clamp(r, 0, 1)
        fill.Size = UDim2.fromScale(r, 1)
        knob.Position = UDim2.fromScale(r, 0.5)
        local value = min + (max - min) * r
        valueLabel.Text = fmt(value)
        if callback then callback(value) end
    end

    local function fromInput(input)
        local w = bar.AbsoluteSize.X
        if w > 0 then
            setRatio((input.Position.X - bar.AbsolutePosition.X) / w)
        end
    end

    hit.InputBegan:Connect(function(input)
        if isPointer(input) then
            fromInput(input)
            beginDrag(input, fromInput)
        end
    end)

    setRatio((default - min) / (max - min))
    return row
end

-- Sección deslizante: al tocarla se despliega (el contenido se crea una sola vez)
local function createCollapsible(page, title, bodyH, onFirstOpen)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -4, 0, 32)
    holder.BackgroundTransparency = 0.1
    holder.ClipsDescendants = true
    holder.LayoutOrder = nextOrder()
    holder.Parent = page
    bind(holder, "BackgroundColor3", "Row")
    corner(holder, 8)

    local head = Instance.new("TextButton")
    head.Size = UDim2.new(1, 0, 0, 32)
    head.BackgroundTransparency = 1
    head.Text = ""
    head.AutoButtonColor = false
    head.Parent = holder
    squish(head)

    local sw = Instance.new("Frame")
    sw.Size = UDim2.fromOffset(12, 12)
    sw.Position = UDim2.fromOffset(10, 10)
    sw.BorderSizePixel = 0
    sw.Parent = head
    bind(sw, "BackgroundColor3", "Acc")
    corner(sw, 6)

    mkLabel(head, title, 11, Enum.Font.GothamBold, "White", UDim2.fromOffset(30, 0), UDim2.new(1, -62, 1, 0))
    local sign = mkLabel(head, "+", 15, Enum.Font.GothamBold, "Acc2",
        UDim2.new(1, -28, 0, 0), UDim2.fromOffset(20, 32), Enum.TextXAlignment.Center)

    local body = Instance.new("Frame")
    body.Position = UDim2.fromOffset(0, 32)
    body.Size = UDim2.new(1, 0, 0, bodyH)
    body.BackgroundTransparency = 1
    body.Parent = holder

    local open, built = false, false
    head.Activated:Connect(function()
        open = not open
        if open and not built then
            built = true
            if onFirstOpen then onFirstOpen(body) end
        end
        sign.Text = open and "-" or "+"
        tween(holder, { Size = UDim2.new(1, -4, 0, open and (32 + bodyH + 6) or 32) }, 0.28)
    end)
    return body
end

--==================================================
-- COLOR DEL MENÚ: rueda de colores (aro de 60 piezas)
--==================================================

local hh, ss, vv = AZUL.Acc:ToHSV()
local custom = { h = hh, s = ss, v = vv }
local customBusy = false

local function applyCustom()
    if customBusy then return end
    customBusy = true
    task.delay(0.1, function()
        customBusy = false
        applyTheme(makeTheme(custom.h, custom.s, custom.v))
    end)
end

local function createColorPicker(page)
    local R, r0, N = 44, 22, 60
    local mid = (R + r0) / 2
    local midRatio = mid / (2 * R)

    createCollapsible(page, "Color del menú", 2 * R + 92, function(body)
        local wheel = Instance.new("Frame")
        wheel.AnchorPoint = Vector2.new(0.5, 0)
        wheel.Position = UDim2.new(0.5, 0, 0, 4)
        wheel.Size = UDim2.fromOffset(2 * R, 2 * R)
        wheel.BackgroundTransparency = 1
        wheel.Parent = body

        local len = R - r0
        local thick = math.ceil(2 * math.pi * R / N) + 1
        for i = 0, N - 1 do
            local hue = i / N
            local ang = hue * 2 * math.pi
            local s = Instance.new("Frame")
            s.AnchorPoint = Vector2.new(0.5, 0.5)
            s.Size = UDim2.fromOffset(len, thick)
            s.Position = UDim2.fromOffset(R + math.cos(ang) * mid, R + math.sin(ang) * mid)
            s.Rotation = math.deg(ang)
            s.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
            s.BorderSizePixel = 0
            s.Parent = wheel
        end

        -- Vista previa en el centro
        local preview = Instance.new("Frame")
        preview.AnchorPoint = Vector2.new(0.5, 0.5)
        preview.Position = UDim2.fromScale(0.5, 0.5)
        preview.Size = UDim2.fromOffset(2 * (r0 - 4), 2 * (r0 - 4))
        preview.BorderSizePixel = 0
        preview.Parent = wheel
        corner(preview, r0)

        local function updatePreview()
            preview.BackgroundColor3 = Color3.fromHSV(custom.h, custom.s, math.max(custom.v, 0.55))
        end
        updatePreview()

        local marker = Instance.new("Frame")
        marker.AnchorPoint = Vector2.new(0.5, 0.5)
        marker.Size = UDim2.fromOffset(12, 12)
        marker.BackgroundTransparency = 1
        marker.ZIndex = 5
        marker.Parent = wheel
        corner(marker, 6)
        local ms = Instance.new("UIStroke")
        ms.Color = Color3.new(1, 1, 1)
        ms.Thickness = 2
        ms.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        ms.Parent = marker
        local a0 = custom.h * 2 * math.pi
        marker.Position = UDim2.fromScale(0.5 + math.cos(a0) * midRatio, 0.5 + math.sin(a0) * midRatio)

        local hit = Instance.new("TextButton")
        hit.Size = UDim2.fromScale(1, 1)
        hit.BackgroundTransparency = 1
        hit.Text = ""
        hit.AutoButtonColor = false
        hit.ZIndex = 6
        hit.Parent = wheel

        local function pick(input)
            local size = wheel.AbsoluteSize.X
            if size <= 0 then return end
            local rad = size / 2
            local p = screenPos(input)
            local dx = p.X - (wheel.AbsolutePosition.X + rad)
            local dy = p.Y - (wheel.AbsolutePosition.Y + rad)
            if math.sqrt(dx * dx + dy * dy) < 4 then return end
            local ang = math.atan2(dy, dx)
            custom.h = (math.deg(ang) % 360) / 360
            marker.Position = UDim2.fromScale(0.5 + math.cos(ang) * midRatio, 0.5 + math.sin(ang) * midRatio)
            updatePreview()
            applyCustom()
        end

        hit.InputBegan:Connect(function(input)
            if isPointer(input) then
                pick(input)
                beginDrag(input, pick)
            end
        end)

        -- Saturación y brillo
        local ready = false
        local r1 = createSlider(body, "Saturación", 0, 1, custom.s,
            function(v) return string.format("%d%%", math.floor(v * 100 + 0.5)) end,
            function(v)
                custom.s = v
                if ready then
                    updatePreview()
                    applyCustom()
                end
            end)
        r1.BackgroundTransparency = 1
        r1.Position = UDim2.fromOffset(2, 2 * R + 8)

        local r2 = createSlider(body, "Brillo", 0.4, 1, custom.v,
            function(v) return string.format("%d%%", math.floor(v * 100 + 0.5)) end,
            function(v)
                custom.v = v
                if ready then
                    updatePreview()
                    applyCustom()
                end
            end)
        r2.BackgroundTransparency = 1
        r2.Position = UDim2.fromOffset(2, 2 * R + 46)
        ready = true
    end)
end

print("[EfrenHub] parte 3 lista")
--==================================================
-- ESTADO
--==================================================

local S = {
    esp = false, camLock = false, lockMode = nil, lastMode = "head",
    infJump = false, fly = false, walk = false, noclip = false,
    boost = false, full = false,
    flySpeed = 60, walkSpeed = 32, defWalk = 16, target = nil,
}
local flyInput = { up = false, down = false }

local function getCamera()
    return Workspace.CurrentCamera
end

local function getParts()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid"), char
end

--==================================================
-- ESP (enemigos en rojo, aliados en azul)
--==================================================

local PAL = {
    enemy = {
        main = Color3.fromRGB(255, 35, 45),
        light = Color3.fromRGB(255, 130, 130),
        dark = Color3.fromRGB(120, 0, 8),
    },
    ally = {
        main = Color3.fromRGB(35, 120, 255),
        light = Color3.fromRGB(130, 200, 255),
        dark = Color3.fromRGB(0, 40, 140),
    },
}
local espObjects = {}

local function isAlly(plr)
    if player.Team ~= nil and plr.Team ~= nil then
        return plr.Team == player.Team
    end
    local a, b = player:GetAttribute("Team"), plr:GetAttribute("Team")
    if a ~= nil and b ~= nil then
        return a == b
    end
    return false
end

local function removeESP(plr)
    local d = espObjects[plr]
    if d then
        if d.hl then d.hl:Destroy() end
        if d.bb then d.bb:Destroy() end
        espObjects[plr] = nil
    end
end

local function clearESP()
    for plr in pairs(espObjects) do removeESP(plr) end
end

local function espText(parent, size, font, pos, sz)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Font = font
    l.TextSize = size
    l.TextColor3 = Color3.new(1, 1, 1)
    l.TextStrokeTransparency = 0.2
    l.TextStrokeColor3 = Color3.new(0, 0, 0)
    l.Position = pos
    l.Size = sz
    l.Parent = parent
    return l
end

local function paintESP(d, ally)
    local p = ally and PAL.ally or PAL.enemy
    d.ally = ally
    d.hl.FillColor = p.main
    d.hl.OutlineColor = p.light
    d.nameL.TextColor3 = p.main
    d.distL.TextColor3 = p.light
    d.barStroke.Color = p.light
    d.barBack.BackgroundColor3 = p.dark:Lerp(Color3.new(0, 0, 0), 0.65)
    d.grad.Color = ColorSequence.new(p.dark, p.main)
end

local function applyESP(plr)
    if plr == player then return end
    local char = plr.Character
    if not char then return end
    removeESP(plr)

    local hl = Instance.new("Highlight")
    hl.Adornee = char
    hl.FillTransparency = 0.2
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = Workspace

    local bb = Instance.new("BillboardGui")
    bb.Name = "EfrenESP"
    bb.Size = UDim2.fromOffset(150, 46)
    bb.StudsOffset = Vector3.new(0, 3.1, 0)
    bb.AlwaysOnTop = true
    bb.LightInfluence = 0
    bb.Adornee = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    bb.Parent = Workspace

    local nameL = espText(bb, 13, Enum.Font.GothamBlack, UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, 14))
    nameL.Text = plr.Name

    local barBack = Instance.new("Frame")
    barBack.AnchorPoint = Vector2.new(0.5, 0)
    barBack.Position = UDim2.new(0.5, 0, 0, 16)
    barBack.Size = UDim2.new(0.9, 0, 0, 13)
    barBack.BackgroundTransparency = 0.1
    barBack.BorderSizePixel = 0
    barBack.Parent = bb
    corner(barBack, 4)

    local barStroke = Instance.new("UIStroke")
    barStroke.Thickness = 1.4
    barStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    barStroke.Parent = barBack

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(1, 1)
    fill.BackgroundColor3 = Color3.new(1, 1, 1)
    fill.BorderSizePixel = 0
    fill.Parent = barBack
    corner(fill, 4)

    local grad = Instance.new("UIGradient")
    grad.Parent = fill

    for i = 1, 3 do
        local tk = Instance.new("Frame")
        tk.Size = UDim2.new(0, 1, 1, 0)
        tk.Position = UDim2.fromScale(i / 4, 0)
        tk.BackgroundColor3 = Color3.new(0, 0, 0)
        tk.BackgroundTransparency = 0.45
        tk.BorderSizePixel = 0
        tk.ZIndex = 2
        tk.Parent = barBack
    end

    local hpL = espText(barBack, 9, Enum.Font.GothamBlack, UDim2.new(), UDim2.fromScale(1, 1))
    hpL.ZIndex = 3
    hpL.TextStrokeTransparency = 0.1

    local distL = espText(bb, 10, Enum.Font.GothamBold, UDim2.fromOffset(0, 31), UDim2.new(1, 0, 0, 12))

    local d = {
        hl = hl, bb = bb, nameL = nameL, distL = distL, barBack = barBack,
        barStroke = barStroke, fill = fill, grad = grad, hpL = hpL,
        char = char, hp = -1, mx = -1, dist = -1, ally = nil,
    }
    espObjects[plr] = d
    paintESP(d, isAlly(plr))
end

local function hookPlayer(plr)
    if plr == player then return end
    track(plr.CharacterAdded:Connect(function()
        if S.esp then
            task.wait(1)
            if S.esp then applyESP(plr) end
        end
    end))
end

do
    local acc = 0
    track(RunService.Heartbeat:Connect(function(dt)
        if not S.esp then return end
        acc += dt
        if acc < 0.12 then return end
        acc = 0

        local lr = player.Character and player.Character:FindFirstChild("HumanoidRootPart")

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then
                local char = plr.Character
                local d = espObjects[plr]

                if char and (not d or d.char ~= char) then
                    applyESP(plr)
                    d = espObjects[plr]
                end

                if d and char then
                    local ally = isAlly(plr)
                    if d.ally ~= ally then paintESP(d, ally) end

                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local root = char:FindFirstChild("HumanoidRootPart")
                    local head = char:FindFirstChild("Head") or root
                    if head and d.bb.Adornee ~= head then d.bb.Adornee = head end

                    local hp, mx = 0, 100
                    if hum then
                        hp = math.max(0, math.floor(hum.Health + 0.5))
                        mx = math.max(1, math.floor(hum.MaxHealth + 0.5))
                    end

                    if d.hp ~= hp or d.mx ~= mx then
                        d.hp, d.mx = hp, mx
                        d.fill.Size = UDim2.fromScale(math.clamp(hp / mx, 0, 1), 1)
                        d.hpL.Text = hp .. "/" .. mx
                    end

                    local dist = (root and lr) and math.floor((root.Position - lr.Position).Magnitude + 0.5) or 0
                    if d.dist ~= dist then
                        d.dist = dist
                        d.distL.Text = dist .. " m"
                    end
                end
            end
        end
    end))
end

for _, plr in ipairs(Players:GetPlayers()) do
    hookPlayer(plr)
end

--==================================================
-- CAM LOCK (modo cabeza / modo pecho)
--==================================================

local setHeadToggle, setChestToggle, updatePlayerList

local function releaseCamLock()
    local cam = getCamera()
    if cam then cam.CameraType = Enum.CameraType.Custom end
    local _, hum = getParts()
    if hum then hum.AutoRotate = true end
end

local function setLockMode(mode)
    S.lockMode = mode
    S.camLock = mode ~= nil
    if mode then S.lastMode = mode end
    if setHeadToggle then setHeadToggle(mode == "head", true) end
    if setChestToggle then setChestToggle(mode == "chest", true) end
    if mode then
        local where = (mode == "head") and "cabeza" or "pecho"
        Status.Text = S.target and ("Objetivo: @" .. S.target.Name .. "  •  " .. where) or "Elige un objetivo en Lista"
    else
        S.target = nil
        releaseCamLock()
        Status.Text = "Cam Lock desactivado"
    end
    if UI.showCamStop then UI.showCamStop(S.camLock) end
    if updatePlayerList then updatePlayerList() end
end

local function aimPoint(char, mode, rootPart)
    if mode == "head" then
        local h = char:FindFirstChild("Head")
        if h then return h.Position end
        return rootPart.Position + Vector3.new(0, 2, 0)
    end
    local t = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if t then return t.Position end
    return rootPart.Position + Vector3.new(0, 0.5, 0)
end

RunService:BindToRenderStep("TargetCamera", Enum.RenderPriority.Camera.Value + 1, function()
    if not S.camLock or not S.target then return end

    local cam = getCamera()
    local root, hum = getParts()
    if not cam or not root then return end

    local tChar = S.target.Character
    local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
    if not tRoot then
        if cam.CameraType == Enum.CameraType.Scriptable then cam.CameraType = Enum.CameraType.Custom end
        if hum and not hum.AutoRotate then hum.AutoRotate = true end
        return
    end

    local flat = Vector3.new(tRoot.Position.X - root.Position.X, 0, tRoot.Position.Z - root.Position.Z)
    if flat.Magnitude < 0.5 then return end
    local dir = flat.Unit

    cam.CameraType = Enum.CameraType.Scriptable
    cam.CFrame = CFrame.lookAt(
        root.Position - dir * 9 + Vector3.new(0, 3.5, 0),
        aimPoint(tChar, S.lockMode, tRoot)
    )

    if hum then hum.AutoRotate = false end
    root.CFrame = CFrame.lookAt(root.Position, root.Position + dir)
end)

print("[EfrenHub] parte 4 lista")
--==================================================
-- FLY (joystick + botones subir / bajar)
--==================================================

local flyBV

local function stopFly()
    if flyBV then
        flyBV:Destroy()
        flyBV = nil
    end
end

track(RunService.Heartbeat:Connect(function()
    if not S.fly then
        if flyBV then stopFly() end
        return
    end

    local root, hum = getParts()
    local cam = getCamera()
    if not root or not hum or not cam then
        stopFly()
        return
    end

    if not flyBV or flyBV.Parent ~= root then
        stopFly()
        flyBV = Instance.new("BodyVelocity")
        flyBV.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        flyBV.Velocity = Vector3.zero
        flyBV.Parent = root
    end

    local move = hum.MoveDirection
    local velocity = Vector3.zero

    if move.Magnitude > 0.05 then
        local rel = cam.CFrame:VectorToObjectSpace(move)
        local dir = cam.CFrame.LookVector * (-rel.Z) + cam.CFrame.RightVector * rel.X
        if dir.Magnitude > 0.01 then
            velocity = dir.Unit * move.Magnitude * S.flySpeed
        end
    end

    local vertical = (flyInput.up and 1 or 0) - (flyInput.down and 1 or 0)
    if vertical ~= 0 then
        velocity += Vector3.new(0, vertical * S.flySpeed, 0)
    end

    flyBV.Velocity = velocity
end))

--==================================================
-- NOCLIP
--==================================================

local setNoclip
do
    local parts, orig, refreshAt = {}, {}, 0

    setNoclip = function(enabled)
        S.noclip = enabled
        if not enabled then
            for p in pairs(orig) do
                if p.Parent then p.CanCollide = true end
            end
            table.clear(orig)
        else
            refreshAt = 0
        end
    end

    track(RunService.Stepped:Connect(function()
        if not S.noclip then return end
        local now = os.clock()
        if now >= refreshAt then
            refreshAt = now + 1
            table.clear(parts)
            local char = player.Character
            if char then
                for _, d in ipairs(char:GetDescendants()) do
                    if d:IsA("BasePart") then parts[#parts + 1] = d end
                end
            end
        end
        for i = 1, #parts do
            local p = parts[i]
            if p.Parent and p.CanCollide then
                orig[p] = true
                p.CanCollide = false
            end
        end
    end))

    track(player.CharacterAdded:Connect(function()
        table.clear(orig)
        refreshAt = 0
    end))
end

--==================================================
-- WALK SPEED (con límite anti-bucle)
--==================================================

local setWalkEnabled
do
    local humConn, reverts, fallback = nil, 0, false

    local function unbind()
        if humConn then
            humConn:Disconnect()
            humConn = nil
        end
    end

    local function bindHum(hum)
        unbind()
        if not hum then return end
        humConn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            if S.walk and hum.WalkSpeed ~= S.walkSpeed and reverts < 20 then
                reverts += 1
                hum.WalkSpeed = S.walkSpeed
            end
        end)
    end

    setWalkEnabled = function(value)
        local _, hum = getParts()
        if value then
            if hum and not S.walk and hum.WalkSpeed ~= S.walkSpeed then
                S.defWalk = hum.WalkSpeed
            end
            S.walk = true
            reverts = 0
            bindHum(hum)
            if hum then hum.WalkSpeed = S.walkSpeed end
        else
            S.walk = false
            fallback = false
            unbind()
            if hum then hum.WalkSpeed = S.defWalk end
        end
    end

    track(player.CharacterAdded:Connect(function(char)
        local hum = char:WaitForChild("Humanoid", 10)
        if S.walk and hum then
            bindHum(hum)
            hum.WalkSpeed = S.walkSpeed
        end
    end))

    track(RunService.Heartbeat:Connect(function(dt)
        if not S.walk then return end
        local root, hum = getParts()
        if not root or not hum then return end

        if hum.WalkSpeed ~= S.walkSpeed then hum.WalkSpeed = S.walkSpeed end

        if fallback and not S.fly and hum.MoveDirection.Magnitude > 0.05 then
            local v = root.AssemblyLinearVelocity
            local extra = S.walkSpeed - Vector3.new(v.X, 0, v.Z).Magnitude
            if extra > 1 then
                root.CFrame = root.CFrame + hum.MoveDirection * extra * dt
            end
        end
    end))

    task.spawn(function()
        while Screen.Parent do
            task.wait(1)
            fallback = S.walk and reverts >= 15
            reverts = 0
        end
    end)
end

--==================================================
-- INFINITE JUMP
--==================================================

track(UserInputService.JumpRequest:Connect(function()
    if S.infJump then
        local _, hum = getParts()
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end))

--==================================================
-- FULLBRIGHT
--==================================================

local FB, atmos = {}, {}

local function setFullbright(on)
    if on == S.full then return end
    S.full = on
    if on then
        FB.Brightness, FB.ClockTime, FB.FogEnd = Lighting.Brightness, Lighting.ClockTime, Lighting.FogEnd
        FB.FogStart, FB.Shadows = Lighting.FogStart, Lighting.GlobalShadows
        FB.Ambient, FB.Outdoor = Lighting.Ambient, Lighting.OutdoorAmbient
        for _, a in ipairs(Lighting:GetChildren()) do
            if a:IsA("Atmosphere") then
                atmos[a] = a.Density
                a.Density = 0
            end
        end
    else
        pcall(function()
            Lighting.Brightness, Lighting.ClockTime, Lighting.FogEnd = FB.Brightness, FB.ClockTime, FB.FogEnd
            Lighting.FogStart, Lighting.GlobalShadows = FB.FogStart, FB.Shadows
            Lighting.Ambient, Lighting.OutdoorAmbient = FB.Ambient, FB.Outdoor
        end)
        for a, v in pairs(atmos) do
            pcall(function() a.Density = v end)
        end
        atmos = {}
    end
end

task.spawn(function()
    while Screen.Parent do
        task.wait(0.6)
        if S.full then
            pcall(function()
                Lighting.Brightness = 2.5
                Lighting.ClockTime = 14
                Lighting.FogEnd = 100000
                Lighting.FogStart = 100000
                Lighting.GlobalShadows = false
                Lighting.Ambient = Color3.fromRGB(190, 190, 190)
                Lighting.OutdoorAmbient = Color3.fromRGB(190, 190, 190)
            end)
        end
    end
end)

print("[EfrenHub] parte 5 lista")
--==================================================
-- FPS BOOST (gráficos mínimos, reversible)
--==================================================

local setFpsBoost
do
    local orig = setmetatable({}, { __mode = "k" })
    local glob, conn, token = {}, nil, 0

    local KIND = {
        ParticleEmitter = "fx", Trail = "fx", Smoke = "fx", Fire = "fx", Sparkles = "fx", Beam = "fx",
        PointLight = "fx", SpotLight = "fx", SurfaceLight = "fx", Clouds = "fx",
        BloomEffect = "fx", BlurEffect = "fx", ColorCorrectionEffect = "fx",
        DepthOfFieldEffect = "fx", SunRaysEffect = "fx",
        Decal = "tex", Texture = "tex",
        Atmosphere = "atmo", SurfaceAppearance = "sa", Explosion = "boom",
    }

    -- Los personajes de jugadores no se tocan (así el ESP se ve limpio)
    local function isCharacter(inst)
        local m = inst:FindFirstAncestorOfClass("Model")
        return m ~= nil and Players:GetPlayerFromCharacter(m) ~= nil
    end

    local function boost(inst)
        if not S.boost or orig[inst] then return end
        local kind = KIND[inst.ClassName]
        if not kind then
            if inst.ClassName == "Terrain" or not inst:IsA("BasePart") then return end
            kind = "part"
        end

        local saved
        pcall(function()
            if kind == "fx" then
                saved = { Enabled = inst.Enabled }
                inst.Enabled = false
            elseif kind == "tex" then
                if isCharacter(inst) then return end
                saved = { Transparency = inst.Transparency }
                inst.Transparency = 1
            elseif kind == "atmo" then
                saved = { Density = inst.Density, Haze = inst.Haze }
                inst.Density = 0
                inst.Haze = 0
            elseif kind == "sa" then
                if isCharacter(inst) then return end
                saved = { Parent = inst.Parent }
                inst.Parent = nil
            elseif kind == "boom" then
                saved = { Visible = inst.Visible }
                inst.Visible = false
            else
                if isCharacter(inst) then return end
                saved = { Material = inst.Material, Reflectance = inst.Reflectance, CastShadow = inst.CastShadow }
                inst.Material = Enum.Material.SmoothPlastic
                inst.Reflectance = 0
                inst.CastShadow = false
                if inst:IsA("MeshPart") then
                    saved.TextureID = inst.TextureID
                    saved.RenderFidelity = inst.RenderFidelity
                    inst.TextureID = ""
                    inst.RenderFidelity = Enum.RenderFidelity.Performance
                end
            end
        end)
        if saved then orig[inst] = saved end
    end

    -- Recorre el mapa en pedacitos de 8 ms para no congelar el juego
    local function sweep(list, myToken)
        local t0 = os.clock()
        for i = 1, #list do
            if myToken ~= token or not S.boost then return end
            boost(list[i])
            if os.clock() - t0 > 0.008 then
                RunService.Heartbeat:Wait()
                t0 = os.clock()
            end
        end
    end

    local function applyGlobal()
        pcall(function()
            glob.Quality = settings().Rendering.QualityLevel
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)
        pcall(function()
            glob.Mesh = settings().Rendering.MeshPartDetailLevel
            settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04
        end)
        pcall(function()
            glob.Shadows = Lighting.GlobalShadows
            Lighting.GlobalShadows = false
        end)
        pcall(function()
            glob.Soft = Lighting.ShadowSoftness
            Lighting.ShadowSoftness = 0
        end)
        pcall(function()
            glob.EnvD, glob.EnvS = Lighting.EnvironmentDiffuseScale, Lighting.EnvironmentSpecularScale
            Lighting.EnvironmentDiffuseScale = 0
            Lighting.EnvironmentSpecularScale = 0
        end)
        pcall(function()
            local ms = game:GetService("MaterialService")
            glob.Mat = ms.Use2022Materials
            ms.Use2022Materials = false
        end)
        pcall(function()
            local t = Workspace.Terrain
            glob.Terrain = { WaterWaveSize = t.WaterWaveSize, WaterWaveSpeed = t.WaterWaveSpeed, WaterReflectance = t.WaterReflectance }
            glob.Decoration = t.Decoration
            t.WaterWaveSize, t.WaterWaveSpeed, t.WaterReflectance = 0, 0, 0
            t.Decoration = false
        end)
        pcall(function()
            if sethiddenproperty and gethiddenproperty then
                glob.Tech = gethiddenproperty(Lighting, "Technology")
                sethiddenproperty(Lighting, "Technology", Enum.Technology.Compatibility)
            end
        end)
    end

    local function restoreGlobal()
        pcall(function() if glob.Quality then settings().Rendering.QualityLevel = glob.Quality end end)
        pcall(function() if glob.Mesh then settings().Rendering.MeshPartDetailLevel = glob.Mesh end end)
        pcall(function() if glob.Shadows ~= nil then Lighting.GlobalShadows = glob.Shadows end end)
        pcall(function() if glob.Soft ~= nil then Lighting.ShadowSoftness = glob.Soft end end)
        pcall(function()
            if glob.EnvD then
                Lighting.EnvironmentDiffuseScale = glob.EnvD
                Lighting.EnvironmentSpecularScale = glob.EnvS
            end
        end)
        pcall(function()
            if glob.Mat ~= nil then game:GetService("MaterialService").Use2022Materials = glob.Mat end
        end)
        pcall(function()
            if glob.Terrain then
                for k, v in pairs(glob.Terrain) do Workspace.Terrain[k] = v end
            end
            if glob.Decoration ~= nil then Workspace.Terrain.Decoration = glob.Decoration end
        end)
        pcall(function()
            if glob.Tech and sethiddenproperty then sethiddenproperty(Lighting, "Technology", glob.Tech) end
        end)
        glob = {}
    end

    setFpsBoost = function(enabled)
        if enabled == S.boost then return end
        S.boost = enabled
        token += 1
        local myToken = token

        if enabled then
            applyGlobal()
            if conn then conn:Disconnect() end
            conn = Workspace.DescendantAdded:Connect(function(inst)
                if S.boost then task.defer(boost, inst) end
            end)
            task.spawn(function()
                sweep(Lighting:GetDescendants(), myToken)
                local cam = Workspace.CurrentCamera
                if cam then sweep(cam:GetDescendants(), myToken) end
                sweep(Workspace:GetDescendants(), myToken)
            end)
        else
            if conn then
                conn:Disconnect()
                conn = nil
            end
            for inst, saved in pairs(orig) do
                pcall(function()
                    for prop, value in pairs(saved) do inst[prop] = value end
                end)
            end
            table.clear(orig)
            restoreGlobal()
        end
    end
end

