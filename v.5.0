do
    createSection(ListPage, "BUSCAR JUGADOR")

    local search = Instance.new("TextBox")
    search.Size = UDim2.new(1, -4, 0, 28)
    search.BackgroundTransparency = 0.1
    search.PlaceholderText = "Escribe un nombre..."
    search.Text = ""
    search.TextSize = 11
    search.Font = Enum.Font.GothamBold
    search.ClearTextOnFocus = false
    search.LayoutOrder = nextOrder()
    search.Parent = ListPage
    bind(search, "BackgroundColor3", "Row")
    bind(search, "TextColor3", "White")
    bind(search, "PlaceholderColor3", "Gray")
    corner(search, 8)
    stroke(search, "Acc", 1, 0.5)

    createSection(ListPage, "JUGADORES CONECTADOS")

    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -4, 0, 0)
    container.BackgroundTransparency = 1
    container.AutomaticSize = Enum.AutomaticSize.Y
    container.LayoutOrder = nextOrder()
    container.Parent = ListPage

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 5)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = container

    updatePlayerList = function()
        local filter = string.lower(search.Text or "")

        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and (filter == "" or string.find(string.lower(plr.Name), filter, 1, true)) then
                local isTarget = S.target == plr

                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, 0, 0, 28)
                btn.BackgroundColor3 = isTarget and C.RowOn or C.Row
                btn.BackgroundTransparency = 0.1
                btn.Text = ""
                btn.AutoButtonColor = false
                btn.Parent = container
                corner(btn, 8)
                squish(btn)

                local bar = Instance.new("Frame")
                bar.AnchorPoint = Vector2.new(0, 0.5)
                bar.Position = UDim2.new(0, 0, 0.5, 0)
                bar.Size = UDim2.fromOffset(3, isTarget and 16 or 0)
                bar.BackgroundColor3 = C.Acc2
                bar.BorderSizePixel = 0
                bar.Parent = btn
                corner(bar, 2)

                local nameL = Instance.new("TextLabel")
                nameL.BackgroundTransparency = 1
                nameL.Position = UDim2.fromOffset(11, 0)
                nameL.Size = UDim2.new(1, -90, 1, 0)
                nameL.Text = "@" .. plr.Name
                nameL.TextColor3 = C.White
                nameL.TextSize = 11
                nameL.Font = Enum.Font.GothamBold
                nameL.TextXAlignment = Enum.TextXAlignment.Left
                nameL.TextTruncate = Enum.TextTruncate.AtEnd
                nameL.Parent = btn

                if isTarget then
                    local tag = Instance.new("TextLabel")
                    tag.BackgroundTransparency = 1
                    tag.Position = UDim2.new(1, -78, 0, 0)
                    tag.Size = UDim2.fromOffset(70, 28)
                    tag.Text = "OBJETIVO"
                    tag.TextColor3 = C.Acc2
                    tag.TextSize = 9
                    tag.Font = Enum.Font.GothamBlack
                    tag.TextXAlignment = Enum.TextXAlignment.Right
                    tag.Parent = btn
                end

                btn.Activated:Connect(function()
                    S.target = plr
                    setLockMode(S.lockMode or S.lastMode)
                    showPage("Funciones")
                end)
            end
        end
    end

    search:GetPropertyChangedSignal("Text"):Connect(function() updatePlayerList() end)
    onThemeSlow(function() updatePlayerList() end)
    updatePlayerList()
end

track(Players.PlayerAdded:Connect(function(plr)
    hookPlayer(plr)
    updatePlayerList()
end))

track(Players.PlayerRemoving:Connect(function(plr)
    removeESP(plr)
    if S.target == plr then
        setLockMode(nil)
        Status.Text = "El objetivo salió del juego"
    end
    task.defer(updatePlayerList)
end))

